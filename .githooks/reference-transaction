#!/bin/sh
# QCore-C main-ref guard — reference-transaction hook (git >= 2.28).
#
# This hook runs for EVERY reference update in the repository, from every
# worktree and from every command, which is why it sees the update a pre-push
# hook cannot: an agent running `git -C <main checkout> merge`.
#
# stdin: <old-value> SP <new-value> SP <ref-name> LF, one line per update.
# argv1: prepared | committed | aborted. A non-zero exit in "prepared" aborts
#        the whole transaction; the exit status is ignored in every other state.
#
# Card CARD-SCOPE-GUARD (wave 36). docs/reports/card-scope-guard/README.md.

set -u

. "$(dirname "$0")/qcore-main-guard.sh"

state="${1:-}"

# Always drain stdin, whatever the state, so git never writes to a closed pipe.
touched=0
detail=""
while IFS=' ' read -r old new ref; do
    [ "${ref:-}" = "$QCORE_PROTECTED_REF" ] || continue
    # A no-op update (main's own value written back) moves nothing. A DELETION
    # reaches this hook as 0000...->0000..., measured, so the all-zeroes new
    # value must be excluded here or a deletion passes as a no-op.
    if [ "${old:-}" = "${new:-}" ] && [ "${new:-}" != "$QCORE_ZERO_OID" ]; then
        continue
    fi
    touched=1
    detail="${detail:+$detail }${old}->${new}"
done

[ "$touched" = 1 ] || exit 0

signals=$(qcore_provenance_signals)

if [ "$state" = "committed" ]; then
    # Reached only when "prepared" allowed the update.
    qcore_guard_log "authorised-main-update" "$QCORE_PROTECTED_REF $detail"
    exit 0
fi

[ "$state" = "prepared" ] || exit 0

if [ -n "$signals" ]; then
    qcore_guard_log "refused-provenance:$signals" "$QCORE_PROTECTED_REF $detail"
    qcore_refusal_message "an update to $QCORE_PROTECTED_REF" "$signals"
    exit 1
fi

if qcore_is_authorised; then
    exit 0
fi

qcore_guard_log "refused-unauthorised" "$QCORE_PROTECTED_REF $detail"
qcore_refusal_message "an update to $QCORE_PROTECTED_REF" ""
exit 1
