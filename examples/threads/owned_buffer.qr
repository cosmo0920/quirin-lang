#import std.concurrency;
#import std.logger;
#import std.fmt;
// Move one buffer to a worker while the parent uses a separate buffer.
concurrency checked;

fn worker(buffer: own<Buffer> use one) -> own<Buffer> {
    let seen = qcore_buffer_read(buffer);
    return move buffer;
}

fn main() -> i32 effects { io, alloc, throws<AllocError>, throws<SpawnError>, spawn, join, may_block } {
    log_level trace;
    let first = qcore_buffer_new(42)?;
    match qcore_buffer_new(7) {
        Result::Ok { value: second } => {
            thread scope workers {
                match spawn workers worker(move first) {
                    Result::Ok { value: handle } => {
                        // The parent can use second while the child owns first.
                        // The read and the rendering are one chain: the buffer
                        // read is a call-shaped model intrinsic, so it is an
                        // ordinary pipeline stage (card PIPE-INTRINSIC-STAGE).
                        second |> qcore_buffer_read |> log info dec;
                        second |> drop;
                        let returned = join move handle?;
                        // Post-join, the parent owns the buffer again: this
                        // renders the number the model computed out of it.
                        // Here the read keeps its own binding rather than
                        // becoming a stage, because the number is used twice --
                        // rendered and returned -- and a pipeline is linear.
                        let value = qcore_buffer_read(returned);
                        value |> log info dec;
                        drop returned;
                        return value;
                    }
                    Result::Err { error: failure } => {
                        // Failed creation restores first to the parent.
                        drop second;
                        let value = qcore_buffer_read(first);
                        value |> log warn dec;
                        drop first;
                        return value;
                    }
                }
            }
        }
        Result::Err { error: shortfall } => {
            let value = qcore_buffer_read(first);
            value |> log fatal dec;
            drop first;
            return value;
        }
    }
}
