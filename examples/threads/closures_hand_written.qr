#import std.concurrency;
#import std.logger;
#import std.fmt;
#import std.io;
// The hand-written twin of closures.qr: each closure written as a named
// worker declared before `main`, its parameters the capture binders at the
// types the captured places have, and each spawn naming the worker with the
// same captures. It checks and emits byte for byte as closures.qr does.
concurrency checked;

type Job { count: i32, data: own<Buffer<u32>> }

fn first_lane(bonus: i32, job: Job use one, pixels: lend<Buffer>) -> Job effects { mut } {
    let seen = qcore_buffer_read(job.data);
    let written = qcore_buffer_write(job.data, 64);
    job.count = bonus;
    let low = qcore_buffer_write(pixels, 0, 17);
    let high = qcore_buffer_write(pixels, 1, 34);
    return move job;
}

fn second_lane(mark: i32, pixels: lend<Buffer>) -> i32 {
    let low = qcore_buffer_write(pixels, 0, 51);
    let high = qcore_buffer_write(pixels, 1, 68);
    return mark;
}

fn main() -> i32 effects { io, alloc, throws<AllocError>, spawn, join, may_block } {
    log_level trace;
    let bonus = 41;
    let start: u32 = 21;
    let data = qcore_buffer_new(start)?;
    let job = Job { count: 1, data: data };
    match qcore_buffer_new(0) {
        Result::Ok { value: pixels } => {
            thread scope lanes {
                match spawn lanes first_lane(copy bonus, move job, lend pixels 0..2) {
                    Result::Ok { value: first } => {
                        match spawn lanes second_lane(copy bonus, lend pixels 2..4) {
                            Result::Ok { value: second } => {
                                let done = join move first?;
                                let mark = join move second?;
                                print dec done.count;
                                let value = qcore_buffer_read(done.data);
                                print dec value;
                                print dec mark;
                                let bytes = qcore_buffer_read(pixels);
                                print hex bytes;
                                drop done;
                                drop pixels;
                                return 0;
                            }
                            Result::Err { error: refused } => {
                                let done = join move first?;
                                drop done;
                                drop pixels;
                                return 1;
                            }
                        }
                    }
                    Result::Err { error: failure } => {
                        print dec job.count;
                        drop job;
                        drop pixels;
                        return 2;
                    }
                }
            }
        }
        Result::Err { error: shortfall } => {
            drop job;
            return 3;
        }
    }
}
