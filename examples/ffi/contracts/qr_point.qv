module contract;

// The declared model of `qr_point.c` (card W48-QR-USABLE-RECORDS).
//
// Each function is marked `[| quant #c_ffi |]`: it takes or returns the
// imported struct, so a `.qr` call of it is admitted only through a marked
// declaration. Loading this file asserts nothing about the C: it is a declared
// assumption, and a file that calls through it is unsafe as a whole.

// A borrowed `const` pointer to the struct: the callee reads it, keeps nothing.
[| quant #c_ffi |]
extern fn qr_point_norm(point: ptr<const, c"struct qr_point">) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(point);
    ensures normal resource_return_none();
};

// The struct by value in and out, with two scalars: copies the caller owns.
[| quant #c_ffi |]
extern fn qr_point_moved(point: c"struct qr_point", dx: i32, dy: i32) -> c"struct qr_point"
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(point);
    ensures normal resource_borrowed(dx);
    ensures normal resource_borrowed(dy);
    ensures normal resource_return_none();
};
