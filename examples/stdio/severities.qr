#import std.fmt;
#import std.logger;

// `log` at every severity the logger has, and the barrier that hands the lines
// on.
//
// The six levels are ordered from `trace` through `fatal`. `error` is
// interpreted contextually here while remaining the declaration keyword in
// `error Failure { Failed; }`.
//
// `fatal` is a severity tag on a line. It does not exit, abort or raise.
fn main() -> unit effects { io } {
    let total = 42;
    let mask = 255;
    log trace dec total;
    log debug hex mask;
    log info dec total;
    log warn hex mask;
    log error dec -7;
    log fatal dec -7;
    flush;
    return;
}
