#import std.extern;
#import std.logger;

// A multi-stage chain. `x |> f(a) |> g(b)` means `g(f(x, a), b)`.
//
//     let scaled = b |> demo_sum(8) |> demo_scale(2) |> demo_scale(3);
//
// Three stages, two intermediate values, no names. The intermediates are
// **hygienic temporaries**: the desugarer invents them, they cannot collide with
// anything you wrote, they cannot be mentioned, and they never reach the emitted
// C, which names values `vN` by identity. `scalar_stages_hand_written.qcore` is
// the same program with those temporaries named by hand, and a test asserts the
// two emit byte-identical C11.
//
// What makes a chain possible at all is that a *scalar* can be an intermediate
// stage. Custody cannot: every stage before the last would have to hold a
// resource it has no way to discharge on a failure arm. So chains are data
// pipelines, and the resource in this file travels the ordinary way — acquired
// once, lent at the first stage, released by name at the end.
//
// Note the first and last lines: the operand of a pipeline is an ordinary
// expression, so `8 |> demo_alloc` and `move b |> demo_release` are the pipe
// spelling of an acquisition and a consumption. `move b` still moves. A use of
// `b` after that statement refuses exactly as it does without the pipe.
error Failure { Failed; }

extern fn demo_alloc(size: usize) -> ptr<mut, u8>;
extern fn demo_fill(buffer: ptr<mut, u8>, value: u32) -> unit;
extern fn demo_sum(buffer: ptr<const, u8>, count: u32) -> i32;
extern fn demo_scale(value: i32, factor: i32) -> i32;
extern fn demo_release(buffer: ptr<mut, u8>) -> unit;

fn main() -> unit effects { io, alloc, mut } {
    log_level trace;
    let b = 8 |> demo_alloc succeeds true else raise Failure;
    b |> demo_fill(7);
    let scaled = b |> demo_sum(8) |> demo_scale(2) |> demo_scale(3);
    move b |> demo_release;
    return;
}
