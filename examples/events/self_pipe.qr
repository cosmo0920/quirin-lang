import std.event;
import std.logger;

// One event context, one endpoint pair the program created itself, one read
// registration on it, one readiness the program induced, one dispatch turn that
// declares what it reports, and a complete teardown.
//
// Every wait in this program is on readiness this program caused. That is what
// makes "the" observation well-defined, and it is the whole determinism
// argument of `source.event.v1` v1 (docs/design/STD_EVENT_V1.md §3).
fn main() -> i32 effects { io } {
    log_level trace;
    event open;
    endpoints a b;
    watch reader a read;
    wake a;
    dispatch ready reader;
    dispatch idle;
    unwatch reader;
    close a;
    close b;
    event close;
    return 0;
}
