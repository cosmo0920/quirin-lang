// ## Card CALLEE-RETENTION-CLASS1, stage (a): the custody-taking setters
//
// USER DECISION 2026-10-05 (W48-CALLEE-DECISION-TABLE class 1, "split by
// shape"). Pinned (C06.2) after reading the bodies at both audited revisions
// (`lib/ctraces/src/ctr_attributes.c:78-88` is byte-identical at `66910c10`
// and `046accf6`):
//
//     int ctr_attributes_set_array(struct ctrace_attributes *attr, char *key,
//                                  struct cfl_array *value)
//     {
//         return cfl_kvlist_insert_array(attr->kv, key, value);
//     }
//
// and `ctr_attributes_set_kvlist` likewise over `cfl_kvlist_insert_kvlist`.
// Each forwards the cfl insert's returned value unchanged (both `int`), so it
// has the insert's disposition (quirin-provider-cfl `sds_lifetime.qv`): `eq 0`
// `value` consumed into `attr->kv`, `ne 0` still the caller's. Declared here
// because their callers (`ctr_span.c`'s `ctr_span_set_attribute_*` and
// `ctr_span_event_set_attribute_*`) sit in another unit; in their own unit the
// body is checked against the declaration by the forwarding route (gateway
// rule 12s), and a contradiction withdraws it at every call site there.
// `attr` is read (`attr->kv`) and keeps its custody; `key` is copied by the
// insert: both `resource_borrowed`. `value` is declared `nonnull` although the
// insert tolerates NULL: rule 11r(5) compares a declared class with the body's
// validated summary exactly, and the forwarding route's summary binds the
// formal non-null (W4 proposes a nullable precondition only where a path
// needs one), so `nullable` would be withdrawn against this very body. The
// stronger precondition is the refusing direction for a caller.

extern fn ctr_attributes_set_array(attr: ptr<mut, u8>, key: ptr<mut, u8>, value: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(attr);
    ensures normal resource_borrowed(key);
    ensures normal resource_on_return(eq, 0, resource_consumed(value, nonnull));
    ensures normal resource_on_return(ne, 0, resource_owned(value, nonnull));
    ensures normal resource_return_none();
};

extern fn ctr_attributes_set_kvlist(attr: ptr<mut, u8>, key: ptr<mut, u8>, value: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(attr);
    ensures normal resource_borrowed(key);
    ensures normal resource_on_return(eq, 0, resource_consumed(value, nonnull));
    ensures normal resource_on_return(ne, 0, resource_owned(value, nonnull));
    ensures normal resource_return_none();
};

// # Slot move (card SLOT-MOVE-AND-INTERIOR-BORROW, class 2, gateway rule 12x)
//
// `lib/ctraces/src/ctr_encode_text.c:22-28` (byte-identical at `66910c10` and
// `046accf6`; the only definition of the name in either tree):
//
//     static inline void sds_cat_safe(cfl_sds_t *buf, char *str)
//     {
//         int len;
//         len = strlen(str);
//         cfl_sds_cat_safe(buf, str, len);
//     }
//
// It forwards its slot to `cfl_sds_cat_safe` (quirin-provider-cfl,
// `resource_slot_moved(buf, nullable)`) and reads `str`: the same slot move.
// Rule 13a checks it against this body in `ctr_encode_text.c` (every mention
// of `buf` is a whole actual at a slot-moving position).

extern fn sds_cat_safe(buf: ptr<mut, ptr<mut, u8>>, str: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(buf);
    ensures normal resource_borrowed(str);
    ensures normal resource_slot_moved(buf, nullable);
    ensures normal resource_return_none();
};

// # Card CG10-INDIRECT-ACCESS-SOLE-RESIDUALS round 2: `ctr_errno_print`
//
// ONE TRUSTED ASSUMPTION, pinned (contract spec C06.2) after reading the body
// at both audited revisions (`lib/ctraces/src/ctr_log.c` is byte-identical at
// `66910c10` and `046accf6`; `include/ctraces/ctr_log.h` differs only in the
// file-name macro its logging macros spell, `__FILENAME__` against
// `__CTR_FILENAME__`, and declares the same prototype at line 38; the only
// definition of the name in either tree):
//
//     int ctr_errno_print(int errnum, const char *file, int line)
//     {
//         char buf[256];
//
//         strerror_r(errnum, buf, sizeof(buf) - 1);
//         fprintf(stderr, "[%s:%i errno=%i] %s\n",
//                 file, line, errnum, buf);
//         return 0;
//     }
//
// It reads `file`, frees and stores nothing, and returns 0: the neutral
// element, every formal `resource_borrowed`, `resource_return_none()`.
// Callers spell it `ctr_errno()`, whose actual is `errno`.
//
// ABI: `int ctr_errno_print(int, const char *, int)`; `i32`, `ptr<const, u8>`,
// `i32`, `-> i32`.
//
// NOT CLAIMED: what is printed, or `file`'s validity.

extern fn ctr_errno_print(errnum: i32, file: ptr<const, u8>, line: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(errnum);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(line);
    ensures normal resource_return_none();
};

// ## The array and map unpackers (card CG22-CALLBACK-REGISTRY-CONTRACT)
//
// Contract spec C04.19, gateway rules 13u (synchronous invocation) and 13v
// (table dispatch); the cmetrics unpackers' reading
// (`qcore-provider-cmetrics/contracts/cmetrics/mpack_utils.qv`), over
// `lib/ctraces/src/ctr_mpack_utils.c`. Each body read at both audited
// revisions: `ctr_mpack_unpack_array` (`:400-457`) is byte-identical at
// `66910c10` and `046accf6`; `046accf6` adds to `ctr_mpack_unpack_map`
// (`:331-398`) a duplicate-key check (a local `handled_entries` array; each
// handler is then called at most once per map), which changes nothing below.
//
// `ctr_mpack_unpack_array(reader, entry_processor_callback, context)` reads
// an array tag through `reader` and calls `entry_processor_callback(reader,
// entry_index, context)` once per entry while the previous call succeeded:
// during the call only, zero or more times, never stored, handed on or
// rebound (rule 13y checks this against the body). `ctr_mpack_unpack_map`
// walks the caller's `callback_list` for each key it reads and calls the
// matching entry's `handler(reader, entry_index, context)`: handlers read
// from the caller's table during the call only (a declared assumption, not
// body-checked). `ctr_mpack_unpacker_entry_callback_fn_t` is `int
// (*)(mpack_reader_t *, size_t, void *)` (`ctr_mpack_utils.h:27-28`),
// projected `fnptr`; the pointers are `ptr<mut, u8>`; the result is a status.

extern fn ctr_mpack_unpack_array(reader: ptr<mut, u8>, entry_processor_callback: fnptr, context: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(reader);
    ensures normal resource_borrowed(entry_processor_callback);
    ensures normal resource_borrowed(context);
    ensures normal resource_callback_invoked(entry_processor_callback, reader, _, context);
    ensures normal resource_return_none();
};

extern fn ctr_mpack_unpack_map(reader: ptr<mut, u8>, callback_list: ptr<mut, u8>, context: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(reader);
    ensures normal resource_borrowed(callback_list);
    ensures normal resource_borrowed(context);
    ensures normal resource_callback_table(callback_list, reader, _, context);
    ensures normal resource_return_none();
};
