module contract;

// W47-LOOP-OWNER-INSTANCE-FLOW (gateway rule 10p's amendment). The Fluent
// Bit facts the thread-entry census needed to tie the fixed in_tail pause
// test's plugin copy to the instance it is installed on
// (`tests/runtime/in_tail.c:2551-2557` at 90978ac6), written down as
// contracts. Nothing here is trusted: every clause below is either checked
// against its body or held for human review.
//
// ## What is checked, and how
//
// The four bodies were read at 66910c10a4d7eafa810b84229cf2dcf7b0f26f97 (the
// corpus source), 046accf6aded7906f66a1baf0202da349e521736 (the system clone)
// and the 90978ac6a59e96d19621108f63e115eb4cd1c576 export (synthetic commit
// 34155955): `flb_create` (src/flb_lib.c:145), `flb_input` (:268) and
// `flb_service_set` (:674) are byte-identical at all three; `flb_input_new`
// (src/flb_input.c:326) differs only by one TLS field initialisation at
// 046accf6 and the export (`tls_crl_file`), which changes no custody
// (docs/reports/w47-loop-owner-instance-flow/scripts/bodies.py). A bare clause
// is a custody fact those readings establish; the per-unit audit also checks
// it against the body wherever it analyses one (contract specification
// C06.4). Each declaration is pinned to those three identities.
//
// ## What is held for review, and why
//
// Resource v1 cannot state a retained pointer (rule 10j), an instance's list
// membership, its coroutine flag, or a list's contents. Every clause that
// would need one is wrapped in `resource_review_pending` (contract
// specification C06.1): the declaration is loaded, validated and pinned, then
// withheld, so it discharges nothing and accuses nothing, and every call site
// that would apply it is held as `awaiting-human-review` (Pending when
// nothing else is open, never Safe, never Unsafe). The reason of each marker
// is the observation itself. Resolving one is a person's decision that the
// observation holds AND that v1 can say it; unwrapping a clause whose reason
// says "retained" would state a false borrow and is not a resolution.
// W47-REVIEW-HOLD-CONCRETE-REASON: those three markers end with
// `rewrite_before_acceptance` (contract specification C06.1), so every row
// holding the call publishes them as `must-be-rewritten-before-acceptance`;
// the other markers are `acceptable-as-written-after-review`. The category
// changes no verdict: a caller whose only open reason is a hold stays Pending.

// The context the test's list is read from (P-FRESH-CONTEXT,
// P-REGISTERED-DESCRIPTORS). `flb_create` allocates the context
// (`flb_calloc`, :163) and returns it, or NULL after releasing what it made on
// every failure path (:163-212). Its config comes from `flb_config_init`
// (:169), which initialises `config->inputs` empty (src/flb_config.c:507)
// and `config->in_plugins` (:502) and registers the build's descriptors
// through the generated `flb_plugins_register` (one heap copy of each
// compiled-in descriptor, `memcpy` then `mk_list_add(&in->_head,
// &config->in_plugins)`), which no census reads.
extern fn flb_create() -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_review_pending(resource_return_owned(nullable), "P-FRESH-CONTEXT and P-REGISTERED-DESCRIPTORS: a non-null result is a new context whose config's input list is empty and whose registered input plugins are the build's compiled-in descriptors, one copy each (src/flb_lib.c:145-221, src/flb_config.c:502-507, the generated flb_plugins_register); v1 states the owned result, not a list's contents", "fluent-bit maintainers");
};

// The test's one creation (P-HEAD-INSTANCE). `flb_input` calls
// `flb_input_new(ctx->config, input, data, FLB_TRUE)` once (:272) and
// returns the instance's id, or -1 when it returns NULL. `input` is read,
// not kept (`flb_input_new` compares it with each registered name and parses
// a network address out of it into its own strings); `data` is stored in the
// instance (`instance->data = data`, src/flb_input.c:496) and handed to the
// plugin's callbacks (`flb_input_instance_init` passes `ins->data` to
// `cb_init`).
extern fn flb_input(ctx: ptr<mut, u8>, input: ptr<const, u8>, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(input);
    ensures normal resource_review_pending(resource_borrowed(data), "retained, not borrowed: data is stored in the created instance (instance->data, src/flb_input.c:496) and passed to the plugin's callbacks; v1 has no retained-pointer mode (rule 10j), so this clause must not be unwrapped as written", rewrite_before_acceptance);
    ensures normal resource_review_pending(resource_return_none(), "P-HEAD-INSTANCE: a result >= 0 means flb_input_new created at least one instance on ctx->config's input list (src/flb_lib.c:268-278); the test reads that list's head without checking it (tests/runtime/in_tail.c:2551-2552), so the census states that the creation succeeded");
};

// The constructor. It walks `config->in_plugins` and, for **every** plugin
// whose name matches `input` ignoring ASCII case (`check_protocol`, :244; the
// loop has no `break` after a creation), allocates an instance, sets
// `instance->p = plugin` (:490), `instance->data = data` (:496),
// `instance->config = config` (:408), `runs_in_coroutine` false then true iff
// the plugin's flags carry FLB_INPUT_CORO (:501, :626), appends it with
// `mk_list_add(&instance->_head, &config->inputs)` (:677), and returns the
// last one, or NULL. The instance is owned by the config's list and released
// by `flb_input_exit_all` through the config's exit, so the result points
// into storage `config` owns (rule 10j's W47-CALLEE-CLOSURE-R2 amendment).
extern fn flb_input_new(config: ptr<mut, u8>, input: ptr<const, u8>, data: ptr<mut, u8>, public_only: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_review_pending(resource_borrowed(config), "retained, not borrowed: the created instance keeps config (instance->config, src/flb_input.c:408) and is linked into config->inputs (:677); v1 has no retained-pointer mode (rule 10j), so this clause must not be unwrapped as written", rewrite_before_acceptance);
    ensures normal resource_borrowed(input);
    ensures normal resource_review_pending(resource_borrowed(data), "retained, not borrowed: data is stored in the instance (instance->data, src/flb_input.c:496); v1 has no retained-pointer mode (rule 10j), so this clause must not be unwrapped as written", rewrite_before_acceptance);
    ensures normal resource_borrowed(public_only);
    ensures normal resource_review_pending(resource_return_interior(config, nullable), "creation: one instance per registered input plugin whose name matches input ignoring ASCII case, each appended to config->inputs (src/flb_input.c:677) with p set to that plugin (:490) and runs_in_coroutine set from its FLB_INPUT_CORO flag (:501, :626) and written nowhere else; the last is returned; v1 states neither list membership nor the flag");
};

// The call that held the fixed test's derivation at the 90978ac6 export.
// `flb_service_set(ctx, key, value, …, NULL)` reads its variadic list in
// key-first pairs (`while ((key = va_arg(va, char *)))`, then `value =
// va_arg(va, char *)`, src/flb_lib.c:683-684), stops at the first null key
// or value or failing key, and passes each key to
// `flb_config_set_property(ctx->config, key, value)` (:691), nothing else.
// W47-SERVICE-PROPERTY-KEYS: the thread-entry census now derives, from these
// bodies at the export, which keys a literal call reaches (rule 10p's
// amendment); the observation is recorded here so it is pinned with the
// bodies it rests on and reviewed, never trusted.
extern fn flb_service_set(ctx: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ctx);
    ensures normal resource_review_pending(resource_variadic_data_tail(), "key-dependent effects: the tail is read as NULL-terminated key/value pairs, key first (src/flb_lib.c:683-684), each key passed to flb_config_set_property(ctx->config, key, value) in order until a null key or value or a failing key (:691); a key's effect is its flb_config_set_property branch (that declaration's reason); only Plugins_File registers input plugins; whether the value strings are copied on every key's branch is that function's; v1 cannot state a key-dependent effect");
    ensures normal resource_return_none();
};

// W47-SERVICE-PROPERTY-KEYS. The property function the census reads a keyed
// `flb_service_set` call through (src/flb_config.c:855-955, with its table
// `service_configs[]` :56-278 and comparison `prop_key_check` :782-791,
// byte-identical at the three trees). For every table entry whose key equals
// `k` ignoring ASCII case over its whole length (`strncasecmp` bounded by
// `strnlen(k, 256)`, and `strnlen(key, 256)` equal to it), it runs one arm,
// chosen by the entry's own key: `Log_Level` → `set_log_level_from_env` /
// `flb_env_var_translate` / `set_log_level` (:869-894); `Parsers_File` →
// `flb_parser_conf_file` (:895-902, under FLB_HAVE_PARSER); `Plugins_File` →
// `flb_plugin_load_config_file`, which registers shared-object and Go-proxy
// input plugins into `config->in_plugins` (:903-908; src/flb_plugin.c:251,
// src/flb_plugin_proxy.c:410); every other entry → one scalar store
// `*(T *)((char *)config + offset)` into the entry's `struct flb_config`
// field, T its declared type (int, double, or char * after freeing the old
// string and duplicating the translated value; :909-940). An unknown key
// warns and returns 0 (:953). `k` and `v` are read and not kept: `k` by the
// comparisons and the warning, `v` through `flb_env_var_translate`'s copy and
// `set_log_level`'s comparisons. What `config` retains through a loaded
// plugin or parser was not read, and v1 cannot state a key-dependent effect,
// so the declaration is held.
extern fn flb_config_set_property(config: ptr<mut, u8>, k: ptr<const, u8>, v: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_review_pending(resource_borrowed(config), "key-dependent effects: for every service_configs entry whose key equals k ignoring ASCII case over its whole length (prop_key_check, src/flb_config.c:782-791), the entry's arm runs: Log_Level sets the log level (:869-894), Parsers_File loads a parsers file (:895-902), Plugins_File registers input plugins into config->in_plugins (:903-908, src/flb_plugin.c:251), every other entry stores one scalar into its own struct flb_config field of its declared type (:909-940); an unknown key only warns (:953); what config retains through a loaded plugin or parser was not read, and v1 cannot state a key-dependent effect");
    ensures normal resource_borrowed(k);
    ensures normal resource_borrowed(v);
    ensures normal resource_return_none();
};
