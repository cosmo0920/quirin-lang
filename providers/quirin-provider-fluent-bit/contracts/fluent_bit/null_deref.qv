module contract;

// Card NULL-SAFETY-PROPERTY (USER DECISION 2026-10-10, decision 2; contract
// specification C09.3, grammar G05d, gateway rules 14o-14p). Bounds contract
// v1 null-dereference checks: `quant null-deref #B;` says the function
// dereferences `B`, so every caller must pass a non-null `B` (otherwise the
// call is a NULL-dereference candidate). Read only by the null-dereference
// property (`QCORE_NULL_PROPERTY`); the bounds consumer never reads these
// clauses, and the resource loader rejects this module.
//
// Each body was read at the two audited Fluent Bit revisions 66910c10 and
// 046accf6 (`scripts/bodies.py`; byte-identical except
// flb_output_set_property, whose first statement reads ins->config at both),
// and the system route's inference (rule 14p) found the formal dereferenced on
// every terminating path before any NULL test. Ranked by the plugin and core
// files that call it (`scripts/clause_rank.py`). Pinned with `quirin-audit pin
// --bounds` at both revisions (`bounds-contracts.lock`).

// flb_output.c: ins->context = context;
extern fn flb_output_set_context(ins: ptr<mut, u8>, context: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #ins;
};

// flb_output.c: if (!ins->host.name) ... (host is read only on that arm).
extern fn flb_output_net_default(host: ptr<const, u8>, port: i32, ins: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #ins;
};

// flb_output.c: if (ins->alias) return ins->alias; return ins->name;
extern fn flb_output_name(ins: ptr<mut, u8>) -> ptr<const, u8>
contract {
    requires bounds_contract_v1;
    quant null-deref #ins;
};

// flb_output.c: struct flb_config *config = ins->config; (both revisions)
extern fn flb_output_set_property(ins: ptr<mut, u8>, k: ptr<const, u8>, v: ptr<const, u8>) -> i32
contract {
    requires bounds_contract_v1;
    quant null-deref #ins;
};

// flb_input_chunk.c: ch = (struct cio_chunk *) ic->chunk; return ch->name;
extern fn flb_input_chunk_get_name(ic: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    quant null-deref #ic;
};

// Card NONNULL-MEMBER-UNIFIED-QUALIFIER (USER DECISION 2026-10-16, decision
// 3, "Migrate, one spelling"): the stable and scope kinds are spelled as one
// clause, `nonnull_member(TAG, FIELD) where quant #scope [[stable]]` and
// `nonnull_member(TAG, FIELD, P) where quant #scope [[scope]]`; each loads to
// the fact its retired spelling did. No declaration here names a premise.
//
// Card FB-PLUGIN-DESCRIPTOR-NONNULL-SCOPE (contract specification C09.3
// "Scoped member invariants", grammar G05f, gateway rules 14x-14z): the
// plugin descriptor of a Fluent Bit instance, `instance->p`, is stable.
// `requires nonnull_member(TAG, p) where quant #scope [[stable]];` says p is never made NULL on an
// existing instance. Every store of p the trees make was read at 66910c10 and
// 046accf6 (and the tail-pause export of 90978ac6, byte-identical to 046accf6
// for every function below): each constructor finds the plugin by name in
// the config's registered list, dereferences it (`plugin->name`,
// `plugin->flags`), then stores `instance->p = plugin` into the instance it
// allocated with flb_calloc (flb_input.c:490, flb_output.c:779 at 66910c10 and
// :857 at 046accf6, flb_filter.c:507, flb_processor.c:2188; flb_input_new and
// flb_output_new differ between the revisions only by the tls_crl_file
// initialisation). No other file under src/, include/ or plugins/ stores
// p, and no file of the system or tail-pause selection writes a whole
// instance (memset, memcpy, struct assignment). The calloc'd object's NULL p is not a store (rule 14x examines
// assignments, struct assignments and typed fills); a fresh object starts
// outside the stable state, and nothing reads p before :490 / :857. The test
// sources (tests/internal/*.c) also store p, always a plugin's address or a
// plugin pointer; they are in no audited selection. flb_custom_instance.p
// (flb_custom.c:214) has no reader on any route and is not declared.
extern fn flb_input_new(config: ptr<mut, u8>, input: ptr<const, u8>, data: ptr<mut, u8>, public_only: i32) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p) where quant #scope [[stable]];
};

extern fn flb_output_new(config: ptr<mut, u8>, output: ptr<const, u8>, data: ptr<mut, u8>, public_only: i32) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_output_instance, p) where quant #scope [[stable]];
};

extern fn flb_filter_new(config: ptr<mut, u8>, filter: ptr<const, u8>, data: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_filter_instance, p) where quant #scope [[stable]];
};

extern fn flb_processor_instance_create(config: ptr<mut, u8>, pu: ptr<mut, u8>, event_type: i32, name: ptr<const, u8>, data: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_processor_instance, p) where quant #scope [[stable]];
};

// Function-scope entries (rule 14z): `requires nonnull_member(
// flb_input_instance, p, ins) where quant #scope [[scope]];` says the instance `ins` names has a non-null
// plugin on entry; every direct caller's actual is a checked obligation, and
// with p stable (above) the entry fact lasts the whole body. Chosen by
// docs/reports/fb-plugin-descriptor-nonnull/scripts/scope_candidates.py from
// the stable-only reading's slice and system runs: every function whose own
// row kept only candidates on `ins->p` for its instance formal `ins`, with
// external linkage and its address taken nowhere in the trees (an indirect
// caller is never checked). Each reads `ins->p` (or a copy of it) without a
// NULL test; each definition is byte-identical at 046accf6 and the
// tail-pause export (flb_input_pause differs at 66910c10 only in its
// already-paused test, which 046accf6 also lets through during a shutdown
// flush; both read ins->p the same way).

// flb_input.c: `if (ins->p->cb_pause_checked != NULL)`, then `ins->p->cb_pause`.
extern fn flb_input_plugin_pause(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input.c: `if (ins->p->cb_resume_checked != NULL)`, then `ins->p->cb_resume`.
extern fn flb_input_plugin_resume(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input.c: `flb_input_buf_paused(ins)`, then `ins->p->cb_pause || ins->p->cb_pause_checked`, and `flb_input_plugin_pause(ins)`.
extern fn flb_input_pause(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input.c: `ins->p->cb_resume || ins->p->cb_resume_checked`, and `flb_input_plugin_resume(ins)`.
extern fn flb_input_resume(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input.c: `flb_input_is_threaded(ins)` (then `flb_input_thread_instance_pre_run(config, ins)`), else `ins->p->cb_pre_run`.
extern fn flb_input_instance_pre_run(ins: ptr<mut, u8>, config: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input.c: `flb_input_is_threaded(ins)`, then `p = ins->p; if (p->cb_exit && ins->context)`.
extern fn flb_input_instance_exit(ins: ptr<mut, u8>, config: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input_thread.c: `if (ins->p->cb_pre_run)`.
extern fn flb_input_thread_instance_pre_run(config: ptr<mut, u8>, ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input_thread.c: `flb_plg_debug(ins, "thread pause instance")` reads `ins->p->name` (flb_input_plugin.h:50-54).
extern fn flb_input_thread_instance_pause(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input_thread.c: `flb_plg_debug(ins, "thread resume instance")` reads `ins->p->name`.
extern fn flb_input_thread_instance_resume(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
};

// flb_input_thread.c: `flb_plg_debug(ins, "thread exit instance")` reads `ins->p->name`.
extern fn flb_input_thread_instance_exit(ins: ptr<mut, u8>) -> i32
contract {
    requires bounds_contract_v1;
    requires nonnull_member(flb_input_instance, p, ins) where quant #scope [[scope]];
