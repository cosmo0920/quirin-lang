module contract;

// Conditional filesystem arm of cio_chunk_close. Freeing the enclosing chunk
// preserves unresolved OS obligations and does not turn deletion failure into
// success. This does not establish callers, stream iteration or context teardown.
extern fn filesystem_chunk_close() -> unit
contract {
    requires nullable_owned_filesystem_chunk_and_live_name;
    requires delete_argument_is_boolean;
    requires backend_dependency_custody_outcome_and_frame_premises;
    requires backend_path_name_and_chunk_have_disjoint_owned_provenance;
    requires live_exclusive_distinct_reciprocal_list_memberships;
    requires context_and_stream_outlive_and_are_disjoint_from_owned_storage;
    requires total_and_up_counters_cover_entry_obligations;
    requires no_lock_busy_task_route_or_transaction_obligations;
    requires reset_list_counter_and_backend_cross_unit_source_abi_bindings;
    requires free_resolves_to_libc;
    ensures normal backend_calls == chunk_was_nonnull;
    ensures normal primary_unlinked == chunk_was_nonnull;
    ensures normal state_unlinked == chunk_was_nonnull;
    ensures normal name_released == chunk_was_nonnull;
    ensures normal chunk_released == chunk_was_nonnull;
    ensures normal total_counter_decrements == chunk_was_nonnull;
    ensures normal mapping_unresolved == dependency_mapping_unresolved;
    ensures normal descriptor_unresolved == dependency_descriptor_unresolved;
    ensures normal deletion_succeeded == dependency_deletion_succeeded;
    ensures normal up_counter_decrements == dependency_up_counter_decrements;
    ensures normal nested_discharge_permitted == (not mapping_unresolved and not descriptor_unresolved);
    ensures normal successful_deletion_permitted == (delete_argument and chunk_was_nonnull and deletion_succeeded and nested_discharge_permitted);
};
