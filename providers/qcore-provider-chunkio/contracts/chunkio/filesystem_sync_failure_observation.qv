module contract;

// Fixed suppressed-msync observations. A successful public result does not
// establish synchronization or durability, especially for an unmapped chunk.
extern fn native_file_sync_failure_observation() -> unit
contract {
    requires compiled_source_and_build_recorded;
    requires exclusive_instrumented_fixture;
    ensures normal exact_native_transitions;
    ensures normal exact_parent_teardown;
    ensures normal os_epochs_and_rings_bound;
    ensures normal allocations == releases;
    ensures normal releases == transient_releases + teardown_releases;
    ensures normal transient_releases == 1;
    ensures normal open_epochs == mapping_epochs;
    ensures normal suppressed_sync_calls == 1;
    ensures normal failed_commit_preserves_transaction + down_despite_sync_failure == 1;
    ensures normal retry_clears_transaction + rollback_retains_header == failed_commit_preserves_transaction;
    ensures normal down_despite_sync_failure == unmapped_commit_without_sync;
    ensures normal reloaded_appended_bytes == unmapped_commit_without_sync;
    ensures normal original_inode_retained;
    ensures normal fixture_cleanup_complete;
    ensures normal static_certificate == 0;
    ensures normal durability_proved == 0;
};
