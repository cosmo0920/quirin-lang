module contract;

// Conditional munmap_file bookkeeping composition. Sync may change mapping
// identity/size, but must preserve the backend and mappedness before native
// unmap; its full body/frame is not yet proved. Error preservation is relative
// to the post-sync state. This is not an unconditional filesystem Safe result.
extern fn unmap_file_outcomes() -> unit
contract {
    requires live_exclusive_chunk_and_nullable_owned_file_backend;
    requires parameter_context_is_live_chunk_context;
    requires chunk_backend_context_and_stream_have_disjoint_storage;
    requires sync_flag_is_boolean;
    requires sync_returns_zero_or_minus_one_and_preserves_backend_and_mappedness;
    requires sync_and_logging_preserve_chunk_identities_mappedness_counter_and_lifetimes;
    requires native_unmap_source_and_external_frames_are_bound;
    requires up_counter_positive_and_in_target_range_when_decremented;
    requires cross_unit_source_and_abi_bindings;
    ensures normal native_calls == was_mapped;
    ensures normal diagnostic_calls == sync_failed;
    ensures normal counter_decrements == native_succeeded;
    ensures normal wrapper_writes == 2 * native_succeeded;
    ensures normal not native_succeeded or returned == 0;
    ensures normal native_succeeded or returned == -1;
    ensures normal root_and_backend_preserved;
    ensures normal saved_parameter_context_used;
};
