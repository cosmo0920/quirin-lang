module contract;

// Parent allocation release preserves the child's unresolved obligations.
// These premises must be bound by a caller; a matching body is not that binding.
extern fn parent_teardown() -> unit
contract {
    requires nullable_owned_parent_and_distinct_nullable_owned_fields;
    requires exclusive_live_parent_storage_until_final_free;
    requires child_traversal_frames_parent_fields_and_unrelated_storage;
    requires stream_membership_has_live_reciprocal_neighbors;
    requires exact_child_unlink_source_abi_and_libc_free_bindings;
    ensures normal complete_typed_reference_body;
    ensures normal null_parent_has_no_effect;
    ensures normal child_traversal_precedes_parent_release;
    ensures normal owned_field_releases_precede_parent_release;
    ensures normal nonnull_parent_released_exactly_once;
    ensures normal not nested_discharge_established_by_parent_free;
};
