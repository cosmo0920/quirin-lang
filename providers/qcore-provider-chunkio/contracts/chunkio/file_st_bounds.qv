module contract;

// Card CG16-BOUNDS-TRANSPORT-AND-CHUNKIO-NEIGHBOURS (CHUNKIO-FILE-ST-NEIGHBOUR-BOUNDS:
// "each accessor read against both pinned bodies and either declared ... or
// its missing vocabulary named"). Bounds contract v1 (contract specification
// C09.1, C09.2; gateway rules 11s, 11e, 12l, 12r, 14f-14j), in the crate's
// bounds view, never its resource view.
//
// Read from `lib/chunkio/include/chunkio/cio_file_st.h`, byte-identical at
// the two pinned Fluent Bit revisions 66910c10 and 046accf6 (sha256
// 02eb3909...). The header is CIO_FILE_HEADER_MIN (24) bytes: 0xC1 0x00, the
// content CRC32 at offsets 2..5, ..., the metadata length at 22..23.
//
// Not review-held: written after reading both revisions and pinned with
// `quirin-audit pin --bounds` at both (`bounds-contracts.lock`); a changed
// body or clause takes a declaration out of force.

// static inline char *cio_file_st_get_hash(char *map)
//     return map + 2;
// The result is the 4-byte CRC32 field at offset 2. The body reads nothing
// through `map` (closed frame: reads) and returns `map + 2` (the relation).
extern fn cio_file_st_get_hash(map: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    ensures normal bounds_frame_reads(map);
    ensures normal bounds_return_derived(map, 2, 4, bytes);
};

// static inline ssize_t cio_file_st_infer_content_len(char *map, size_t size)
//     content_length = size; content_length -= CIO_FILE_HEADER_MIN;
//     content_length -= cio_file_st_get_meta_len(map); return content_length;
// Its only use of `map` is the call to cio_file_st_get_meta_len, whose check
// is `[22, 24)`: the same check, exactly (rule 12l(4) decides the escape
// inside), and a read frame.
extern fn cio_file_st_infer_content_len(map: ptr<mut, u8>, size: usize) -> isize
contract {
    requires bounds_contract_v1;
    quant checks map, Idx #i: 22 <= #i && #i < 24;
    ensures normal bounds_frame_reads(map);
};

// static inline void cio_file_st_set_content_len(char *map, uint32_t len)
//     content_length_buffer = (uint8_t *) &map[CIO_FILE_CONTENT_LENGTH_OFFSET];
//     content_length_buffer[0] = ...; ... content_length_buffer[3] = ...;
// CIO_FILE_CONTENT_LENGTH_OFFSET is 10: the body writes map[10..13], the
// big-endian content length, through a byte view of `&map[10]` (uint8_t and
// char are both one byte, rule 14g). A write frame: it writes through `map`
// and resizes, moves or releases nothing.
extern fn cio_file_st_set_content_len(map: ptr<mut, u8>, len: u32) -> unit
contract {
    requires bounds_contract_v1;
    quant checks map, Idx #i: 10 <= #i && #i < 14;
    ensures normal bounds_frame_writes(map);
};
