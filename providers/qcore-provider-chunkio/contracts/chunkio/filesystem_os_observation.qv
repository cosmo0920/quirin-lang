module contract;

// Real Linux syscalls and endpoint probes for twelve exclusive temporary
// fixtures. Observation acceptance cannot establish static safety or durability.
extern fn native_os_cleanup_observation() -> unit
contract {
    requires exclusive_linux_fixture;
    requires forwarded_syscalls;
    requires compiled_source_and_build_recorded;
    ensures normal exact_arguments_and_outcomes;
    ensures normal os_endpoints_and_inode_bound;
    ensures normal record_frame_preserved;
    ensures normal fixture_cleanup_complete;
    ensures normal not observed_close_success or descriptor_absent_after;
    ensures normal not observed_unmap_success or mapping_absent_after;
    ensures normal not observed_delete_success or path_absent_after;
    ensures normal not observed_unmap_failure or mapping_live_after;
    ensures normal static_certificate == 0;
    ensures normal durability_proved == 0;
};
