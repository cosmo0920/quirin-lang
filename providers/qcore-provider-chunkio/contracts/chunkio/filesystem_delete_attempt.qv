module contract;

// Producer-use evidence from complete short-circuit source paths. The fd guard
// can skip the map read; unlink only appears on the remaining branch. This
// policy checks result use, not guard correctness or actual filesystem deletion.
extern fn native_delete_result_use() -> unit
contract {
    requires source_has_cleanup_attempts;
    ensures normal guarded_results == cleanup_calls;
    ensures normal ignored_results == 0;
};
