module contract;

// Runtime-only chunk-file integrity profiles. A corrupted input and an
// injected operation failure are separate axes: the content class is derived
// from the recorded bytes, the injection is a property of the harness wrapper,
// and neither is inferred from the other. Library releases and harness
// reclamations are counted separately and never merged. Recorded executions
// only; no static certificate and no durability claim.
extern fn native_file_integrity_observation() -> unit
contract {
    requires compiled_source_and_build_recorded;
    requires exclusive_instrumented_fixture;
    ensures normal corrupted_input == bad_checksum + bad_magic + truncated;
    ensures normal injected_operation_failure == injected_map_failure + injected_close_failure;
    ensures normal injected_operation_failure == suppressed_calls;
    ensures normal chunk_returned + corrupted_input + injected_map_failure == 1;
    ensures normal allocations == library_allocation_releases + harness_allocation_releases;
    ensures normal harness_allocation_releases == 0;
    ensures normal allocations == 10;
    ensures normal descriptor_epochs == 1;
    ensures normal descriptor_epochs == library_descriptor_releases + harness_descriptor_releases;
    ensures normal mapping_epochs == library_mapping_releases + harness_mapping_releases;
    ensures normal harness_mapping_releases == 0;
    ensures normal mapping_epochs + injected_map_failure == 1;
    ensures normal parent_descriptor_residuals == harness_descriptor_releases;
    ensures normal parent_descriptor_residuals == injected_close_failure;
    ensures normal content_changed == 0;
    ensures normal original_inode_retained;
    ensures normal original_size_retained;
    ensures normal static_certificate == 0;
    ensures normal durability_proved == 0;
};
