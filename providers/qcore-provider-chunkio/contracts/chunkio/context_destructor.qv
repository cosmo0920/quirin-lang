module contract;

// Upstream source: src/cio.c (ChunkIO 1.5.5)
// Audited mechanism: context-to-stream cascading teardown.

resource type ChunkContext {
    repr: ptr<mut, u8>;
    footprint: { chunk_contexts = 1 };
    destructor: cio_destroy noexcept;
    copy: forbidden;
    move: allowed;
}

extern fn cio_destroy(
    context: own<ChunkContext> use one
) -> unit
contract {
    quant condition entry #r060(#context: object, #env: environment, #live: predicate<environment, object>) = #live(#env,#context);
    quant condition entry #r192(#context: object, #discharged: predicate<environment, obligation>, #env: environment, #wrapper_obligation: predicate<environment, object, obligation>) = forall (#obligation: obligation) { (#wrapper_obligation(#env,#context,#obligation) => #discharged(#env,#obligation)) };
    ensures normal every_stream_is_destroyed;
    ensures normal every_chunk_backend_is_closed;
    ensures normal chunk_counter_is_zero;
    ensures normal context_is_discharged;
    quant normal live_contexts == old(live_contexts) - 1;
};
