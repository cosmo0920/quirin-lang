module contract;

// Null and memory-backed paths of cio_chunk_close only. Filesystem and invalid
// backend paths remain uncovered. The source-derived dependencies discharge
// backend allocations, both embedded list links and the saved context counter.
// Raw nullable Chunk ownership and caller/build premises are explicit; this is
// not a claim that constructors or arbitrary call sites establish them.
extern fn cio_chunk_close(chunk: ptr<mut, Chunk>, delete: i32) -> unit
contract {
    requires nullable_owned_chunk;
    requires nonnull_chunk_has_memory_backend;
    requires backend_and_name_have_disjoint_owned_provenance;
    requires both_links_are_live_reciprocal_memberships;
    requires embedded_links_have_distinct_stream_memberships;
    requires context_and_stream_outlive_chunk;
    requires context_counter_covers_live_chunk;
    requires no_lock_busy_task_route_or_transaction_obligations;
    requires exclusive_access;
    requires cross_unit_source_and_abi_bindings;
    requires free_resolves_to_libc;
    ensures normal not chunk_was_nonnull or backend_discharged;
    ensures normal not chunk_was_nonnull or primary_unlinked;
    ensures normal not chunk_was_nonnull or state_unlinked;
    ensures normal not chunk_was_nonnull or name_released;
    ensures normal not chunk_was_nonnull or chunk_released;
    ensures normal not chunk_was_nonnull or saved_context_counter_decremented;
    ensures normal not chunk_was_nonnull or call_count == 7;
    ensures normal chunk_was_nonnull or call_count == 0;
};
