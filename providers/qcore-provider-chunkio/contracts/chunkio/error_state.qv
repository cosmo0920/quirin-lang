module contract;

// Source: lib/chunkio/src/cio_error.c, cio_error_reset. The frame-helper
// importer validates the complete body before checking these postconditions.
// Live storage, exclusive access and cross-unit source/build/ABI identity are
// caller/audit premises. This is a metadata frame contract, not teardown.
extern fn cio_error_reset(
    chunk: borrow<'call, mut, Chunk> use one
) -> unit
contract {
    requires chunk_is_live;
    requires exclusive_chunk_access;
    ensures normal field_error_n == 0;
    ensures normal writes_only_declared_fields;
    ensures normal lock_is_preserved;
};
