module contract;

// Generic source-frame policy for the declared cio_chunk model record.
// The importer protects every Boolean field modeled for this record. Live,
// exclusive access and actual cross-unit ABI equality remain caller premises.
extern fn cio_error_reset(
    chunk: borrow<'call, mut, cio_chunk> use one
) -> unit
contract {
    requires object_is_live;
    requires exclusive_object_access;
    ensures normal field_error_n == 0;
    ensures normal writes_only_declared_fields;
    ensures normal modeled_fields_are_preserved;
};
