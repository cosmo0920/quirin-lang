module contract;

// ChunkIO chunk content size — resource-projection vocabulary v1.
//
// Card W31-CORPUS-CONTRACTS-2. ONE TRUSTED ASSUMPTION about one upstream
// ChunkIO function. This module verifies nothing: the C body is not analyzed
// by this loader, and a declaration is a premise. Any verdict that rests on it
// is a verdict RELATIVE TO this declaration, never a proof of the C
// implementation.
//
// The body was read at Fluent Bit
// `66910c10a4d7eafa810b84229cf2dcf7b0f26f97`, in the vendored ChunkIO copy
// under `lib/chunkio/`, and is cited by line. The C declaration in force is
// `lib/chunkio/include/chunkio/cio_chunk.h:66`:
//
//     ssize_t cio_chunk_get_content_size(struct cio_chunk *ch);
//
// `ssize_t` resolves to `long int` on the LP64 model the audited targets use,
// so `isize` is an admissible spelling of the result under the declared-ABI
// agreement gate (standing constraint 8); the parameter is one object-pointer
// level, spelled `ptr<mut, u8>` as every object pointer of this vocabulary is.
//
// ## `cio_chunk_get_content_size`, read from `lib/chunkio/src/cio_chunk.c:315-334`
//
//     ssize_t cio_chunk_get_content_size(struct cio_chunk *ch)
//
// The whole body:
//
//   1. `cio_error_reset(ch)` (`lib/chunkio/src/cio_error.c:56-59`) — the
//      entire body is `ch->error_n = 0;`, a store into the chunk's OWN error
//      field. `chunkio/error_frame.qcore` and `chunkio/error_state.qcore`
//      already declare this callee borrowed on the same reading.
//   2. `type = ch->st->type;` — a field read.
//   3. For `CIO_STORE_MEM`, `mf = ch->backend;` then `return mf->buf_len;`;
//      for `CIO_STORE_FS`, `cf = ch->backend;` then `return cf->data_size;`
//      — field reads on either storage arm.
//   4. `return -1;` on an unrecognized storage type.
//
// Nothing is allocated, freed, stored or published on any path, and the
// result is a byte count (or a negative status), a value with no identity.
//
// This is the very body card W29-CORPUS-CONTRACTS read when it declared the
// Fluent Bit wrapper `flb_input_chunk_get_size` (whose whole body is
// `return cio_chunk_get_content_size(ic->chunk);`) — the reading recorded in
// `fluent_bit/input_chunk_sizes.qcore` — and this module resolves that card's
// named non-declaration `W29-CONTENT-SIZE-UNDECLARED` by giving the callee the
// ChunkIO-side module it asked for: the stated obstruction was that a
// ChunkIO-side declaration is a different library's module with its own body
// reading, and this is that module, with that reading.
//
// ## Which mode is faithful
//
// On every path the caller keeps exactly the obligations it had before the
// call: `resource_borrowed(ch)` states that, and it is the only v1 parameter
// mode with that caller-side effect (`owned` demands live custody, `consumed`
// transfers, `released` discharges, `out` creates custody at a destination,
// `stored` transfers under an owner and `removed` detaches from one). Writing
// into `ch`'s own field — the error reset — does not move custody, exactly as
// `cio_chunk_up_force`/`cio_chunk_down`'s deeper mutations were read not to in
// `chunkio/chunk_residency.qcore`.
//
// The declaration says nothing about `ch` being non-null — the body
// dereferences it unconditionally, but `resource_borrowed` imposes NO non-null
// precondition, which is the weaker statement and deliberately so: a mode that
// demanded entry custody would delete the caller's failure paths.
//
// ## Why this function is declared although a corpus unit defines it
//
// `lib/chunkio/src/cio_chunk.c` is itself a unit of the pinned corpus, so this
// is the arrangement cards PROD-CONTRACTS, NEIGHBOURS and W29-CORPUS-CONTRACTS
// already established: a declared contract ALWAYS wins over a W4-inferred
// summary, a disagreement is reported as a `SummaryConflict` diagnostic and
// never silently resolved (`crates/qcore-c-gateway/src/legacy_summary.rs`),
// and declaring a defined function does not stop the unit analysing that
// function's own body — it only fixes what its CALLERS may assume.
//
// ## NOT CLAIMED, recorded rather than hidden
//
//   * **Nothing about the returned value's meaning.** `-1` on an unrecognized
//     storage type is value semantics, outside a custody projection.
//   * **Nothing about retention.** Whether any other object holds `ch` or its
//     interior pointers is the unmodeled retention this corpus records as
//     B03/R13 and is not decided here.
//   * **The rest of the size family stays undeclared.**
//     `cio_chunk_get_real_size` and `cio_meta_size` are read (they are cited
//     in `fluent_bit/input_chunk_sizes.qcore`'s wrapper reading) but occur at
//     ZERO directly-refused call sites in the pinned corpus's projections
//     outside their declared wrappers, so declaring them would cost a premise
//     and buy nothing — card O04-ARMS' standard, followed here.

// --- the chunk's content size, as ChunkIO itself reports it -----------------
extern fn cio_chunk_get_content_size(ch: ptr<mut, u8>) -> isize
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ch);
    ensures normal resource_return_none();
};

// ## Card W45-CALLEE-CASCADE-RESIDUAL round 3: two size readers whose bodies
// ## are Safe in their home units
//
// TWO TRUSTED ASSUMPTIONS, pinned after reading every definition at both
// revisions (byte-identical). Each body is analysed in its home unit, where
// W4 checks the declaration against it (rule 13g).
//
//   * `cio_file_native_get_size(cf, file_size)` (`cio_file_unix.c:317-341`;
//     the Windows definition, `cio_file_win32.c:366-381`, is not built here
//     and does the same through its handle or path helpers) calls `fstat` on
//     an open descriptor, else `stat` on `cf->path`, and stores the size
//     through `file_size` when it is not NULL; it returns `CIO_OK` or
//     `CIO_ERROR`. Neutral. Caller: `cio_file_real_size` (`cio_file.c:576-…`).
//   * `cio_stream_size_chunks_up(st)` (`cio_stream.c:258-276`) walks
//     `st->chunks_up` and sums `cio_chunk_get_content_size` (declared above)
//     of each chunk: neutral. Caller: `flb_input_chunk_total_size`
//     (`src/flb_input_chunk.c:2947-2955`, itself declared neutral in
//     `quirin-provider-fluent-bit`'s `input_chunk_total_size.qv`).

extern fn cio_file_native_get_size(cf: ptr<mut, u8>, file_size: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(cf);
    ensures normal resource_borrowed(file_size);
    ensures normal resource_return_none();
};

extern fn cio_stream_size_chunks_up(st: ptr<mut, u8>) -> usize
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(st);
    ensures normal resource_return_none();
};
