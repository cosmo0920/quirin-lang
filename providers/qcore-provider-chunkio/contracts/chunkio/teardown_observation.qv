module contract;

// Runtime observations only: the pinned observer/build and exclusive execution
// are trusted. The adapter binds these predicates to constructor allocation IDs,
// intrusive ring snapshots and the exact nested destructor event sequence.
extern fn native_teardown_observation() -> unit
contract {
    requires observed_memory_profile;
    requires compiled_source_and_build_recorded;
    requires exclusive_instrumented_execution;
    ensures normal constructor_graph_bound;
    ensures normal reciprocal_rings_bound;
    ensures normal exact_nested_release_sequence;
    ensures normal allocations == releases;
    ensures normal chunks == counter_steps;
    ensures normal terminal_live == 0;
    ensures normal terminal_total == 0;
    ensures normal not static_certificate;
};
