module contract;

// Upstream source: src/cio_chunk.c (ChunkIO 1.5.5)
// Audited mechanism: backend close, dual unlink, and counter discharge.

resource type Chunk {
    repr: ptr<mut, u8>;
    footprint: { chunks = 1 };
    destructor: cio_chunk_close noexcept;
    copy: forbidden;
    move: allowed;
}

// Card CONTRACT-VIEW-PROJECTION-CHECK: `delete_backing` is `i32`, not `bool`.
// The C declaration is `void cio_chunk_close(struct cio_chunk *ch, int delete)`
// (`lib/chunkio/include/chunkio/cio_chunk.h:56` and `src/cio_chunk.c:111` in
// the pinned audit source), and `bool` projects C `_Bool`, a different ABI
// type. The two other declarations of this function already say `i32`; the
// checked view relation refused the disagreement.
extern fn cio_chunk_close(
    chunk: own<Chunk> use one,
    delete_backing: i32
) -> unit
effects { io }
contract {
    requires chunk_is_live;
    requires chunk_is_not_busy;
    requires chunk_has_no_task_or_route_custody;
    ensures normal selected_backend_is_closed;
    ensures normal stream_link_is_removed;
    ensures normal context_link_is_removed;
    ensures normal chunk_name_and_object_are_released;
    ensures normal context_chunk_counter_is_decremented;
    ensures normal deletion_is_recorded_as_requested;
    quant normal live_chunks == old(live_chunks) - 1;
};

extern fn cio_chunk_delete(
    chunk: borrow<'call, mut, Chunk> use one
) -> i32
effects { io }
contract {
    requires chunk_is_live;
    ensures normal backing_content_is_deleted;
    ensures normal chunk_object_remains_live;
    ensures any delete_only_is_not_object_destruction;
    quant any live_chunks == old(live_chunks);
};
