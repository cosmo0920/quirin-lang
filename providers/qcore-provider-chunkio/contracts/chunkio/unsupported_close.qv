module contract;

// Partial source effect only. No backend layout or reachable caller is inferred.
extern fn unsupported_chunk_close() -> unit
contract {
    requires nonnull_live_chunk_and_stream_with_unrecognized_int_backend;
    requires nullable_name_has_owned_provenance_disjoint_from_parent_and_backend;
    requires live_exclusive_distinct_reciprocal_list_memberships;
    requires saved_context_outlives_chunk_and_total_counter_is_positive;
    requires reset_list_counter_source_abi_and_libc_free_bindings;
    requires delete_argument_is_boolean_and_no_wrapper_obligations;
    ensures normal backend_calls == 0 and call_count == 6;
    ensures normal primary_unlinked and state_unlinked;
    ensures normal name_release_attempts == 1 and chunk_released;
    ensures normal total_counter_decrements == 1 and up_counter_decrements == 0;
    ensures normal backend_custody_unresolved and not nested_discharge_permitted;
    ensures normal not deletion_established and not constructor_reachability_established;
};
