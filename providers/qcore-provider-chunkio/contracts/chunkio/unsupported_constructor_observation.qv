module contract;

// Four recorded native inputs, not a universal constructor/reachability proof.
extern fn native_unsupported_constructor() -> unit
contract {
    requires selected_unsupported_int_case;
    requires compiled_source_and_build_recorded;
    requires exclusive_instrumented_execution;
    ensures normal stream_preserves_requested_kind;
    ensures normal chunk_null and error_sentinel_unchanged;
    ensures normal allocations == rollback_releases + teardown_releases;
    ensures normal rollback_releases == 2;
    ensures normal teardown_releases == 4;
    ensures normal empty_reciprocal_surviving_tree;
    ensures normal terminal_live == 0;
    ensures normal not static_certificate;
};
