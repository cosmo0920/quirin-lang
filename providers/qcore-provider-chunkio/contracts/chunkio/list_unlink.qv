module contract;

// Source-derived intrusive-list unlink, including its complete helper body.
// Neighbors may alias each other (a singleton element between the same head),
// but are distinct from entry. Live reciprocal links and exclusive link-cell
// access are premises; no containing allocation is released by either function.
// Raw helper pointers allow neighbor aliasing under the cell-level premises.
extern fn __mk_list_del(prev: ptr<mut, ListNode>, next: ptr<mut, ListNode>) -> unit
contract {
    requires neighbor_link_cells_are_live;
    requires exclusive_link_access;
    ensures normal previous_next_is_next;
    ensures normal next_prev_is_previous;
    ensures normal only_neighbor_link_cells_written;
    ensures normal write_count == 2;
};

extern fn mk_list_del(entry: borrow<'call, mut, ListNode> use one) -> unit
contract {
    requires entry_is_live;
    requires exclusive_link_access;
    requires entry_has_live_reciprocal_neighbors;
    requires entry_is_distinct_from_neighbors;
    ensures normal entry_prev_is_null;
    ensures normal entry_next_is_null;
    ensures normal previous_next_is_next;
    ensures normal next_prev_is_previous;
    ensures normal only_unlink_cells_written;
    ensures normal helper_calls == 1;
    ensures normal write_count == 4;
    ensures normal no_object_release;
};
