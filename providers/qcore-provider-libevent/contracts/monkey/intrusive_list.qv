module contract;

// Monkey intrusive list: insertion and removal — resource-projection
// vocabulary version 1 with the container clauses of contract specification
// §C04.8 (card W45-FB-RETRY-LIFETIME).
//
// Two header-inline functions of `monkey/mk_core/mk_list.h`, bound by name and
// by the declared signature below. No revision, line number or file digest is
// part of this module; the evidence binding them to an audited source lives in
// the card report. A signature that differs at another revision is withdrawn
// by the declared-ABI check (fail-closed), never adapted.
//
// ## What the bodies do
//
//     struct mk_list { struct mk_list *prev, *next; };
//
//     static inline void mk_list_add(struct mk_list *_new, struct mk_list *head)
//     {
//         __mk_list_add(_new, head->prev, head);   /* four pointer stores */
//     }
//
//     static inline void mk_list_del(struct mk_list *entry)
//     {
//         __mk_list_del(entry->prev, entry->next); /* two pointer stores */
//         entry->prev = NULL;
//         entry->next = NULL;
//     }
//
// Each has one arm. Neither allocates, frees nor calls anything but its
// header-local helper.
//
// ## Why these are not borrows (MK-LIST-ADD-BORROWED-PUBLICATION)
//
// Card CONSTRUCTOR-RESIDUALS declared `mk_list_add` borrowed on both
// positions, on the ground that it moves no obligation. That reading left a
// body that allocates an object, links it into a list its caller reaches and
// returns accused of a leak at the return (8 corpus leaves, 2 more in the
// Fluent Bit system slice), and it let a helper that links a formal's object
// tell its callers nothing had happened to it.
//
// `resource_published(entry, head)` states what the body does: after the call
// the list rooted at `head` holds the object `entry` is embedded in. The
// custody of that object passes to the container, whose owner answers for it.
// It is NOT `resource_stored(entry, head)`: that relation says destroying the
// owner destroys the child, and destroying a list head destroys no member —
// `mk_list` has no destructor.
//
// `resource_unpublished(entry)` states the converse: after the call no list
// holds the object, and custody returns to the caller.
//
// Both positions keep `resource_borrowed` for the ABI projection and for the
// admission of a member address (`&obj->_head`); the effect is the container
// clause. A consumer that does not apply it must refuse the call.
//
// ## What a consumer decides from this (gateway constraint 10d)
//
// * A publication discharges a body-acquired object only into a container
//   reached from a formal the body never rebinds (memory the caller supplied).
//   Any other container — a local, a file-scope object, an object the body
//   acquired — refuses.
// * Releasing a published object is a violation candidate
//   (`release_after_escape`); returning it refuses.
// * An unlink restores custody only of an object the same body published on
//   every path reaching it; any other unlink refuses.
//
// Nothing is claimed about `__mk_list_add`, `mk_list_append`,
// `mk_list_add_before`/`_after`, iteration (`mk_list_foreach`, owned by card
// FB-BACKLOG-CUSTODY), or the `container_of` idiom (`mk_list_entry`) by which
// callers recover an enclosing object from a node: an object recovered that way
// is not a tracked identity, so an unlink of it refuses.

extern fn mk_list_add(entry: ptr<mut, u8>, head: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(entry);
    ensures normal resource_borrowed(head);
    ensures normal resource_published(entry, head);
    ensures normal resource_return_none();
};

extern fn mk_list_del(entry: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(entry);
    ensures normal resource_unpublished(entry);
    ensures normal resource_return_none();
};

// Card W45-CALLEE-CASCADE-RESIDUAL round 3: `mk_fifo_queue_destroy`.
//
// ONE TRUSTED ASSUMPTION, pinned (C06.2) after reading the body at both
// audited revisions (`lib/monkey/mk_server/mk_fifo.c:212-219`, byte-identical
// at `66910c10` and `046accf6`). It is the only uncontracted call of
// `mk_fifo_queue_id_destroy` and `mk_fifo_queue_destroy_all` (`:221-248`).
// It sits here, beside the `mk_list_del` its body calls, rather than in
// `memory.qv`, whose declarations are the pinned libc-inheriting wrappers.
//
//     int mk_fifo_queue_destroy(struct mk_fifo *ctx, struct mk_fifo_queue *q)
//     {
//         (void) ctx;
//         mk_list_del(&q->_head);
//         mk_mem_free(q);
//         return 0;
//     }
//
// It unlinks the queue from the list it is on (`ctx->queues`,
// `mk_fifo_queue_create` links it there) and frees it: after the call no list
// holds the object and the object is released, so `resource_released(q,
// nonnull)` (it dereferences `q` unconditionally). The queue's `data` is the
// creator's pointer, kept and never freed by the queue (`mk_fifo.h:61-73`):
// not released here. `ctx` is not read (`(void) ctx`); the result is always 0.
// NOT CLAIMED: that `q` is on `ctx`'s list, or anything about a reader still
// holding the queue's callback.

extern fn mk_fifo_queue_destroy(ctx: ptr<mut, u8>, q: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ctx);
    ensures normal resource_released(q, nonnull);
    ensures normal resource_return_none();
};

// Card W48-SCHED-CLEANUP-PRODUCTION (gateway rule 34): `mk_http_thread_destroy`,
// the element destroyer of the scheduler's thread lists.
//
// Read at both audited revisions (`lib/monkey/mk_server/mk_http_thread.c:251-272`
// with the inline `mk_thread_destroy` of
// `lib/monkey/include/monkey/mk_thread_libco.h:64-78`, byte-identical at
// `66910c10` and `046accf6`; the seven files of the scheduler decomposition,
// docs/reports/scheduler-lifetime-contracts/, hash-equal). It is the only
// uncontracted call of `sched_thread_cleanup` and `mk_sched_threads_destroy_conn`.
//
//     int mk_http_thread_destroy(struct mk_http_thread *mth)
//     {
//         libco_params = MK_TLS_GET(mk_http_thread_libco_params);
//         if (libco_params != NULL) {
//             mk_mem_free(libco_params);
//             MK_TLS_SET(mk_http_thread_libco_params, NULL);
//         }
//         mk_list_del(&mth->_head);
//         th = mth->parent;
//         mth->session->channel->event->type = MK_EVENT_CONNECTION;
//         mk_thread_destroy(th);   /* cb_destroy?, Valgrind request,
//                                     co_delete(th->callee), mk_mem_free(th) */
//         return 0;
//     }
//
// What the custody projection states: the call unlinks the object `mth`
// designates from the list holding it (`resource_unpublished`) and then ends
// it (`resource_released`): `mth` is the data area of its parent allocation
// (`mk_http_thread_create`: `mth = MK_THREAD_DATA(th)`, `mth->parent = th`),
// and freeing `th` ends the storage `mth` lives in. A caller applies the
// unlink first (rule 34): an element of a safe iteration over a list its
// formal reaches, or an object it published, and nothing else. The result is
// always 0.
//
// What no generic rule proves is carried as named premises, which every row
// resting on this declaration lists. They reuse the scheduler decomposition's
// hypothesis names (hypotheses.json) and are Open source truth:
//
// * the parent embedding (`exact_parent_embedding`);
// * the callback footprint (`callback_footprint`): read from source, the only
//   inserters into `sched->threads` and `threads_purge` are
//   `mk_http_thread_create` and `mk_http_thread_purge`, creation passes a
//   NULL `cb_destroy` to `mk_thread_new`, and no other Monkey source writes
//   it; the premise is that it is still NULL, or a returning callback that
//   releases and mutates neither the saved successor, nor its parent, nor
//   any other list element. No neutral-callback reading is made;
// * the params slot (`tls_params_owned`, `tls_api_success`);
// * the coroutine (`callee_live`, `suspended_coroutines`);
// * the borrowed session chain (`borrowed_chain_live`);
// * list membership and writers (`valid_membership`, `no_concurrent_writer`);
// * the aliases the source leaves behind (`no_later_alias_use`);
// * the Valgrind client request `MK_HAVE_VALGRIND` compiles in.
//
// NOT CLAIMED: anything about the current thread's `mk_thread` key, which
// destruction does not clear; that `mth` is on any particular list; creation,
// purge or dispatch.
//
// Card LERI-HELD-AND-LINK-MEMBER-PREMISES (gateway rule 46): the unlink names
// its link member, `_head` (`mk_list_del(&mth->_head)` in the body at
// `mk_server/mk_http_thread.c`, 66910c10 and 046accf6), so a caller's element
// is taken only when its `container_of` binding names `_head` too, and an
// object the caller holds only when the caller initialised its `_head` links.

extern fn mk_http_thread_destroy(mth: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_premise(scheduler_exact_parent_embedding, "mth is the mk_http_thread embedded at MK_THREAD_DATA of exactly one live mk_thread allocation that mth->parent names and nothing else releases; freeing mth->parent ends the storage of mth (scheduler decomposition exact_parent_embedding and parent_live; established at creation by mk_http_thread_create, not by this body)");
    requires resource_premise(scheduler_callback_footprint, "th->cb_destroy is NULL, as mk_http_thread_create sets it through mk_thread_new and no other Monkey source writes it, or a returning callback whose transitive effects release and mutate neither the saved successor of a caller's iteration, nor its parent, nor any other list element, coroutine or borrowed object (scheduler decomposition callback_footprint); no neutral-callback reading is made");
    requires resource_premise(scheduler_tls_params_owned, "the mk_http_thread_libco_params key of the current thread holds NULL or one live allocation it alone owns, disjoint from every caller-tracked object; pthread_getspecific and pthread_setspecific of that key succeed, so the freed params are no longer reachable from the key (scheduler decomposition tls_params_owned and tls_api_success)");
    requires resource_premise(scheduler_callee_live, "th->callee is a coroutine co_delete accepts, created for this thread, suspended and not co_active, with no concurrent resume or deletion (scheduler decomposition callee_live and suspended_coroutines)");
    requires resource_premise(scheduler_borrowed_chain_live, "mth->session, its channel and that channel's event are live borrowed objects this call neither releases nor ends; the call writes one scalar through them (scheduler decomposition borrowed_chain_live)");
    requires resource_premise(scheduler_valid_membership, "mth->_head is linked in exactly one valid circular mk_list, the one its caller reaches it through, with reciprocal links and no concurrent or reentrant writer of that list, the coroutine, the borrowed chain or the key (scheduler decomposition valid_membership and no_concurrent_writer)");
    requires resource_premise(scheduler_no_later_alias_use, "no alias the source leaves behind, request->thread, channel.thread or the current thread's mk_thread key, is read or resumed after the call (scheduler decomposition no_later_alias_use)");
    requires resource_premise(scheduler_valgrind_request_neutral, "the Valgrind client request VALGRIND_STACK_DEREGISTER compiled in under MK_HAVE_VALGRIND reads th->valgrind_stack_id and changes no object the projection tracks");
    ensures normal resource_unpublished(mth, _head);
    ensures normal resource_released(mth, nonnull);
    ensures normal resource_return_none();
};
