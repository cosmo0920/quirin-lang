module contract;

// Source-backed specifications for all 15 pinned Unix/Libevent wrappers.
// These predicates preserve findings from the typed source reports. They are
// currently syntax-preserved specifications, not executable custody proofs.
// Calls remain opaque; an observed call is not successful cleanup. Native C
// failure codes are normal returns. Assertion termination is not teardown.
// This module is intentionally outside cycle19-resource-contracts.json.

extern fn mk_event_libevent_socketpair(
    descriptors: borrow<'call, mut, DescriptorPairOut> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal result_is_forwarded_from_evutil_socketpair;
    ensures normal source_socket_constants_and_output_pointer_are_forwarded;
};

extern fn _mk_event_init() -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal result == 0;
    ensures normal no_resource_call_is_executed;
};

extern fn _mk_event_loop_create(size: i32) -> ptr<mut, EventContext>
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal initialization_or_context_allocation_failure_returns_null;
    ensures normal event_base_new_result_is_stored_without_a_null_test;
    ensures normal fired_allocation_failure_frees_context_without_base_free;
    ensures normal successful_return_sets_queue_size_and_returns_context;
};

extern fn _mk_event_loop_destroy(ctx: own<EventContext> use one) -> unit
contract {
    requires selected_unix_libevent_source_profile;
    requires context_and_children_have_valid_destruction_provenance;
    ensures normal calls_base_free_then_fired_free_then_context_free;
    ensures normal nested_event_and_map_custody_still_requires_composition;
};

extern fn _mk_event_update(
    ctx: borrow<'call, mut, EventContext> use one,
    fd: i32, event_type: i32, events: u32,
    data: borrow<'call, mut, MonkeyEvent> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal old_event_delete_and_free_precede_new_event_creation;
    ensures normal nullable_event_creation_failure_returns_minus_one;
    ensures normal registration_failure_returns_minus_one_without_new_event_free;
    ensures normal successful_registration_stores_event_and_context_in_map;
};

extern fn _mk_event_add(
    ctx: borrow<'call, mut, EventContext> use one,
    fd: i32, event_type: i32, events: u32,
    data: borrow<'call, mut, MonkeyEvent> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    requires assertion_conditions_hold_on_normal_return;
    ensures normal dirty_event_delegates_to_update;
    ensures normal map_allocation_failure_returns_minus_one;
    ensures normal map_and_event_fields_are_published_before_registration;
    ensures normal event_creation_result_is_not_null_tested;
    ensures normal registration_failure_has_no_invented_cleanup;
};

extern fn _mk_event_del(
    ctx: borrow<'call, mut, EventContext> use one,
    event: borrow<'call, mut, MonkeyEvent> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    requires assertion_conditions_hold_on_normal_return;
    ensures normal unregistered_event_returns_zero_before_map_cleanup;
    ensures normal only_positive_pipe_descriptors_get_close_calls;
    ensures normal close_results_do_not_control_following_cleanup;
    ensures normal event_delete_precedes_event_free_and_map_free;
    ensures normal cleanup_clears_data_and_conditionally_removes_priority_before_event_reset;
};

extern fn _mk_event_timeout_create(
    ctx: borrow<'call, mut, EventContext> use one,
    seconds: i64, nanoseconds: i64,
    data: borrow<'call, mut, MonkeyEvent> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    requires assertion_conditions_hold_on_normal_return;
    ensures normal socketpair_failure_returns_minus_one;
    ensures normal map_allocation_failure_has_no_descriptor_close_calls;
    ensures normal timer_event_creation_and_registration_results_are_not_checked;
    ensures normal read_event_add_result_is_ignored;
    ensures normal successful_source_path_returns_read_descriptor;
};

extern fn _mk_event_timeout_destroy(
    ctx: borrow<'call, mut, EventContext> use one,
    data: ptr<mut, MonkeyEvent>
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal null_data_returns_zero;
    ensures normal positive_read_descriptor_gets_close_call_before_event_delete;
    ensures normal nonnull_path_returns_event_delete_result;
};

extern fn _mk_event_channel_create(
    ctx: borrow<'call, mut, EventContext> use one,
    read_out: borrow<'call, mut, DescriptorOut> use one,
    write_out: borrow<'call, mut, DescriptorOut> use one,
    data: borrow<'call, mut, MonkeyEvent> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    requires assertion_conditions_hold_on_normal_return;
    ensures normal socketpair_failure_returns_minus_one;
    ensures normal add_failure_calls_close_on_both_descriptors_and_returns_add_result;
    ensures normal successful_source_path_writes_both_out_descriptors_and_returns_zero;
};

extern fn _mk_event_channel_destroy(
    ctx: borrow<'call, mut, EventContext> use one,
    read_fd: i32, write_fd: i32,
    data: borrow<'call, mut, MonkeyEvent> use one
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal read_descriptor_mismatch_returns_minus_one_before_cleanup;
    ensures normal matched_path_calls_event_delete_then_both_descriptor_closes;
    ensures normal matched_path_returns_event_delete_result;
};

extern fn _mk_event_inject(
    loop: borrow<'call, mut, EventLoop> use one,
    event: borrow<'call, mut, MonkeyEvent> use one,
    mask: i32, prevent_duplication: i32
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    requires loop_bounds_arithmetic_and_storage_require_separate_evidence;
    ensures normal duplicate_scan_is_conditioned_on_prevent_duplication;
    ensures normal scan_match_returns_zero_before_append;
    ensures normal append_writes_fd_mask_data_then_increments_both_counts;
    ensures normal result == 0;
};

extern fn _mk_event_wait_with_flags(
    loop: borrow<'call, mut, EventLoop> use one, flags: i32
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal fired_count_is_cleared_before_dispatch;
    ensures normal dispatch_result_is_ignored;
    ensures normal final_fired_count_is_copied_to_loop_and_returned;
};

extern fn _mk_event_wait_2(
    loop: borrow<'call, mut, EventLoop> use one, timeout: i32
) -> i32
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal infinite_and_zero_wait_paths_delegate_without_timer_creation;
    ensures normal timed_wait_uses_explicit_stack_timeval;
    ensures normal timeout_event_creation_and_registration_results_are_not_checked;
    ensures normal timed_wait_calls_event_free_after_dispatch_and_returns_dispatch_result;
};

extern fn _mk_event_backend() -> ptr<const, u8>
contract {
    requires selected_unix_libevent_source_profile;
    ensures normal result_names_libevent_adapter;
    ensures normal result_does_not_pin_runtime_dispatch_backend;
};
