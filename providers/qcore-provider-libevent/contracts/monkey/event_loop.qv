module contract;

// Card FB-EVENT-LOOP-RETENTION-AND-REGISTRATION (gateway rule 12t, contract
// specification §C04.14; ledger entries FB-EVENT-LOOP-RETENTION-AND-REGISTRATION
// and W47-LOOP-OWNER-UNDECLARABLE-OPERATIONS). Monkey's event-loop
// registrations, declared in Monkey's owner crate.
//
// USER DECISIONS 2026-10-16 (verbatim in the card's report):
// 1. "Tracked holder path": a holder reached through a member is spelled as a
//    path and tracked by the analysis.
// 2. Removal "R3: quant state": `quant live #loop: #holds(event) |-> #absent;`
//    — after the call the loop formal no longer holds the registration of P;
//    every other registration is unchanged. mk_event_channel_destroy is
//    declared without a removal, because its removal condition can't be
//    stated.
//
// ## The bodies (read at 66910c10 and 046accf6)
//
// `mk_core/mk_event.c` is byte-identical at 66910c10a4d7eafa810b84229cf2dcf7b0f26f97
// (Fluent Bit's lib/monkey copy and the corpus's own Monkey source),
// 046accf6aded7906f66a1baf0202da349e521736 and the 90978ac6 export; each
// public operation calls its backend's `_mk_event_*` through `loop->data`.
// The epoll backend (`mk_event_epoll.c`, the analysed configuration) differs
// between the revisions only by `pthread_detach(tid)` in the pipe arm of
// `_mk_event_timeout_create` (046accf6:335), which changes no registration;
// the select, poll and kqueue arms register and remove the same way.
//
// * mk_event_add (mk_event.c:99): `_mk_event_add` stores `data` in the
//   kernel's interest list (`ep_event.data.ptr = data`) and writes the event's
//   fd, status, type, mask and priority: the loop keeps a pointer into
//   `data`'s object. Nothing is allocated, freed or taken.
// * mk_event_timeout_create (:156): a timerfd (or, without timerfd, a pipe
//   and a detached worker thread) is created, stored into the event
//   (`event->fd`) and registered through `_mk_event_add` with `data`; the fd
//   is returned (or -1).
// * mk_event_channel_create (:181): a pipe, its read end registered with
//   `data`; the two ends are written through `r_fd` / `w_fd`.
// * mk_event_del (:132) and mk_event_timeout_destroy (:172): the event is
//   removed from the loop (`_mk_event_del`: EPOLL_CTL_DEL, the priority-queue
//   link unlinked, MK_EVENT_NEW); an unregistered event is left as it is, so
//   after the call the loop holds no registration of it either way, and
//   mk_event_timeout_destroy(loop, NULL) does nothing. timeout_destroy then
//   closes `event->fd`. Card RETENTION-UNMATCHED-REMOVAL-POISONS: through a
//   loop that does not hold the event, EPOLL_CTL_DEL fails (ignored) and
//   MK_EVENT_NEW still clears the status, so a later removal through the
//   loop that does hold it returns at :140 and leaves it registered. Rule
//   12t reads this: a removal that does not match a record exactly poisons
//   every record it may name, which then ends only by its loop's destroy.
// * mk_event_loop_create (:61) and mk_event_loop_destroy (:91), card
//   RETENTION-UNMATCHED-REMOVAL-POISONS (bodies identical at the three
//   revisions): create allocates the backend (`_mk_event_loop_create`, epoll
//   :48: an epoll descriptor and its event array), then the loop and its
//   event array (`mk_mem_alloc_z`), freeing what it made and returning NULL
//   on any failure; a fresh loop the caller owns. destroy dereferences
//   `loop->data` (non-null), closes the epoll descriptor (which drops every
//   registration the loop held, without touching the events' statuses), and
//   frees the arrays and the loop. Rule 12t reads the destroy as the end of
//   every record the loop holds, poisoned or not.
// * mk_event_channel_destroy (:193): removes and closes only when
//   `event->fd == r_fd` (epoll backend :397); otherwise it returns -1 with
//   the registration in place. Since card MK-EVENT-DESCRIPTOR-QUANT the
//   removal and both closes are stated under that member-equality guard
//   (decision D4); before it, the declaration stated no removal.
// * mk_event_wait (:205): `epoll_wait` into the loop's own array; nothing
//   is registered, removed or taken.
//
// ## The descriptors (card MK-EVENT-DESCRIPTOR-QUANT, §C04.6.2, rule 38)
//
// USER DIRECTION 2026-11-01 (verbatim): "We must decompose the premise into
// quant like composed clauses." USER DECISION 2026-11-01 (verbatim): "I
// approve the changes of D1-D5." The named premise `mk_event_descriptors` is
// retired; each descriptor effect is a descriptor-cell state. Bodies read at
// 66910c10, 046accf6 and 34155955 (`mk_event.c` byte-identical,
// `8ef958d2…`; `mk_event_epoll.c` `0bbc8f00…` / `a2a16119…`, differing only by
// `pthread_detach` in the pipe arm, which the build's MK_HAVE_TIMERFD_CREATE
// leaves out):
//
// * timeout_create (epoll :190): -1 with `event->fd` untouched (clock,
//   timerfd or settime failure); `event->fd = timer_fd` (:233), then on an
//   `_mk_event_add` failure the descriptor is closed and -1 returned with the
//   closed number left in the member (:240-243); otherwise `timer_fd` (>= 0)
//   is returned. D1: the member names the new descriptor; the result is its
//   witness.
// * timeout_destroy (:341): NULL data does nothing; otherwise the removal,
//   then `close(event->fd)` unconditionally, the member never written. D2:
//   `#stale(descriptor)`.
// * channel_create (:355): -1 with nothing written (pipe failure); the
//   member written `fd[0]` (:371), then on an `_mk_event_add` failure both
//   ends closed and -1 with the closed number in the member; on success
//   `*r_fd = fd[0]`, `*w_fd = fd[1]`, 0. D3: the slots' pointees and the
//   member's second name of the read end.
// * channel_destroy (:389): when `event->fd != r_fd`, -1 and nothing touched;
//   otherwise the removal (`_mk_event_del`), `close(r_fd)`, `close(w_fd)` and
//   `_mk_event_del`'s result. D4: the member-equality guard.

extern fn mk_event_add(loop: ptr<mut, u8>, fd: i32, type: i32, mask: u32, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(type);
    ensures normal resource_borrowed(mask);
    ensures normal resource_borrowed(data);
    ensures normal resource_retained_by(data, loop);
    ensures normal resource_return_none();
};

extern fn mk_event_timeout_create(loop: ptr<mut, u8>, sec: i64, nsec: i64, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(sec);
    ensures normal resource_borrowed(nsec);
    ensures normal resource_borrowed(data);
    ensures normal resource_retained_by(data, loop);
    quant live #data: mk_event.fd |-> #fresh(descriptor) when #result != -1;
    quant live #data: mk_event.fd |-> {#stale(descriptor), #kept} when #result == -1;
    ensures normal resource_return_none();
};

extern fn mk_event_channel_create(loop: ptr<mut, u8>, r_fd: ptr<mut, u8>, w_fd: ptr<mut, u8>, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(r_fd);
    ensures normal resource_borrowed(w_fd);
    ensures normal resource_borrowed(data);
    ensures normal resource_retained_by(data, loop);
    quant live #r_fd: #pointee |-> #fresh(descriptor) when #result == 0;
    quant live #w_fd: #pointee |-> #fresh(descriptor) when #result == 0;
    quant live #data: mk_event.fd |-> #same(r_fd) when #result == 0;
    quant live #data: mk_event.fd |-> {#stale(descriptor), #kept} when #result != 0;
    ensures normal resource_return_none();
};

extern fn mk_event_del(loop: ptr<mut, u8>, event: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(event);
    quant live #loop: #holds(event) |-> #absent;
    ensures normal resource_return_none();
};

extern fn mk_event_timeout_destroy(loop: ptr<mut, u8>, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(data);
    quant live #loop: #holds(data) |-> #absent;
    quant live #data: mk_event.fd |-> #stale(descriptor);
    ensures normal resource_return_none();
};

// mk_event.c:166 at 66910c10, 046accf6 and 34155955: the complete body is
// `return mk_event_del(loop, (struct mk_event *) data);`. Disable removes
// the registration using the same poisoning rules as del. The wrapper adds
// no close call; this contract states no backend descriptor-lifecycle effect.
// This is a pinned declaration, not a body proof.
extern fn mk_event_timeout_disable(loop: ptr<mut, u8>, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(data);
    quant live #loop: #holds(data) |-> #absent;
    ensures normal resource_return_none();
};

extern fn mk_event_channel_destroy(loop: ptr<mut, u8>, r_fd: i32, w_fd: i32, data: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_borrowed(data);
    ensures normal resource_kind(r_fd, descriptor);
    ensures normal resource_kind(w_fd, descriptor);
    ensures normal resource_released(r_fd, valid) when #data: mk_event.fd == #r_fd;
    ensures normal resource_released(w_fd, valid) when #data: mk_event.fd == #r_fd;
    quant live #loop: #holds(data) |-> #absent when #data: mk_event.fd == #r_fd;
    ensures normal resource_return_none();
};

extern fn mk_event_wait(loop: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(loop);
    ensures normal resource_return_none();
};

extern fn mk_event_loop_create(size: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn mk_event_loop_destroy(loop: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(loop, nonnull);
    ensures normal resource_return_none();
};
