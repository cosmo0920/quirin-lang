module contract;

// Executable policy for cb_timeout's running-callback self teardown.  Rust
// derives these facts from a sealed SourceSummary, pinned Libevent bytes, and
// an independently supplied native evidence record.
//
// Card CONTRACT-VIEW-PROJECTION-CHECK: the Monkey source identity is declared
// once, as `source_identity` in `monkey/wait_source_policy.qcore`. This
// module's former copy was textually identical; its consumer
// (`qcore_verification::timeout_teardown`) now evaluates the owner's
// declaration and binds the owner's digest into its projection and evidence.

extern fn cb_timeout_source() -> unit
contract {
    ensures normal (signature == "void (int, short, void *)") or (signature == "void (evutil_socket_t, short, void *)");
    ensures normal import_role == "Callback";
    ensures normal path_count == 3;
    ensures normal path_operation_counts == "21,20,10";
    ensures normal path_call_sequences == "send,__errno_location,perror,evutil_closesocket,event_del,event_free,mk_mem_free;send,__errno_location,evutil_closesocket,event_del,event_free,mk_mem_free;send";
    ensures normal teardown_path_indices == "0,1";
    ensures normal (source_summary_digest == "4787d6d5025421959b0f5c746fe0ff2916001f8a9b88f39d73b8d416ae0b2155") or (source_summary_digest == "ba528a16a79d673073f734f07367436f7c024d1a204a598e75300ab70b4261a4");
};

extern fn cb_timeout_teardown_path() -> unit
contract {
    ensures normal (path_calls == "send,__errno_location,perror,evutil_closesocket,event_del,event_free,mk_mem_free") or (path_calls == "send,__errno_location,evutil_closesocket,event_del,event_free,mk_mem_free");
};

extern fn libevent_self_teardown() -> unit
contract {
    ensures normal libevent_revision == "d82464a277d0f42703702c4dfd9af6af38595a83";
    ensures normal event_c_digest == "3506c3c54cfde9934a42526dbd4a9fbacc98f65068dbb038209f71eb9a63e346";
    ensures normal event_free_delete_call == "event_del(ev)";
    ensures normal event_del_mode == "EVENT_DEL_AUTOBLOCK";
    ensures normal wait_guard == "!EVBASE_IN_THREAD(base)";
};

extern fn teardown_obligations() -> unit
contract {
    ensures normal callback == "cb_timeout";
    ensures normal callback_descriptor == map_write_descriptor;
    ensures normal event_descriptor_present == 0;
    ensures normal callback_dispatcher == delete_dispatcher;
    ensures normal callback_dispatcher == free_dispatcher;
    ensures normal callback_dispatcher == exit_dispatcher;
    ensures normal event_id == delete_event_id;
    ensures normal event_id == free_event_id;
    ensures normal event_id == exit_event_id;
    ensures normal native_map_address != event_pointer;
    ensures normal peer_descriptor != callback_descriptor;
    ensures normal close_function == "evutil_closesocket";
    ensures normal delete_operation == "event_del";
    ensures normal free_operation == "event_free";
    ensures normal map_free_function == "mk_mem_free";
    ensures normal exit_operation == "callback_exit";
    ensures normal callback_enter_sequence < close_sequence;
    ensures normal close_sequence < delete_sequence;
    ensures normal delete_sequence < free_sequence;
    ensures normal map_free_sequence == free_sequence;
    ensures normal free_sequence < callback_exit_sequence;
};
