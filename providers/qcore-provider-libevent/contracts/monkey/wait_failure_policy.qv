module contract;

// Executable policy for the bounded failure observations derived from the
// pinned Monkey loop-create and timed-wait source paths. Rust supplies facts
// decoded from a complete native fault-injection trace and a sealed source
// projection; a scenario label alone cannot select a verdict.

extern fn loop_init_failure() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_loop_create";
    ensures normal outcome == "unknown";
    ensures normal path_count == 4;
    ensures normal property == "initialization_failure_reachability";
    ensures normal reason == "the imported CFG retains an opaque-call branch whose Unix-profile reachability is unproved";
};

extern fn context_allocation_failure() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_loop_create";
    ensures normal outcome == "unknown";
    ensures normal returned_null == 1;
    ensures normal trace == "event_init,context_alloc";
    ensures normal property == "caller_handles_null_loop";
    ensures normal reason == "the wrapper returns null and downstream caller handling is outside this source slice";
};

extern fn base_creation_failure() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_loop_create";
    ensures normal outcome == "unsafe";
    ensures normal returned_null == 0;
    ensures normal returned_context_base_nonnull == 0;
    ensures normal trace == "event_init,context_alloc,event_base_new,fired_alloc";
    ensures normal property == "nonnull_loop_has_live_event_base";
    ensures normal reason == "the source-preserving fault model returns a nonnull context whose base is null";
};

extern fn fired_allocation_failure() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_loop_create";
    ensures normal outcome == "unsafe";
    ensures normal returned_null == 1;
    ensures normal base_created == 1;
    ensures normal base_freed == 0;
    ensures normal context_freed == 1;
    ensures normal trace == "event_init,context_alloc,event_base_new,fired_alloc,context_free";
    ensures normal property == "created_event_base_is_released";
    ensures normal reason == "the source-preserving fault model frees the context without freeing its created event base";
};

extern fn timer_creation_failure() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_wait_2";
    ensures normal outcome == "unsafe";
    ensures normal returned_dispatch_result == 1;
    ensures normal event_add_argument_nonnull == 0;
    ensures normal event_free_argument_nonnull == 0;
    ensures normal trace == "event_new,event_add,dispatch,event_free";
    ensures normal property == "null_event_is_not_used";
    ensures normal reason == "the source-preserving fault model forwards the null creation result to event_add and event_free";
};

extern fn timer_registration_failure() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_wait_2";
    ensures normal outcome == "unknown";
    ensures normal returned_dispatch_result == 1;
    ensures normal event_add_argument_nonnull == 1;
    ensures normal event_add_result < 0;
    ensures normal timeout_activated == 0;
    ensures normal trace == "event_new,event_add,dispatch,event_free";
    ensures normal property == "failed_timer_registration_preserves_wait_semantics";
    ensures normal reason == "the registration error is ignored while backend liveness and timeout behavior remain unproved";
};

extern fn success_observation() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_wait_2";
    ensures normal outcome == "unknown";
    ensures normal returned_dispatch_result == 1;
    ensures normal event_add_argument_nonnull == 1;
    ensures normal event_add_result == 0;
    ensures normal timeout_activated == 1;
    ensures normal trace == "event_new,event_add,dispatch,event_free";
    ensures normal property == "all_failure_paths_safe";
    ensures normal reason == "one successful harness execution does not discharge source-derived failure paths";
};

extern fn loop_size_bounds() -> unit
contract {
    ensures normal source_bound == 1;
    ensures normal path == "_mk_event_loop_create";
    ensures normal outcome == "unknown";
    ensures normal path_count == 4;
    ensures normal property == "fired_allocation_extent_is_in_bounds";
    ensures normal reason == "the imported paths do not prove the caller size or multiplication bound";
};
