module contract;

// Executable acceptance policy for the bounded Monkey timed-wait source slice.
// Rust derives every named fact from constructor-private typed source summaries;
// this module is the sole authority for expected values. The artifact-set rule
// admits either the focused fixture or the production translation unit as a
// whole vector, so summaries from the two sources cannot be mixed.

extern fn source_identity() -> unit
contract {
    ensures normal source_revision == "66910c10a4d7eafa810b84229cf2dcf7b0f26f97";
    ensures normal library == "monkey";
    ensures normal source_set == "fluent-bit";
    ensures normal profile_digest != "";
};

