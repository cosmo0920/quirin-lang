extern fn observed_row() -> unit contract {
    ensures normal status == "observed";
    ensures normal property == "generic_libevent_cross_thread_activation";
    ensures normal observer_scope == "generic_libevent_only";
    ensures normal observer_transparency == "not_claimed";
    ensures normal source_revision_actual == source_revision_expected;
    ensures normal harness_sha256_actual == harness_sha256_expected;
    ensures normal runtime_host_actual == runtime_host_expected;
    ensures normal runtime_backend_actual == runtime_backend_expected;
    ensures normal process_exit == 0;
    ensures normal activation_count == 1;
    ensures normal callback_count == 1;
    ensures normal callback_flags == 2;
    ensures normal dispatch_thread != activating_thread;
    ensures normal callback_thread == dispatch_thread;
};

extern fn unknown_row() -> unit contract {
    ensures normal status == "unknown";
    ensures normal reason_actual == reason_expected;
    ensures normal current_evidence_item_count == 0;
    ensures normal observer_transparency == "not_claimed";
};
