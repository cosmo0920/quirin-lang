module contract;

// Native language regression for type-local definitional index bindings.
// This declares an abstract credit-preserving interface, not an audited C API.
quant axis chunks : credit<Count<Chunk>>;

extern fn preserve_five_chunk_credits(
    credit: quant<n where n := 5> use one
) -> quant<credit, { chunks = total } where total := base + 2, base := 3, total <= 5>
contract {
    requires caller_owns_chunk_credit;
    quant normal returned_credit.chunks == old(credit.chunks);
};
