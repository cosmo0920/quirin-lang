module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// <stdlib.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. TRUSTED ASSUMPTIONS about the C library (trust
// boundary 28); no libc body is analysed. Read from the prototypes the
// analysed units declare (`/usr/include/stdlib.h` on the audited host):
//
//   extern int atoi (const char *__nptr) __THROW __attribute_pure__ __nonnull ((1)) __wur;
//   extern void srand (unsigned int __seed) __THROW;
//   extern int rand_r (unsigned int *__seed) __THROW;
//   extern int system (const char *__command) __wur;
//
// ## The custody statements
//
// `atoi` reads a string; `srand` takes a scalar; `rand_r` reads and updates
// the caller's `unsigned int` seed through its pointer (a value write, the
// `cmt_mpack_consume_uint_tag` precedent: borrowed, not a custody `Out`);
// `system` reads a command string and waits for the child it runs. None
// allocates, frees or retains a caller object, and every result is a scalar,
// so `resource_borrowed` on every parameter and `resource_return_none()` are
// exact.
//
// ## Deliberately NOT declared here (recorded in the card report)
//
//   (`exit` and `abort` are declared below with `resource_no_return()`,
//   card CG21-CALL-EXITS-AND-BOUNDARIES; W43-LIBC-CONTRACTS had declined
//   them while v1 had no no-return exit.)
//   (`strtol`/`strtoll`/`strtoul`/`strtoull`/`strtod` are declared below
//   with a derived out slot, card SLOT-MOVE-AND-INTERIOR-BORROW;
//   W43-LIBC-CONTRACTS had declined them while `ptr<mut, ptr<mut, u8>>`
//   admitted only `resource_out`.)
//   (`qsort` and `bsearch` invoke a caller-supplied comparator; they are
//   declared below with a synchronous invocation, card
//   CG22-CALLBACK-REGISTRY-CONTRACT; W43-LIBC-CONTRACTS had declined `qsort`
//   while no clause stated a callback.) `realpath` returns either its second argument
//   or a fresh `malloc` allocation, a conditional alias.
//
// ## What no declaration here says
//
// Nothing about parse errors, overflow, the random sequence, the child's exit
// status or its side effects. Per-call custody statements about the CALLER's
// obligations, and nothing more.

extern fn atoi(nptr: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(nptr);
    ensures normal resource_return_none();
};

extern fn srand(seed: u32) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(seed);
    ensures normal resource_return_none();
};

extern fn rand_r(seed: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(seed);
    ensures normal resource_return_none();
};

extern fn system(command: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(command);
    ensures normal resource_return_none();
};

// ## The no-return exits (card CG21-CALL-EXITS-AND-BOUNDARIES)
//
//   extern void abort (void) __THROW __attribute__ ((__noreturn__)) __COLD;
//   extern void exit (int __status) __THROW __attribute__ ((__noreturn__));
//
// C17 7.22.4.1 and 7.22.4.4: `abort` raises SIGABRT and does not return;
// `exit` runs the `atexit` handlers, flushes and closes the streams and
// terminates the program. Neither returns, and no frame of the calling
// thread resumes, which is what `resource_no_return()` states (a non-local
// exit is not this exit). Neither takes custody of anything: the status is a
// scalar. `exit`'s `atexit` handlers and stream closing are effects of the
// program's end, not of a frame the custody projection follows. The C
// gateway lowers either call as a path end only where the call's own Clang
// declaration is `noreturn` (gateway rule 11o).

extern fn abort() -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};

extern fn exit(status: i32) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(status);
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};

// ## <assert.h>'s failure call (card CG21-CALL-EXITS-AND-BOUNDARIES)
//
// Declared in this module, beside `abort`, because it is `abort`'s caller
// (C17 7.2.1.1: a failed `assert` writes a diagnostic and calls `abort`), and
// so every selection that reads this module reads it. From
// `/usr/include/assert.h` on the audited host (glibc 2.43):
//
//   extern void __assert_fail (const char *__assertion, const char *__file,
//                              unsigned int __line, const char *__function)
//        __THROW __attribute__ ((__noreturn__)) __COLD;
//
// glibc's `assert (E)` calls it when `E` compares equal to 0. It prints the
// message and aborts: it does not return and no frame of the calling thread
// resumes. It reads its three strings and takes custody of none of them; the
// line is a scalar. `__assert_perror_fail` and `__assert` are not declared:
// no analysed unit calls either.

extern fn __assert_fail(assertion: ptr<const, u8>, file: ptr<const, u8>, line: u32, function: ptr<const, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(assertion);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(line);
    ensures normal resource_borrowed(function);
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};

// ## Derived out slots (card SLOT-MOVE-AND-INTERIOR-BORROW, C04.16)
//
// `strtol`, `strtoll`, `strtoul`, `strtoull` and `strtod` (C11 7.22.1.3-4)
// store, when `endptr` is not NULL, a pointer to the first character after
// the parsed number, or `nptr` itself when nothing was parsed, through
// `endptr`: a pointer derived from `nptr`, owning nothing, `const` dropped
// (`char **endptr` over `const char *nptr`). They allocate, free and retain
// nothing. W43-LIBC-CONTRACTS declined them while `ptr<mut, ptr<mut, u8>>`
// admitted only `resource_out` (fresh custody); the derived out slot states
// exactly the store. glibc 2.x prototypes (`stdlib.h`): `long int`,
// `long long int`, `unsigned long int`, `unsigned long long int`, `double`;
// the `__restrict` after a parameter's last `*` qualifies the parameter object
// and is dropped (C04.1).

extern fn strtol(nptr: ptr<const, u8>, endptr: ptr<mut, ptr<mut, u8>>, base: i32) -> i64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(nptr);
    ensures normal resource_borrowed(endptr);
    ensures normal resource_borrowed(base);
    ensures normal resource_out_derived(endptr, nptr, nullable);
    ensures normal resource_return_none();
};

extern fn strtoll(nptr: ptr<const, u8>, endptr: ptr<mut, ptr<mut, u8>>, base: i32) -> i64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(nptr);
    ensures normal resource_borrowed(endptr);
    ensures normal resource_borrowed(base);
    ensures normal resource_out_derived(endptr, nptr, nullable);
    ensures normal resource_return_none();
};

extern fn strtoul(nptr: ptr<const, u8>, endptr: ptr<mut, ptr<mut, u8>>, base: i32) -> u64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(nptr);
    ensures normal resource_borrowed(endptr);
    ensures normal resource_borrowed(base);
    ensures normal resource_out_derived(endptr, nptr, nullable);
    ensures normal resource_return_none();
};

extern fn strtoull(nptr: ptr<const, u8>, endptr: ptr<mut, ptr<mut, u8>>, base: i32) -> u64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(nptr);
    ensures normal resource_borrowed(endptr);
    ensures normal resource_borrowed(base);
    ensures normal resource_out_derived(endptr, nptr, nullable);
    ensures normal resource_return_none();
};

extern fn strtod(nptr: ptr<const, u8>, endptr: ptr<mut, ptr<mut, u8>>) -> f64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(nptr);
    ensures normal resource_borrowed(endptr);
    ensures normal resource_out_derived(endptr, nptr, nullable);
    ensures normal resource_return_none();
};

// ## Searching and sorting with a caller's comparator
//
// Card CG22-CALLBACK-REGISTRY-CONTRACT (contract spec C04.19, gateway rule
// 13u). Read from the prototypes the analysed units declare
// (`/usr/include/stdlib.h:982-999` on the audited host):
//
//   extern void *bsearch (const void *__key, const void *__base,
//                         size_t __nmemb, size_t __size, __compar_fn_t __compar)
//        __nonnull ((1, 2, 5)) __wur;
//   extern void qsort (void *__base, size_t __nmemb, size_t __size,
//                      __compar_fn_t __compar) __nonnull ((1, 4));
//
// `__compar_fn_t` is `int (*)(const void *, const void *)`, projected `fnptr`.
// Both call the comparator during the call only, zero or more times, and
// keep it nowhere (C11 7.22.5p1-2; glibc's extern inline `bsearch`,
// `bits/stdlib-bsearch.h`, calls `(*__compar) (__key, __p)`): `bsearch` with
// the caller's key and a pointer into `base`, `qsort` with two pointers into
// `base`. A pointer the callee computes into the caller's array is `_` (a
// value the callee supplies), so the comparator's own contract must be the
// identity per call for the call to read as the borrowed reading below
// (rule 13u's loop-safe composition); a comparator with no contract in force,
// or one that frees or keeps anything, refuses the call. `bsearch` returns
// NULL or a pointer to an element of `base` (C04.3.1's interior result);
// `qsort` permutes `base`'s bytes in place, which moves no custody (the
// caller still owns the array whole). Nothing is allocated or freed.

extern fn bsearch(key: ptr<const, u8>, base: ptr<const, u8>, nmemb: usize, size: usize, compar: fnptr) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(key);
    ensures normal resource_borrowed(base);
    ensures normal resource_borrowed(nmemb);
    ensures normal resource_borrowed(size);
    ensures normal resource_borrowed(compar);
    ensures normal resource_callback_invoked(compar, key, _);
    ensures normal resource_return_interior(base, nullable);
};

extern fn qsort(base: ptr<mut, u8>, nmemb: usize, size: usize, compar: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(base);
    ensures normal resource_borrowed(nmemb);
    ensures normal resource_borrowed(size);
    ensures normal resource_borrowed(compar);
    ensures normal resource_callback_invoked(compar, _, _);
    ensures normal resource_return_none();
};

// ## Card LIBC-GAP-DECLARATIONS: `abs`, `<ctype.h>` case mapping and `strcat`
//
// TRUSTED ASSUMPTIONS (trust boundary 28), read from the prototypes on the
// audited host (`/usr/include/stdlib.h:1008`, `/usr/include/ctype.h:122-125`,
// `/usr/include/string.h:164-165`):
//
//   extern int abs (int __x) __THROW __attribute__ ((__const__)) __wur;
//   extern int tolower (int __c) __THROW;
//   extern int toupper (int __c) __THROW;
//   extern char *strcat (char *__restrict __dest, const char *__restrict __src)
//     __THROW __nonnull ((1, 2));
//
// `abs`, `tolower` and `toupper` map an `int` to an `int` (C11 7.22.6.1,
// 7.4.2.1, 7.4.2.2): no pointer anywhere, so `resource_borrowed` and
// `resource_return_none()` are the only faithful modes. Nothing here says
// anything about `abs(INT_MIN)` or an argument outside `unsigned char`/`EOF`.
//
// `strcat` appends a copy of `src` to the string at `dest` and returns `dest`
// (C11 7.24.3.1): the exact alias of argument 1, `strcpy`'s statement in
// `libc/string.qv` (`resource_return_alias(dest, nonnull)`, contract
// specification C04.3.1). It allocates, frees and retains nothing. It stands
// in this module and not in `libc/string.qv` because that module is
// published: its SHA-256 is pinned in `providers/contract-load-path.json` and
// is part of the identity of every contract that inherits from it, which a
// new declaration there would change for no semantic reason. Nothing here
// says anything about the destination's capacity or overlap.

extern fn abs(x: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(x);
    ensures normal resource_return_none();
};

extern fn tolower(c: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(c);
    ensures normal resource_return_none();
};

extern fn toupper(c: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(c);
    ensures normal resource_return_none();
};

extern fn strcat(dest: ptr<mut, u8>, src: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_return_alias(dest, nonnull);
};
