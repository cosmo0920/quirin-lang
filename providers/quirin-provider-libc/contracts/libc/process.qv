module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// <sys/prctl.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. A TRUSTED ASSUMPTION about Linux's `prctl` (trust
// boundary 28); no libc or kernel body is analysed. Read from the prototype
// the analysed units declare (`/usr/include/x86_64-linux-gnu/sys/prctl.h` on
// the audited host):
//
//   extern int prctl (int __option, ...) __THROW;
//
// ## The custody statement, and why it carries a literal premise
//
// `prctl` is a multiplexer: what it does with its tail depends on the option.
// The declaration therefore carries `resource_literal_argument(option, 15)` and
// applies ONLY at call sites whose option is exactly `15` -- `PR_SET_NAME` in
// `linux/prctl.h`, the spelling the pinned call site reaches after
// preprocessing -- and at every other option the callee stays undeclared. For
// `PR_SET_NAME` the kernel copies at most 16 bytes of the name the second
// argument points to and retains nothing; the remaining actuals are unused
// scalars. So the option is `resource_borrowed`, the tail is exactly
// `resource_variadic_data_tail()` (no custody taken, no pointer retained), and
// the `int` result is `resource_return_none()`.
//
// ## Deliberately NOT declared (recorded in the card report)
//
//   (`regexec`, `regerror` spell `const regex_t *__restrict __preg`, which
//   this card's reader withdrew; card W43-LIBC-RESTRICT-PROTOTYPES declares
//   both in `libc/regex.qcore`.)
//   (`getrlimit`, `setrlimit`, whose first parameter is the enumeration
//   typedef `__rlimit_resource_t`, are declared below since card
//   W43-ABI-ENUM-AND-CONST-PP, gateway rule 12u.)
//   `regcomp` allocates storage inside the caller's `regex_t`, released by
//   `regfree`: an in-place object lifecycle v1 cannot state.
//
// ## What no declaration here says
//
// Nothing about the thread name, truncation, errors, or any other option.

extern fn prctl(option: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_literal_argument(option, 15);
    ensures normal resource_borrowed(option);
    ensures normal resource_variadic_data_tail();
    ensures normal resource_return_none();
};

// <sys/resource.h> -- card W43-ABI-ENUM-AND-CONST-PP (gateway rule 12u).
//
// TRUSTED ASSUMPTIONS about glibc's `getrlimit` and `setrlimit` (trust
// boundary 28), flexible like every libc declaration. Read from the prototypes
// the analysed units declare under `_GNU_SOURCE`
// (`/usr/include/x86_64-linux-gnu/sys/resource.h` on the audited host):
//
//   typedef enum __rlimit_resource __rlimit_resource_t;
//   extern int getrlimit (__rlimit_resource_t __resource,
//                         struct rlimit *__rlimits) __THROW __nonnull ((2));
//   extern int setrlimit (__rlimit_resource_t __resource,
//                         const struct rlimit *__rlimits) __THROW __nonnull ((2));
//
// `enum __rlimit_resource` (`bits/resource.h`) runs from `RLIMIT_CPU = 0` to
// `__RLIMIT_NLIMITS = 16` with no negative value, so Clang's integer type for
// it is `unsigned int`: the first parameter is `u32` (USER DECISION
// 2026-10-05, contract specification C04.1). A unit that declares the
// parameter `int` (no `_GNU_SOURCE`) disagrees and withdraws the declaration
// there. `getrlimit` writes the two limits into `*rlimits`; `setrlimit` reads
// them. Neither allocates, frees or keeps a pointer, and the `int` result is
// data.

extern fn getrlimit(resource: u32, rlimits: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(resource);
    ensures normal resource_borrowed(rlimits);
    ensures normal resource_return_none();
};

extern fn setrlimit(resource: u32, rlimits: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(resource);
    ensures normal resource_borrowed(rlimits);
    ensures normal resource_return_none();
};

// ## Card LIBC-GAP-DECLARATIONS: `getpwnam_r` and `getgrnam_r`
//
// TRUSTED ASSUMPTIONS (trust boundary 28), read from the prototypes on the
// audited host (`/usr/include/pwd.h:153-157`, `/usr/include/grp.h:150-154`):
//
//   extern int getpwnam_r (const char *__restrict __name,
//                          struct passwd *__restrict __resultbuf,
//                          char *__restrict __buffer, size_t __buflen,
//                          struct passwd **__restrict __result)
//     __nonnull ((1, 2, 3, 5));
//   extern int getgrnam_r (const char *__restrict __name,
//                          struct group *__restrict __resultbuf,
//                          char *__restrict __buffer, size_t __buflen,
//                          struct group **__restrict __result)
//     __nonnull ((1, 2, 3, 5));
//
// POSIX getpwnam_r()/getgrnam_r(): the entry is written into the caller's
// record `__resultbuf`, and its strings into the caller's `__buffer`.
// `*__result` is set to `__resultbuf` on success and to NULL when the entry
// is not found or on error. Two statements follow, and both are needed:
//
// * The slot `__result` receives a pointer derived from `__resultbuf`, owning
//   nothing, or NULL: `resource_out_derived(result, resultbuf, nonnull)`
//   (contract specification C04.16; `nonnull` is the slot itself, which
//   `__nonnull ((5))` requires).
// * The record keeps pointers into `__buffer` (`pw_name`, `pw_dir`,
//   `gr_name`, `gr_mem`, ...): `resource_retained_by(buffer, resultbuf)`
//   (C04.14). The caller keeps custody of the buffer, but releasing it while
//   the record still lives leaves the record dangling, so rule 12t refuses
//   that release (`retention-released-while-held`), never `Safe` and never
//   accused.
//
// Nothing is allocated, freed or taken into custody. The result is a
// status. Nothing here says anything about `ERANGE`, which entry is found or
// `errno`.

extern fn getpwnam_r(name: ptr<const, u8>, resultbuf: ptr<mut, u8>, buffer: ptr<mut, u8>, buflen: usize, result: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(name);
    ensures normal resource_borrowed(resultbuf);
    ensures normal resource_borrowed(buffer);
    ensures normal resource_borrowed(buflen);
    ensures normal resource_borrowed(result);
    ensures normal resource_retained_by(buffer, resultbuf);
    ensures normal resource_out_derived(result, resultbuf, nonnull);
    ensures normal resource_return_none();
};

extern fn getgrnam_r(name: ptr<const, u8>, resultbuf: ptr<mut, u8>, buffer: ptr<mut, u8>, buflen: usize, result: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(name);
    ensures normal resource_borrowed(resultbuf);
    ensures normal resource_borrowed(buffer);
    ensures normal resource_borrowed(buflen);
    ensures normal resource_borrowed(result);
    ensures normal resource_retained_by(buffer, resultbuf);
    ensures normal resource_out_derived(result, resultbuf, nonnull);
    ensures normal resource_return_none();
};
