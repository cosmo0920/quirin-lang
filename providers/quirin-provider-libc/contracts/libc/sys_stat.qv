module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// <sys/stat.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. TRUSTED ASSUMPTIONS about POSIX (trust boundary
// 28); no libc body is analysed. Read from the prototypes the analysed units
// declare (`/usr/include/x86_64-linux-gnu/sys/stat.h` on the audited host):
//
//   extern int fstat (int __fd, struct stat *__buf) __THROW __nonnull ((2));
//   extern int mkdir (const char *__path, __mode_t __mode) __THROW __nonnull ((1));
//   extern __mode_t umask (__mode_t __mask) __THROW;        // unsigned int
//
// ## The custody statements
//
// `fstat` fills the caller's `struct stat` (a value write through a borrowed
// pointer); `mkdir` reads a path; `umask` exchanges a scalar. No call
// allocates, frees or retains a caller object and every result is a scalar:
// `resource_borrowed` on every parameter and `resource_return_none()`, exactly.
//
// ## Deliberately NOT declared here (recorded in the card report)
//
//   (`stat` spells `T *__restrict p`, which this card's reader withdrew; card
//   W43-LIBC-RESULT-ALIAS taught the reader that qualifier, and card
//   W43-LIBC-RESTRICT-PROTOTYPES declares `stat` at the end of this module.)
//
// ## What no declaration here says
//
// Nothing about the file system, permissions, errors or `errno`. Per-call
// custody statements about the CALLER's obligations, and nothing more.

extern fn fstat(fd: i32, buf: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(buf);
    ensures normal resource_return_none();
};

extern fn mkdir(path: ptr<const, u8>, mode: u32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(path);
    ensures normal resource_borrowed(mode);
    ensures normal resource_return_none();
};

extern fn umask(mask: u32) -> u32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(mask);
    ensures normal resource_return_none();
};

// ## Card W43-LIBC-RESTRICT-PROTOTYPES: `stat`
//
//   extern int stat (const char *__restrict __file,
//                    struct stat *__restrict __buf) __THROW __nonnull ((1, 2));
//
// `stat` reads the path and fills the caller's `struct stat` -- a value write
// through a borrowed pointer into caller storage, exactly `fstat`'s shape above.
// Nothing is allocated, freed or retained, and the `int` result is a scalar:
// `resource_borrowed` on both parameters, `resource_return_none()`. TRUSTED
// ASSUMPTION; the `__restrict` spellings are read by the declared-ABI reader
// since card W43-LIBC-RESULT-ALIAS. Nothing here says anything about the file
// system, symbolic links, permissions or `errno`.

extern fn stat(file: ptr<const, u8>, buf: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(buf);
    ensures normal resource_return_none();
};

// ## Card W48-CALLEE-CLOSURE-R3: `lstat`
//
//   extern int lstat (const char *__restrict __file,
//                     struct stat *__restrict __buf) __THROW __nonnull ((1, 2));
//
// `lstat` is `stat` that does not follow a final symbolic link: it reads the
// path and fills the caller's `struct stat`, a value write through a borrowed
// pointer into caller storage. Nothing is allocated, freed or retained, and
// the `int` result is a scalar: `resource_borrowed` on both parameters,
// `resource_return_none()`, the statement `stat` above makes. TRUSTED
// ASSUMPTION. Ranked by the card's callee closure: the Fluent Bit tail-pause
// slice's `tail_file_lstat` (`plugins/in_tail/tail_file.c`) is blocked by
// this call alone. Nothing here says anything about the file system,
// symbolic links, permissions or `errno`.

extern fn lstat(file: ptr<const, u8>, buf: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(buf);
    ensures normal resource_return_none();
};

// ## Card LIBC-GAP-DECLARATIONS: `chmod`
//
//   extern int chmod (const char *__file, __mode_t __mode)
//     __THROW __nonnull ((1));                // sys/stat.h:352; mode_t is u32
//
// Reads a path and changes its file's mode bits (POSIX chmod()); `mkdir`'s
// statement above. Nothing about permissions or errors.

extern fn chmod(file: ptr<const, u8>, mode: u32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(mode);
    ensures normal resource_return_none();
};
