module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// <time.h> and <sys/time.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. TRUSTED ASSUMPTIONS about the C library (trust
// boundary 28); no libc body is analysed. Read from the prototypes the
// analysed units declare (glibc headers on the audited host):
//
//   extern time_t time (time_t *__timer) __THROW;                 // long
//   extern time_t timegm (struct tm *__tp) __THROW;
//
// ## The custody statements
//
// Each call reads or writes values through caller pointers (`time` may store
// the result through `__timer`; `timegm` normalises `*__tp` in place) and
// returns a
// scalar. Nothing is allocated, freed or retained: `resource_borrowed` on every
// parameter, `resource_return_none()`, exactly.
//
// ## Deliberately NOT declared here (recorded in the card report)
//
//   (`gmtime_r`/`localtime_r` return their SECOND argument or NULL; card
//   W43-LIBC-RESULT-ALIAS declares them at the end of this module.)
//   (`gettimeofday`, `strftime` spell `T *__restrict p`, which this card's
//   reader withdrew; card W43-LIBC-RESTRICT-PROTOTYPES declares both at the
//   end of this module.)
//
// ## What no declaration here says
//
// Nothing about clocks, time zones, overflow, or buffer bounds. Per-call
// custody statements about the CALLER's obligations, and nothing more.

extern fn time(timer: ptr<mut, u8>) -> i64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(timer);
    ensures normal resource_return_none();
};

extern fn timegm(tp: ptr<mut, u8>) -> i64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_none();
};

// ## Card W43-LIBC-RESULT-ALIAS: the reentrant broken-down time calls
//
//   extern struct tm *gmtime_r (const time_t *__restrict __timer,
//                               struct tm *__restrict __tp) __THROW;
//   extern struct tm *localtime_r (const time_t *__restrict __timer,
//                                  struct tm *__restrict __tp) __THROW;
//
// Each reads `*__timer`, writes the caller's `*__tp`, and returns `__tp` on
// success or NULL on error (POSIX). Nothing is allocated, freed or retained:
// both pointers are `resource_borrowed`, and the result is
// `resource_return_alias(tp, nullable)` -- exactly the second argument, or
// NULL. TRUSTED ASSUMPTIONS; the `__restrict` spellings are read by the
// declared-ABI reader since this card. Nothing here says anything about time
// zones or the validity of the broken-down time.

extern fn gmtime_r(timer: ptr<const, u8>, tp: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(timer);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_alias(tp, nullable);
};

extern fn localtime_r(timer: ptr<const, u8>, tp: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(timer);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_alias(tp, nullable);
};

// ## Card W43-LIBC-RESTRICT-PROTOTYPES: `strftime` and `gettimeofday`
//
//   extern size_t strftime (char *__restrict __s, size_t __maxsize,
//                           const char *__restrict __format,
//                           const struct tm *__restrict __tp) __THROW;
//   extern int gettimeofday (struct timeval *__restrict __tv,
//                            void *__restrict __tz) __THROW __nonnull ((1));
//
// `strftime` reads the format and the caller's broken-down time and writes at
// most `__maxsize` bytes into the caller's buffer, returning a count.
// `gettimeofday` writes the caller's `struct timeval` (and ignores the
// obsolete `__tz`, which may be NULL), returning an `int`. Both are value
// writes through borrowed pointers into caller storage: nothing is allocated,
// freed or retained, and each result is a scalar, so `resource_borrowed` on
// every parameter and `resource_return_none()` are exact. TRUSTED
// ASSUMPTIONS; the `__restrict` spellings are read by the declared-ABI reader
// since card W43-LIBC-RESULT-ALIAS. Nothing here says anything about clocks,
// time zones, locales, buffer bounds or truncation.

extern fn strftime(s: ptr<mut, u8>, maxsize: usize, format: ptr<const, u8>, tp: ptr<const, u8>) -> usize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(maxsize);
    ensures normal resource_borrowed(format);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_none();
};

extern fn gettimeofday(tv: ptr<mut, u8>, tz: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(tv);
    ensures normal resource_borrowed(tz);
    ensures normal resource_return_none();
};

// ## Card W48-CALLEE-CLOSURE-R3: `clock_gettime`
//
//   extern int clock_gettime (clockid_t __clock_id, struct timespec *__tp)
//        __THROW __nonnull((2));                      // clockid_t is int
//
// `clock_gettime` writes the caller's `struct timespec` and returns an `int`:
// a value write through a borrowed pointer into caller storage, exactly
// `gettimeofday`'s statement above. Nothing is allocated, freed or retained:
// `resource_borrowed` on both parameters, `resource_return_none()`. TRUSTED
// ASSUMPTION. Ranked by the card's callee closure: it is the only call in
// librdkafka's `rd_clock` (`src/rdtime.h`, the Linux arm), a `static`
// header body W4 derives but cannot validate while this call is
// uncontracted, and whose callers carry 65 uncontracted-call leaves. Nothing
// here says anything about clocks, their resolution or `errno`.

extern fn clock_gettime(clock_id: i32, tp: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(clock_id);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_none();
};
