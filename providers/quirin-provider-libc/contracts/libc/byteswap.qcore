module contract;

// <bits/byteswap.h>, <bits/uintn-identity.h> -- resource-projection vocabulary
// version 1.
//
// Card W44-LIBC-RESIDUALS. TRUSTED ASSUMPTIONS about six glibc helpers
// (trust boundary 28). These are **header-inline bodies**, not external
// functions: glibc defines each one `static __inline` in a system header, so
// every unit that uses it carries its body. The analyser does not project
// those bodies -- a definition spelled in a header is outside the enumerated
// main-source denominator (boundary E01-B2) -- so each call was an
// uncontracted callee (599 leaves at the card's base). A declaration here
// replaces a body the unit could in principle check with an assumption; that
// is the trade, and it is stated rather than hidden.
//
// What makes the assumption small, measured by the card's
// `header_inline_census.py` over the 185 pinned units: every one of the 174
// units that defines these helpers carries the SAME signature and body, read
// from `/usr/include/x86_64-linux-gnu/bits/byteswap.h` and
// `bits/uintn-identity.h` after preprocessing on the audited host:
//
//   static __inline __uint16_t __bswap_16 (__uint16_t __bsx)
//   { return ((__uint16_t) ((((__bsx) >> 8) & 0xff) | (((__bsx) & 0xff) << 8))); }
//   static __inline __uint32_t __bswap_32 (__uint32_t __bsx)
//   { return ((((__bsx) & 0xff000000u) >> 24) | … | (((__bsx) & 0x000000ffu) << 24)); }
//   __extension__ static __inline __uint64_t __bswap_64 (__uint64_t __bsx)
//   { return ((((__bsx) & 0xff00000000000000ull) >> 56) | … ); }
//   static __inline __uint16_t __uint16_identity (__uint16_t __x) { return __x; }
//   static __inline __uint32_t __uint32_identity (__uint32_t __x) { return __x; }
//   static __inline __uint64_t __uint64_identity (__uint64_t __x) { return __x; }
//
// Each body is integer arithmetic over its one scalar parameter: no call, no
// pointer, no object other than the parameter. `__bswap_64`'s definition
// begins with `__extension__`, which the declared-ABI reader discards since
// this card; before it, that definition was unreadable in every unit.
//
// The declared-ABI gate reads each helper's definition as its C declaration,
// so a unit whose glibc spells a different signature withdraws the
// declaration there, fail-closed.
//
// ## The custody statements
//
// Scalar in, scalar out: every parameter is `resource_borrowed` and every
// result `resource_return_none()`, the neutral element, exactly as `htonl` and
// `ntohl` in `libc/socket.qcore`.
//
// ## What no declaration here says
//
// Nothing about the value computed (byte order, identity), overflow or the
// host's endianness. A declaration here is not checked against the body in
// the unit being analysed: the body census above is a measurement of the
// pinned corpus, not a gate.

extern fn __bswap_16(bsx: u16) -> u16
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(bsx);
    ensures normal resource_return_none();
};

extern fn __bswap_32(bsx: u32) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(bsx);
    ensures normal resource_return_none();
};

extern fn __bswap_64(bsx: u64) -> u64
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(bsx);
    ensures normal resource_return_none();
};

extern fn __uint16_identity(x: u16) -> u16
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(x);
    ensures normal resource_return_none();
};

extern fn __uint32_identity(x: u32) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(x);
    ensures normal resource_return_none();
};

extern fn __uint64_identity(x: u64) -> u64
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(x);
    ensures normal resource_return_none();
};
