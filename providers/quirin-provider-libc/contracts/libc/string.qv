extern fn memset(s: ptr<mut, u8>, c: i32, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(s, nonnull);
};

// ### The interior pointers: the result points INTO the first argument
//
//   extern char *strchr (const char *__s, int __c)
//        __THROW __attribute_pure__ __nonnull ((1));
//   extern char *strrchr (const char *__s, int __c)
//        __THROW __attribute_pure__ __nonnull ((1));
//   extern char *strstr (const char *__haystack, const char *__needle)
//        __THROW __attribute_pure__ __nonnull ((1, 2));
//   extern char *strcasestr (const char *__haystack, const char *__needle)
//        __THROW __attribute_pure__ __nonnull ((1, 2));
//   extern void *memchr (const void *__s, int __c, size_t __n)
//        __THROW __attribute_pure__ __nonnull ((1));
//   extern void *memrchr (const void *__s, int __c, size_t __n)
//        __THROW __attribute_pure__ __nonnull ((1));
//
//   Each only READS its arguments and returns either a pointer to a located
//   character or substring inside the object its first argument points to,
//   or NULL (C11 7.24.5.2p3, 7.24.5.5p3, 7.24.5.7p3, 7.24.5.1p2; glibc for
//   `strcasestr` and `memrchr`). So: every pointer is `resource_borrowed`, and
//   the result is `resource_return_interior(s, nullable)`. The base is
//   `const char *`/`const void *` while the result is not, so the loader
//   records `const_dropped`: a write through the result writes through a
//   pointer the caller declared `const`.
//
// ## What no declaration in this section says
//
// Nothing about bounds, overlap, termination, the offset of an interior
// result, or whether the located byte exists. Releasing an interior result is
// an invalid free unless the offset happens to be zero, which the analyzer
// cannot know: it reports a violation CANDIDATE, never a defect.

extern fn strchr(s: ptr<const, u8>, c: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_return_interior(s, nullable);
};

extern fn strrchr(s: ptr<const, u8>, c: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_return_interior(s, nullable);
};

extern fn strstr(haystack: ptr<const, u8>, needle: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(haystack);
    ensures normal resource_borrowed(needle);
    ensures normal resource_return_interior(haystack, nullable);
