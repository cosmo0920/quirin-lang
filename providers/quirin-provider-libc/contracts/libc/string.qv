module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// <string.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. Every declaration below is a TRUSTED ASSUMPTION
// about the C library. It verifies nothing: no libc body is analysed, and a
// declaration is a premise (trust boundary 28). Each was read from the
// prototype the analysed units themselves declare (glibc 2.x headers on the
// audited host, `/usr/include/string.h`), after preprocessing.
//
// ## The custody statements
//
//   extern int strcmp (const char *__s1, const char *__s2)
//     __THROW __attribute_pure__ __nonnull ((1, 2));
//   extern size_t strlen (const char *__s) __THROW __attribute_pure__ __nonnull ((1));
//
//   Both only READ their arguments and return a scalar. They allocate, free
//   and retain nothing, so every pointer is `resource_borrowed` and the result
//   is `resource_return_none()` -- a scalar result, so the mode is exact, not
//   an approximation.
//
//   extern char *strdup (const char *__s) __THROW __attribute_malloc__ __nonnull ((1));
//
//   Reads `__s` (borrowed) and returns a FRESH `malloc` allocation or NULL on
//   failure (C23 7.26.2.6, POSIX). That is exactly
//   `resource_return_owned(nullable)`: the caller acquires an obligation that
//   `free` (declared in `libc/memory.qcore`) discharges, from the same
//   allocator, and must test the result for null before relying on it.
//
//   extern int strerror_r (int __errnum, char *__buf, size_t __buflen)
//     __asm__ ("__xpg_strerror_r") __THROW __nonnull ((2));
//
//   The XSI form: writes a message into the caller's buffer and returns an
//   `int` status. Borrowed buffer, scalar result. glibc ALSO has a GNU form,
//   `char *strerror_r (int, char *, size_t)`, selected by `_GNU_SOURCE`, whose
//   result is either `__buf` or a pointer to static storage -- a conditional
//   alias this vocabulary cannot state. This declaration speaks only for the
//   XSI prototype: in a unit that declares the GNU form, the declared-ABI gate
//   (gateway constraint 8) sees `-> i32` against `char *` and WITHDRAWS the
//   declaration at every call site, which is the refusing direction.
//
// ## Declared later in this module (card W43-LIBC-RESULT-ALIAS)
//
//   `memcpy`, `memmove`, `memset`, `strcpy`, `strncpy` return their FIRST
//   ARGUMENT, and `strchr`, `strrchr`, `strstr`, `strcasestr`, `memchr`,
//   `memrchr` return a pointer INTO their first argument. Card W43-LIBC-CONTRACTS
//   could not state either (`LIBC-MEM-RESULT-ALIAS`); they are declared at the
//   end of this module with the derived-result modes of contract spec C04.3.1.
//
// ## What no declaration here says
//
// Nothing about string contents, termination, bounds, overlap, or the value of
// any result. These are per-call custody statements about the CALLER's
// obligations, and nothing more.

extern fn strcmp(s1: ptr<const, u8>, s2: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s1);
    ensures normal resource_borrowed(s2);
    ensures normal resource_return_none();
};

extern fn strlen(s: ptr<const, u8>) -> usize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_return_none();
};

// W46-LIBC-EVENT-CONTRACT-GAPS. glibc string.h:75,174,445 and
// strings.h:116: these are scalar comparisons or a bounded length query.
// Each reads its input bytes, retains no pointer, and creates/releases no
// resource. They assert no bounds, termination, or equality fact.
extern fn memcmp(s1: ptr<const, u8>, s2: ptr<const, u8>, n: usize) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s1);
    ensures normal resource_borrowed(s2);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_none();
};

extern fn strncmp(s1: ptr<const, u8>, s2: ptr<const, u8>, n: usize) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s1);
    ensures normal resource_borrowed(s2);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_none();
};

extern fn strnlen(s: ptr<const, u8>, maxlen: usize) -> usize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(maxlen);
    ensures normal resource_return_none();
};

extern fn strcasecmp(s1: ptr<const, u8>, s2: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s1);
    ensures normal resource_borrowed(s2);
    ensures normal resource_return_none();
};

extern fn strdup(s: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_return_owned(nullable);
};

extern fn strerror_r(errnum: i32, buf: ptr<mut, u8>, buflen: usize) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(errnum);
    ensures normal resource_borrowed(buf);
    ensures normal resource_borrowed(buflen);
    ensures normal resource_return_none();
};

// ## Card W43-LIBC-RESULT-ALIAS: results derived from an argument
//
// TRUSTED ASSUMPTIONS, read from the same headers. Each result below is
// DERIVED from one argument and owns nothing (contract spec C04.3.1): it
// acquires, discharges and transfers no custody, releasing it is not a release
// of the base, and releasing the base invalidates it.
//
// ### The exact aliases: the result IS the first argument
//
//   extern void *memcpy (void *__restrict __dest, const void *__restrict __src,
//                        size_t __n) __THROW __nonnull ((1, 2));
//   extern void *memmove (void *__dest, const void *__src, size_t __n)
//        __THROW __nonnull ((1, 2));
//   extern void *memset (void *__s, int __c, size_t __n) __THROW __nonnull ((1));
//   extern char *strcpy (char *__restrict __dest, const char *__restrict __src)
//        __THROW __nonnull ((1, 2));
//   extern char *strncpy (char *__restrict __dest,
//                         const char *__restrict __src, size_t __n)
//        __THROW __nonnull ((1, 2));
//
//   Each writes through its first argument, reads the others, and "returns the
//   value of" its first argument (C11 7.24.2.1p3, 7.24.2.2p3, 7.24.6.1p3,
//   7.24.2.3p3, 7.24.2.4p5). So: every pointer is `resource_borrowed` (the
//   callee retains nothing), and the result is `resource_return_alias(dest,
//   nonnull)` -- the call never substitutes NULL for its argument. The
//   `__restrict` spellings are read by the declared-ABI reader as qualifiers
//   of the parameter object (C11 6.7.6.3p15) since this card.

extern fn strcpy(dest: ptr<mut, u8>, src: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn strncpy(dest: ptr<mut, u8>, src: ptr<const, u8>, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn memcpy(dest: ptr<mut, u8>, src: ptr<const, u8>, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn memmove(dest: ptr<mut, u8>, src: ptr<const, u8>, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
