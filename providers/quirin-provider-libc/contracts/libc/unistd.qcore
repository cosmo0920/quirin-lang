extern fn read(fd: i32, buf: ptr<mut, u8>, nbytes: usize) -> isize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(buf);
    ensures normal resource_borrowed(nbytes);
    ensures normal resource_return_none();
};

extern fn write(fd: i32, buf: ptr<const, u8>, n: usize) -> isize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(buf);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_none();
