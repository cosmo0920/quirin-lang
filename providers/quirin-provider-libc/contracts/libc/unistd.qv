// ## Descriptors (Card W43-DESCRIPTOR-RESOURCE-TRACKING)
//
// TRUSTED ASSUMPTIONS, read from the prototypes the analysed units declare
// (`/usr/include/fcntl.h` for `open`, `/usr/include/unistd.h` for `close`):
//
//   extern int open (const char *__file, int __oflag, ...) __nonnull ((1));
//   extern int close (int __fd);
//
// `open` returns a fresh file descriptor or the sentinel `-1`
// (`resource_return_owned(sentinel)` of the `descriptor` kind, contract spec
// §C04.6); its path is read, its flags are a scalar, and its optional `mode`
// is data (`resource_variadic_data_tail()`). `close` releases a valid
// descriptor (`resource_released(fd, valid)` of the `descriptor` kind); a
// descriptor that may be `-1` must be validity-tested first. `open` lives in
// `<fcntl.h>`; it is declared in this module beside its release so that the
// pair is one reading.
//
// ## What these two declarations do not say
//
// Nothing about `errno`, `EINTR`, a failed `close` (whose descriptor POSIX
// leaves unspecified; the declaration reads every `close` as a release, the
// reading Linux implements), `O_CLOEXEC`, or which file was opened. A
// `descriptor` is released only by a descriptor release: `free(fd)` and
// `fclose(fd)` discharge nothing.
//
// ## Deliberately NOT declared (recorded in the card report)
//
//   `fcntl` creates a descriptor only for `F_DUPFD`/`F_DUPFD_CLOEXEC` and is a
//   neutral use for every other command; the audited units spell five
//   commands (`F_SETFL`, `F_GETFL`, `F_SETFD`, `F_SETLK`, a nested `F_GETFL`),
//   and one declaration carries one literal premise per parameter, so no
//   single declaration is exact. `pipe` writes two descriptors into an
//   `int[2]`, and a descriptor has no out slot in this vocabulary. `dup`,
//   `dup2`, `creat`, `openat` and `mkstemp` are called by no audited unit.

extern fn open(file: ptr<const, u8>, oflag: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(oflag);
    ensures normal resource_variadic_data_tail();
    ensures normal resource_return_owned(sentinel);
    ensures normal resource_return_kind(descriptor);
};

extern fn close(fd: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_released(fd, valid);
    ensures normal resource_kind(fd, descriptor);
    ensures normal resource_return_none();
};

// ## Card W46-EXTERNAL-CALLEE-CONTRACTS: `fcntl` at `F_SETFD` only
//
// A TRUSTED ASSUMPTION, read from the prototype the analysed units declare
// (`/usr/include/fcntl.h:177` on the audited host):
//
//   extern int fcntl (int __fd, int __cmd, ...);
//
// The decline above stands for `fcntl` as a whole: its effect depends on the
// command, and `F_DUPFD`/`F_DUPFD_CLOEXEC` create a descriptor. This
// declaration therefore carries `resource_literal_argument(cmd, 2)` and applies
// ONLY at call sites whose command is exactly `2`, which is `F_SETFD`
// (`bits/fcntl-linux.h:169`; the spelling a call site reaches after
// preprocessing), the `prctl` precedent in `libc/process.qcore`. At every other
// command, including `F_GETFL`, `F_SETFL` and `F_GETPIPE_SZ`, the callee stays
// undeclared.
//
// For `F_SETFD` the call sets the descriptor's flags (`FD_CLOEXEC`) from the
// third argument, an `int` read by value, and returns `0` or `-1`. It creates,
// closes and transfers no descriptor, and allocates, frees or retains nothing.
// So `fd` is `resource_borrowed` (a tracked descriptor handed here is a use, and
// a use after its `close` is a violation candidate), the command is a scalar,
// the tail is exactly `resource_variadic_data_tail()` (the flag, and any extra
// actual, which `F_SETFD` never reads), and the `int` result is
// `resource_return_none()`.
//
// NOT CLAIMED: which flags are set, whether the call succeeded, and anything
// about any other command.

extern fn fcntl(fd: i32, cmd: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_literal_argument(cmd, 2);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(cmd);
    ensures normal resource_variadic_data_tail();
    ensures normal resource_return_none();
};

// ## Card W48-BU-EXTERNAL-CALLEE-CONTRACTS: POSIX writev custody.
// POSIX.1-2017 writev / the configured <sys/uio.h> declaration:
// ssize_t writev(int, const struct iovec *, int).
// A normal return transfers or retains neither the caller's vector nor its
// reachable buffers, and does not close the descriptor. The vector and count
// are borrowed; the signed scalar result carries no resource custody.
// This is a declared libc/ABI assumption (trust boundary 28), not a proof of
// libc code. No purity, errno preservation, successful/full output, buffer
// validity/bounds, nullness or cancellation guarantee is stated. The resource
// projection does not check the liveness/bounds of reachable buffer objects.
extern fn writev(fd: i32, iov: ptr<const, u8>, iovcnt: i32) -> isize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(iov);
    ensures normal resource_borrowed(iovcnt);
    ensures normal resource_return_none();
};

// ## Card LIBC-GAP-DECLARATIONS: descriptor, path and buffer uses
//
// TRUSTED ASSUMPTIONS (trust boundary 28), read from the prototypes on the
// audited host, where no audited unit defines `_FILE_OFFSET_BITS` (so no
// `__REDIRECT` to a `*64` name applies and `__off_t` is `long int`, `i64`):
//
//   extern __off_t lseek (int __fd, __off_t __offset, int __whence) __THROW;
//   extern int ftruncate (int __fd, __off_t __length) __THROW __wur;
//   extern ssize_t readlink (const char *__restrict __path,
//                            char *__restrict __buf, size_t __len)
//     __THROW __nonnull ((1, 2)) __wur;
//   extern int chown (const char *__file, __uid_t __owner, __gid_t __group)
//     __THROW __nonnull ((1)) __wur;
//   extern int posix_fallocate (int __fd, off_t __offset, off_t __len);
//   extern int msync (void *__addr, size_t __len, int __flags);
//   extern ssize_t getrandom (void *__buffer, size_t __length,
//                             unsigned int __flags) __wur;
//
// (`unistd.h:339`, `:1049`, `:838-841`, `:493-494`; `fcntl.h:324`;
// `sys/mman.h:89`; `sys/random.h`.) `__uid_t`, `__gid_t` and `unsigned int`
// are `u32`; `ssize_t` is `isize`.
//
// ## The custody statements
//
// Each USES what it is handed and creates, closes, frees or retains nothing,
// so every parameter is `resource_borrowed` and every result
// `resource_return_none()`, `read`'s statement above:
//
// * `lseek`, `ftruncate` and `posix_fallocate` use an open descriptor
//   (POSIX): they move its offset or change its file's size, and the
//   descriptor stays open. A tracked descriptor handed to them is a use, so a
//   use after its `close` is a `use_after_release` candidate (contract
//   specification C04.6 rule 6).
// * `readlink` reads a path and writes at most `__len` bytes into the
//   caller's buffer; `chown` reads a path.
// * `msync` writes back a mapping the caller keeps (POSIX msync()). The
//   mapping's own lifecycle (`mmap`/`munmap`, whose failure value is the
//   pointer sentinel `MAP_FAILED`) is not declared, so no mapping is tracked
//   and the address is borrowed data.
// * `getrandom` writes at most `__length` bytes into the caller's buffer
//   (Linux getrandom(2)).
//
// Nothing here says anything about errors, `errno`, short transfers, file
// sizes or permissions.

extern fn lseek(fd: i32, offset: i64, whence: i32) -> i64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(offset);
    ensures normal resource_borrowed(whence);
    ensures normal resource_return_none();
};

extern fn ftruncate(fd: i32, length: i64) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(length);
    ensures normal resource_return_none();
};

