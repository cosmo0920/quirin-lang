module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// <stdio.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. Every declaration below is a TRUSTED ASSUMPTION
// about the C library (trust boundary 28); no libc body is analysed. Each was
// read from the prototype the analysed units declare (`/usr/include/stdio.h`
// on the audited host), after preprocessing:
//
//   extern void perror (const char *__s);
//   extern int fflush (FILE *__stream);
//   extern int remove (const char *__filename) __THROW;
//
// ## The custody statements
//
// `perror` reads one string and writes to `stderr`; `fflush` writes out the
// buffer of a stream the caller keeps (`FILE *` is an object pointer the call
// borrows); `remove` reads one path. None allocates, frees or retains a caller
// object and every result is `void` or an `int`: `resource_borrowed` on every
// parameter and `resource_return_none()`, exactly.
//
// ## Deliberately NOT declared here (recorded in the card report)
//
//   `printf`, `fprintf`, `snprintf`, `sprintf`: faithful in v1
//   (`LIBC-PRINTF-FAMILY`), but every one spells a qualifier AFTER the `*`
//   (`const char *__restrict __format`), which the declared-ABI reader
//   (gateway constraint 8) does not read: this card measured each of them
//   withdrawn with `abi-unreadable-declaration` at every call site in the
//   pinned corpus (`LOADER-ABI-RESTRICT-QUALIFIER`). A declaration withdrawn
//   everywhere decides nothing, so none is shipped. [Superseded for these
//   four by card W43-LIBC-PRINTF-FAMILY once card W43-LIBC-RESULT-ALIAS had
//   repaired the reader: see the section at the end of this module.]
//   `vprintf`/`vsnprintf` take a `va_list` (`__builtin_va_list`), for which
//   this vocabulary has no ABI spelling. [Superseded for these two by card
//   W44-LIBC-RESIDUALS, which added the `va_list` spelling: see the section at
//   the end of this module.]
//   `fopen`/`fclose` open and close a STREAM: a v1 owned/released pair would
//   put `FILE *` custody in the one kind-less pointer class `malloc`/`free`
//   use, so `free(fopen(...))` and `fclose(malloc(...))` would both discharge.
//   Superseded by the stream section at the end of this module (card
//   W43-DESCRIPTOR-RESOURCE-TRACKING), which gives them the `stream` kind.
//
// ## What no declaration here says
//
// Nothing about stream state, buffering, errors or `errno`. These are per-call
// custody statements about the CALLER's obligations, and nothing more.

extern fn perror(s: ptr<const, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_return_none();
};

extern fn fflush(stream: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(stream);
    ensures normal resource_return_none();
};

extern fn remove(filename: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(filename);
    ensures normal resource_return_none();
};

// ---------------------------------------------------------------------------
// Card W43-LIBC-PRINTF-FAMILY: the formatted-output family.
//
// Each declaration below is a TRUSTED ASSUMPTION about the C library (trust
// boundary 28); no libc body is analysed. Each was read from the prototype the
// analysed units declare (`/usr/include/stdio.h` on the audited host, glibc,
// x86-64, LP64), after preprocessing:
//
//   extern int printf (const char *__restrict __format, ...);
//   extern int fprintf (FILE *__restrict __stream,
//         const char *__restrict __format, ...) __attribute__ ((__nonnull__ (1)));
//   extern int snprintf (char *__restrict __s, size_t __maxlen,
//          const char *__restrict __format, ...)
//        __attribute__ ((__nothrow__)) __attribute__ ((__format__ (__printf__, 3, 4)));
//   extern int sprintf (char *__restrict __s,
//         const char *__restrict __format, ...) __attribute__ ((__nothrow__));
//
// A qualifier after a parameter's last `*` is read as the unqualified type
// (C11 6.7.6.3p15; card W43-LIBC-RESULT-ALIAS's reader repair). The
// declared-ABI census over the 185 captured units reads each of the four as
// agreeing in all 168 units that declare it and withdrawn in none
// (`docs/reports/w43-libc-printf-family/census/family9.txt`).
//
// ## The custody statements
//
// * The RESULT is an `int` (a count, or a negative error): a scalar, so
//   `resource_return_none()` is the literally faithful mode, not an
//   approximation.
// * `stream` (`FILE *`) is a stream the caller keeps. The call writes to it
//   and neither opens, closes nor retains it: `resource_borrowed`, exactly as
//   `fflush` above. `__nonnull__ (1)` is a precondition, not custody.
// * `s`, the destination buffer of `snprintf` and `sprintf`, is WRITTEN
//   THROUGH and is the caller's before and after the call:
//   `resource_borrowed`, the mode `msgpack_packer_init`'s written-through `pk`
//   already establishes. The call neither frees nor retains it, and the
//   result is a count, not a pointer into it.
// * `maxlen` is a `size_t` by value, and `format` is a string that is read.
// * The variadic tail is consumed by the call and rendered as text. No tail
//   argument is freed, and no pointer to one is retained past the call:
//   `resource_variadic_data_tail()`, exactly as Monkey's `mk_print` declares
//   it (`qcore-provider-libevent/contracts/monkey/logging.qcore`). The clause
//   admits nothing on its own: the gateway still requires, per call site,
//   that every tail actual is data.
// * [Card CONTRACT-NORETURN-AND-BORROWED-TAILS] `printf`, `fprintf` and
//   `snprintf` now declare `resource_variadic_borrowed_tail()` (contract
//   specification C04.2): the same statement, and that every trailing
//   position is `resource_borrowed`. C17 7.21.6.1 (with 7.21.6.3 and
//   7.21.6.5) gives each conversion's effect on its argument: `%s` and `%p`
//   READ the pointer or the string it points to, `%n` STORES the count of
//   characters written so far through an `int *` (p8), and every other
//   conversion reads a value. None frees, stores or returns an argument, and
//   nothing of an argument outlives the call but the rendered text, so a
//   pointer handed to the tail is borrowed: the gateway reads a trailing
//   plain name as a borrowed place (gateway rule 11w, T8) and still refuses a
//   released one (C04.2's caller-side rule). `%n`'s store is a write through
//   a borrowed position, exactly as `snprintf`'s `s` is: no custody moves.
//   It is not a claim that the stored count is unchanged: the gateway forgets
//   the fact of a scalar lent as `&x` (T7) and holds no fact about `*p` of a
//   pointer, so no custody decision can rest on the rewritten count
//   (`a_percent_n_write_through_an_aliased_scalar_is_never_certified`).
//   `sprintf` keeps the data tail: no analysed call of it has a tail actual
//   the data tail refuses, so the borrowed tail would decide nothing.
//
// ## What no declaration here says
//
// Nothing about buffer bounds or truncation (`sprintf` overrunning `s`, or
// `snprintf` given a `maxlen` larger than `s`), about agreement between the
// format and the tail (an argument whose type does not match its conversion
// is undefined behaviour, C17 7.21.6.1p9, which no custody statement covers),
// about the count `%n` stores, about `%s` reading through a released pointer
// (the gateway's own liveness precondition, unchanged), stream errors,
// `errno`, locale, or interleaving across threads. These are per-call custody
// statements about the CALLER's obligations, and nothing more.
//
// ## Refused by name (recorded in the card report)
//
//   `vprintf`, `vfprintf`, `vsprintf`, `vsnprintf` take a `__gnuc_va_list`
//   (`__builtin_va_list`) parameter, which the declared-ABI reader cannot
//   read: the census withdraws each with `abi-unreadable-declaration` in all
//   168 units, so a declaration would decide nothing and only rename leaves
//   (`LIBC-PRINTF-VA-LIST`). `dprintf` agrees everywhere, but no analysed unit
//   calls it, so it is not declared. [Superseded for `vsnprintf` and `vprintf`
//   by card W44-LIBC-RESIDUALS: see the section at the end of this module.]

extern fn printf(format: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(format);
    ensures normal resource_variadic_borrowed_tail();
    ensures normal resource_return_none();
};

extern fn fprintf(stream: ptr<mut, u8>, format: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(stream);
    ensures normal resource_borrowed(format);
    ensures normal resource_variadic_borrowed_tail();
    ensures normal resource_return_none();
};

extern fn snprintf(s: ptr<mut, u8>, maxlen: usize, format: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(maxlen);
    ensures normal resource_borrowed(format);
    ensures normal resource_variadic_borrowed_tail();
    ensures normal resource_return_none();
};

extern fn sprintf(s: ptr<mut, u8>, format: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(format);
    ensures normal resource_variadic_data_tail();
    ensures normal resource_return_none();
};

// ## Streams (Card W43-DESCRIPTOR-RESOURCE-TRACKING)
//
// TRUSTED ASSUMPTIONS, read from the prototypes the analysed units declare:
//
//   extern FILE *fopen (const char *__restrict __filename,
//                       const char *__restrict __modes)
//     __attribute__ ((__malloc__));
//   extern int fclose (FILE *__stream) __nonnull ((1));
//   extern int fileno (FILE *__stream) __THROW __nonnull ((1));
//
// `fopen` returns a fresh stream or NULL (`resource_return_owned(nullable)` of
// the `stream` kind, contract spec §C04.6). `fclose` releases a non-NULL stream
// (`resource_released(stream, nonnull)` of the `stream` kind), whether or not
// it reports an error. `fileno` borrows the stream and returns the number of
// the descriptor the stream owns: `resource_return_none()`, because that
// number is borrowed, and closing it independently would be a second release
// of the stream's descriptor, which this declaration never licenses.
//
// ## What these declarations do not say
//
// Nothing about buffering, flushing on close, `errno` or the file system. A
// `stream` is released only by a stream release: `free(fp)` and `close(fp)`
// discharge nothing. `fdopen` (the descriptor moves into the stream only when
// it returns non-NULL) and `popen`/`pclose` (a process stream `fclose` must not
// release) are not declared.

extern fn fopen(filename: ptr<const, u8>, modes: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(filename);
    ensures normal resource_borrowed(modes);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(stream);
};

extern fn fclose(stream: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_released(stream, nonnull);
    ensures normal resource_kind(stream, stream);
    ensures normal resource_return_none();
};

extern fn fileno(stream: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(stream);
    ensures normal resource_return_none();
};

// ## The `va_list` members (card W44-LIBC-RESIDUALS)
//
// TRUSTED ASSUMPTIONS (trust boundary 28), read from the prototypes the
// analysed units declare (`/usr/include/stdio.h`, glibc, x86-64, LP64):
//
//   extern int vsnprintf (char *__restrict __s, size_t __maxlen,
//                         const char *__restrict __format, __gnuc_va_list __arg)
//     __THROWNL __attribute__ ((__format__ (__printf__, 3, 0)));
//   extern int vprintf (const char *__restrict __format, __gnuc_va_list __arg);
//
// `__gnuc_va_list` is `typedef __builtin_va_list __gnuc_va_list;`. Since this
// card the declared-ABI reader reads the builtin at a parameter as the
// `va_list` spelling (contract spec §C04.1), which is not a pointer spelling,
// so `resource_borrowed` is the only mode it can carry. The census agrees for
// both in all 168 units that declare them.
//
// * `s`, `maxlen` and `format` read exactly as `snprintf`'s and `printf`'s
//   above: the destination is written through and stays the caller's.
// * `arg` is the caller's variable-argument list. The call reads the arguments
//   it reaches and renders them as text; it frees none and retains no pointer
//   to one, which is the tail premise `resource_variadic_data_tail()` states
//   for the fixed-arity members, stated here for the list that carries them.
//   The list object itself is used up (its value in the caller is indeterminate
//   afterwards, C11 7.16p3); that is not custody, and nothing here says the
//   caller may reuse it.
//
// `vfprintf` and `vsprintf` agree as well, but no analysed unit calls either,
// so neither is declared.
//
// ## What no declaration here says
//
// Everything the printf section above lists, and nothing about `va_start`/
// `va_end` pairing, which is the caller's and is not modelled.

extern fn vsnprintf(s: ptr<mut, u8>, maxlen: usize, format: ptr<const, u8>, arg: va_list) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(maxlen);
    ensures normal resource_borrowed(format);
    ensures normal resource_borrowed(arg);
    ensures normal resource_return_none();
};

extern fn vprintf(format: ptr<const, u8>, arg: va_list) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(format);
    ensures normal resource_borrowed(arg);
    ensures normal resource_return_none();
};

// ## Card LIBC-GAP-DECLARATIONS: `fread`
//
// A TRUSTED ASSUMPTION, read from `/usr/include/stdio.h:732-734` on the
// audited host:
//
//   extern size_t fread (void *__restrict __ptr, size_t __size,
//                        size_t __n, FILE *__restrict __stream) __wur
//     __nonnull((4));
//
// `fread` reads up to `__n` elements of `__size` bytes from the stream into
// the caller's buffer and returns how many it read (C11 7.21.8.1). It is
// `fflush`'s statement: the stream is USED, not opened or closed, and the
// buffer is written, not retained. A stream (`stream` kind, `fopen` above)
// handed to it is a use, so a use after its `fclose` is a `use_after_release`
// candidate (contract specification C04.6 rule 6). Nothing here says anything
// about short reads, end of file, errors or `errno`.

extern fn fread(ptr: ptr<mut, u8>, size: usize, n: usize, stream: ptr<mut, u8>) -> usize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(ptr);
    ensures normal resource_borrowed(size);
    ensures normal resource_borrowed(n);
    ensures normal resource_borrowed(stream);
    ensures normal resource_return_none();
};
