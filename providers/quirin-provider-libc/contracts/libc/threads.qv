// ## Card W43-LIBC-RESTRICT-PROTOTYPES: `cnd_timedwait` and `pthread_sigmask`
//
//   extern int cnd_timedwait (cnd_t *__restrict __cond,
//                             mtx_t *__restrict __mutex,
//                             const struct timespec *__restrict __time_point);
//   extern int pthread_sigmask (int __how,
//                               const __sigset_t *__restrict __newmask,
//                               __sigset_t *__restrict __oldmask) __THROW;
//
// `cnd_timedwait` is `cnd_wait` above with a deadline the caller keeps: it
// atomically unlocks `*__mutex`, waits, and locks `*__mutex` again before it
// returns, on success and on timeout alike (C11 7.26.3.5). That is the same
// custody statement as `cnd_wait` and the `libc/pthread_mutex.qcore`
// lock/unlock pair: the condition, the mutex and the deadline stay the
// caller's on both sides of the call, so each is `resource_borrowed`, and the
// `int` result is `resource_return_none()`. It says no more about the mutex
// than `cnd_wait` does -- in particular it states no lock state, so it is
// consistent with the other lock declarations here and leaves constraint 27's
// checked mutex model untouched.
//
// `pthread_sigmask` reads the new mask through `__newmask` (which may be NULL)
// and writes the old mask through `__oldmask` (which may be NULL): value
// reads and writes of a `sigset_t` in caller storage, like `sigemptyset`
// above. Nothing is allocated, freed or retained; `resource_borrowed` on
// every parameter, `resource_return_none()`.
//
// TRUSTED ASSUMPTIONS; the `__restrict` spellings are read by the declared-ABI
// reader since card W43-LIBC-RESULT-ALIAS. Nothing here says anything about
// timeouts, spurious wake-ups, error returns, or signal delivery.

extern fn cnd_timedwait(cond: ptr<mut, u8>, mutex: ptr<mut, u8>, time_point: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(cond);
    ensures normal resource_borrowed(mutex);
    ensures normal resource_borrowed(time_point);
    ensures normal resource_return_none();
};

extern fn pthread_sigmask(how: i32, newmask: ptr<const, u8>, oldmask: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(how);
    ensures normal resource_borrowed(newmask);
    ensures normal resource_borrowed(oldmask);
    ensures normal resource_return_none();
};

// ## One-time initialisation
//
// Card CG22-CALLBACK-REGISTRY-CONTRACT (contract spec C04.19, gateway rule
// 13u). Read from `/usr/include/pthread.h:509-510` on the audited host:
//
//   extern int pthread_once (pthread_once_t *__once_control,
//                            void (*__init_routine) (void)) __nonnull ((1, 2));
//
// `init_routine` is called at most once across every call with the same
// `once_control`, by one of them, and the others wait for it (POSIX). From
// one caller's custody view that is "called during this call, zero or more
// times, with no actual" (a superset of the paths), and nothing keeps it:
// `resource_callback_invoked(init_routine)`. The routine's own contract must
// be the identity (rule 13u), so an initialiser that allocates into a global
// refuses the call. `once_control` is read and updated in place (a scalar
// state); the result is a status.

extern fn pthread_once(once_control: ptr<mut, u8>, init_routine: fnptr) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(once_control);
    ensures normal resource_borrowed(init_routine);
    ensures normal resource_callback_invoked(init_routine);
    ensures normal resource_return_none();
};

// ## Card W48-BU-EXTERNAL-CALLEE-CONTRACTS: C11 current-thread identifier.
// C11 N1570 7.26.5.2: thrd_current returns the calling thread's identifier.
// The audited WITH_C11THREADS=1 configurations select system <threads.h>,
// not an analysed bundled TinyC body. Here thrd_t -> __thrd_t -> unsigned
// long int, on LP64. u64 records that observed ABI; a pointer or incompatible
// scalar declaration must withdraw this flexible contract at the ABI gate.
// The identifier supplies no owning thread handle, synchronization fact or
// thread-lifetime proof. This is a declared standard/ABI premise (boundary 28).
// mtx_destroy remains undeclared: destroying in-place mutex resources is not
// freeing their storage, and the global-owner lifecycle has no admitted kind.
extern fn thrd_current() -> u64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_return_none();
};

// ## Card LIBC-GAP-DECLARATIONS: `sigdelset`, `pthread_cancel`, thread-specific data
//
// TRUSTED ASSUMPTIONS (trust boundary 28), read from the prototypes on the
// audited host (`/usr/include/signal.h:208`, `/usr/include/pthread.h:528`,
// `:1305-1310`):
//
//   extern int sigdelset (sigset_t *__set, int __signo) __THROW __nonnull ((1));
//   extern int pthread_cancel (pthread_t __th);
//   extern void *pthread_getspecific (pthread_key_t __key) __THROW;
//   extern int pthread_setspecific (pthread_key_t __key,
//                                   const void *__pointer)
//     __THROW __attr_access_none (2);
//
// `pthread_t` is `unsigned long int` (`u64`); `pthread_key_t` is `unsigned
// int` (`u32`, `bits/pthreadtypes.h:49`).
//
// `sigdelset` is `sigaddset` above with the member removed (POSIX
// sigdelset()): a value write into the caller's signal set.
//
// `pthread_cancel` requests cancellation of the thread `__th` names (POSIX
// pthread_cancel()). It takes a scalar and returns a status; nothing of the
// caller's is allocated, freed or retained, which is `pthread_kill`'s
// statement above. What the cancelled thread's own frames abandon is that
// thread's, and nothing here says anything about it.
//
// `pthread_setspecific(key, value)` associates `value` with `key` in the
// calling thread (POSIX pthread_setspecific(): "associate a thread-specific
// value with a key"). The value is kept past the call in thread-specific
// storage that no caller object denotes, and the call takes no custody: the
// caller keeps whatever obligation `value` carries. That is exactly
// `resource_retained_by(pointer, global)` (contract specification C04.14):
// the declaration is withheld from the function map, and the route-G
// consumer (rule 12t) decides the retention only for static storage (a
// string literal). A heap object, a caller's object or any other actual is
// `retention-undecided`, never `Safe`. A key's destructor may later release
// the value at thread exit; no declaration here states that, so nothing is
// discharged by it.
//
// `pthread_getspecific(key)` returns the value the calling thread last
// associated with `key`, or NULL (POSIX). It returns no fresh custody: the
// caller does not own the result through this call, so the result mode is
// `resource_return_none()`, the `gai_strerror`/`__errno_location` statement.
// The relation to the object an earlier `pthread_setspecific` retained is NOT
// stated. The result therefore carries no identity on route G: a release of
// it, a store of it into a custody position or any other custody use is
// refused as an unresolved identity, never credited to an obligation and
// never `Safe` (`libc_gap_declarations.rs` pins `free(pthread_getspecific(k))`
// as refused). A retained-result relation stays open
// (W43-RESULT-ALIAS-CONDITIONAL-AND-RETAINED, W46-FLUENT-TLS-RETAINED-RESULT).

extern fn sigdelset(set: ptr<mut, u8>, signo: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(set);
    ensures normal resource_borrowed(signo);
    ensures normal resource_return_none();
};

extern fn pthread_cancel(thread: u64) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(thread);
    ensures normal resource_return_none();
};

extern fn pthread_setspecific(key: u32, pointer: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(key);
    ensures normal resource_borrowed(pointer);
