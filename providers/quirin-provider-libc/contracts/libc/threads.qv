module contract;

// Card W45-CONTRACT-REVISION-MODE: every contract in this module is
// `revision flexible` (contract spec C06.2): it binds by name and declared
// signature at any revision of the audited project, and reports list the libc
// contracts as one standing assumption, the libc/C-standard ABI premise. The
// C library's version stays in the build's provenance.

// C11 <threads.h> and POSIX thread/signal helpers -- resource-projection
// vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. TRUSTED ASSUMPTIONS about the C library (trust
// boundary 28); no libc body is analysed. Read from the prototypes the
// analysed units declare (glibc `threads.h`, `pthread.h`, `bits/sigthread.h`,
// `signal.h` on the audited host):
//
//   extern int mtx_lock (mtx_t *__mutex);
//   extern int mtx_unlock (mtx_t *__mutex);
//   extern int cnd_wait (cnd_t *__cond, mtx_t *__mutex);
//   extern int pthread_rwlock_rdlock (pthread_rwlock_t *__rwlock) __THROWNL __nonnull ((1));
//   extern int pthread_rwlock_wrlock (pthread_rwlock_t *__rwlock) __THROWNL __nonnull ((1));
//   extern int pthread_rwlock_unlock (pthread_rwlock_t *__rwlock) __THROWNL __nonnull ((1));
//   extern pthread_t pthread_self (void) __THROW __attribute__ ((__const__));  // unsigned long
//   extern int pthread_kill (pthread_t __threadid, int __signo) __THROW;
//   extern int pthread_setcancelstate (int __state, int *__oldstate);
//   extern int pthread_setcanceltype (int __type, int *__oldtype);
//   extern int pthread_attr_setdetachstate (pthread_attr_t *__attr, int __detachstate)
//     __THROW __nonnull ((1));
//   extern int sigemptyset (sigset_t *__set) __THROW __nonnull ((1));
//   extern int sigfillset (sigset_t *__set) __THROW __nonnull ((1));
//   extern int sigaddset (sigset_t *__set, int __signo) __THROW __nonnull ((1));
//
// ## The custody statements
//
// The lock, wait and unlock calls are the `libc/pthread_mutex.qcore` shape:
// they neither allocate, free, reallocate nor take custody of the lock object,
// which the caller owns on both sides of the call, so the caller's obligations
// are unchanged -- `resource_borrowed` -- and each `int` result is
// `resource_return_none()`. The remaining calls read or write scalar state
// through a caller pointer (`oldstate`, the attribute object, a signal set) or
// take scalars; every result is a scalar. Nothing is allocated, freed or
// retained.
//
// ## Deliberately NOT declared here (recorded in the card report)
//
//   The OBJECT LIFECYCLE pairs -- `mtx_init`/`mtx_destroy`,
//   `pthread_rwlock_init`/`pthread_rwlock_destroy`, `pthread_attr_init`,
//   `pthread_key_create` -- open an obligation to destroy an object the caller
//   owns in place; v1 cannot state it, and a neutral declaration would erase
//   it. `call_once` invokes a caller-supplied function (`pthread_once` is
//   declared at the end of this module with a synchronous invocation, card
//   CG22-CALLBACK-REGISTRY-CONTRACT; `call_once`, which librdkafka's
//   `rdkafka.c` calls and `tinycthread.c` may define, is not declared here;
//   recorded in the card report).
//   `pthread_setspecific` RETAINS its
//   pointer argument past the call, and `pthread_getspecific` returns that
//   retained pointer -- an alias this vocabulary cannot state. (Card
//   LIBC-GAP-DECLARATIONS declares both at the end of this module: the
//   retention as C04.14's `global` holder, and the result as owning nothing.)
//   (`cnd_timedwait`, `pthread_sigmask` spell `T *__restrict p`, which this
//   card's reader withdrew; card W43-LIBC-RESTRICT-PROTOTYPES declares both at
//   the end of this module.)
//
// ## What no declaration here says
//
// Nothing about mutual exclusion, lock ordering, deadlock, spurious wake-ups,
// timeouts, cancellation, signal delivery, or which data a lock protects.
// QCore's checked-concurrency model (constraint 27) is untouched. Per-call
// custody statements about the CALLER's obligations, and nothing more.

extern fn mtx_lock(mutex: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(mutex);
    ensures normal resource_return_none();
};

extern fn mtx_unlock(mutex: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(mutex);
    ensures normal resource_return_none();
};

