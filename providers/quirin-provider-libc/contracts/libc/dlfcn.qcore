module contract;

// <dlfcn.h> -- resource-projection vocabulary version 1.
//
// Card W43-LIBC-CONTRACTS. TRUSTED ASSUMPTIONS about the C library (trust
// boundary 28); no libc body is analysed. Read from the prototypes the
// analysed units declare (`/usr/include/dlfcn.h` on the audited host):
//
//   extern char *dlerror (void) __THROW;
//
// ## The custody statements
//
// `dlerror` returns a pointer to a message in storage the library owns and
// reuses; the caller must not free it, and it aliases no argument (there is
// none). The caller acquires NO obligation, which is
// exactly `resource_return_none()` -- the `__errno_location` /
// `flb_input_chunk_get_name` precedent for a pointer result that carries no
// custody. The gateway binds no identity to such a result.
//
// ## Deliberately NOT declared here (recorded in the card report)
//
//   `dlopen`/`dlclose` open and close a handle: a v1 owned/released pair would
//   put the handle in the one kind-less pointer class `malloc`/`free` use.
//   (`dlsym` spells `T *__restrict p`, which this card's reader withdrew;
//   card W43-LIBC-RESTRICT-PROTOTYPES declares it at the end of this module,
//   with the reading of its result.)
//
// ## What no declaration here says
//
// Nothing about the lifetime of the `dlerror` message (the next call may
// overwrite it). Per-call custody statements about the CALLER's
// obligations, and nothing more.

extern fn dlerror() -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_return_none();
};

// ## Card W43-LIBC-RESTRICT-PROTOTYPES: `dlsym`
//
//   extern void *dlsym (void *__restrict __handle,
//                       const char *__restrict __name) __THROW __nonnull ((2));
//
// `dlsym` looks a symbol up and returns its ADDRESS inside an object the
// dynamic loader mapped (or NULL). Why `resource_return_none()` is exact:
//
//   * it is not fresh custody: nothing is allocated for the caller, and no
//     release function applies to a symbol address (freeing it is undefined);
//   * it is not derived from an argument: it points into neither `__name`'s
//     string nor any object `__handle` points to as a C object -- the handle
//     is opaque, and the pseudo-handles `RTLD_DEFAULT`/`RTLD_NEXT` point to
//     nothing at all;
//   * so the caller acquires no obligation, which is the `dlerror` /
//     `gai_strerror` / `__errno_location` precedent for a pointer result
//     carrying no custody. The gateway binds no identity to it.
//
// Both parameters are read and retained by nothing the caller owns:
// `resource_borrowed`. TRUSTED ASSUMPTION; the `__restrict` spellings are read
// by the declared-ABI reader since card W43-LIBC-RESULT-ALIAS.
//
// NOT stated: the symbol's lifetime ends at the `dlclose` of the handle that
// found it. A use after that is invisible to this declaration. It cannot make
// a verdict `Safe` in the pinned corpus today, because `dlopen`/`dlclose` stay
// undeclared (`W43-LIBC-DESCRIPTOR-LIFECYCLE`), so any function that closes a
// handle keeps an uncontracted call. A handle-lifecycle card that declares
// `dlclose` must revisit this result.

extern fn dlsym(handle: ptr<mut, u8>, name: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(handle);
    ensures normal resource_borrowed(name);
    ensures normal resource_return_none();
};
