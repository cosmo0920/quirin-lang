    requires resource_revision(flexible);
    ensures normal resource_borrowed(ecode);
    ensures normal resource_return_none();
};

// ## Card W43-LIBC-RESTRICT-PROTOTYPES: `getsockopt` and `getpeername`
//
//   extern int getsockopt (int __fd, int __level, int __optname,
//                          void *__restrict __optval,
//                          socklen_t *__restrict __optlen) __THROW;
//   extern int getpeername (int __fd, __SOCKADDR_ARG __addr,
//                           socklen_t *__restrict __len) __THROW;
//
// Each USES an existing descriptor and writes through out-pointers into caller
// storage: the kernel copies the option value (at most `*__optlen` bytes) or
// the peer address into the caller's buffer and updates the caller's length.
// These are value copies of scalars and records, never a pointer the caller
// would own: no custody moves, nothing is allocated, freed or retained, and
// neither out-pointer is a pointer-to-pointer (`W43-LIBC-OUT-POINTER-ALIAS`'s
// shape does not arise). So every parameter is `resource_borrowed` and the
// `int` result is `resource_return_none()`. TRUSTED ASSUMPTIONS.
//
// `__SOCKADDR_ARG` is `struct sockaddr *__restrict` without `_GNU_SOURCE`,
// and the declared-ABI reader reads it there. Under `_GNU_SOURCE` it is a
// transparent union of `struct sockaddr_* *__restrict` members, which the
// reader does not read, so the gate withdraws `getpeername` in those units
// (`abi-unreadable-declaration`; card W43-LIBC-RESTRICT-PROTOTYPES measured 12
// agreeing units and 93 withdrawing, including the one pinned call site's
// `mk_socket.c`). Reading the union is `W43-LIBC-ABI-READER-SHAPES`, with
// `bind`/`connect`. Nothing here says anything about connection state,
// option semantics, truncation or `errno`.

extern fn getsockopt(fd: i32, level: i32, optname: i32, optval: ptr<mut, u8>, optlen: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(level);
    ensures normal resource_borrowed(optname);
    ensures normal resource_borrowed(optval);
    ensures normal resource_borrowed(optlen);
    ensures normal resource_return_none();
};

extern fn getpeername(fd: i32, addr: ptr<mut, u8>, len: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(addr);
    ensures normal resource_borrowed(len);
    ensures normal resource_return_none();
};

// ## Descriptors (Card W43-DESCRIPTOR-RESOURCE-TRACKING)
//
// A TRUSTED ASSUMPTION, read from the prototype the analysed units declare:
//
//   extern int socket (int __domain, int __type, int __protocol) __THROW;
//
// `socket` returns a fresh descriptor or the sentinel `-1`
// (`resource_return_owned(sentinel)` of the `descriptor` kind, contract spec
// §C04.6); its three arguments are scalars. `close` (in `libc/unistd.qcore`)
// releases it. The descriptor-using calls above (`setsockopt`, `send`,
// `recv`, `listen`, `sendfile`) borrow a descriptor: a tracked one handed to
// them is a use, and a use after its `close` is a violation candidate.
//
// ## Deliberately NOT declared (recorded in the card report)
//
//   `accept4` takes `__SOCKADDR_ARG`, a transparent union under
//   `_GNU_SOURCE`: the declared-ABI census withdraws it in all 93 units that
//   declare it (`abi-unreadable-declaration`), so it decides nothing.
//   `accept` likewise. `getaddrinfo`'s list is valid exactly when the call
//   returns `0`, which needs a status witness bound to the out slot; a
//   `nullable` out slot would misstate the failure arm, and `freeaddrinfo`
//   without its acquisition decides nothing. `socketpair` writes an `int[2]`.

extern fn socket(domain: i32, kind: i32, protocol: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(domain);
    ensures normal resource_borrowed(kind);
    ensures normal resource_borrowed(protocol);
    ensures normal resource_return_owned(sentinel);
    ensures normal resource_return_kind(descriptor);
};

// ## Card LIBC-GAP-DECLARATIONS: `shutdown`, `sendmsg` and `poll`
//
// TRUSTED ASSUMPTIONS (trust boundary 28), read from the prototypes on the
// audited host (`/usr/include/x86_64-linux-gnu/sys/socket.h:174-175`,
// `:324`; `sys/poll.h:54-55`):
//
//   extern ssize_t sendmsg (int __fd, const struct msghdr *__message,
//                           int __flags);
//   extern int shutdown (int __fd, int __how) __THROW;
//   extern int poll (struct pollfd *__fds, nfds_t __nfds, int __timeout)
//     __fortified_attr_access (__write_only__, 1, 2);
//
// `nfds_t` is `unsigned long int` (`u64`).
//
// * `shutdown` disables further sends and/or receives on a socket (POSIX
//   shutdown()). It does NOT close the descriptor: `close` still releases it.
//   So it is a use, like `send` above.
// * `sendmsg` sends the data the caller's `msghdr` describes (POSIX
//   sendmsg()). The kernel copies it and retains no caller pointer. Any
//   descriptors the caller passes as `SCM_RIGHTS` ancillary data are
//   duplicated into the receiver, so the sender's descriptors stay open and
//   stay the sender's.
// * `poll` reads the `pollfd` array and writes each entry's `revents`
//   (POSIX poll()). The descriptors in it are read as data, never created or
//   closed.
//
// Each is `resource_borrowed` on every parameter and
// `resource_return_none()`.
//
// Deliberately NOT declared: `recvmsg`. With an `SCM_RIGHTS` control
// buffer it CREATES descriptors in the caller (Linux unix(7)), which no
// declaration here could state, and a neutral one would erase their
// obligation. `accept`, `accept4` and the two address-taking calls above
// stay undeclared for the transparent-union reader gap
// (W43-LIBC-GETPEERNAME-SOCKADDR-UNION).

extern fn shutdown(fd: i32, how: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(how);
    ensures normal resource_return_none();
};

extern fn sendmsg(fd: i32, message: ptr<const, u8>, flags: i32) -> isize
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fd);
    ensures normal resource_borrowed(message);
    ensures normal resource_borrowed(flags);
    ensures normal resource_return_none();
};

extern fn poll(fds: ptr<mut, u8>, nfds: u64, timeout: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    ensures normal resource_borrowed(fds);
    ensures normal resource_borrowed(nfds);
    ensures normal resource_borrowed(timeout);
    ensures normal resource_return_none();
};
