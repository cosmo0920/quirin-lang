extern fn cfl_kvlist_insert_double(list: ptr<mut, u8>, key: ptr<mut, u8>, value: f64) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(list);
    ensures normal resource_borrowed(key);
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
