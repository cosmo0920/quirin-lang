module contract;

// CFL dynamic-string release — resource-projection vocabulary version 1.
//
// Card W36-CORPUS-CONTRACTS-3. ONE TRUSTED ASSUMPTION about one upstream
// function. This module verifies nothing: the C body is not analyzed by this
// loader, and a declaration is a premise. Any verdict that rests on it is a
// verdict RELATIVE TO this declaration, never a proof of the C implementation.
//
// Every citation below was read from the pinned checkout
// (`build/cycle19/fluent-bit-clang-source`) at Fluent Bit
// 66910c10a4d7eafa810b84229cf2dcf7b0f26f97 on this card's own run.
//
// ## Why this callee
//
// `cfl_sds_destroy` is the highest function-cover callee in the baseline: of
// the 193 projected functions whose ONLY refusals are `call to uncontracted
// function` leaves, 13 name it and **8 name nothing else**, so one declaration
// decides every leaf those eight hold. All eight are one-statement encoder
// destructors in cmetrics and ctraces, e.g.
// (`lib/cmetrics/src/cmt_encode_text.c:697-700`)
//
//     void cmt_encode_text_destroy(cfl_sds_t text)
//     {
//         cfl_sds_destroy(text);
//     }
//
// ## `cfl_sds_destroy`, read from `lib/cfl/src/cfl_sds.c:249-275`
//
//     void cfl_sds_destroy(cfl_sds_t s)
//     {
//         struct cfl_sds *head;
//         struct cfl_sds_arena_header *arena_head;
//
//         if (!s) {
//             return;
//         }
//
//         head = CFL_SDS_HEADER(s);
//         if ((head->alloc & CFL_SDS_ARENA_FLAG) == 0) {
//             free(head);
//         }
//         else {
//             arena_head = sds_arena_header(head);
//             if (arena_head->external) {
//                 cfl_arena_free_external(arena_head->arena, arena_head);
//             }
//             else if (arena_head->allocation_class != 0) {
//                 cfl_arena_free_sds(
//                     arena_head->arena, arena_head,
//                     arena_head->allocation_class,
//                     sizeof(struct cfl_sds_arena_header) + CFL_SDS_HEADER_SIZE +
//                     cfl_sds_alloc(s) + 1);
//             }
//         }
//     }
//
//   * `s` is the ONLY parameter. On every path that does anything, the storage
//     `s` addresses stops being the caller's: the non-arena arm calls
//     `free(head)` outright, and both arena arms return the block to its arena
//     (`cfl_arena_free_external`, `cfl_arena_free_sds`). After the call the
//     caller may not read, write or release `s` again on any path. That is what
//     `resource_released` says.
//   * The FIRST statement is `if (!s) { return; }`, so a null argument is
//     tolerated and is not a defect at any call site. The nullability marker is
//     therefore `nullable` — the same reading, on the same ground (a leading
//     null guard in the body), that card WAVE23-C-OPERATIONS gave
//     `flb_input_chunk_destroy_direct_routes`, whose already-declared
//     neighbour `flb_input_chunk_destroy` carries `nonnull` because its body
//     has no such guard.
//   * The result is `void`, so `resource_return_none()` is the faithful — and
//     the only faithful — result mode.
//
// ## The interior-pointer offset, stated rather than hidden
//
// `s` is NOT the address `free` receives: `CFL_SDS_HEADER(s)` steps back to the
// allocation base and `free(head)` releases THAT. The declaration is
// nonetheless faithful at the abstraction the resource projection works in,
// because the identity the caller holds is the one `cfl_sds_create` and its
// siblings RETURN, which is the interior pointer `s`. Acquisition and release
// are stated in the same coordinate. The header offset is internal to CFL and
// is not modeled here; nothing in this declaration says the released address
// equals `s`.
//
// ## ABI and modes (constraint 8)
//
// `lib/cfl/include/cfl/cfl_sds.h:74` declares
//
//     void cfl_sds_destroy(cfl_sds_t s);
//
// and `lib/cfl/include/cfl/cfl_sds.h:32` declares `typedef char *cfl_sds_t;`.
// So the one parameter is exactly one object-pointer level — `ptr<mut, u8>` —
// and the result is `void`, spelled `unit`. The declared arity is one, which
// is the arity every analysed call site writes; the C declaration is not
// variadic, so no `resource_variadic_data_tail()` is declared.
//
// ## No W4 interaction
//
// `cfl_sds_destroy` is DEFINED in `lib/cfl/src/cfl_sds.c`, which is not one of
// the 185 audited units — the corpus's libraries are cmetrics, ctraces,
// librdkafka, chunkio, fluent-bit-chunk and monkey-libevent, and CFL is not
// among them. No unit therefore derives a W4 summary for this callee, so
// constraint 8's duty gate has nothing to compare and the declaration cannot be
// withdrawn for disagreement with an inferred summary. This is the cleanest of
// the card's six cases, and it is the reason this one was chosen first.
//
// ## NOT CLAIMED
//
//   * Nothing about the CFL arena itself — `cfl_arena_free_external` and
//     `cfl_arena_free_sds` are not declared, modeled or claimed here, and no
//     arena is a tracked resource in this projection.
//   * Nothing about whether the body is correct, whether `s` was produced by a
//     CFL constructor, or whether the arena flag is read correctly.
//   * Nothing about double release: passing an already-released `s` is a
//     use-after-free this declaration neither creates nor detects. The
//     gateway's own liveness precondition is what refuses that, on settled
//     denotations, and it is unchanged here.
//   * Nothing about thread safety or ordering.

// --- the CFL dynamic string's release --------------------------------------
extern fn cfl_sds_destroy(s: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(s, nullable);
    ensures normal resource_return_none();
};

// ## Card W46-EXTERNAL-CALLEE-CONTRACTS: `cfl_sds_len`
//
// ONE TRUSTED ASSUMPTION, pinned (contract spec C06.2) after reading the body
// at both audited revisions (identical at `66910c10` and `046accf6`). With
// `mpack_write_bin` (`mpack/writer.qcore`) it is the last uncontracted call of
// `pack_bytes` (`lib/ctraces/src/ctr_encode_msgpack.c:88-96`); its other five
// call sites sit in functions with other blockers.
//
// ## The body, read from `lib/cfl/src/cfl_sds.c:193-200`
//
//     size_t cfl_sds_len(cfl_sds_t s)
//     {
//         if (s == NULL) {
//             return 0;
//         }
//
//         return (size_t) CFL_SDS_HEADER(s)->len;
//     }
//
// It reads the length field of the string's header (a null string reads as
// length zero) and returns it. It allocates, frees, stores and transfers
// nothing: `s` is `resource_borrowed` and the `size_t` result is
// `resource_return_none()`.
//
// ## ABI (constraint 8)
//
// `lib/cfl/include/cfl/cfl_sds.h:69` declares `size_t cfl_sds_len(cfl_sds_t s);`
// with `typedef char *cfl_sds_t;` (`:32`): one object-pointer level,
// `ptr<mut, u8>`, and `size_t` is `usize` under LP64. `lib/cfl/src/cfl_sds.c`
// is not an analysed unit, so no body is checked against this declaration.
//
// NOT CLAIMED: that `s` addresses a live CFL string (the gateway's own
// borrowed-liveness precondition decides that at each call site), or anything
// about the header's contents.

// --- the CFL dynamic string's length ----------------------------------------
extern fn cfl_sds_len(s: ptr<mut, u8>) -> usize
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(s);
    ensures normal resource_return_none();
};

// ## Card W47-CALLEE-CLOSURE-R2: `cfl_arena_calloc`
//
// ONE TRUSTED ASSUMPTION, pinned (contract spec C06.2) after reading the body
// at both audited revisions (identical at `66910c10` and `046accf6`; one copy
// in the tree). After P3 it is the last uncontracted call of
// `initialize_attribute_list` and `initialize_summary_value_at_quantile_list`
// (`lib/cmetrics/src/cmt_encode_opentelemetry.c:2000-2011`, `:2230-2241`),
// which bind its result and return it; its other eleven call sites sit in
// functions with other blockers. It sits in this module because the crate's
// only other resource-view module is `cfl/time.qv`, and `cfl/arena_lifetime.qv`
// is not a v1 resource module (one declaration does not justify a new
// resource-view module).
//
// ## The body, read from `lib/cfl/src/cfl_arena.c:354-371`
//
//     void *cfl_arena_calloc(struct cfl_arena *arena,
//                            size_t count, size_t size)
//     {
//         void *result;
//         size_t total;
//
//         if (count != 0 && size > SIZE_MAX / count) {
//             return NULL;
//         }
//
//         total = count * size;
//         result = cfl_arena_malloc(arena, total);
//         if (result != NULL) {
//             memset(result, 0, total);
//         }
//
//         return result;
//     }
//
// `cfl_arena_malloc` (`:279-347`) returns NULL for a NULL arena or a zero
// size, otherwise a pointer into the data of a chunk the arena owns: an
// existing chunk (`&chunk->data[offset]`) or a new one it allocates with the
// arena's own allocator and links into `arena->head` (NULL when that fails).
// The header (`lib/cfl/include/cfl/cfl_arena.h:42-46`) states the contract:
// raw allocations "cannot be freed individually and remain valid until reset
// or destruction", and a zero-sized or overflowing request returns NULL.
//
// ## Custody
//
//   * `arena` is `resource_borrowed`: the call hands the caller no custody of
//     the arena and takes none from it (the arena's chunk list grows, which is
//     the arena's own state, as a writer's buffer is the writer's).
//   * `count` and `size` are scalars.
//   * The result is `resource_return_interior(arena, nullable)`. It acquires,
//     discharges and transfers nothing (rule 1 of C04.3.1); releasing it is
//     not a release of the arena and is an invalid free (rule 2: the value was
//     never returned by the C allocator); releasing the arena invalidates it
//     (rule 3: `cfl_arena_destroy` frees every chunk); its nullness is its own
//     (rule 4: NULL for overflow, zero size or a failed chunk allocation,
//     whatever the arena is). The extent is read as *the storage the arena
//     object owns*, not the bytes of `struct cfl_arena` itself: the chunks are
//     separate allocations reached from it, destroyed with it. That is the
//     reading every consumer rule above applies, and it is the only v1 result
//     mode that keeps the result's dependence on the arena:
//     `resource_return_none()` would forget it, and card W47-CALLEE-CLOSURE-R2
//     measured that it then admits a use of the result after its base is
//     released as `Safe`.
//
// ## ABI (constraint 8)
//
// `struct cfl_arena *` is one object-pointer level, `ptr<mut, u8>`; `size_t`
// is `usize` under LP64; `void *` is `ptr<mut, u8>`. `lib/cfl/src/cfl_arena.c`
// is not an analysed unit, so no body is checked against this declaration.
//
// NOT CLAIMED: anything about `cfl_arena_reset` (which also invalidates the
// result without releasing the arena; it is undeclared, so a caller of it is
// refused), the arena's allocator callbacks, alignment, or the zeroing.

// --- a zeroed allocation inside a CFL arena -----------------------------------
extern fn cfl_arena_calloc(arena: ptr<mut, u8>, count: usize, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(arena);
    ensures normal resource_borrowed(count);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_interior(arena, nullable);
};

// ## Card W45-CALLEE-CASCADE-RESIDUAL: the kvlist count and four copying
// ## inserts
//
// FIVE TRUSTED ASSUMPTIONS, pinned (contract spec C06.2) after reading each
// body at both audited revisions (`lib/cfl/src/cfl_kvlist.c`,
// `cfl_variant.c` and `cfl_container.c` are byte-identical at `66910c10` and
// `046accf6`). They sit in this module, the crate's one resource-view module
// besides `time.qv`, because one new kvlist module would add a selected
// module for five declarations.
//
// `cfl_kvlist_count` is the only uncontracted call of `ctr_attributes_count`
// (`lib/ctraces/src/ctr_attributes.c:49-52`) and of `get_attributes_count`
// (`ctr_encode_opentelemetry.c`). Each insert is the only uncontracted call of
// the ctraces setter of its type (`ctr_attributes_set_string`, `_int64`,
// `_bool`, `_double`, `ctr_attributes.c:54-76`), which the ctraces crate now
// declares on this reading (`ctraces/context_lifetime.qv`).
//
// ## `cfl_kvlist_count`, read from `cfl_kvlist.c:698-705`
//
// `if (list == NULL) return 0; return cfl_list_size(&list->list);` — a count
// of the list's links.
//
// ## The inserts, read from `cfl_kvlist.c:561-578`, `:601-639` and the `_s`
// ## forms at `:162-188`, `:245-351`
//
// Each NULL-tests `list` and `key` (and `value` for the string), takes
// `strlen(key)` and calls its `_s` form, which:
//
//   1. creates a NEW variant in `list->arena` holding a COPY of the value:
//      `cfl_variant_create_from_string_s_in(..., referenced = CFL_FALSE)`
//      copies the string with `cfl_sds_create_len_in` (`cfl_variant.c:437-473`);
//      the int64, bool and double forms store the scalar
//      (`:497-547`);
//   2. calls `cfl_kvlist_insert_s` (`:439-496`), which allocates a pair, COPIES
//      `key` with `cfl_sds_create_len_in`, moves the new variant into the list
//      (`cfl_container_move_variant_to_kvlist`, `cfl_container.c:526-575`) and
//      links the pair into `list->list`; on any failure it frees what it
//      allocated, and the `_s` form destroys the new variant and returns -2.
//
// So every new allocation is owned by `list` (released by
// `cfl_kvlist_destroy`), the caller's `key` and value are copied and never
// retained, and nothing the caller owns changes hands.
//
// ## NOT the array, kvlist, reference or bytes inserts
//
// `cfl_kvlist_insert_array`/`_kvlist` wrap the caller's container in a variant
// that the list takes on success (and give back on failure), and
// `cfl_kvlist_insert_reference`/`_bytes(..., referenced)` keep the caller's
// pointer: custody-taking or retaining readings, left to the user
// (W48-CALLEE-DECISION-TABLE). They are not declared.
//
// ## Custody and ABI (constraint 8)
//
// Every pointer formal `resource_borrowed`, every scalar `resource_borrowed`,
// every result an `int`: `resource_return_none()`. Prototypes
// `include/cfl/cfl_kvlist.h:66-101` agree with the definitions:
// `struct cfl_kvlist *` and `char *` are `ptr<mut, u8>`, `int` `i32`,
// `int64_t` `i64`, `double` `f64`.
//
// NOT CLAIMED: a duplicate key (the insert appends; lookups find the first),
// the arena's capacity, or the list's contents.

// --- the number of pairs in a kvlist ----------------------------------------
extern fn cfl_kvlist_count(list: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(list);
    ensures normal resource_return_none();
};

// --- copying inserts ---------------------------------------------------------
extern fn cfl_kvlist_insert_string(list: ptr<mut, u8>, key: ptr<mut, u8>, value: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(list);
    ensures normal resource_borrowed(key);
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
};

extern fn cfl_kvlist_insert_bool(list: ptr<mut, u8>, key: ptr<mut, u8>, value: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(list);
    ensures normal resource_borrowed(key);
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
};

extern fn cfl_kvlist_insert_int64(list: ptr<mut, u8>, key: ptr<mut, u8>, value: i64) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(list);
    ensures normal resource_borrowed(key);
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
