module contract;

// Upstream source: include/cfl/cfl_list.h
// Audited mechanism: intrusive-list insertion and removal.

resource type CflListEntry {
    repr: ptr<mut, u8>;
    footprint: { list_entries = 1 };
    destructor: cfl_list_entry_destroy noexcept;
    copy: forbidden;
    move: allowed;
}

extern fn cfl_list_add(
    entry: own<CflListEntry> use one,
    list: borrow<'list, mut, CflListEntry> use one
) -> unit
contract {
    quant condition entry #r094(#entry: object, #env: environment, #member: predicate<environment, object, object>) = forall (#list: object) { !(#member(#env,#list,#entry)) };
    ensures normal entry_has_list_custody;
    ensures normal previous_and_next_links_are_consistent;
    quant any live_resources == old(live_resources);
};

extern fn cfl_list_del(
    entry: own<CflListEntry> use one
) -> own<CflListEntry>
contract {
    quant condition entry #r090(#entry: object, #env: environment, #member: predicate<environment, object, object>, #owns: predicate<environment, object, object>) = exists (#list: object) { ((#member(#env,#list,#entry) && #owns(#env,#list,#entry)) && forall (#other: object) { (#member(#env,#other,#entry) => (#other == #list)) }) };
    ensures normal entry_has_local_custody;
    ensures normal entry_previous_is_null;
    ensures normal entry_next_is_null;
    quant any live_resources == old(live_resources);
};

// W48-CMT-TRACKED-INTERIOR-SELF-INIT, gateway rule 36b.
// Declared model of the checked initializer effect, matching
// QCore.TrackedSelfInit / QCore.TrackedSelfInitDisjointFrame and shared vectors.
// This is not resource_contract_v1 and grants no ordinary call summary.
// Every call still needs fresh complete CG11 body/layout evidence; a function
// name or this declaration alone cannot establish any of these preconditions.
// `list` denotes the root or an embedded record, whose storage ends with its
// owning root. The optional nondefault frame preserves existing child slots
// only under source-sealed same-owner layout proofs; different resource IDs
// supply no physical separation or allocator-freshness premise. Other possible
// member facts are forgotten. No empty-list, membership, new child custody or
// self-pointer postcondition is exported. Declined frame probes restore evidence.
// In the audited CFL body the retained leaf fields are next and prev; the
// effect records the actual checked set rather than assuming those names.
extern fn cfl_list_init(
    list: borrow<'owner, mut, CflListEntry> use one
) -> unit
contract {
    quant condition entry #r055(#body_op: predicate<source, declaration, operation>, #complete_body: predicate<source, declaration>, #decl: declaration, #self_store: predicate<source, declaration, operation>, #source: source, #unit_exit: predicate<source, declaration, operation>) = (#complete_body(#source,#decl) && forall (#op: operation) { (#body_op(#source,#decl,#op) => (#self_store(#source,#decl,#op) || #unit_exit(#source,#decl,#op))) });
    quant condition entry #r084(#body_decl: function<source, declaration>, #call: activation, #call_signature: function<activation, signature>, #callee_decl: function<activation, declaration>, #decl: declaration, #decl_signature: function<declaration, signature>, #source: source) = (((#callee_decl(#call) == #decl) && (#body_decl(#source) == #decl)) && (#call_signature(#call) == #decl_signature(#decl)));
    quant condition entry #r001(#actual: object, #embedded: predicate<environment, object, path, object>, #env: environment, #path: path, #root: object) = ((#actual == #root) || #embedded(#env,#root,#path,#actual));
    quant condition entry #r089(#ordinary_field: predicate<source, path_step>, #path: path, #path_length: function<path, integer>, #path_step: predicate<path, path_step>, #source: source) = (((#path_length(#path) >= 0) && (#path_length(#path) <= 3)) && forall (#step: path_step) { (#path_step(#path,#step) => #ordinary_field(#source,#step)) });
    quant condition entry #r130(#array_step: predicate<source, path_step>, #cast_step: predicate<source, path_step>, #path: path, #path_step: predicate<path, path_step>, #pointer_load: predicate<source, path_step>, #qualified_step: predicate<source, path_step>, #source: source, #union_step: predicate<source, path_step>) = forall (#step: path_step) { (#path_step(#path,#step) => ((((!(#pointer_load(#source,#step)) && !(#array_step(#source,#step))) && !(#cast_step(#source,#step))) && !(#union_step(#source,#step))) && !(#qualified_step(#source,#step)))) };
    quant condition entry #r187(#complete_layout: predicate<source, declaration, layout>, #env: environment, #layout: layout, #layout_compatible: predicate<environment, object, layout>, #root: object, #root_decl: predicate<source, object, declaration>, #source: source, #root_declaration: declaration) = (((#root_decl(#source,#root,#root_declaration) && forall (#other_decl: declaration) { (#root_decl(#source,#root,#other_decl) => (#root_declaration == #other_decl)) }) && #complete_layout(#source,#root_declaration,#layout)) && #layout_compatible(#env,#root,#layout));
    quant condition entry #r166(#env: environment, #null: object, #owner: object, #root: object, #unknown: predicate<environment, object>, #points_to: predicate<environment, object, object>) = (((!(#unknown(#env,#root)) && !((#root == #null))) && #points_to(#env,#root,#owner)) && forall (#target: object) { (#points_to(#env,#root,#target) => (#target == #owner)) });
    quant condition entry #r167(#env: environment, #ledger: function<environment, object, integer>, #nullable: predicate<environment, object>, #owner: object) = ((#ledger(#env,#owner) == 1) && !(#nullable(#env,#owner)));
    quant condition entry #r072(#assignment: predicate<source, operation>, #body_op: predicate<source, declaration, operation>, #call_effect: predicate<environment, activation, effect>, #caller_custody: predicate<environment, place>, #custody_change: predicate<effect>, #decl: declaration, #env: environment, #instantiated_write: predicate<source, path, interval>, #interval_start: function<interval, integer>, #interval_stop: function<interval, integer>, #ledger: function<environment, object, integer>, #link_owner: function<link, object>, #linked_child: predicate<environment, object, object>, #nondefault: predicate<environment>, #nullable: predicate<environment, object>, #ordinary_contract: predicate<environment, activation>, #out_slot: predicate<environment, place>, #owner: object, #partial_link: predicate<environment, link>, #path: path, #precise_heap: predicate<environment, object>, #protected_slot: predicate<environment, interval>, #recognized: predicate<environment, place>, #slot_address: predicate<source, operation>, #source: source, #target: predicate<environment, object, object>, #type_compatible: predicate<source, object, object>, #typed_assignment: predicate<source, operation>, #unknown: predicate<environment, object>, #field_link: predicate<environment, link>, #existing_place: predicate<environment, place>, #body_call: predicate<source, declaration, activation>) = ((forall (#link: link) { !(#field_link(#env,#link)) } && forall (#place: place) { !(#caller_custody(#env,#place)) }) || (((((((#nondefault(#env) && (#nondefault(#env) => ((((#ledger(#env,#owner) == 1) && !(#nullable(#env,#owner))) && #precise_heap(#env,#owner)) && forall (#child: object) { (#linked_child(#env,#owner,#child) => (((!((#child == #owner)) && (#ledger(#env,#child) == 1)) && !(#nullable(#env,#child))) && #precise_heap(#env,#child))) }))) && (#nondefault(#env) => (forall (#link: link) { (#field_link(#env,#link) => (#link_owner(#link) == #owner)) } && forall (#link: link) { (#partial_link(#env,#link) => #field_link(#env,#link)) }))) && (#nondefault(#env) => forall (#place: place) { (#existing_place(#env,#place) => ((!(#caller_custody(#env,#place)) && !(#out_slot(#env,#place))) && #recognized(#env,#place))) })) && (#nondefault(#env) => forall (#op: operation) { (#body_op(#source,#decl,#op) => ((#assignment(#source,#op) => #typed_assignment(#source,#op)) && !(#slot_address(#source,#op)))) })) && (#nondefault(#env) => forall (#nested_call: activation) { (#body_call(#source,#decl,#nested_call) => (#ordinary_contract(#env,#nested_call) && forall (#effect: effect) { (#call_effect(#env,#nested_call,#effect) => !(#custody_change(#effect))) })) })) && (#nondefault(#env) => forall (#slot: interval) { (#protected_slot(#env,#slot) => ((#interval_start(#slot) < #interval_stop(#slot)) && forall (#write: interval) { (#instantiated_write(#source,#path,#write) => ((#interval_stop(#slot) <= #interval_start(#write)) || (#interval_stop(#write) <= #interval_start(#slot)))) })) })) && (#nondefault(#env) => forall (#alias: object) { (#target(#env,#alias,#owner) => (!(#unknown(#env,#alias)) && #type_compatible(#source,#alias,#owner))) })));
    quant condition entry #r190(#env: environment, #fact_target: predicate<environment, fact, object>, #fact_unknown: predicate<environment, fact>, #owner: object, #owner_rooted: predicate<environment, fact, object>, #protected: predicate<environment, fact>, #member_fact: predicate<environment, fact>) = forall (#fact: fact) { (((#member_fact(#env,#fact) && #owner_rooted(#env,#fact,#owner)) && !(#protected(#env,#fact))) => (!(#fact_unknown(#env,#fact)) && forall (#target: object) { (#fact_target(#env,#fact,#target) => (#target == #owner)) })) };
    quant condition entry #r134(#env: environment, #ledger: function<environment, object, integer>, #linked_child: predicate<environment, object, object>, #nondefault: predicate<environment>, #nullable: predicate<environment, object>, #owner: object, #precise_heap: predicate<environment, object>) = (#nondefault(#env) => ((((#ledger(#env,#owner) == 1) && !(#nullable(#env,#owner))) && #precise_heap(#env,#owner)) && forall (#child: object) { (#linked_child(#env,#owner,#child) => (((!((#child == #owner)) && (#ledger(#env,#child) == 1)) && !(#nullable(#env,#child))) && #precise_heap(#env,#child))) }));
    quant condition entry #r136(#env: environment, #link_owner: function<link, object>, #nondefault: predicate<environment>, #owner: object, #partial_link: predicate<environment, link>, #field_link: predicate<environment, link>) = (#nondefault(#env) => (forall (#link: link) { (#field_link(#env,#link) => (#link_owner(#link) == #owner)) } && forall (#link: link) { (#partial_link(#env,#link) => #field_link(#env,#link)) }));
    quant condition entry #r135(#caller_custody: predicate<environment, place>, #env: environment, #nondefault: predicate<environment>, #out_slot: predicate<environment, place>, #recognized: predicate<environment, place>, #existing_place: predicate<environment, place>) = (#nondefault(#env) => forall (#place: place) { (#existing_place(#env,#place) => ((!(#caller_custody(#env,#place)) && !(#out_slot(#env,#place))) && #recognized(#env,#place))) });
    quant condition entry #r133(#assignment: predicate<source, operation>, #body_op: predicate<source, declaration, operation>, #decl: declaration, #env: environment, #nondefault: predicate<environment>, #slot_address: predicate<source, operation>, #source: source, #typed_assignment: predicate<source, operation>) = (#nondefault(#env) => forall (#op: operation) { (#body_op(#source,#decl,#op) => ((#assignment(#source,#op) => #typed_assignment(#source,#op)) && !(#slot_address(#source,#op)))) });
    quant condition entry #r132(#call_effect: predicate<environment, activation, effect>, #custody_change: predicate<effect>, #decl: declaration, #env: environment, #nondefault: predicate<environment>, #ordinary_contract: predicate<environment, activation>, #source: source, #body_call: predicate<source, declaration, activation>) = (#nondefault(#env) => forall (#nested_call: activation) { (#body_call(#source,#decl,#nested_call) => (#ordinary_contract(#env,#nested_call) && forall (#effect: effect) { (#call_effect(#env,#nested_call,#effect) => !(#custody_change(#effect))) })) });
    quant condition entry #r138(#env: environment, #instantiated_write: predicate<source, path, interval>, #interval_start: function<interval, integer>, #interval_stop: function<interval, integer>, #nondefault: predicate<environment>, #path: path, #protected_slot: predicate<environment, interval>, #source: source) = (#nondefault(#env) => forall (#slot: interval) { (#protected_slot(#env,#slot) => ((#interval_start(#slot) < #interval_stop(#slot)) && forall (#write: interval) { (#instantiated_write(#source,#path,#write) => ((#interval_stop(#slot) <= #interval_start(#write)) || (#interval_stop(#write) <= #interval_start(#slot)))) })) });
    quant condition entry #r137(#env: environment, #nondefault: predicate<environment>, #owner: object, #source: source, #target: predicate<environment, object, object>, #type_compatible: predicate<source, object, object>, #unknown: predicate<environment, object>) = (#nondefault(#env) => forall (#alias: object) { (#target(#env,#alias,#owner) => (!(#unknown(#env,#alias)) && #type_compatible(#source,#alias,#owner))) });
    quant condition entry #r112(#call: activation, #diagnostic_count: function<environment, activation, integer>, #entry_state: function<environment, abstract_state>, #env: environment, #probe_state: function<environment, activation, abstract_state>) = ((#diagnostic_count(#env,#call) == 0) && (#probe_state(#env,#call) == #entry_state(#env)));
    ensures normal instantiated_leaf_self_write_paths_are_recorded;
    ensures normal only_existing_layout_proved_owner_child_slot_pointer_facts_may_survive;
    ensures normal plain_and_derived_alias_bindings_are_preserved;
    ensures normal all_resource_status_and_nullable_site_facts_are_preserved;
    ensures normal no_resource_child_link_or_owning_alias_is_created;
    ensures normal no_empty_list_membership_or_ordinary_summary_is_exported;
    ensures normal all_field_links_and_partial_links_are_preserved;
    ensures normal all_other_possible_member_pointer_facts_are_forgotten_conservatively;
    ensures normal declined_optional_probes_restore_reading_and_contract_consultation_state;
    quant any live_resources == old(live_resources);
};
