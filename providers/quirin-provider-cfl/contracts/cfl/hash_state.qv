module contract;

// Source-audited declared model for cfl_hash.h at Fluent Bit
// 66910c10a4d7eafa810b84229cf2dcf7b0f26f97. The names are aliases of the
// vendored XXH3 streaming API. This file has no resource_contract_v1 marker and
// grants no interpreted call permission. In particular, digest is not assumed
// nonzero: the NUL-free byte sequence 42 d5 68 e1 38 d7 27 ff hashes to zero
// under the pinned default secret and short-input mixer.

resource type CflHashState {
    repr: ptr<mut, u8>;
    footprint: { hash_states = 1 };
    destructor: cfl_hash_state_retire noexcept;
    copy: forbidden;
    move: allowed;
}

extern fn cfl_hash_64bits_reset(state: borrow<'state, mut, CflHashState> use one) -> i32
contract {
    quant condition entry #r176(#env: environment, #hash_state_type: type, #live: predicate<environment, object>, #null: object, #state: object, #writable: predicate<environment, object, type>) = ((!((#state == #null)) && #live(#env,#state)) && #writable(#env,#state,#hash_state_type));
    quant condition normal #reset_zero(#result: integer, #after: state, #target: object, #initialized: predicate<state,object>, #secret: function<state,object,secret>, #default_secret: secret, #stream: function<state,object,stream>, #empty: stream) = ((#result == 0) => ((#initialized(#after,#target) && #secret(#after,#target) == #default_secret) && #stream(#after,#target) == #empty));
    // A nonzero reset result supplies no initialized-state guarantee.
    quant condition normal #reset_custody(#call: activation, #caller: predicate<activation,object>, #event_of: predicate<activation,event>, #consumes: predicate<event,object>) = forall (#resource: object) { (#caller(#call,#resource) => forall (#event: event) { (#event_of(#call,#event) => !#consumes(#event,#resource)) }) };
};

extern fn cfl_hash_64bits_update(state: borrow<'state, mut, CflHashState> use one,
                                 input: ptr<const, u8>, len: usize) -> i32
contract {
    quant condition entry #r175(#call: activation, #env: environment, #latest_reset: predicate<trace, activation, object, event>, #live: predicate<environment, object>, #reset_event: predicate<trace, object, event>, #result: function<trace, event, integer>, #state: object, #trace: trace) = (#live(#env,#state) && exists (#reset: event) { ((#reset_event(#trace,#state,#reset) && (#result(#trace,#reset) == 0)) && #latest_reset(#trace,#call,#state,#reset)) });
    quant condition entry #r120(#env: environment, #input: object, #length: integer, #readable_byte: predicate<environment, object, integer>) = ((#length == 0) || ((#length > 0) && forall (#i: integer) { (((#i >= 0) && (#i < #length)) => #readable_byte(#env,#input,#i)) }));
    quant condition entry #r119(#env: environment, #input: object, #start: function<environment, object, integer>, #state: object, #stop: function<environment, object, integer>) = ((#stop(#env,#input) <= #start(#env,#state)) || (#stop(#env,#state) <= #start(#env,#input)));
    quant condition normal #update_zero(#result: integer, #before: state, #after: state, #target: object, #input: object, #length: integer, #stream: function<state,object,stream>, #bytes: function<state,object,integer,stream>, #append: function<stream,stream,stream>) = ((#result == 0) => #stream(#after,#target) == #append(#stream(#before,#target),#bytes(#before,#input,#length)));
    // A nonzero update result supplies no digest/progress guarantee.
    quant condition normal #update_custody(#call: activation, #input: object, #caller: predicate<activation,object>, #event_of: predicate<activation,event>, #consumes: predicate<event,object>) = forall (#resource: object) { ((#resource == #input || #caller(#call,#resource)) => forall (#event: event) { (#event_of(#call,#event) => !#consumes(#event,#resource)) }) };
};

extern fn cfl_hash_64bits_digest(state: borrow<'state, const, CflHashState> use one) -> u64
contract {
    quant condition entry #r175(#call: activation, #env: environment, #latest_reset: predicate<trace, activation, object, event>, #live: predicate<environment, object>, #reset_event: predicate<trace, object, event>, #result: function<trace, event, integer>, #state: object, #trace: trace) = (#live(#env,#state) && exists (#reset: event) { ((#reset_event(#trace,#state,#reset) && (#result(#trace,#reset) == 0)) && #latest_reset(#trace,#call,#state,#reset)) });
    quant condition entry #r095(#event_index: function<trace, event, integer>, #prior_successful_bytes: function<trace, object, event, integer>, #state: object, #stream_offset: function<trace, event, integer>, #successful_update: predicate<trace, object, event>, #trace: trace, #update_length: function<trace, event, integer>) = (forall (#left: event) { forall (#right: event) { (((#successful_update(#trace,#state,#left) && #successful_update(#trace,#state,#right)) && (#event_index(#trace,#left) < #event_index(#trace,#right))) => ((#stream_offset(#trace,#left) + #update_length(#trace,#left)) <= #stream_offset(#trace,#right))) } } && forall (#event: event) { (#successful_update(#trace,#state,#event) => (#stream_offset(#trace,#event) == #prior_successful_bytes(#trace,#state,#event))) });
    quant condition entry #r162(#algorithm: function<environment, object, algorithm>, #default_secret: secret, #env: environment, #implementation_sha: digest, #pinned_implementation_sha: digest, #secret: function<environment, object, secret>, #state: object, #xxh3_64: algorithm) = (((#algorithm(#env,#state) == #xxh3_64) && (#secret(#env,#state) == #default_secret)) && (#implementation_sha == #pinned_implementation_sha));
    quant condition normal #digest_value(#result: integer, #before: state, #target: object, #stream: function<state,object,stream>, #xxh3: function<stream,integer>) = #result == #xxh3(#stream(#before,#target));
    // The pinned nonempty NUL-free zero-digest witness above forbids a nonzero-result assumption.
    quant condition normal #digest_custody(#call: activation, #target: object, #caller: predicate<activation,object>, #event_of: predicate<activation,event>, #consumes: predicate<event,object>) = forall (#resource: object) { ((#resource == #target || #caller(#call,#resource)) => forall (#event: event) { (#event_of(#call,#event) => !#consumes(#event,#resource)) }) };
};
