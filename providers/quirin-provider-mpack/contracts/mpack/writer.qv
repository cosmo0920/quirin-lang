// ## Tag accessors (`mpack.h`)
//
// `mpack_tag_type` (`:1629-1631`), `mpack_tag_int_value` (`:1658-1661`),
// `mpack_tag_uint_value` (`:1676-1679`), `mpack_tag_double_value`
// (`:1708-1711`), `mpack_tag_array_count` (`:1721-1724`),
// `mpack_tag_map_count` (`:1734-1737`), `mpack_tag_str_length`
// (`:1747-1750`) and `mpack_tag_bin_length` (`:1760-1763`) are `MPACK_INLINE`
// definitions. Each reads one field of the caller's `mpack_tag_t` (an
// assertion of the tag's type compiles out without `MPACK_DEBUG`) and
// returns it by value. The amalgamation copies (`:2273`, `:2302`, `:2320`,
// `:2377`, `:2390`, `:2403`, `:2416`) are the same; it has no
// `mpack_tag_double_value`. `tag` is `resource_borrowed`. Each result is a
// scalar, `resource_return_none()`. `mpack_type_t` has no negative constant
// (`:1406-1427`), so it is `u32`.
//
// LEFT UNDECLARED: `mpack_read_tag` and `mpack_peek_tag` (`mpack.c:2992-3033`,
// `:3035-3048`) return an `mpack_tag_t` structure by value. v1's result
// vocabulary is scalars, pointers and `unit` (C04.1). Follow-up:
// `MPACK-STRUCT-RESULT-BY-VALUE`.

extern fn mpack_tag_type(tag: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(tag);
    ensures normal resource_return_none();
};

