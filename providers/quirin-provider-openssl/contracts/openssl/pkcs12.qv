module contract;

// Card OPENSSL-PROVIDER-REMAINING-CALLEES. PKCS#12 structures (see err.qv
// for what every declaration of this crate shares). PKCS12 is not reference
// counted (no page gives it an up_ref), so its decoder returns a fresh
// object and its free is a final release.

// d2i_PKCS12_bio: https://docs.openssl.org/1.1.1/man3/d2i_X509/ (also 3.5;
// the 1.0.2 page does not document it). No HISTORY entry names it.
// DESCRIPTION (3.5): d2i_TYPE_bio() "is similar to d2i_TYPE() except it
// attempts to parse data from BIO bp"; "If either a or *a is NULL, then
// fresh storage is allocated for the returned object"; RETURN VALUES: "a
// valid TYPE structure or NULL if an error occurs". With a non-NULL `p12`
// the call may reuse or free the caller's `*p12`, so the declaration holds
// only at calls passing a null pointer constant there (C04.5). Pinned
// prototype: `PKCS12 *d2i_PKCS12_bio(BIO *bp, PKCS12 **p12)`
// (openssl/pkcs12.h). Card OPENSSL-BIO-READER-INVOCATIONS: it parses data
// "from BIO bp", so it runs what a read through a BIO runs (bio_slots.qv):
// the BIO's callback ("called during most high-level BIO operations",
// BIO_set_callback 3.5) and the functions of its method table ("in response
// to" the operation each implements, BIO_meth_new 3.5). As in pem.qv, all
// 14 slots are stated on `bp` with every actual `_`, beside the
// library-value premise `openssl_builtin_bio_methods` (C04.18) and beside
// the `p12` premise (C04.5 "Beside a slot invocation", gateway rule 57
// amended).
// Card OPENSSL-EX-DATA-REGISTRY: a safe in public-key integrity mode is a
// signed PKCS#7 whose certificates are decoded as X509 objects (freed again
// on a failed parse).
// Card OPENSSL-INNER-FREES-SILENT-METHOD-CALLBACKS: a failed parse frees the partial object: a signed PKCS#7 safe's
// certificates, their public keys and its CRLs (tasn_dec.c, 3.5.5): the
// unstated-slots premise in the statement of a free names what those frees run.
// Card OPENSSL-FREE-REMAINING-INDIRECT-CALLBACKS: the key it frees inside
// runs the teardown slots whose setters are declared now (teardown_slots.qv),
// which the free statement no longer covers, so they are stated through the
// borrowed formal at position 0 (the key is run-wide), beside
// `openssl_builtin_teardown_functions` and `openssl_loaded_module_functions`.
extern fn d2i_PKCS12_bio(bp: ptr<mut, u8>, p12: ptr<mut, ptr<mut, u8>>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_literal_argument(p12, 0);
    requires resource_premise(openssl_builtin_bio_methods,
        quant all #b in #chain(#of(BIO, #args) | #bios(#of(SSL, #args))): #method(#b) in #builtin
        -> #fns(#b) |-> #inert
        && quant all #f in #fns(#b): #in_turn(#f, #ssl_of(#b) \ #args) |-> #inert);
    requires resource_premise(openssl_unstated_callback_slots,
        quant all #o in #freed: #teardown(#o) \ (#stated | #settable) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    requires resource_premise(openssl_builtin_teardown_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #library
        -> #f |-> #inert);
    requires resource_premise(openssl_loaded_module_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #loaded
        -> #f |-> #inert);
    ensures normal resource_borrowed(bp);
    ensures normal resource_borrowed(p12);
    ensures normal resource_callback_slot_invoked(bp, bio_st.bio_callback_ex, _, _, supplied_nullable, _, _, _, _, supplied_nullable);
    ensures normal resource_callback_slot_invoked(bp, bio_st.bio_callback, _, _, supplied_nullable, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_write_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_write, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_read_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_read, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_puts, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_gets, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_ctrl, _, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_create, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_destroy, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_callback_ctrl, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_sendmmsg, _, _, _, _, _, _);
    ensures normal resource_callback_slot_invoked(bp, bio_method_st.meth_recvmmsg, _, _, _, _, _, _);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_callback_slot_invoked(bp, dh_method.dh_meth_finish, _);
    ensures normal resource_callback_slot_invoked(bp, dsa_method.dsa_meth_finish, _);
    ensures normal resource_callback_slot_invoked(bp, ec_key_method_st.ec_key_meth_finish, _);
    ensures normal resource_callback_slot_invoked(bp, engine_st.engine_destroy, _);
    ensures normal resource_callback_slot_invoked(bp, engine_st.engine_finish, _);
    ensures normal resource_callback_slot_invoked(bp, engine_st.engine_pkey_asn1_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(bp, engine_st.engine_pkey_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(bp, evp_pkey_asn1_method_st.asn1_meth_pkey_free, _);
    ensures normal resource_callback_slot_invoked(bp, rsa_meth_st.rsa_meth_finish, _);
};

// PKCS12_free: https://docs.openssl.org/1.1.1/man3/X509_dup/ (also 3.5; no
// page at 1.0.2). HISTORY (3.5) names other TYPEs only. DESCRIPTION (3.5):
// "TYPE_free() releases the object and all pointers and sub-objects within
// it. If the argument is NULL, nothing is done." Pinned prototype: `void
// PKCS12_free(PKCS12 *a)` (through DECLARE_ASN1_FUNCTIONS).
// Card OPENSSL-EX-DATA-REGISTRY: it frees the certificates a signed PKCS#7
// safe holds.
// Card OPENSSL-OBJECT-FREES-SILENT-METHOD-CALLBACKS: freeing the PKCS#7 safes
// frees their certificates' keys, signer info keys and CRLs (pk7_asn1.c and
// x_crl.c 3.5.5), and so runs those keys' provider, method and engine
// functions and a CRL's X509_CRL_METHOD free: the unstated-slots premise of a
// free names them.
// Card OPENSSL-FREE-REMAINING-INDIRECT-CALLBACKS: the free releases its
// argument, so it can state none of the teardown slots of the keys it frees
// in turn (C04.19.3 reads a slot through a borrowed parameter); it names the
// free statement through a released argument, beside the two teardown
// premises. A CRL's X509_CRL_METHOD free function is left too.
extern fn PKCS12_free(a: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    requires resource_premise(openssl_builtin_teardown_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #library
        -> #f |-> #inert);
    requires resource_premise(openssl_loaded_module_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #loaded
        -> #f |-> #inert);
    requires resource_premise(openssl_unstated_callback_slots,
        quant all #o in #freed: #teardown(#o) \ #stated |-> #inert);
    ensures normal resource_released(a, nullable);
    ensures normal resource_return_none();
};
