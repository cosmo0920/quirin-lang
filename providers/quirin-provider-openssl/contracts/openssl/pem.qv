module contract;

// Card OPENSSL-PROVIDER-REMAINING-CALLEES. Reading PEM objects from a BIO
// (see err.qv for what every declaration of this crate shares).
//
// https://docs.openssl.org/1.0.2/man3/pem/ documents both functions (3.5,
// 1.1.1: man3/PEM_read_bio_PrivateKey); HISTORY names neither, so the bound
// is the oldest series checked. What the 3.5 page states, PEM FUNCTION
// ARGUMENTS:
//
// * `x`: "If x is NULL then the parameter is ignored"; otherwise the result
//   is written to `*x`, or the structure at `*x` is reused. The reuse arm
//   hands a caller's object to the call, so each declaration holds only at
//   calls passing a null pointer constant there (C04.5's premise); every
//   other call stays uncontracted.
// * `cb`: "the callback to use when querying for the pass phrase", called
//   during the read with `u` ("The u parameter has the same value as the u
//   parameter passed to the PEM routine"); the pem_password_cb prototype is
//   `int (char *buf, int size, int rwflag, void *u)`, and `buf`, `size` and
//   `rwflag` are the routine's own values. Card OPENSSL-PEM-CALLBACK-ARM
//   states it as a synchronous invocation with a null default (C04.19)
//   beside the `x` premise (C04.5, gateway rule 57):
//   `resource_callback_invoked_or_default(cb, _, _, _, u)`. Nothing keeps
//   `cb` or `u` after the call. A non-null `cb` is decided as C04.19
//   requires: every candidate's own contract in force must be the identity,
//   so no callback is read as benign. A null `cb` invokes no caller
//   function: "If the cb parameters is set to NULL and the u parameter is
//   not NULL then the u parameter is interpreted as a NUL terminated string
//   to use as the passphrase. If both cb and u are NULL then the default
//   callback routine is used", OpenSSL's own; either way `u` is read, not
//   kept, which `resource_borrowed(u)` states.
// * RETURN VALUES: "The read routines return either a pointer to the
//   structure read or NULL if an error occurred." X509 and EVP_PKEY are
//   reference counted (X509_new, EVP_PKEY_new), so the result is one
//   returned reference, which X509_free / EVP_PKEY_free drops.
// * `out`: both are the BIO forms of the PEM read routines, so each reads
//   the PEM text through the caller's BIO. Card OPENSSL-BIO-READER-INVOCATIONS
//   states what a read through a BIO runs (bio_slots.qv): its callback,
//   "called during most high-level BIO operations" (BIO_set_callback, 3.5),
//   `bio_st.bio_callback_ex` and `bio_st.bio_callback`, and the functions of
//   its method table, each called "in response to" the BIO operation it
//   implements (BIO_meth_new, 3.5), the twelve `bio_method_st.meth_*` keys.
//   The page does not say which BIO operations a read performs, and a filter
//   BIO forwards operations down its chain, so all 14 slots are stated on
//   `out` exactly as the SSL I/O calls state them (ssl_io.qv). Each is
//   handed `out` or a BIO chained to it, so every actual is `_`, which
//   refuses every candidate that is not the identity there. A method the
//   library defines itself is in no run's set and is the library-value
//   premise `openssl_builtin_bio_methods` (C04.18). The invocations stand
//   beside the `x` premise as C04.5 "Beside a slot invocation" admits
//   (gateway rule 57 amended): a call outside the premise is undeclared, so
//   no slot is decided there.

// PEM_read_bio_X509. Pinned prototype: `X509 *PEM_read_bio_X509(BIO *out,
// X509 **x, pem_password_cb *cb, void *u)` (openssl/pem.h).
// Card OPENSSL-EX-DATA-REGISTRY: it allocates the X509 it returns (and frees
// it on a failed read).
// Card OPENSSL-INNER-FREES-SILENT-METHOD-CALLBACKS: a failed decode frees the partial certificate and the public
// key it decoded (tasn_dec.c, x509_pubkey_ex_free, 3.5.5): the
// unstated-slots premise in the statement of a free names what those frees run.
extern fn PEM_read_bio_X509(out: ptr<mut, u8>, x: ptr<mut, ptr<mut, u8>>, cb: fnptr, u: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_literal_argument(x, 0);
    requires resource_premise(openssl_builtin_bio_methods,
        quant all #b in #chain(#of(BIO, #args) | #bios(#of(SSL, #args))): #method(#b) in #builtin
        -> #fns(#b) |-> #inert
        && quant all #f in #fns(#b): #in_turn(#f, #ssl_of(#b) \ #args) |-> #inert);
    requires resource_premise(openssl_unstated_callback_slots,
        quant all #o in #freed: #teardown(#o) \ (#stated | #settable) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(out);
    ensures normal resource_borrowed(x);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(u);
    ensures normal resource_callback_invoked_or_default(cb, _, _, _, u);
    ensures normal resource_callback_slot_invoked(out, bio_st.bio_callback_ex, _, _, supplied_nullable, _, _, _, _, supplied_nullable);
    ensures normal resource_callback_slot_invoked(out, bio_st.bio_callback, _, _, supplied_nullable, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_write_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_write, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_read_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_read, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_puts, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_gets, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_ctrl, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_create, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_destroy, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_callback_ctrl, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_sendmmsg, _, _, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_recvmmsg, _, _, _, _, _, _);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(reference);
};

// PEM_read_bio_PrivateKey. Pinned prototype: `EVP_PKEY
// *PEM_read_bio_PrivateKey(BIO *out, EVP_PKEY **x, pem_password_cb *cb, void
// *u)`.
// Card OPENSSL-EX-DATA-REGISTRY: it allocates the EVP_PKEY it returns (and
// frees it on a failed read).
// Card OPENSSL-INNER-FREES-SILENT-METHOD-CALLBACKS: a failed read frees the key it built (a decoded key lacking
// the selected components, a failed legacy decode) and the decoder context
// (crypto/pem/pem_pkey.c 3.5.5): the
// unstated-slots premise in the statement of a free names what those frees run.
extern fn PEM_read_bio_PrivateKey(out: ptr<mut, u8>, x: ptr<mut, ptr<mut, u8>>, cb: fnptr, u: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_literal_argument(x, 0);
    requires resource_premise(openssl_builtin_bio_methods,
        quant all #b in #chain(#of(BIO, #args) | #bios(#of(SSL, #args))): #method(#b) in #builtin
        -> #fns(#b) |-> #inert
        && quant all #f in #fns(#b): #in_turn(#f, #ssl_of(#b) \ #args) |-> #inert);
    requires resource_premise(openssl_unstated_callback_slots,
        quant all #o in #freed: #teardown(#o) \ (#stated | #settable) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(out);
    ensures normal resource_borrowed(x);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(u);
    ensures normal resource_callback_invoked_or_default(cb, _, _, _, u);
    ensures normal resource_callback_slot_invoked(out, bio_st.bio_callback_ex, _, _, supplied_nullable, _, _, _, _, supplied_nullable);
    ensures normal resource_callback_slot_invoked(out, bio_st.bio_callback, _, _, supplied_nullable, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_write_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_write, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_read_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_read, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_puts, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_gets, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_ctrl, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_create, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_destroy, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_callback_ctrl, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_sendmmsg, _, _, _, _, _, _);
    ensures normal resource_callback_slot_invoked(out, bio_method_st.meth_recvmmsg, _, _, _, _, _, _);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(reference);
};
