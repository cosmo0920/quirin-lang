module contract;

// Card OPENSSL-PROVIDER-REMAINING-CALLEES. Configuring an SSL_CTX (see
// err.qv for what every declaration of this crate shares; ssl_io.qv for the
// callback slots). Not declared here, each fail-closed: SSL_CTX_ctrl (its
// custody depends on `cmd`: SSL_CTX_add_extra_chain_cert hands the context
// the caller's certificate) and SSL_CTX_use_cert_and_key (the page states the
// custody of the key only, not of the certificate or the chain).
//
// Card OPENSSL-SSL-CTX-CALLBACK-SLOTS. An SSL_CTX carries several callback
// slots. SSL_CTX is opaque (`typedef struct ssl_ctx_st SSL_CTX;` in
// openssl/types.h), so a slot is stated as one of an opaque record
// (C04.19.3, `resource_callback_slot_registered` /
// `resource_callback_slot_invoked`, rule 12n): its writers are exactly its
// declared setters, the run's candidates every function those setters are
// handed. Two slots are stated: the password callback
// (`ssl_ctx_st.default_passwd_cb`) and the certificate callback
// (`ssl_ctx_st.cert_cb`, see ssl_io.qv for the SSL's copy). Every other slot
// a call may run is named by the premise `openssl_unstated_callback_slots`
// where the call may run it.
//
// Card OPENSSL-UNSTATED-CALLBACK-SLOTS. Eight more slots are stated, each
// with every writer its 3.5 page names declared (the SSL's setters in
// ssl_io.qv): the verify, info, message and security callbacks
// (`ssl_ctx_st.verify_callback`, `.info_callback`, `.msg_callback`,
// `.sec_cb`), the three session callbacks (`.new_session_cb`,
// `.remove_session_cb`, `.get_session_cb`) and the client certificate
// callback (`.client_cert_cb`). Not declared, each fail-closed: the
// SSL_CTX_callback_ctrl and SSL_CTX_ctrl command arms (the servername,
// status and ticket key callbacks, card OPENSSL-CTRL-COMMAND-ARMS) and the
// `*_arg` / security ex_data setters, which keep a pointer for a callback
// (a retention this crate does not state).

// SSL_CTX_set_options: https://docs.openssl.org/3.5/man3/SSL_CTX_set_options/
// HISTORY (3.5): "The SSL_OP_ constants and the corresponding parameter and
// return values of the affected functions were changed to uint64_t type in
// OpenSSL 3.0", so the pinned prototype holds since 3.0.0. It adds option
// bits to `ctx`. Pinned prototype: `uint64_t SSL_CTX_set_options(SSL_CTX
// *ctx, uint64_t op)` (openssl/ssl.h).
extern fn SSL_CTX_set_options(ctx: ptr<mut, u8>, op: u64) -> u64
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "3.0.0");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(op);
    ensures normal resource_return_none();
};

// SSL_CTX_set_default_verify_paths: https://docs.openssl.org/1.1.1/man3/SSL_CTX_load_verify_locations/
// (also 3.5; the 1.0.2 page does not document it). No HISTORY entry.
// DESCRIPTION (3.5): it "specifies that the default locations from which CA
// certificates are loaded should be used"; RETURN VALUES: "1 on success or 0
// on failure". Pinned prototype: `int
// SSL_CTX_set_default_verify_paths(SSL_CTX *ctx)`.
// Card OPENSSL-EX-DATA-REGISTRY: the default file lookup reads certificates
// (new X509 objects) and frees each one the store already holds.
extern fn SSL_CTX_set_default_verify_paths(ctx: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_return_none();
};

// SSL_CTX_load_verify_locations: https://docs.openssl.org/1.0.2/man3/SSL_CTX_load_verify_locations/
// (also 3.5, 1.1.1). No HISTORY entry. DESCRIPTION (3.5): it "specifies the
// locations for ctx, at which CA certificates for verification purposes are
// located"; NOTES: "The CAfile is processed on execution of the
// SSL_CTX_load_verify_locations() function". The paths are read, not kept.
// Pinned prototype: `int SSL_CTX_load_verify_locations(SSL_CTX *ctx, const
// char *CAfile, const char *CApath)`.
// Card OPENSSL-EX-DATA-REGISTRY: CAfile is read on execution: new X509
// objects, each freed when the store already holds it.
extern fn SSL_CTX_load_verify_locations(ctx: ptr<mut, u8>, CAfile: ptr<const, u8>, CApath: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(CAfile);
    ensures normal resource_borrowed(CApath);
    ensures normal resource_return_none();
};

// SSL_CTX_use_certificate: https://docs.openssl.org/1.0.2/man3/SSL_CTX_use_certificate/
// (also 3.5, 1.1.1). HISTORY (1.0.2) names only DER key support in the
// *_file functions (0.9.8). DESCRIPTION (3.5): it "loads the certificate x
// into ctx"; "On success the reference counter of the x is incremented."
// The context takes its own reference; the caller's is unchanged, so `x` is
// borrowed (as SSL_new's `ctx` is). Card OPENSSL-UNSTATED-CALLBACK-SLOTS:
// the call consults the context's security callback on `x`
// (SSL_CTX_set_security_level, 3.5: "Attempts to set certificates or
// parameters with insufficient security are also blocked. For example
// trying to set a certificate using a 512 bit RSA key ... using
// SSL_CTX_use_certificate()"), a check originating from the context: `s`
// NULL (a value the callee supplies), `ctx` the context, and `other` "the
// X509 certificate" (SSL_SECOP_EE_KEY, SSL_SECOP_CA_KEY). Until this card
// the declaration read that callback silently. Pinned prototype: `int
// SSL_CTX_use_certificate(SSL_CTX *ctx, X509 *x)`.
// Card OPENSSL-EX-DATA-REGISTRY: the certificate it replaces is freed (its
// last reference may be the context's), and a private key that does not match
// the new certificate is freed.
extern fn SSL_CTX_use_certificate(ctx: ptr<mut, u8>, x: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(x);
    ensures normal resource_callback_slot_invoked(ctx, ssl_ctx_st.sec_cb, supplied_nullable, ctx, _, _, _, x, supplied_nullable);
    ensures normal resource_return_none();
};

// SSL_CTX_use_PrivateKey: same page. DESCRIPTION (3.5): it "adds pkey as
// private key to ctx"; "On success the reference counter of the pkey / rsa
// is incremented." `pkey` is borrowed as `x` is above. Pinned prototype:
// `int SSL_CTX_use_PrivateKey(SSL_CTX *ctx, EVP_PKEY *pkey)`.
// Card OPENSSL-EX-DATA-REGISTRY: the key it replaces is freed, and a
// certificate that does not match the new key is freed.
extern fn SSL_CTX_use_PrivateKey(ctx: ptr<mut, u8>, pkey: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(pkey);
    ensures normal resource_return_none();
};

// SSL_CTX_use_PrivateKey_file: same page. DESCRIPTION (3.5): it "adds the
// first private key found in file to ctx"; NOTES: "In order to successfully
// load encrypted keys, a function returning the passphrase must have been
// supplied, see SSL_CTX_set_default_passwd_cb", so the call may run the
// context's password callback (SSL_CTX_set_default_passwd_cb page, 3.5: "the
// default password callback called when loading/storing a PEM certificate
// with encryption"), with a buffer, its size, the read/write flag and the
// context's userdata (`pem_password_cb(char *buf, int size, int rwflag, void
// *u)`): four values the callee supplies. No page names another callback the
// call runs (card OPENSSL-SSL-CTX-CALLBACK-SLOTS: the registered-callbacks
// premise is replaced by this stated invocation). Pinned prototype: `int
// SSL_CTX_use_PrivateKey_file(SSL_CTX *ctx, const char *file, int type)`.
// Card OPENSSL-EX-DATA-REGISTRY: it reads a key into a new EVP_PKEY, frees it
// after use, and replaces the context's key.
extern fn SSL_CTX_use_PrivateKey_file(ctx: ptr<mut, u8>, file: ptr<const, u8>, filetype: i32) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(filetype);
    ensures normal resource_callback_slot_invoked(ctx, ssl_ctx_st.default_passwd_cb, _, _, _, _);
    ensures normal resource_return_none();
};

// SSL_CTX_use_certificate_chain_file: same page. DESCRIPTION (3.5): it
// "loads a certificate chain from file into ctx"; NOTES: "Certificate files
// might be encrypted as well", and the password callback is "called when
// loading/storing a PEM certificate with encryption" (SSL_CTX_set_default_passwd_cb,
// 3.5): the stated invocation, as for SSL_CTX_use_PrivateKey_file. Card
// OPENSSL-SSL-CTX-CALLBACK-SLOTS: the call also sets certificates, which the
// security callback is consulted on (SSL_CTX_set_security_level, 3.5:
// "Attempts to set certificates or parameters with insufficient security
// are also blocked"; the callback "is consulted whenever the library needs to
// decide whether an algorithm, key, parameter or protocol version meets the
// configured security level"). Card OPENSSL-UNSTATED-CALLBACK-SLOTS: its
// setters (SSL_CTX_set_security_callback, SSL_set_security_callback) are now
// declared, so the invocation is stated: a check originating from the
// context (`s` NULL, `ctx` the context, `other` a certificate the call read
// from the file, a value the callee supplies). Every slot the call may run is
// then stated, and `openssl_unstated_callback_slots` is dropped. What it
// still may run unstated is the ex_data registry (CRYPTO_get_ex_new_index,
// 3.5: "new_func() is called when a structure is initially allocated (such
// as RSA_new())", "When a structure is free'd ... then the free_func() is
// called for every defined index"; the call creates certificates and frees
// the chain it replaces), a global registry per object class, not a slot of
// the context: named by the narrower premise `openssl_ex_data_callbacks`
// (C04.18). Pinned prototype: `int SSL_CTX_use_certificate_chain_file(SSL_CTX
// *ctx, const char *file)`.
extern fn SSL_CTX_use_certificate_chain_file(ctx: ptr<mut, u8>, file: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(file);
    ensures normal resource_callback_slot_invoked(ctx, ssl_ctx_st.default_passwd_cb, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ctx, ssl_ctx_st.sec_cb, supplied_nullable, ctx, _, _, _, supplied_nullable, supplied_nullable);
    ensures normal resource_return_none();
};

// SSL_CTX_get_cert_store: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_cert_store/
// (also 3.5, 1.1.1). No HISTORY entry. DESCRIPTION (3.5): it "returns a
// pointer to the current certificate verification storage"; NOTES: to share
// it with a second SSL_CTX, "use SSL_CTX_get_cert_store() to get the
// X509_STORE from the first SSL_CTX, and then use SSL_CTX_set1_cert_store()
// to assign to the second SSL_CTX and increment the reference count", so the
// getter takes no reference: the store stays the context's. A borrowed
// result of `ctx`. Pinned prototype: `X509_STORE
// *SSL_CTX_get_cert_store(const SSL_CTX *)`.
extern fn SSL_CTX_get_cert_store(ctx: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_return_borrowed_from(ctx, nullable);
};

// SSL_CTX_set_default_passwd_cb_userdata: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_default_passwd_cb/
// (also 3.5, 1.1.1). HISTORY (3.5) names only the getters and the SSL_*
// setters (1.1.0). DESCRIPTION (3.5): it "sets a pointer to userdata, u,
// which will be provided to the password callback on invocation": the
// context keeps `u` (C04.14); the caller keeps custody of `u`'s object and
// must show it outlives the context. Pinned prototype: `void
// SSL_CTX_set_default_passwd_cb_userdata(SSL_CTX *ctx, void *u)`.
extern fn SSL_CTX_set_default_passwd_cb_userdata(ctx: ptr<mut, u8>, u: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(u);
    ensures normal resource_retained_by(u, ctx);
    ensures normal resource_return_none();
};

// SSL_CTX_set_default_passwd_cb: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_default_passwd_cb/
// (also 3.5, 1.1.1). HISTORY (3.5) names only the getters and the SSL_*
// setters (1.1.0). DESCRIPTION (3.5): it "sets the default password callback
// called when loading/storing a PEM certificate with encryption"; the SSL_*
// setters "perform the same function as their SSL_CTX counterparts, but
// using an SSL object", so they write the SSL's copy, which no declaration
// here invokes: the context's slot has this one writer. A registration into
// the opaque context's password slot (card OPENSSL-SSL-CTX-CALLBACK-SLOTS,
// C04.19.3). Pinned prototype: `void SSL_CTX_set_default_passwd_cb(SSL_CTX
// *ctx, pem_password_cb *cb)`.
extern fn SSL_CTX_set_default_passwd_cb(ctx: ptr<mut, u8>, cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.default_passwd_cb, cb);
    ensures normal resource_return_none();
};

// SSL_CTX_set_cert_cb: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_cert_cb/
// (also 3.5, 1.1.1). No HISTORY entry. NAME (3.5, 1.0.2):
// "SSL_CTX_set_cert_cb, SSL_set_cert_cb - handle certificate callback
// function": the slot's two writers, both declared. DESCRIPTION (3.5): they
// set "the cert_cb callback, arg value is pointer which is passed to the
// application callback"; "When cert_cb is NULL, no callback function is
// used". The context keeps `arg` for the callback (C04.14); the caller keeps
// custody of its object. A registration into the certificate slot (card
// OPENSSL-SSL-CTX-CALLBACK-SLOTS). Pinned prototype: `void
// SSL_CTX_set_cert_cb(SSL_CTX *c, int (*cb)(SSL *ssl, void *arg), void
// *arg)`.
extern fn SSL_CTX_set_cert_cb(c: ptr<mut, u8>, cert_cb: fnptr, arg: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(c);
    ensures normal resource_borrowed(cert_cb);
    ensures normal resource_borrowed(arg);
    ensures normal resource_callback_slot_registered(c, ssl_ctx_st.cert_cb, cert_cb);
    ensures normal resource_retained_by(arg, c);
    ensures normal resource_return_none();
};

// SSL_CTX_set_verify: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_verify/
// (also 3.5, 1.1.1). HISTORY (3.5, 1.1.1) names only the post-handshake
// functions (1.1.1), so the bound is the oldest series that documents it.
// NAME (3.5) names the slot's two writers, SSL_CTX_set_verify and
// SSL_set_verify (ssl_io.qv). DESCRIPTION (3.5): it "sets the verification
// flags for ctx to be mode and specifies the verify_callback function to be
// used. If no callback function shall be specified, the NULL pointer can be
// used". A registration into the verify slot (card
// OPENSSL-UNSTATED-CALLBACK-SLOTS, C04.19.3). Pinned prototype: `void
// SSL_CTX_set_verify(SSL_CTX *ctx, int mode, SSL_verify_cb callback)`, with
// `typedef int (*SSL_verify_cb)(int preverify_ok, X509_STORE_CTX
// *x509_ctx)`.
extern fn SSL_CTX_set_verify(ctx: ptr<mut, u8>, mode: i32, verify_callback: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(mode);
    ensures normal resource_borrowed(verify_callback);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.verify_callback, verify_callback);
    ensures normal resource_return_none();
};

// SSL_CTX_set_info_callback: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_info_callback/
// (also 3.5, 1.1.1). No HISTORY entry. NAME (3.5): the writers
// SSL_CTX_set_info_callback and SSL_set_info_callback (ssl_io.qv).
// DESCRIPTION (3.5): it "sets the callback function, that can be used to
// obtain state information for SSL objects created from ctx during
// connection setup and use"; "When callback is NULL, no callback function
// is used." A registration into the info slot. Pinned prototype: `void
// SSL_CTX_set_info_callback(SSL_CTX *ctx, void (*cb)(const SSL *ssl, int
// type, int val))`.
extern fn SSL_CTX_set_info_callback(ctx: ptr<mut, u8>, cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.info_callback, cb);
    ensures normal resource_return_none();
};

// SSL_CTX_set_msg_callback: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_msg_callback/
// (also 3.5, 1.1.1). HISTORY (1.0.2): "SSL_CTX_set_msg_callback(),
// SSL_CTX_set_msg_callback_arg(), SSL_set_msg_callback() and
// SSL_get_msg_callback_arg() were added in OpenSSL 0.9.7." NAME (3.5): the
// writers SSL_CTX_set_msg_callback and SSL_set_msg_callback (ssl_io.qv);
// the context's settings "will be copied to new SSL objects by SSL_new";
// "Using a NULL pointer for cb disables the message callback." A
// registration into the message slot. Pinned prototype: `void
// SSL_CTX_set_msg_callback(SSL_CTX *ctx, void (*cb)(int write_p, int
// version, int content_type, const void *buf, size_t len, SSL *ssl, void
// *arg))`.
extern fn SSL_CTX_set_msg_callback(ctx: ptr<mut, u8>, cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "0.9.7");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.msg_callback, cb);
    ensures normal resource_return_none();
};

// SSL_CTX_set_security_callback: https://docs.openssl.org/3.5/man3/SSL_CTX_set_security_level/
// HISTORY (3.5, 1.1.1): "These functions were added in OpenSSL 1.1.0." (no
// page at 1.0.2). NAME (3.5): the writers SSL_CTX_set_security_callback and
// SSL_set_security_callback (ssl_io.qv); "If not set a default security
// callback is used." A registration into the security slot. Pinned
// prototype: `void SSL_CTX_set_security_callback(SSL_CTX *ctx, int
// (*cb)(const SSL *s, const SSL_CTX *ctx, int op, int bits, int nid, void
// *other, void *ex))`.
extern fn SSL_CTX_set_security_callback(ctx: ptr<mut, u8>, cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.0");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.sec_cb, cb);
    ensures normal resource_return_none();
};

// SSL_CTX_sess_set_new_cb: https://docs.openssl.org/1.0.2/man3/SSL_CTX_sess_set_get_cb/
// (also 3.5, 1.1.1). No HISTORY entry. NAME (3.5): one setter per session
// slot, SSL_CTX_sess_set_new_cb, SSL_CTX_sess_set_remove_cb and
// SSL_CTX_sess_set_get_cb, each declared here. DESCRIPTION (3.5): it "sets
// the callback function that is called whenever a new session was
// negotiated". A registration into the new-session slot. Pinned prototype:
// `void SSL_CTX_sess_set_new_cb(SSL_CTX *ctx, int (*new_session_cb)(struct
// ssl_st *ssl, SSL_SESSION *sess))`.
extern fn SSL_CTX_sess_set_new_cb(ctx: ptr<mut, u8>, new_session_cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(new_session_cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.new_session_cb, new_session_cb);
    ensures normal resource_return_none();
};

// SSL_CTX_sess_set_remove_cb: same page. DESCRIPTION (3.5): it "sets the
// callback function that is called whenever a session is removed by the SSL
// engine"; NOTES: "This can happen when the session is removed because it is
// expired or when a connection was not shutdown cleanly. It also happens for
// all sessions in the internal session cache when SSL_CTX_free(3) is
// called." A registration into the session-remove slot. Pinned prototype:
// `void SSL_CTX_sess_set_remove_cb(SSL_CTX *ctx, void
// (*remove_session_cb)(struct ssl_ctx_st *ctx, SSL_SESSION *sess))`.
extern fn SSL_CTX_sess_set_remove_cb(ctx: ptr<mut, u8>, remove_session_cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(remove_session_cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.remove_session_cb, remove_session_cb);
    ensures normal resource_return_none();
};

// SSL_CTX_sess_set_get_cb: same page. DESCRIPTION (3.5): it "sets the
// callback function that is called whenever a TLS client proposed to resume
// a session but the session could not be found in the internal session
// cache". A registration into the session-get slot. Pinned prototype: `void
// SSL_CTX_sess_set_get_cb(SSL_CTX *ctx, SSL_SESSION *(*get_session_cb)(struct
// ssl_st *ssl, const unsigned char *data, int len, int *copy))`.
extern fn SSL_CTX_sess_set_get_cb(ctx: ptr<mut, u8>, get_session_cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(get_session_cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.get_session_cb, get_session_cb);
    ensures normal resource_return_none();
};

// SSL_CTX_set_client_cert_cb: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_client_cert_cb/
// (also 3.5, 1.1.1). No HISTORY entry. NAME (3.5): its one writer.
