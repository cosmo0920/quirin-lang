module contract;

// Card OPENSSL-UNDECLARED-HANDSHAKE-CALLBACKS. The setters of the handshake
// callback slots OPENSSL-UNSTATED-CALLBACK-SLOTS left under the premise
// `openssl_unstated_callback_slots` (see err.qv for what every declaration of
// this crate shares, and ssl_io.qv for the invocations).
//
// Each slot is C04.19.3's opaque slot (rule 12n): a setter's registration
// `resource_callback_slot_registered(H, ssl_ctx_st.FIELD, F)`, decided over
// the run's closed set of what the slot's declared setters are handed. Every
// writer the slot's 3.5 manual page names is declared here, and the page's
// NAME list is exactly the slot's writers and not-writers (the checker's
// `slot_writers_declared`). Where the page names an SSL setter beside the
// context's, the two share one key: the page says the SSL inherits the
// context's setting at SSL_new, so the SSL's slot holds a value one of the
// setters was handed. A key whose field the library spells differently
// internally (the custom extension callbacks live in a per-extension table)
// names the documented callback, not a layout: the run never defines the
// record, so the key is only the slot's name.
//
// A setter that the page says passes `arg` back to the callback keeps it for
// the callback (C04.14, `resource_retained_by(arg, ctx)`); the caller keeps
// custody of its object.
//
// Not stated here, and left under the premise on the handshake and I/O
// calls: the certificate transparency validation slot, which
// SSL_CTX_enable_ct and SSL_enable_ct write with the library's own callback
// through no function pointer formal (SSL_CTX_set_ct_validation_callback,
// 3.5), so no declaration can register what they write and the run's set
// would miss it; and the methods and callbacks of a BIO the SSL holds.

// SSL_CTX_set_keylog_callback: https://docs.openssl.org/1.1.1/man3/SSL_CTX_set_keylog_callback/
// (also 3.5; no page at 1.0.2). No HISTORY entry, so the bound is the oldest
// series that documents it. NAME (3.5): "SSL_CTX_set_keylog_callback,
// SSL_CTX_get_keylog_callback, SSL_CTX_keylog_cb_func": the slot's one
// writer. DESCRIPTION (3.5): it "sets the TLS key logging callback. This
// callback is called whenever TLS key material is generated or received"
// with "the ssl object associated with the connection, and line"; with NULL
// "no logging of key material will be done". A registration into the keylog
// slot. Pinned prototype: `void SSL_CTX_set_keylog_callback(SSL_CTX *ctx,
// SSL_CTX_keylog_cb_func cb)`, with `typedef void (*SSL_CTX_keylog_cb_func)(const
// SSL *ssl, const char *line)`.
extern fn SSL_CTX_set_keylog_callback(ctx: ptr<mut, u8>, cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.keylog_callback, cb);
    ensures normal resource_return_none();
};

// SSL_CTX_set_alpn_select_cb: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_alpn_select_cb/
// (also 3.5, 1.1.1). No HISTORY entry. NAME (3.5) names three slots'
// writers: SSL_CTX_set_alpn_select_cb, SSL_CTX_set_next_proto_select_cb and
// SSL_CTX_set_next_protos_advertised_cb, all declared here. DESCRIPTION
// (3.5): it "sets the application callback cb used by a server to select
// which protocol to use for the incoming connection. When cb is NULL, ALPN is
// not used. The arg value is a pointer which is passed to the application
// callback." A registration into the ALPN selection slot, keeping `arg`.
// Pinned prototype: `void SSL_CTX_set_alpn_select_cb(SSL_CTX *ctx,
// SSL_CTX_alpn_select_cb_func cb, void *arg)`.
extern fn SSL_CTX_set_alpn_select_cb(ctx: ptr<mut, u8>, cb: fnptr, arg: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(arg);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.alpn_select_cb, cb);
    ensures normal resource_retained_by(arg, ctx);
    ensures normal resource_return_none();
};

// SSL_CTX_set_next_proto_select_cb: https://docs.openssl.org/1.1.1/man3/SSL_CTX_set_alpn_select_cb/
// (also 3.5; the 1.0.2 page does not name it). No HISTORY entry.
