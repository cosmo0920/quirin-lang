// SSL_CTX_set_cert_verify_callback: https://docs.openssl.org/1.0.2/man3/SSL_CTX_set_cert_verify_callback/
// (also 3.5, 1.1.1). HISTORY (1.0.2): "Previous to OpenSSL 0.9.7, the arg
// argument to SSL_CTX_set_cert_verify_callback was ignored, and callback was
// called simply as int (*callback)(X509_STORE_CTX *)", so the reading (the
// callback receives `arg`) holds since 0.9.7. NAME (3.5): its one writer.
// DESCRIPTION (3.5): "SSL objects that are created from ctx inherit the
// setting valid at the time when SSL_new(3) is called"; NOTES: the callback
// "is called instead with the arguments callback(X509_STORE_CTX
// *x509_store_ctx, void *arg)"; "By setting callback to NULL, the default
// behaviour is restored." A registration into the certificate verification
// slot, keeping `arg`. Pinned prototype: `void
// SSL_CTX_set_cert_verify_callback(SSL_CTX *ctx, int (*cb)(X509_STORE_CTX *,
// void *), void *arg)`.
extern fn SSL_CTX_set_cert_verify_callback(ctx: ptr<mut, u8>, cb: fnptr, arg: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "0.9.7");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(arg);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.app_verify_callback, cb);
    ensures normal resource_retained_by(arg, ctx);
    ensures normal resource_return_none();
};

