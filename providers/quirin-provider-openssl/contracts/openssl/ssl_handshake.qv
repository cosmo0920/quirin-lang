// SSL_CTX_add_custom_ext: https://docs.openssl.org/3.5/man3/SSL_extension_supported/
// HISTORY (3.5): "The SSL_CTX_add_custom_ext() function was added in OpenSSL
// 1.1.1." NAME (3.5): the writers SSL_CTX_add_custom_ext (the `_ex` style
// callbacks) and SSL_CTX_add_client_custom_ext / SSL_CTX_add_server_custom_ext
// (the older style), beside the callback types and SSL_extension_supported.
// DESCRIPTION (3.5): it "adds a custom extension ... with extension type
// ext_type and callbacks add_cb, free_cb and parse_cb"; EXTENSION CALLBACKS:
// add_cb is called with "add_arg to the value set when the extension handler
// was added", free_cb "is called (if it is set) with the value of out set by
// the add callback", parse_cb "receives data for TLS extensions". Each call
// adds an extension, so a slot holds every callback any call registered: the
// run's set is the union. Three registrations, one per callback slot, and
// the context keeps `add_arg` and `parse_arg` for them. Pinned prototype:
// `int SSL_CTX_add_custom_ext(SSL_CTX *ctx, unsigned int ext_type, unsigned
// int context, SSL_custom_ext_add_cb_ex add_cb, SSL_custom_ext_free_cb_ex
// free_cb, void *add_arg, SSL_custom_ext_parse_cb_ex parse_cb, void
// *parse_arg)`.
extern fn SSL_CTX_add_custom_ext(ctx: ptr<mut, u8>, ext_type: u32, context: u32, add_cb: fnptr, free_cb: fnptr, add_arg: ptr<mut, u8>, parse_cb: fnptr, parse_arg: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.1");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(ext_type);
    ensures normal resource_borrowed(context);
    ensures normal resource_borrowed(add_cb);
    ensures normal resource_borrowed(free_cb);
    ensures normal resource_borrowed(add_arg);
    ensures normal resource_borrowed(parse_cb);
    ensures normal resource_borrowed(parse_arg);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.custom_ext_add_cb_ex, add_cb);
