// SSL_CTX_set_client_hello_cb: https://docs.openssl.org/3.5/man3/SSL_CTX_set_client_hello_cb/
// HISTORY (3.5): "The SSL ClientHello callback ... were added in OpenSSL
// 1.1.1." NAME (3.5): its one writer; the other names are the callback type
// and the accessors the callback may call. DESCRIPTION (3.5): it "sets the
// callback function, which is automatically called during the early stages
// of ClientHello processing on the server. The argument supplied when setting
// the callback is passed back to the callback at run time." A registration
// into the ClientHello slot, keeping `arg`. Pinned prototype: `void
// SSL_CTX_set_client_hello_cb(SSL_CTX *c, SSL_client_hello_cb_fn cb, void
// *arg)` (the page's synopsis spells `SSL_client_hello_cb_fn *f`; the header
// is the cross-check).
extern fn SSL_CTX_set_client_hello_cb(c: ptr<mut, u8>, cb: fnptr, arg: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.1");
    ensures normal resource_borrowed(c);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(arg);
    ensures normal resource_callback_slot_registered(c, ssl_ctx_st.client_hello_cb, cb);
    ensures normal resource_retained_by(arg, c);
    ensures normal resource_return_none();
};

// SSL_CTX_set_record_padding_callback: https://docs.openssl.org/3.5/man3/SSL_CTX_set_record_padding_callback/
// HISTORY (3.5): "The record padding API was added for TLS 1.3 support in
// OpenSSL 1.1.1." NAME (3.5): the writers SSL_CTX_set_record_padding_callback
// and SSL_set_record_padding_callback; the `_arg` setters keep the
// callback's argument, not the callback (an undeclared retention, which
// fails closed). DESCRIPTION (3.5): they "can be used to assign a callback
// function cb to specify the padding for TLS 1.3 records. The value set in
// ctx is copied to a new SSL by SSL_new()"; "Setting the user-supplied
// callback to NULL will restore the configured block padding behavior." A
// registration into the record padding slot. Pinned prototype: `void
// SSL_CTX_set_record_padding_callback(SSL_CTX *ctx, size_t (*cb)(SSL *ssl,
// int type, size_t len, void *arg))` (HISTORY says the return type became
// int in 3.0; the pinned 3.5.5 header declares void, and the declaration
// follows the header).
extern fn SSL_CTX_set_record_padding_callback(ctx: ptr<mut, u8>, cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.1");
    ensures normal resource_borrowed(ctx);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ctx, ssl_ctx_st.record_padding_cb, cb);
    ensures normal resource_return_none();
};

// SSL_set_record_padding_callback: same page and HISTORY. The SSL's copy of
// the record padding slot; it may fail ("the callback function cannot be set
// if Kernel TLS is already configured"), which leaves the slot as it was.
// Pinned prototype: `int SSL_set_record_padding_callback(SSL *ssl, size_t
// (*cb)(SSL *ssl, int type, size_t len, void *arg))`.
extern fn SSL_set_record_padding_callback(ssl: ptr<mut, u8>, cb: fnptr) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.1");
    ensures normal resource_borrowed(ssl);
    ensures normal resource_borrowed(cb);
    ensures normal resource_callback_slot_registered(ssl, ssl_ctx_st.record_padding_cb, cb);
    ensures normal resource_return_none();
};

