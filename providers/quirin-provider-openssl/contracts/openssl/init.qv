module contract;

// Card OPENSSL-PROVIDER-PLUGIN. Library initialisation (see err.qv for what
// every declaration of this crate shares).

// OPENSSL_init_ssl: https://docs.openssl.org/3.5/man3/OPENSSL_init_ssl/
// HISTORY (3.5, 1.1.1): "The OPENSSL_init_ssl() function was added in OpenSSL
// 1.1.0." Pinned prototype: `int OPENSSL_init_ssl(uint64_t opts, const
// OPENSSL_INIT_SETTINGS *settings)` (openssl/ssl.h). `settings` is read
// during the call (NULL for the defaults); no custody is taken or returned.
// In OpenSSL 3, `SSL_load_error_strings()` is a macro over this function.
extern fn OPENSSL_init_ssl(opts: u64, settings: ptr<const, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.0");
    ensures normal resource_borrowed(opts);
    ensures normal resource_borrowed(settings);
    ensures normal resource_return_none();
};
