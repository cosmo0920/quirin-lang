module contract;

// Card OPENSSL-REMAINING-HANDSHAKE-SETTERS. The callbacks of a certificate
// store, X509_STORE_set_verify_cb_func (3.5): twelve slots, one
// `X509_STORE_set_*` writer each, every one declared here. "All the callbacks
// from a X509_STORE are inherited by the corresponding X509_STORE_CTX
// structure when it is initialized" (NOTES); the handshake verifies the peer's
// chain through such a context over the store of the SSL_CTX, so the
// handshake and I/O calls invoke each slot (ssl_io.qv), every actual the
// library's.
//
// The holder is the store, an object that reaches a connection only through
// other calls (SSL_CTX_new makes the context's store, SSL_CTX_set_cert_store
// replaces it). The key is run-wide (C04.19.3), so its set is every function
// any store's setter is handed, as for a BIO method table. A slot left NULL
// makes the library use "the internal default function", which is the call's
// own behaviour, not a value of the slot.
//
// The page's aliases X509_STORE_set_verify_cb_func, X509_STORE_set_verify_func
// and X509_STORE_set_lookup_crls_cb are "available as macros" expanding to
// X509_STORE_set_verify_cb, X509_STORE_set_verify and
// X509_STORE_set_lookup_crls, so a call through one is a call to a writer
// declared here; the checker lists them as not-writers. The X509_STORE_CTX
// setters (X509_STORE_CTX_set_verify_cb, X509_STORE_CTX_set_verify) write the
// verification context's copy, which during a handshake only a callback can
// reach; none is declared, so a candidate calling one has no contract in
// force.
//
// Keys. Each key is the store field the page's setter names, except the
// cleanup slot, spelled `x509_store_st.cleanup_fn` after the page's
// X509_STORE_CTX_cleanup_fn. A key is only the slot's name (the run never
// defines the record), but its segments are tokens of the run's member
// pre-pass: a unit naming `cleanup` (WAMR's wasm_loader.c, whose Clang AST the
// reader cannot parse) is then read, stays unread and opens every member,
// which demoted six unrelated Safe rows of the opt-in run (report, section 4).
//
// Each setter: HISTORY (3.5) "The functions X509_STORE_set_verify_cb(), ...,
// X509_STORE_set_cleanup() and X509_STORE_get_cleanup() were added in OpenSSL
// 1.1.0" (X509_STORE_set_verify_cb is also said to be "added in OpenSSL
// 1.0.0"; the later bound is taken), so `since "1.1.0"`.

// X509_STORE_set_verify_cb: https://docs.openssl.org/3.5/man3/X509_STORE_set_verify_cb_func/
// (also 1.1.1). DESCRIPTION: it "sets the verification callback of xs to
// verify_cb overwriting the previous callback". A registration into the store's
// verify_cb slot. Pinned prototype: `void X509_STORE_set_verify_cb(X509_STORE
// *xs, X509_STORE_CTX_verify_cb verify_cb)`.
extern fn X509_STORE_set_verify_cb(xs: ptr<mut, u8>, verify_cb: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.0");
    ensures normal resource_borrowed(xs);
    ensures normal resource_borrowed(verify_cb);
    ensures normal resource_callback_slot_registered(xs, x509_store_st.verify_cb, verify_cb);
    ensures normal resource_return_none();
};

// X509_STORE_set_verify: https://docs.openssl.org/3.5/man3/X509_STORE_set_verify_cb_func/
// (also 1.1.1). DESCRIPTION: it "sets the final chain verification function for
// xs to verify". A registration into the store's verify slot. Pinned prototype:
// `void X509_STORE_set_verify(X509_STORE *xs, X509_STORE_CTX_verify_fn
// verify)`.
extern fn X509_STORE_set_verify(xs: ptr<mut, u8>, verify: fnptr) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.0");
    ensures normal resource_borrowed(xs);
    ensures normal resource_borrowed(verify);
    ensures normal resource_callback_slot_registered(xs, x509_store_st.verify, verify);
    ensures normal resource_return_none();
};

