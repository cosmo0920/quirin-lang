module contract;

// Card OPENSSL-PROVIDER-PLUGIN. SSL_CTX and SSL objects (see err.qv for what
// every declaration of this crate shares).
//
// Both objects are reference counted: the SSL_CTX_new and SSL_new pages
// (3.5) say each "is reference counted", that creation increments the count
// and that resources are freed "When the reference count drops to zero".
// So, per the 2026-10-05 class-3 decision (C04.17), a constructor returns one
// reference the caller owes (`resource_return_kind(reference)`) and a free is
// a reference drop, never read as a final free.
//
// Card OPENSSL-SSL-CTX-CALLBACK-SLOTS: SSL_shutdown, SSL_free and
// SSL_CTX_free read silently, until this card, that the callbacks they may
// run take nothing the caller holds. They now name it, the narrowed premise
// `openssl_unstated_callback_slots` (C04.18) of ssl_io.qv: SSL_shutdown
// sends or reads the close_notify alert (the info callback "is called
// whenever a significant event occurs such as: the state changes, an alert
// appears", SSL_CTX_set_info_callback 3.5); SSL_CTX_free runs the
// session-remove callback ("If a session-remove callback is set
// (SSL_CTX_sess_set_remove_cb()), this callback will be called for each
// session being freed from ctx's session cache", SSL_CTX_free 3.5); a free
// runs the ex_data free callbacks ("When a structure is free'd (such as
// SSL_CTX_free()) then the free_func() is called for every defined index",
// CRYPTO_get_ex_new_index 3.5). None of those setters is declared, so no
// slot is stated; the frees keep their NULL-accepting reference drop.
//
// Card OPENSSL-UNSTATED-CALLBACK-SLOTS: the info, message and session-remove
// setters are now declared (ssl_ctx.qv, ssl_io.qv). SSL_shutdown states the
// info and message invocations (the close_notify alert it sends or reads is
// a protocol message and an alert); it keeps the premise for what else
// reading records may run (a post-handshake message, a record padding or
// keylog callback, a BIO's method). The frees cannot state the
// session-remove invocation: C04.19 admits no callback clause beside a
// reference drop (`contract_loader.rs`: "a callback clause stands only
// beside retentions and plain predicates"), so they keep the premise, which
// covers it ("a callback slot ... whose invocation the declaration does not
// state"), the ex_data free callbacks and the BIOs SSL_free frees (SSL_free
// 3.5: "the read and write BIOs"). Follow-up
// OPENSSL-FREE-SESSION-REMOVE-INVOCATION.
//
// Card OPENSSL-BIO-METHODS-AND-CALLBACKS: a BIO's callback and its method
// table's functions are now stated slots (bio_slots.qv). SSL_shutdown states
// their invocations, on `ssl` with every actual the callee's own (the BIO,
// not the connection, is what each is handed), beside the library-value
// premise `openssl_builtin_bio_methods` for the methods the library defines
// itself, which no setter is handed. The unstated-slots premise no longer
// names a BIO's methods or callback. SSL_free frees the BIOs ("the read and
// write BIOs"), which runs each one's callback with BIO_CB_FREE, its destroy
// function and its ex_data free callbacks beside the drop; no clause can
// state that there, so SSL_free names `openssl_bio_free_callbacks`, as
// BIO_free does (bio.qv).
//
// Card OPENSSL-FREE-SESSION-REMOVE-INVOCATION: C04.19 now admits a slot
// invocation beside a reference drop (bio.qv says why it is sound). The
// session-remove callback runs "for all sessions in the internal session
// cache when SSL_CTX_free(3) is called" and "when a connection was not
// shutdown cleanly" (SSL_CTX_sess_set_get_cb 3.5; SSL_free 3.5: a bad
// session "will also be removed from the session cache"), so SSL_CTX_free
// and SSL_free state it, with both actuals `_` (the context handed is the
// session's, a formal only at SSL_CTX_free). SSL_free also states the BIO
// callback and destroy slots its BIOs' last drops run, as BIO_free does,
// beside `openssl_builtin_bio_methods`, and `openssl_bio_free_callbacks`
// names only the BIO class's ex_data free callbacks. Both frees keep
// `openssl_unstated_callback_slots`: freeing the context frees its
// certificate store (SSL_CTX_set_cert_store 3.5: the context takes
// ownership), whose lookup methods' free and shutdown functions are
// user-settable (X509_LOOKUP_meth_set_free, X509_LOOKUP_meth_set_shutdown);
// SSL_free may drop the context's last reference. Both keep
// `openssl_ex_data_callbacks` (card OPENSSL-EX-DATA-REGISTRY). Card
// OPENSSL-REMAINING-HANDSHAKE-SETTERS: the premise's statement now names
// those lookup methods ("a function of an X509_LOOKUP_METHOD of a lookup the
// certificate store of the SSL_CTX holds"); the frees state nothing new.

// TLS_server_method: https://docs.openssl.org/3.5/man3/SSL_CTX_new/
// HISTORY (3.5, 1.1.1): TLS_method(), TLS_server_method() and
// TLS_client_method() "were added in OpenSSL 1.1.0". Pinned prototype:
// `const SSL_METHOD *TLS_server_method(void)` (openssl/ssl.h). The method
// table is static: the result owns nothing.
extern fn TLS_server_method() -> ptr<const, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.0");
    ensures normal resource_return_none();
};

// SSL_CTX_new: https://docs.openssl.org/1.0.2/man3/SSL_CTX_new/ (also 3.5,
// 1.1.1). No HISTORY entry names its introduction at any series checked, so
// the bound is the oldest series that documents it. RETURN VALUES: NULL when
// creation failed. Pinned prototype: `SSL_CTX *SSL_CTX_new(const SSL_METHOD
// *meth)`.
// Card OPENSSL-EX-DATA-REGISTRY: it allocates an SSL_CTX and its X509_STORE,
// both ex_data classes, so the new callbacks of both classes run (and the
// free callbacks when a failed construction frees them).
extern fn SSL_CTX_new(meth: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(meth);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(reference);
};

// SSL_CTX_free: https://docs.openssl.org/1.1.1/man3/SSL_CTX_free/ (also 3.5,
// 1.0.2). No HISTORY entry. DESCRIPTION (3.5): it "decrements the reference
// count of ctx" and frees the object when the count reaches zero; "If ctx is
// NULL nothing is done" (1.1.1, 3.5; the 1.0.2 page does not say it). Card
// REFERENCE-DROP-NULL-ACCEPTING: the drop is NULL-accepting (C04.17), so the
// bound is the oldest series checked whose page states the NULL behaviour,
// 1.1.1. Pinned prototype: `void SSL_CTX_free(SSL_CTX *)`.
// Card OPENSSL-EX-DATA-REGISTRY: the last drop frees the SSL_CTX, its
// X509_STORE, its certificates, keys and cached sessions: the free callbacks
// of those classes run.
// Card OPENSSL-FREE-INDIRECT-CALLBACKS: the last drop frees the context's
// certificate store ("SSL_CTX_set_cert_store() will take ownership of the
// store", SSL_CTX_set_cert_store 3.5) and its CERT's verify and chain stores
// (ssl_cert_free, ssl_cert.c 3.5.5): the lookup method's shutdown and free
// slots are stated, as at X509_STORE_free. The unstated-slots premise is kept
// in the statement of a free, naming what remains (report section 2): the
// functions of the providers, methods and engines of the keys it frees, the
// client certificate engine (tls_engine_finish), and a CRL's method. The
// ctrl arms, CT and the undocumented handshake setters run during a
// handshake, not here, and ex_data is `openssl_ex_data_callbacks`.
// Card OPENSSL-FREE-REMAINING-INDIRECT-CALLBACKS: the teardown slots of the
// keys and engines the last drop frees in turn are stated (teardown_slots.qv;
// the client certificate engine's finish and destroy functions are the
// engine slots), beside the two teardown premises. A CRL's X509_CRL_METHOD
// free function stays under the free statement (its writer registers into
// its result, C04.19.3).
extern fn SSL_CTX_free(ctx: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_unstated_callback_slots,
        quant all #o in #freed: #teardown(#o) \ (#stated | #settable) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    requires resource_premise(openssl_builtin_lookup_methods,
        quant all #l in #lookups(#of(X509_STORE, #freed)): #method(#l) in #builtin
        -> #fns(#l) |-> #inert);
    requires resource_premise(openssl_builtin_teardown_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #library
        -> #f |-> #inert);
    requires resource_premise(openssl_loaded_module_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #loaded
        -> #f |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_reference_dropped(ctx, nullable);
    ensures normal resource_callback_slot_invoked(ctx, ssl_ctx_st.remove_session_cb, _, _);
    ensures normal resource_callback_slot_invoked(ctx, x509_lookup_method_st.lookup_meth_shutdown, _);
    ensures normal resource_callback_slot_invoked(ctx, x509_lookup_method_st.lookup_meth_free, _);
    ensures normal resource_callback_slot_invoked(ctx, dh_method.dh_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ctx, dsa_method.dsa_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ctx, ec_key_method_st.ec_key_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ctx, engine_st.engine_destroy, _);
    ensures normal resource_callback_slot_invoked(ctx, engine_st.engine_finish, _);
    ensures normal resource_callback_slot_invoked(ctx, engine_st.engine_pkey_asn1_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(ctx, engine_st.engine_pkey_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(ctx, evp_pkey_asn1_method_st.asn1_meth_pkey_free, _);
    ensures normal resource_callback_slot_invoked(ctx, rsa_meth_st.rsa_meth_finish, _);
    ensures normal resource_return_none();
};

// SSL_new: https://docs.openssl.org/1.0.2/man3/SSL_new/ (also 3.5, 1.1.1).
// No HISTORY entry. RETURN VALUES: NULL when creation failed. The new SSL
// takes its own reference on `ctx`; the caller's is unchanged. Pinned
// prototype: `SSL *SSL_new(SSL_CTX *ctx)`.
// Card OPENSSL-EX-DATA-REGISTRY: it allocates an SSL (and the memory BIOs of
// its record layers): the new callbacks of the SSL and BIO classes run.
extern fn SSL_new(ctx: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(ctx);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(reference);
};

// SSL_free: https://docs.openssl.org/1.1.1/man3/SSL_free/ (also 3.5, 1.0.2).
// No HISTORY entry. DESCRIPTION (3.5): it "decrements the reference count of
// ssl"; "If ssl is NULL nothing is done" (1.1.1, 3.5; the 1.0.2 page does not
// say it). Card REFERENCE-DROP-NULL-ACCEPTING: the drop is NULL-accepting
// (C04.17), so the bound is 1.1.1, the oldest series stating it. Pinned
// prototype: `void SSL_free(SSL *ssl)`.
// Card OPENSSL-EX-DATA-REGISTRY: the last drop frees the SSL, its session,
// peer certificate and BIOs: the free callbacks of those classes run.
// Card OPENSSL-FREE-INDIRECT-CALLBACKS: the last drop frees the connection's
// CERT and its verify and chain stores, and drops its references to the
// context and the session context (SSL_CTX_free twice, ssl_lib.c 3.5.5), so
// it may free a context's store: the lookup method's shutdown and free slots
// are stated. The unstated-slots premise stays in the statement of a free:
// besides what SSL_CTX_free leaves, the async wait context's fd cleanup
// functions (ASYNC_WAIT_CTX_free), the QUIC TLS callbacks
// (SSL_set_quic_tls_cbs, run when RECORD_LAYER_clear releases a record), and
// what a QUIC object's free runs, which was not traced.
// Card OPENSSL-FREE-REMAINING-INDIRECT-CALLBACKS: the teardown slots of the
// keys, engines, digest, cipher and public key method contexts and async
// wait context the last drop frees in turn are stated (teardown_slots.qv),
// beside the two teardown premises, and so are the message and info
// callbacks, which the record layer's clear runs on its error path (a fatal
// record release, ossl_statem_fatal then ssl3_send_alert, s3_msg.c at
// 3.5.5). The QUIC free path was traced past quic_impl.c (report section 3):
// it runs nothing beyond these, the stated BIO and session-remove slots and
// ex_data. A CRL's X509_CRL_METHOD free function and the QUIC TLS
// crypto_release_rcd function of a TLS object given SSL_set_quic_tls_cbs (a
// dispatch table) stay under the free statement.
extern fn SSL_free(ssl: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_unstated_callback_slots,
        quant all #o in #freed: #teardown(#o) \ (#stated | #settable) |-> #inert);
    requires resource_premise(openssl_bio_free_callbacks,
        quant all #b in #of(BIO, #args) | #chain(#bios(#of(SSL, #args))): #b in #freed
        -> #ex_data_free(BIO) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    requires resource_premise(openssl_builtin_lookup_methods,
        quant all #l in #lookups(#of(X509_STORE, #freed)): #method(#l) in #builtin
        -> #fns(#l) |-> #inert);
    requires resource_premise(openssl_builtin_bio_methods,
        quant all #b in #chain(#of(BIO, #args) | #bios(#of(SSL, #args))): #method(#b) in #builtin
        -> #fns(#b) |-> #inert
        && quant all #f in #fns(#b): #in_turn(#f, #ssl_of(#b) \ #args) |-> #inert);
    requires resource_premise(openssl_builtin_teardown_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #library
        -> #f |-> #inert);
    requires resource_premise(openssl_loaded_module_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #loaded
        -> #f |-> #inert);
    ensures normal resource_borrowed(ssl);
    ensures normal resource_reference_dropped(ssl, nullable);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.remove_session_cb, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_st.bio_callback_ex, _, _, supplied_nullable, _, _, _, _, supplied_nullable);
    ensures normal resource_callback_slot_invoked(ssl, bio_st.bio_callback, _, _, supplied_nullable, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_destroy, _);
    ensures normal resource_callback_slot_invoked(ssl, x509_lookup_method_st.lookup_meth_shutdown, _);
    ensures normal resource_callback_slot_invoked(ssl, x509_lookup_method_st.lookup_meth_free, _);
    ensures normal resource_callback_slot_invoked(ssl, async_wait_ctx_st.wait_fd_cleanup, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, dh_method.dh_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, dsa_method.dsa_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, ec_key_method_st.ec_key_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_destroy, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_pkey_asn1_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_pkey_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_cipher_st.cipher_meth_cleanup, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_md_st.md_meth_cleanup, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_pkey_asn1_method_st.asn1_meth_pkey_free, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_pkey_method_st.pkey_meth_cleanup, _);
    ensures normal resource_callback_slot_invoked(ssl, rsa_meth_st.rsa_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.info_callback, ssl, _, _);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.msg_callback, _, _, _, _, _, ssl, _);
    ensures normal resource_return_none();
};

// SSL_shutdown: https://docs.openssl.org/1.0.2/man3/SSL_shutdown/ (also 3.5,
// 1.1.1). HISTORY (3.5) names only SSL_shutdown_ex() (added in 3.2), so the
// bound for SSL_shutdown is the oldest series that documents it. "ssl MUST
// NOT be NULL" (3.5). Pinned prototype: `int SSL_shutdown(SSL *s)`. It
// sends or reads the close_notify alert on `ssl`; custody is unchanged.
// Card OPENSSL-UNDECLARED-HANDSHAKE-CALLBACKS: the alert is a record, and the
// record padding callback "is invoked for every record before encryption",
// its `type` "may be one of SSL3_RT_APPLICATION_DATA, SSL3_RT_HANDSHAKE, or
// SSL3_RT_ALERT" (SSL_CTX_set_record_padding_callback, 3.5): a stated
// invocation. The premise stays for what reading records may still run (a
// post-handshake message's callbacks). Card OPENSSL-BIO-METHODS-AND-CALLBACKS:
// the alert is written to and read from the SSL's BIOs, so the BIO callback
// and method slots are stated invocations (every actual `_`), the built-in
// methods under `openssl_builtin_bio_methods`.
// Card OPENSSL-EX-DATA-REGISTRY: it may process post-handshake messages (a
// NewSessionTicket creates an SSL_SESSION) while reading for the
// close_notify.
// Card OPENSSL-REMAINING-HANDSHAKE-SETTERS: an asynchronous SSL call runs the
// async callback when "a retry occurs" (SSL_set_async_callback 3.5), and
// SSL_shutdown is such a call under SSL_MODE_ASYNC: a stated invocation,
// `ssl_ctx_st.async_cb(ssl, _)`. The premise's statement now names what it
// covers by name (ssl_io.qv); on SSL_shutdown it still covers the slots this
// declaration does not state (a post-handshake message's callbacks, and on a
// QUIC object another connection's handshake callbacks run by the shared
// reactor).
// Card OPENSSL-INNER-FREES-SILENT-METHOD-CALLBACKS: the handshake statement's
// last conjunct is the statement of a free: the call frees peer and ephemeral
// keys, peer certificates, key exchange and signature contexts, transcript
// digests and record-layer cipher contexts inside (ssl/statem, s3_lib.c 3.5.5).
// Card OPENSSL-FREE-REMAINING-INDIRECT-CALLBACKS: the keys and the digest,
// cipher and public key contexts the call frees inside run the teardown
// slots whose setters are declared now (teardown_slots.qv), which the
// handshake statement's free conjunct no longer covers, so they are stated,
// beside `openssl_builtin_teardown_functions` and
// `openssl_loaded_module_functions`.
extern fn SSL_shutdown(ssl: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.0.2");
    requires resource_premise(openssl_unstated_callback_slots,
        #slots(#of(SSL, #args) | #ctx(#of(SSL, #args)) | #of(SSL_CTX, #args)) \ #stated |-> #inert
        && (quant all #l in #lookups(#store(#ctx(#of(SSL, #args)) | #of(SSL_CTX, #args))): #fns(#l) \ #stated |-> #inert)
        && (quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) \ #stated |-> #inert)
        && quant all #o in #freed: #teardown(#o) \ (#stated | #settable) |-> #inert);
    requires resource_premise(openssl_builtin_bio_methods,
        quant all #b in #chain(#of(BIO, #args) | #bios(#of(SSL, #args))): #method(#b) in #builtin
        -> #fns(#b) |-> #inert
        && quant all #f in #fns(#b): #in_turn(#f, #ssl_of(#b) \ #args) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    requires resource_premise(openssl_builtin_teardown_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #library
        -> #f |-> #inert);
    requires resource_premise(openssl_loaded_module_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #loaded
        -> #f |-> #inert);
    ensures normal resource_borrowed(ssl);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.info_callback, ssl, _, _);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.msg_callback, _, _, _, _, _, ssl, _);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.record_padding_cb, ssl, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, ssl_ctx_st.async_cb, ssl, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_st.bio_callback_ex, _, _, supplied_nullable, _, _, _, _, supplied_nullable);
    ensures normal resource_callback_slot_invoked(ssl, bio_st.bio_callback, _, _, supplied_nullable, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_write_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_write, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_read_ex, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_read, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_puts, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_gets, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_ctrl, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_create, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_destroy, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_callback_ctrl, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_sendmmsg, _, _, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, bio_method_st.meth_recvmmsg, _, _, _, _, _, _);
    ensures normal resource_callback_slot_invoked(ssl, dh_method.dh_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, dsa_method.dsa_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, ec_key_method_st.ec_key_meth_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_destroy, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_finish, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_pkey_asn1_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(ssl, engine_st.engine_pkey_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_cipher_st.cipher_meth_cleanup, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_md_st.md_meth_cleanup, _);
    ensures normal resource_callback_slot_invoked(ssl, evp_pkey_asn1_method_st.asn1_meth_pkey_free, _);
