module contract;

// Card OPENSSL-PROVIDER-PLUGIN. EVP_PKEY keys (see err.qv for what every
// declaration of this crate shares).

// EVP_PKEY_free: https://docs.openssl.org/3.5/man3/EVP_PKEY_new/ HISTORY
// (3.5, 1.1.1): EVP_PKEY_new() and EVP_PKEY_free() "exist in all versions of
// OpenSSL" (EVP_PKEY_up_ref() was added in 1.1.0); no version is named, and
// the 1.0.2 page's HISTORY reads "TBA". DESCRIPTION (3.5): EVP_PKEY_free()
// "decrements the reference count of key" and frees it at zero; "If key is
// NULL, nothing is done" (1.1.1, 3.5; the 1.0.2 page does not say it). Card
// REFERENCE-DROP-NULL-ACCEPTING: the drop is NULL-accepting (C04.17), so the
// bound is 1.1.1 (https://docs.openssl.org/1.1.1/man3/EVP_PKEY_new/), the
// oldest series checked stating the NULL behaviour. Pinned prototype: `void
// EVP_PKEY_free(EVP_PKEY *pkey)`.
// Card OPENSSL-EX-DATA-REGISTRY: the last reference frees the EVP_PKEY: the
// EVP_PKEY class's free callbacks run.
// Card OPENSSL-OBJECT-FREES-SILENT-METHOD-CALLBACKS: the last reference also
// runs the key's provider key management free, its EVP_PKEY_ASN1_METHOD free,
// its RSA/DSA/DH/EC_KEY method finish and its ENGINE finish (p_lib.c and
// rsa_lib.c 3.5.5), whose setters no declaration states: the unstated-slots
// premise of a free names them.
// Card OPENSSL-FREE-REMAINING-INDIRECT-CALLBACKS: every function the last
// reference runs is stated now: the ASN.1 method free (handed the key) and
// the RSA, DSA, DH or EC_KEY method finish and engine slots
// (teardown_slots.qv), with the library's own methods, engines and the
// built-in providers' key management under `openssl_builtin_teardown_functions`
// and a loaded provider's or engine module's under
// `openssl_loaded_module_functions`. So the free names no free statement.
extern fn EVP_PKEY_free(pkey: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    requires resource_premise(openssl_builtin_teardown_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #library
        -> #f |-> #inert);
    requires resource_premise(openssl_loaded_module_functions,
        quant all #o in #freed: quant all #f in #teardown(#o): #f in #loaded
        -> #f |-> #inert);
    ensures normal resource_borrowed(pkey);
    ensures normal resource_reference_dropped(pkey, nullable);
    ensures normal resource_callback_slot_invoked(pkey, dh_method.dh_meth_finish, _);
    ensures normal resource_callback_slot_invoked(pkey, dsa_method.dsa_meth_finish, _);
    ensures normal resource_callback_slot_invoked(pkey, ec_key_method_st.ec_key_meth_finish, _);
    ensures normal resource_callback_slot_invoked(pkey, engine_st.engine_destroy, _);
    ensures normal resource_callback_slot_invoked(pkey, engine_st.engine_finish, _);
    ensures normal resource_callback_slot_invoked(pkey, engine_st.engine_pkey_asn1_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(pkey, engine_st.engine_pkey_meths, _, supplied_nullable, supplied_nullable, _);
    ensures normal resource_callback_slot_invoked(pkey, evp_pkey_asn1_method_st.asn1_meth_pkey_free, pkey);
    ensures normal resource_callback_slot_invoked(pkey, rsa_meth_st.rsa_meth_finish, _);
    ensures normal resource_return_none();
};
