module contract;

// Card OPENSSL-PROVIDER-PLUGIN. EVP_PKEY keys (see err.qv for what every
// declaration of this crate shares).

// EVP_PKEY_free: https://docs.openssl.org/3.5/man3/EVP_PKEY_new/ HISTORY
// (3.5, 1.1.1): EVP_PKEY_new() and EVP_PKEY_free() "exist in all versions of
// OpenSSL" (EVP_PKEY_up_ref() was added in 1.1.0); no version is named, and
// the 1.0.2 page's HISTORY reads "TBA". DESCRIPTION (3.5): EVP_PKEY_free()
// "decrements the reference count of key" and frees it at zero; "If key is
// NULL, nothing is done" (1.1.1, 3.5; the 1.0.2 page does not say it). Card
// REFERENCE-DROP-NULL-ACCEPTING: the drop is NULL-accepting (C04.17), so the
// bound is 1.1.1 (https://docs.openssl.org/1.1.1/man3/EVP_PKEY_new/), the
// oldest series checked stating the NULL behaviour. Pinned prototype: `void
// EVP_PKEY_free(EVP_PKEY *pkey)`.
// Card OPENSSL-EX-DATA-REGISTRY: the last reference frees the EVP_PKEY: the
// EVP_PKEY class's free callbacks run.
// Card OPENSSL-OBJECT-FREES-SILENT-METHOD-CALLBACKS: the last reference also
// runs the key's provider key management free, its EVP_PKEY_ASN1_METHOD free,
// its RSA/DSA/DH/EC_KEY method finish and its ENGINE finish (p_lib.c and
// rsa_lib.c 3.5.5), whose setters no declaration states: the unstated-slots
// premise names them.
extern fn EVP_PKEY_free(pkey: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_unstated_callback_slots, "a callback the call may run that no clause of this declaration states (a function of a provider, method or engine of the key the call frees, whose setter no declaration of this crate states or which no setter is handed, among them the free function of the key management of the provider of the key and, when the key holds the last reference to that provider, the teardown function of the provider, the free function of the EVP_PKEY_ASN1_METHOD of the key, the finish function of the RSA_METHOD, DSA_METHOD, DH_METHOD or EC_KEY_METHOD of the key, and the finish and destroy functions of an ENGINE of the key) takes, releases or retains nothing the caller holds");
    requires resource_premise(openssl_ex_data_callbacks, "an ex_data callback the call may run (a new, dup or free callback CRYPTO_get_ex_new_index registers for the class of an object the call creates, copies or frees) takes, releases or retains nothing the caller holds");
    ensures normal resource_borrowed(pkey);
    ensures normal resource_reference_dropped(pkey, nullable);
    ensures normal resource_return_none();
};
