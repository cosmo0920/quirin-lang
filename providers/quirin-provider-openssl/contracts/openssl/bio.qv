module contract;

// Card OPENSSL-PROVIDER-PLUGIN. BIO objects (see err.qv for what every
// declaration of this crate shares).

// BIO_free: https://docs.openssl.org/1.1.1/man3/BIO_new/ (also 3.5, 1.0.2).
// No HISTORY entry names its introduction. DESCRIPTION (3.5): "BIO_up_ref()
// increments the reference count associated with the BIO object", which
// BIO_free releases; "If a is NULL nothing is done" (1.1.1, 3.5; the 1.0.2
// page does not say it). Card REFERENCE-DROP-NULL-ACCEPTING: the drop is
// NULL-accepting (C04.17), so the bound is 1.1.1, the oldest series checked
// stating the NULL behaviour. Pinned prototype: `int
// BIO_free(BIO *a)` (openssl/bio.h). BIO_new_mem_buf is not declared here:
// the BIO it returns keeps reading the caller's buffer, a retention
// (`resource_retained_by`) this card does not state.
//
// Card OPENSSL-BIO-METHODS-AND-CALLBACKS: BIO_free read silently, until this
// card, that it runs callbacks. When the last reference drops it runs the
// BIO's callback ("callback_ex(b, BIO_CB_FREE, NULL, 0, 0, 0L, 1L, NULL) or
// callback(b, BIO_CB_FREE, NULL, 0L, 0L, 1L) is called before the free
// operation", BIO_set_callback 3.5), its method's destroy function ("This
// function will be called in response to the application calling
// BIO_free()", BIO_meth_new 3.5) and the BIO class's ex_data free callbacks
// ("When a structure is free'd ... then the free_func() is called for every
// defined index", CRYPTO_get_ex_new_index 3.5). The callback and destroy
// slots are stated (bio_slots.qv), but their invocation cannot be stated
// here: C04.19 admits no callback clause beside a reference drop, and
// admitting one needs the gateway to apply a candidate's requirement on the
// dropped formal before the drop (the callback route runs after the
// reference route in the transfer today), which this card does not build.
// The ex_data callbacks are no slot at all. So the declaration names the
// premise `openssl_bio_free_callbacks` (C04.18) for exactly those three,
// published with every row that applies it. Follow-up
// OPENSSL-FREE-SESSION-REMOVE-INVOCATION (the clause beside a drop).
// Card OPENSSL-EX-DATA-REGISTRY: openssl_bio_free_callbacks names the BIO
// class's free callbacks; the ex_data premise is named too, so every
// declaration that may run an ex_data callback names it.
extern fn BIO_free(a: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(openssl, documented "1.1.1");
    requires resource_premise(openssl_bio_free_callbacks,
        quant all #b in #of(BIO, #args) | #chain(#bios(#of(SSL, #args))): #b in #freed
        -> #callback(#b, BIO_CB_FREE) |-> #inert
        && #destroy(#b) |-> #inert
        && #ex_data_free(BIO) |-> #inert);
    requires resource_premise(openssl_ex_data_callbacks,
        quant all #o in #created | #copied | #freed: #ex_data(#class(#o)) |-> #inert);
    ensures normal resource_borrowed(a);
    ensures normal resource_reference_dropped(a, nullable);
    ensures normal resource_return_none();
};
