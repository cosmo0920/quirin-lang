    requires resource_revision(flexible);
    requires resource_library_version(openssl, since "1.1.0");
    ensures normal resource_borrowed(biom);
    ensures normal resource_borrowed(bread);
    ensures normal resource_callback_slot_registered(biom, bio_method_st.bread, bread);
    ensures normal resource_return_none();
};

