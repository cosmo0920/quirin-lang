module contract;

// Card NULL-SAFETY-PROPERTY (USER DECISION 2026-10-10, decision 2; contract
// specification C09.3, grammar G05d, gateway rules 14o-14p). Bounds contract
// v1 null-dereference checks: `quant null-deref #B;` says the function
// dereferences `B`, so every caller must pass a non-null `B` (otherwise the
// call is a NULL-dereference candidate). Read only by the null-dereference
// property (`QCORE_NULL_PROPERTY`); the bounds consumer never reads these
// clauses, and the resource loader rejects this module.
//
// Each body was read at the two audited Fluent Bit revisions 66910c10 and
// 046accf6 (byte-identical at both, `scripts/bodies.py`), and the unit's own
// inference (rule 14p) found the formal dereferenced on every terminating
// path before any NULL test at 66910c10. Ranked by the files other than the
// definition that call it (`scripts/clause_rank.py`). Pinned with
// `quirin-audit pin --bounds` at both revisions (`bounds-contracts.lock`): a
// changed body or clause takes the declaration out of force (held).

// rdkafka.c: rd_kafka_destroy(rk) { rd_kafka_destroy_app(rk, 0); }, whose
// body reads rk->rk_conf before anything tests rk.
extern fn rd_kafka_destroy(rk: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #rk;
};

// rdkafka_partition.c: the loop condition reads rktparlist->cnt first.
extern fn rd_kafka_topic_partition_list_destroy(rktparlist: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #rktparlist;
};

// rdkafka_partition.c: forwards to rd_kafka_topic_partition_list_add0, whose
// body reads rktparlist->cnt before anything tests it.
extern fn rd_kafka_topic_partition_list_add(rktparlist: ptr<mut, u8>, topic: ptr<const, u8>, partition: i32) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    quant null-deref #rktparlist;
};

// rdlist.c: rd_list_destroy_elems(rl) reads rl->rl_elems first.
extern fn rd_list_destroy(rl: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #rl;
};

// rdlist.c: reads rl->rl_cnt first (elem is tested, so it has no clause).
extern fn rd_list_add(rl: ptr<mut, u8>, elem: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    quant null-deref #rl;
};

// rdkafka_queue.c: reads rkqu->rkqu_is_owner first.
extern fn rd_kafka_queue_destroy(rkqu: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #rkqu;
};

// rdkafka_msg.c: reads rkmessage->_private first.
extern fn rd_kafka_message_destroy(rkmessage: ptr<mut, u8>) -> unit
contract {
    requires bounds_contract_v1;
    quant null-deref #rkmessage;
};

// Card NULL-CANDIDATE-TRIAGE (contract specification C09.3, grammar G05e,
// gateway rule 14t): declared non-null members. `requires
// nonnull_member(TAG, FIELD);` says every `struct TAG`'s FIELD is
// non-null wherever it is read. It is a type-level declaration; each is
// hosted on its record's constructor, which stores the member. It is checked
// against every store the analysed units make to the member (a store not
// proved non-null withdraws it for the whole run, and every null row that
// relied on it is published Unknown); the zero-initialised object a
// constructor fills in before its first store is a listed premise
// (`construction`), so these declarations are never `validated`. Ranked by
// the memory-field candidates each discharges (NULL-SAFETY-PROPERTY's
// candidates.json.gz); every store was read at 66910c10 and 046accf6.
// Not declared on measured grounds: rd_kafka_buf_s.rkbuf_rkb (3,474
// candidates; rdkafka_broker.c resets it to NULL after a response is
// handled), msetr_rkb (stores rkbuf->rkbuf_rkb) and rd_kafka_broker_s.rkb_rk
// (682; the run's store check withdrew it: rd_kafka_broker_find_by_nodeid0_fl
// builds a lookup key `rd_kafka_broker_t skel = {.rkb_nodeid = ...}` whose
// rkb_rk is NULL, and three unit tests build brokers without it).

// Card NONNULL-MEMBER-UNIFIED-QUALIFIER (USER DECISION 2026-10-16, "Yes, all
// kinds"; contract specification C09.3, gateway rules 14t, 14x): the plugin
// premise applies to every kind of `nonnull_member` by the same reachability
// rule. A plain member's fact is checked against the analysed units' stores
// exactly as a stable member's is, so a store made by a plugin's callback
// could falsify it too. Each of the four declarations below meets
// LIBRDKAFKA-PLUGIN-PREMISE-REMAINDER's rule at 66910c10 and 046accf6 (rule
// (a): a store to the member is reachable from an external function; rule
// (b): the host body reaches an rk_conf or interceptor call;
// docs/reports/nonnull-member-unified-qualifier/artifacts/member-census-reproduced.json),
// so each names P-RK-PLUGIN-CALLBACK-CLOSURE, and every null row resting on
// `member:TAG.FIELD` lists it.
//
// rdkafka_partition.c: rd_kafka_toppar_new0 stores `rktp->rktp_rkt =
// rd_kafka_topic_keep(rkt)` (a declared non-null result, below) and
// `rktp->rktp_rkt = rkt` after reading rkt.
extern fn rd_kafka_toppar_new0(rkt: ptr<mut, u8>, partition: i32, func: ptr<const, u8>, line: i32) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires nonnull_member(rd_kafka_toppar_s, rktp_rkt);
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    requires resource_hypothesis(plugin_artifact_symbol_abi, "For every reached loaded artifact, exact selected build/inventory, artifact identity and required symbol/address/ABI prerequisites hold.");
    requires resource_hypothesis(plugin_callback_candidates, "Every actual rk_conf invocation has its exact declared member candidate and a prior successful public registration or stated static default.");
    requires resource_hypothesis(plugin_code_context_lifetime, "Every loaded callback invocation, including destruction and copied on_new paths, has live code and opaque context.");
    requires resource_hypothesis(plugin_interceptor_custody, "Every interceptor-descendant pointer and scalar resource is borrowed, with no retain/transfer/global custody and each local acquisition dropped before its activation returns.");
    requires resource_hypothesis(plugin_interceptor_registration, "Every loaded interceptor uses a successful public setter with the exact pinned list/union-arm candidate and permitted configuration/client lifecycle.");
    requires resource_hypothesis(plugin_lifecycle_unload, "Every callback invocation precedes matching final unload and copied registrations retain actual loader references.");
    requires resource_hypothesis(plugin_outer_bridge, "Actually loaded RK and Fluent Bit C/Go code independently meet their respectively bound proposed outer envelopes; one envelope covers no missing obligation of another.");
    requires resource_premise_decomposition(rk_plugin_callback_closure, plugin_artifact_symbol_abi, plugin_callback_candidates, plugin_code_context_lifetime, plugin_interceptor_custody, plugin_interceptor_registration, plugin_lifecycle_unload, plugin_outer_bridge);
};

// rdkafka_topic.c: rd_kafka_topic_new0 stores `rkt->rkt_topic =
// rd_kafkap_str_new(topic, -1)` and `rkt->rkt_rk = rk`.
extern fn rd_kafka_topic_new0(rk: ptr<mut, u8>, topic: ptr<const, u8>, conf: ptr<mut, u8>, existing: ptr<mut, u8>, do_lock: i32) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires nonnull_member(rd_kafka_topic_s, rkt_rk);
    requires nonnull_member(rd_kafka_topic_s, rkt_topic);
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    requires resource_hypothesis(plugin_artifact_symbol_abi, "For every reached loaded artifact, exact selected build/inventory, artifact identity and required symbol/address/ABI prerequisites hold.");
    requires resource_hypothesis(plugin_callback_candidates, "Every actual rk_conf invocation has its exact declared member candidate and a prior successful public registration or stated static default.");
    requires resource_hypothesis(plugin_code_context_lifetime, "Every loaded callback invocation, including destruction and copied on_new paths, has live code and opaque context.");
    requires resource_hypothesis(plugin_interceptor_custody, "Every interceptor-descendant pointer and scalar resource is borrowed, with no retain/transfer/global custody and each local acquisition dropped before its activation returns.");
    requires resource_hypothesis(plugin_interceptor_registration, "Every loaded interceptor uses a successful public setter with the exact pinned list/union-arm candidate and permitted configuration/client lifecycle.");
