};

// rdkafka_topic.c: rd_kafka_topic_new0 stores `rkt->rkt_topic =
// rd_kafkap_str_new(topic, -1)` and `rkt->rkt_rk = rk`.
extern fn rd_kafka_topic_new0(rk: ptr<mut, u8>, topic: ptr<const, u8>, conf: ptr<mut, u8>, existing: ptr<mut, u8>, do_lock: i32) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires null_member_nonnull(rd_kafka_topic_s, rkt_rk);
    requires null_member_nonnull(rd_kafka_topic_s, rkt_topic);
};

// rdkafka_cgrp.c: rd_kafka_cgrp_new stores `rkcg->rkcg_rk = rk`.
extern fn rd_kafka_cgrp_new(rk: ptr<mut, u8>, group_protocol: i32, group_id: ptr<const, u8>, client_id: ptr<const, u8>) -> ptr<mut, u8>
