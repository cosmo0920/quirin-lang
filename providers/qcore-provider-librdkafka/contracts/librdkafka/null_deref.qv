// = rkb`.
extern fn rd_kafka_transport_new(rkb: ptr<mut, u8>, s: i32, errstr: ptr<mut, u8>, errstr_size: usize) -> ptr<mut, u8>
contract {
    requires bounds_contract_v1;
    requires null_member_nonnull(rd_kafka_transport_s, rktrans_rkb);
