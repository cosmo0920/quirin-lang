    ensures normal resource_borrowed(topic);
    ensures normal resource_borrowed(partition);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(reference);
};

// `ut_create_mock_queue` (`rdunittest_fetcher.c:95-100`, `static`): `rkq =
// rd_calloc(…)` (non-null), `rd_kafka_q_init(rkq, NULL)` (count 1, no client),
// marks it allocated, `return rkq;`.

extern fn ut_create_mock_queue() -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_premise(asserted_allocation, "the result is non-null because it is allocated with rd_calloc (rd.h:139-143), which asserts its result, and the audited compile commands define no NDEBUG, so it never returns NULL in the audited build");
    ensures normal resource_return_owned(nonnull);
    ensures normal resource_return_kind(reference);
};

