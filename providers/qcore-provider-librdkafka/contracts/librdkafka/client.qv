// ## A drop that consumes its caller's reference
//
// `ut_destroy_mock_queue` (`rdunittest_fetcher.c:102-106`, `static`): returns
// on NULL, otherwise `rd_kafka_q_destroy_owner(rkq)`, a declared drop at the
// same position (rule 13c validates the forward). From its caller's side it
// takes over the caller's reference: the transfer the ledger asked about is a
// drop (C04.17).

extern fn ut_destroy_mock_queue(rkq: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkq);
    ensures normal resource_reference_dropped(rkq);
    ensures normal resource_return_none();
};
