// Card REFCOUNT-REFERENCE-RETURNING-DECLARATIONS (contract specification
// C04.17, C04.14.2; gateway rules 13d and 13e), under the user's decision of
// 2026-10-05 on class 3. A returned reference is
// `resource_return_owned(n)` with `resource_return_kind(reference)`: the call
// hands its caller one reference the caller must drop or hand off (an
// acquired family, rule 13b). Rule 13d checks each body below in every unit
// that defines it: every `return` is a null constant (declared nullable), a
// call of a declared keep or returned reference, or a local assigned only
// from those or from a declared allocation and never given away. The count
// arithmetic and the non-null results stay declared assumptions, cited here
// and pinned (C06.2). `rd_malloc` and `rd_calloc` (`rd.h:139-149`) assert
// their result, and the audited compile commands define no `NDEBUG`, so they
// never return NULL in the audited build. Every body was read at `66910c10`
// and `046accf6` and is byte-identical (`scripts/body.py`).

// ## Lookups (each returns a kept reference, or NULL)
//
// `rd_kafka_toppar_get0` (`rdkafka_partition.c:418-436`): `rktp` is read from
// the topic's partition array or its UA partition; a present one is returned
// through `rd_kafka_toppar_keep_fl` (`rd_kafka_toppar_keep0`, a declared
// keep), otherwise NULL. The `rd_kafka_toppar_get` macro
// (`rdkafka_partition.h:614-615`) passes `__FUNCTION__` and `__LINE__`.

extern fn rd_kafka_toppar_get0(func: ptr<const, u8>, line: i32, rkt: ptr<const, u8>, partition: i32, ua_on_miss: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(func);
    ensures normal resource_borrowed(line);
    ensures normal resource_borrowed(rkt);
    ensures normal resource_borrowed(partition);
    ensures normal resource_borrowed(ua_on_miss);
    ensures normal resource_return_owned(nullable);
    ensures normal resource_return_kind(reference);
};

// `rd_kafka_toppar_desired_get` (`rdkafka_partition.c:628-639`): walks the
