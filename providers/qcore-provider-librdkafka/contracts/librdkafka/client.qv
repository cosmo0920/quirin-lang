// ## Constructors (each returns a fresh object holding one reference)
//
// `rd_kafka_q_new0` (`rdkafka_queue.c:115-129`): `rkq = rd_malloc(…)`
// (non-null), `rd_kafka_q_init(rkq, rk)` or `rd_kafka_consume_q_init(rkq, rk)`
// (`rd_kafka_q_init0`, `:85-110`: `rkq->rkq_refcnt = 1` at `:92`,
// `rkq->rkq_rk = rk`), then, in the audited build (`ENABLE_DEVEL` off in the
// audited CMake cache), `rkq->rkq_name = func`, and `return rkq;`. The queue
// keeps `rk` and `func`: both are retained by the returned queue (C04.14.2,
// rule 13e), so a caller must show they outlive it (the queue's last reference
// this caller holds is dropped first). Every audited `func` is the
// `__FUNCTION__` the `rd_kafka_q_new` and `rd_kafka_consume_q_new` macros pass
// (`rdkafka_queue.h:149`), a static array.

extern fn rd_kafka_q_new0(rk: ptr<mut, u8>, for_consume: u8, func: ptr<const, u8>, line: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_premise(asserted_allocation, "the result is non-null because it is allocated with rd_malloc (rd.h:145-149), which asserts its result, and the audited compile commands define no NDEBUG, so it never returns NULL in the audited build");
    ensures normal resource_borrowed(rk);
    ensures normal resource_borrowed(for_consume);
    ensures normal resource_borrowed(func);
    ensures normal resource_borrowed(line);
    ensures normal resource_retained_by(rk, result);
    ensures normal resource_retained_by(func, result);
    ensures normal resource_return_owned(nonnull);
    ensures normal resource_return_kind(reference);
};

