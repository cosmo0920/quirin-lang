};

// `rd_kafka_enq_once_trigger` (`rdkafka_queue.h:1110-1149`): drops the
// source's reference (`eonce->refcnt--` under `eonce->lock`), detaches the op
// the eonce held, destroys the eonce at zero (`rd_kafka_enq_once_destroy0`),
// and enqueues the detached op on its reply queue. The op is the eonce's, so
// the caller's balance changes only by the dropped reference. `err` is
// `rd_kafka_resp_err_t`, `i32` (rule 12u, see the head of this module).

extern fn rd_kafka_enq_once_trigger(eonce: ptr<mut, u8>, err: i32, srcdesc: ptr<const, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(eonce);
    ensures normal resource_borrowed(err);
    ensures normal resource_borrowed(srcdesc);
    ensures normal resource_reference_dropped(eonce);
    ensures normal resource_return_none();
};

// ## Owners of references (the decision's hand-offs, existing vocabulary)
//
// A reference stored into an owner is the owner's; the owner's destructor
// drops it. From the caller's side these are an ordinary constructor and
// ordinary destructors.
//
// `rd_kafka_queue_new0` (`rdkafka_queue.c:988-999`): `rkqu =
// rd_calloc(1, sizeof(*rkqu))` (`rd.h:139-143` asserts on failure, so the
// result is never NULL), `rkqu->rkqu_q = rkq`, `rd_kafka_q_keep(rkq)`,
// `rkqu->rkqu_rk = rk`, `return rkqu;`: the reference it takes on `rkq` is
// handed into the queue handle it returns, which `rd_kafka_queue_destroy`
// (`:980-986`) drops before freeing the handle. The caller owes the handle.
// The handle also keeps `rk` (`rkqu->rkqu_rk`), the client's back-pointer.
// Card REFCOUNT-REFERENCE-RETURNING-DECLARATIONS (C04.14.2, gateway rule 13e)
// spells that holder: the handle the call returns retains `rk`, so a caller
// must show the client outlives the handle (the handle is released first);
// otherwise the call is `retention-undecided`, never `Safe` (librdkafka
// requires every queue to be destroyed before its client, which no audited
// caller shows). This replaces the borrowed reading of `rk` recorded as a gap
// by REFCOUNT-RESOURCE-KIND (`RETAINED-BY-RESULT-HOLDER`); the declaration is
// now withheld from the function map with the retaining declarations.

extern fn rd_kafka_queue_new0(rk: ptr<mut, u8>, rkq: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rk);
    ensures normal resource_borrowed(rkq);
    ensures normal resource_retained_by(rk, result);
    ensures normal resource_return_owned(nonnull);
};

// `rd_kafka_topic_partition_list_destroy` (`rdkafka_partition.c:3117-3128`):
// destroys each element in place (`rd_kafka_topic_partition_destroy0(&elems[i],
// 0)`, which frees its topic and metadata and drops the toppar reference its
// `_private` holds), frees `elems`, frees the list. It dereferences
// `rktparlist` unconditionally: `nonnull`.

extern fn rd_kafka_topic_partition_list_destroy(rktparlist: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(rktparlist, nonnull);
    ensures normal resource_return_none();
};

// `rd_kafka_topic_partition_destroy0` (`rdkafka_partition.c:2969-2982`,
// `static`): frees the partition's topic and metadata, destroys its
// `_private` (dropping the toppar reference it holds, `:2962-2967`), and frees
// the partition itself **only when `do_free`**. The literal premise (C04.5)
// confines the declaration to the call sites passing `1` (`rd_true` is `1`,
// `rdtypes.h:50`): `rd_kafka_topic_partition_destroy` (`:3108-3110`) and
// `rd_kafka_topic_partition_destroy_free` (`:3104-3106`). The sites passing
// `0` (the list destructor and `_list_clear`) stay undeclared, which answers
// the conditional-release ground on which `topic_partition.qv` left it
// undeclared; its other ground (W4 is the lever) does not hold, because its
// body drops the reference `_private` holds through a member read, which no
// rule infers (`REFCOUNT-MEMBER-REFERENCE-DROP`).

extern fn rd_kafka_topic_partition_destroy0(rktpar: ptr<mut, u8>, do_free: i32) -> unit
contract {
    requires resource_contract_v1;
    requires resource_literal_argument(do_free, 1);
    ensures normal resource_released(rktpar, nonnull);
    ensures normal resource_borrowed(do_free);
    ensures normal resource_return_none();
};

