    quant proposition #plugin_interceptor_custody(#acquire: action, #action: function<environment,event,action>, #activation: function<environment,event,activation>, #env: environment, #global_custody: action, #in_interceptor: function<environment,event,integer>, #in_trace: predicate<environment,event>, #loaded: predicate<environment,plugin,family>, #local_resource: function<environment,event,integer>, #plugin: function<environment,event,plugin>, #pointer_borrowed: function<environment,event,integer>, #release: action, #resource: function<environment,event,resource>, #retain: action, #return_boundary: function<environment,activation,integer>, #return_local: action, #scalar_borrowed: function<environment,event,integer>, #time: function<environment,event,integer>, #transfer: action) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => forall (#ev: event) { ((#in_trace(#env,#ev) && (#plugin(#env,#ev) == #p)) => ((#in_interceptor(#env,#ev) == 1) => (((((((#pointer_borrowed(#env,#ev) == 1) && (#scalar_borrowed(#env,#ev) == 1)) && ((#action(#env,#ev) == #release) => (#local_resource(#env,#ev) == 1))) && (#action(#env,#ev) != #retain)) && (#action(#env,#ev) != #transfer)) && (#action(#env,#ev) != #global_custody)) && ((#action(#env,#ev) == #acquire) => exists (#drop: event) { ((((((#in_trace(#env,#drop) && (#plugin(#env,#drop) == #p)) && (#resource(#env,#drop) == #resource(#env,#ev))) && (#activation(#env,#drop) == #activation(#env,#ev))) && (#action(#env,#drop) == #return_local)) && (#time(#env,#ev) < #time(#env,#drop))) && (#time(#env,#drop) < #return_boundary(#env,#activation(#env,#ev)))) })))) }) };
    requires resource_lifecycle_v1(introduce_plugin_interceptor_custody, |^+ hypothesis(plugin_interceptor_custody));
    quant proposition #plugin_interceptor_registration(#action: function<environment,event,action>, #conf_live: function<environment,event,integer>, #config_registration: function<environment,event,integer>, #env: environment, #exact_candidate: function<environment,event,integer>, #from_on_new: function<environment,event,integer>, #in_trace: predicate<environment,event>, #initialized: function<environment,event,integer>, #intercept: action, #loaded: predicate<environment,plugin,family>, #plugin: function<environment,event,plugin>, #public_setter: function<environment,event,integer>, #result: function<environment,event,integer>, #share_consumer: function<environment,event,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => forall (#reg: event) { ((#in_trace(#env,#reg) && (#plugin(#env,#reg) == #p)) => ((#action(#env,#reg) == #intercept) => ((((#public_setter(#env,#reg) == 1) && (#result(#env,#reg) == 0)) && (#exact_candidate(#env,#reg) == 1)) && (((#config_registration(#env,#reg) == 1) && (#conf_live(#env,#reg) == 1)) || ((((#config_registration(#env,#reg) == 0) && (#from_on_new(#env,#reg) == 1)) && (#initialized(#env,#reg) == 0)) && (#share_consumer(#env,#reg) == 0)))))) }) };
    requires resource_lifecycle_v1(introduce_plugin_interceptor_registration, |^+ hypothesis(plugin_interceptor_registration));
    quant proposition #plugin_lifecycle_unload(#action: function<environment,event,action>, #close: action, #copy_reference: action, #destroy_callback: action, #env: environment, #handle: function<environment,event,handle>, #handle_for: function<environment,plugin,handle>, #in_trace: predicate<environment,event>, #invoke: action, #loaded: predicate<environment,plugin,family>, #plugin: function<environment,event,plugin>, #ref_count: function<environment,handle,integer,integer>, #time: function<environment,event,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => (forall (#stop: event) { ((#in_trace(#env,#stop) && (#plugin(#env,#stop) == #p)) => ((((#action(#env,#stop) == #close) && (#handle(#env,#stop) == #handle_for(#env,#p))) && (#ref_count(#env,#handle(#env,#stop),#time(#env,#stop)) == 0)) => forall (#call: event) { ((#in_trace(#env,#call) && (#plugin(#env,#call) == #p)) => (((#action(#env,#call) == #invoke) || (#action(#env,#call) == #destroy_callback)) => (#time(#env,#call) < #time(#env,#stop)))) })) } && forall (#copy: event) { ((#in_trace(#env,#copy) && (#plugin(#env,#copy) == #p)) => ((#action(#env,#copy) == #copy_reference) => (0 < #ref_count(#env,#handle_for(#env,#p),#time(#env,#copy))))) })) };
    requires resource_lifecycle_v1(introduce_plugin_lifecycle_unload, |^+ hypothesis(plugin_lifecycle_unload));
    quant proposition #plugin_outer_bridge(#env: environment, #fluent_c: family, #fluent_go: family, #fluent_proposed: predicate<environment,plugin>, #loaded: predicate<environment,plugin,family>, #rk: family, #rk_proposed: predicate<environment,plugin>) = (forall (#p: plugin) { (#loaded(#env,#p,#rk) => #rk_proposed(#env,#p)) } && forall (#p: plugin) { ((#loaded(#env,#p,#fluent_c) || #loaded(#env,#p,#fluent_go)) => #fluent_proposed(#env,#p)) });
    requires resource_lifecycle_v1(introduce_plugin_outer_bridge, |^+ hypothesis(plugin_outer_bridge));
    requires resource_premise_decomposition(rk_plugin_callback_closure, plugin_artifact_symbol_abi, plugin_callback_candidates, plugin_code_context_lifetime, plugin_interceptor_custody, plugin_interceptor_registration, plugin_lifecycle_unload, plugin_outer_bridge);
    requires resource_premise_flow_v1(decompose_rk_plugin_callback_closure, ((((((plugin_artifact_symbol_abi |-> plugin_callback_candidates) |-> plugin_code_context_lifetime) |-> plugin_interceptor_custody) |-> plugin_interceptor_registration) |-> plugin_lifecycle_unload) |-> plugin_outer_bridge));
    ensures normal resource_borrowed(rkb);
    ensures normal resource_borrowed(rktp);
    ensures normal resource_borrowed(err);
    ensures normal resource_return_none();
};

// ## Lists with a free callback (card CG22-CALLBACK-REGISTRY-CONTRACT)
//
// Contract spec C04.19, gateway rules 13w (registry) and 13x (element custody,
// flag-conditioned self-release). Each body read at both audited revisions
// (byte-identical at `66910c10` and `046accf6`, `scripts/body.py` of the
// card's report), `lib/librdkafka-2.15.0/src/rdlist.c`; prototypes
// `rdlist.h:72,89,138,216,225`.
//
// `rd_list_init(rl, initial_size, free_cb)` (`:53-62`): `memset(rl, 0, …)`
// (which clears `RD_LIST_F_ALLOCATED`), grows the element array when
// `initial_size > 0`, stores `rl->rl_free_cb = free_cb` and returns `rl`. The
// list keeps the callback: `resource_callback_registered(free_cb, rl)`, an
// in-place registration; rule 13y checks it against this body (the callback
// is mentioned only as the value of `rl->rl_free_cb = free_cb;`). The result
// is its argument (`resource_return_alias(rl, nonnull)`).
//
// `rd_list_new(initial_size, free_cb)` (`:84-89`): `rl = rd_list_alloc()`
// (`rd_malloc`, which aborts rather than return NULL), `rd_list_init(rl, …)`,
// then `rl->rl_flags |= RD_LIST_F_ALLOCATED`, and returns `rl`: a fresh list
// the caller owns, registered by a constructor:
// `resource_callback_registered(free_cb, result)` beside
// `resource_return_owned(nonnull)`.
//
// `rd_list_add(rl, elem)` (`:143-150`): grows the array when full, clears
// `RD_LIST_F_SORTED`, stores a non-NULL `elem` as the next element and returns
// that slot's element (a preallocated element when `elem` is NULL). `elem`
// becomes an element `rl` holds: `resource_element_added(elem, rl)` (custody
// passes to the list when its registered callback releases its argument,
// otherwise the list only retains `elem`). The result points into what the
// list holds: `resource_return_borrowed_from(rl, nullable)`.
//
// `rd_list_destroy(rl)` (`:316-320`): `rd_list_destroy_elems(rl)` (`:290-306`:
// when `rl->rl_free_cb` is set, calls it on every non-NULL element, last
// first, then frees the element array and zeroes the count), then
// `rd_free(rl)` exactly when `rl->rl_flags & RD_LIST_F_ALLOCATED`:
// `resource_callback_registry_invoked(rl, element)`,
// `resource_elements_dropped(rl)`, `resource_callback_unregistered(rl)` (the
// list is gone, or holds nothing a later call may use) and
// `resource_released_if_constructed(rl)`. `rd_list_clear(rl)` (`:311-313`) is
// `rd_list_destroy_elems(rl)` alone: the registry invoked over the elements,
// which are dropped; the registration stays.
//
// Route G decides each of these only where the registration is in force on
// every path in the calling body: a frame list `&L` named nowhere else, or a
// list a constructor returned. A list reached through a formal or a member
// (every list the measured callers destroy) is undecided, never Safe.

extern fn rd_list_init(rl: ptr<mut, u8>, initial_size: i32, free_cb: fnptr) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_borrowed(initial_size);
    ensures normal resource_borrowed(free_cb);
    ensures normal resource_callback_registered(free_cb, rl);
    ensures normal resource_return_alias(rl, nonnull);
};

extern fn rd_list_new(initial_size: i32, free_cb: fnptr) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(initial_size);
    ensures normal resource_borrowed(free_cb);
    ensures normal resource_callback_registered(free_cb, result);
    ensures normal resource_return_owned(nonnull);
};

extern fn rd_list_add(rl: ptr<mut, u8>, elem: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_borrowed(elem);
    ensures normal resource_element_added(elem, rl);
    ensures normal resource_return_borrowed_from(rl, nullable);
};

extern fn rd_list_destroy(rl: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_callback_registry_invoked(rl, element);
    ensures normal resource_elements_dropped(rl);
    ensures normal resource_callback_unregistered(rl);
    ensures normal resource_released_if_constructed(rl);
    ensures normal resource_return_none();
};

extern fn rd_list_clear(rl: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_callback_registry_invoked(rl, element);
    ensures normal resource_elements_dropped(rl);
    ensures normal resource_return_none();
};

// ## nanopb's output stream (card CG22-CALLBACK-REGISTRY-CONTRACT)
//
// `lib/librdkafka-2.15.0/src/nanopb/pb_encode.c`, each body byte-identical at
// both audited revisions. `pb_write(stream, buf, count)` (`:83-104`): when
// `count > 0` and `stream->callback` is set, checks the stream's size limit
// and calls `stream->callback(stream, buf, count)`; then adds `count` to
// `stream->bytes_written`. `pb_encode_varint(stream, value)` (`:606-…`)
// encodes `value` into a local buffer and calls `pb_write(stream, buffer, i)`.
// Both call, during the call, the callback the stream keeps:
// `resource_callback_registry_invoked(stream, …)`. The registration is
// `pb_ostream_from_buffer`, which returns the stream BY VALUE with `callback =
// &buf_write` (`:61-79`): a by-value aggregate result, which the declared-ABI
// reader does not read, so no registration is ever in force in a calling
// body and every call refuses (`callback-registry-undecided`), as every
// measured caller (a formal `stream`) would anyway. `pb_byte_t *` is
// `ptr<const, u8>`; `bool` the result, a status; `pb_uint64_t` is `uint64_t`
// (this build defines no `PB_WITHOUT_64BIT`).

extern fn pb_write(stream: ptr<mut, u8>, buf: ptr<const, u8>, count: usize) -> bool
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(stream);
    ensures normal resource_borrowed(buf);
    ensures normal resource_borrowed(count);
    ensures normal resource_callback_registry_invoked(stream, stream, buf, count);
    ensures normal resource_return_none();
};

extern fn pb_encode_varint(stream: ptr<mut, u8>, value: u64) -> bool
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(stream);
    ensures normal resource_borrowed(value);
    ensures normal resource_callback_registry_invoked(stream, stream, _, _);
    ensures normal resource_return_none();
};

// ## Card W45-CALLEE-CASCADE-RESIDUAL round 3: Admin-API destructors
//
// FIVE TRUSTED ASSUMPTIONS, pinned (C06.2) after reading each body at both
// audited revisions (`rdkafka_admin.c` is byte-identical at `66910c10` and
// `046accf6`). Each is the only uncontracted call of its `_free` wrapper
// (`static void ..._free(void *ptr) { ..._destroy(ptr); }`) and of its
// `_destroy_array` loop.
//
// Each destructor releases its object and everything the object owns, and
// nothing else; none drops a reference or releases a child it does not own:
//
//   * `rd_kafka_AclBinding_destroy` (`:5393-5403`) frees `name`, `principal`
//     and `host` (each `rd_strdup`ed by `rd_kafka_AclBinding_new0`, `:5202-5227`,
//     NULL-tested) and destroys `error` (a fresh `rd_kafka_error_new` there,
//     NULL-tested), then frees the binding.
//   * `rd_kafka_ConfigResource_destroy` (`:2976-2981`) destroys the embedded
//     `config` list (initialised with the free callback
//     `rd_kafka_ConfigEntry_free`, `:2971`: the list owns its entries), frees
//     `errstr` when set, then frees the resource (its name is in the same
//     allocation).
//   * `rd_kafka_NewPartitions_destroy` (`:2516-2519`) destroys the embedded
//     `replicas` list (`rd_list_init(..., rd_list_destroy_free)`, `:2483`: it
//     owns its replica lists) and frees the object.
//   * `rd_kafka_NewTopic_destroy` (`:1950-1955`) destroys the embedded
//     `replicas` (`:1905`, owning) and `config` (`:1911`,
//     `rd_kafka_ConfigEntry_free`) lists, frees `topic` (`rd_strdup`) and the
//     object.
//   * `rd_kafka_UserScramCredentialAlteration_destroy` (`:6070-6082`) returns
//     at once on NULL (`nullable`); otherwise frees `user` and, for an upsert,
//     the `salt` and `password` byte buffers it copied in its constructor
//     (`:6040-6049`), then the object.
//
// The first four dereference their argument unconditionally: `nonnull`. The
// release is the declared assumption; where `rdkafka_admin.c` is analysed,
// each body is examined against it (rule 13g's fold) and the report states
// the standing. NOT CLAIMED: anything about the list elements' own release
// callbacks beyond their being the library's own functions fixed at
// construction.

extern fn rd_kafka_AclBinding_destroy(acl_binding: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(acl_binding, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_ConfigResource_destroy(config: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(config, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_NewPartitions_destroy(newps: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(newps, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_NewTopic_destroy(new_topic: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(new_topic, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_UserScramCredentialAlteration_destroy(alteration: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(alteration, nullable);
    ensures normal resource_return_none();
};

// ## Card W45-CALLEE-CASCADE-RESIDUAL round 3: `unit_test_telemetry`
//
// ONE TRUSTED ASSUMPTION, pinned after reading the body at both revisions
// (`rdkafka_telemetry_decode.c:525-786`, byte-identical). It is the only
// uncontracted call of `unit_test_telemetry_gauge` and `_sum`.
//
// The body builds its own client and broker (`rd_calloc`), calls
// `set_metric_value(rk, rkb)` once with those two objects it allocated
// (`:651`, the only mention of `set_metric_value` besides its declaration),
// encodes and decodes a telemetry payload, compares the decoded fields with
// `expected_name` and `expected_description` (`strncmp`, `strcmp`) and with
// the scalars (stored in the file-scope `unit_test_data` by
// `clear_unit_test_data`, `:76-94`, scalars only), frees what it allocated on
// the passing path, and returns 0 or 1 (`RD_UT_ASSERT` returns 1 early,
// leaking only its own objects). It keeps no pointer the caller passed and
// releases nothing the caller owns: every parameter borrowed, the callback a
// synchronous invocation over two values the callee supplies
// (`resource_callback_invoked(set_metric_value, _, _)`, C04.19; rule 13y
// checks it against the body). `rd_kafka_type_t`, the producer metric name
// and `rd_kafka_telemetry_metric_type_t` are enumerations with no negative
// enumerator (`rdkafka.h:209-212`, `rdkafka_telemetry_encode.h:53-70`):
// `u32` (C04.1); `rd_bool_t` is `uint8_t` (`rdtypes.h:49`).

// LIBRDKAFKA-PLUGIN-PREMISE-UNSTATED: `unit_test_telemetry` may run an rk_conf
// callback (unit_test_telemetry -> rd_kafka_telemetry_encode_metrics ->
// rd_kafka_log0 -> rd_kafka_log_buf -> conf->log_cb; reached: log_cb,
// on_acknowledgement, on_conf_destroy, on_conf_set, on_response_received), so
// it names `rk_plugin_callback_closure`.
extern fn unit_test_telemetry(rk_type: u32, metric_name: u32, expected_name: ptr<const, u8>, expected_description: ptr<const, u8>, expected_type: u32, is_double: u8, is_per_broker: u8, set_metric_value: fnptr, expected_value_int: i64, expected_value_double: f64) -> i32
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    quant proposition #plugin_artifact_symbol_abi(#actual_abi: function<environment,integer,abi>, #actual_artifact: function<environment,plugin,digest>, #actual_build: function<environment,plugin,digest>, #actual_inventory: function<environment,digest>, #env: environment, #expected_abi: function<environment,integer,abi>, #expected_address: function<environment,plugin,symbol,integer>, #expected_artifact: function<environment,plugin,digest>, #expected_build: function<environment,plugin,digest>, #expected_inventory: function<environment,digest>, #loaded: predicate<environment,plugin,family>, #loader_enabled: function<environment,family,integer>, #required_symbol: predicate<environment,plugin,symbol>, #resolved_address: function<environment,plugin,symbol,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => (((((#actual_build(#env,#p) == #expected_build(#env,#p)) && (#actual_inventory(#env) == #expected_inventory(#env))) && forall (#family: family) { (#loaded(#env,#p,#family) => (#loader_enabled(#env,#family) == 1)) }) && (#actual_artifact(#env,#p) == #expected_artifact(#env,#p))) && forall (#symbol: symbol) { (#required_symbol(#env,#p,#symbol) => (((#resolved_address(#env,#p,#symbol) == #expected_address(#env,#p,#symbol)) && (#resolved_address(#env,#p,#symbol) != 0)) && (#actual_abi(#env,#resolved_address(#env,#p,#symbol)) == #expected_abi(#env,#expected_address(#env,#p,#symbol))))) })) };
    requires resource_lifecycle_v1(introduce_plugin_artifact_symbol_abi, |^+ hypothesis(plugin_artifact_symbol_abi));
    quant proposition #plugin_callback_candidates(#action: function<environment,event,action>, #env: environment, #function: function<environment,event,callback>, #in_trace: predicate<environment,event>, #invoke: action, #member: function<environment,event,member>, #member_candidate: predicate<environment,member,callback>, #public_setter: function<environment,event,integer>, #register: action, #result: function<environment,event,integer>, #static_default: predicate<environment,member,callback>, #time: function<environment,event,integer>) = forall (#ev: event) { ((#in_trace(#env,#ev) && (#action(#env,#ev) == #invoke)) => (#member_candidate(#env,#member(#env,#ev),#function(#env,#ev)) && (#static_default(#env,#member(#env,#ev),#function(#env,#ev)) || exists (#reg: event) { ((((((#in_trace(#env,#reg) && (#action(#env,#reg) == #register)) && (#function(#env,#reg) == #function(#env,#ev))) && (#member(#env,#reg) == #member(#env,#ev))) && (#time(#env,#reg) < #time(#env,#ev))) && (#result(#env,#reg) == 0)) && (#public_setter(#env,#reg) == 1)) }))) };
    requires resource_lifecycle_v1(introduce_plugin_callback_candidates, |^+ hypothesis(plugin_callback_candidates));
    quant proposition #plugin_code_context_lifetime(#action: function<environment,event,action>, #code_live: predicate<environment,callback,integer>, #context_live: predicate<environment,context,integer>, #destroy_callback: action, #env: environment, #function: function<environment,event,callback>, #in_trace: predicate<environment,event>, #invoke: action, #loaded: predicate<environment,plugin,family>, #opaque: function<environment,event,context>, #plugin: function<environment,event,plugin>, #time: function<environment,event,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => forall (#ev: event) { ((#in_trace(#env,#ev) && (#plugin(#env,#ev) == #p)) => (((#action(#env,#ev) == #invoke) || (#action(#env,#ev) == #destroy_callback)) => (#code_live(#env,#function(#env,#ev),#time(#env,#ev)) && #context_live(#env,#opaque(#env,#ev),#time(#env,#ev))))) }) };
    requires resource_lifecycle_v1(introduce_plugin_code_context_lifetime, |^+ hypothesis(plugin_code_context_lifetime));
    quant proposition #plugin_interceptor_custody(#acquire: action, #action: function<environment,event,action>, #activation: function<environment,event,activation>, #env: environment, #global_custody: action, #in_interceptor: function<environment,event,integer>, #in_trace: predicate<environment,event>, #loaded: predicate<environment,plugin,family>, #local_resource: function<environment,event,integer>, #plugin: function<environment,event,plugin>, #pointer_borrowed: function<environment,event,integer>, #release: action, #resource: function<environment,event,resource>, #retain: action, #return_boundary: function<environment,activation,integer>, #return_local: action, #scalar_borrowed: function<environment,event,integer>, #time: function<environment,event,integer>, #transfer: action) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => forall (#ev: event) { ((#in_trace(#env,#ev) && (#plugin(#env,#ev) == #p)) => ((#in_interceptor(#env,#ev) == 1) => (((((((#pointer_borrowed(#env,#ev) == 1) && (#scalar_borrowed(#env,#ev) == 1)) && ((#action(#env,#ev) == #release) => (#local_resource(#env,#ev) == 1))) && (#action(#env,#ev) != #retain)) && (#action(#env,#ev) != #transfer)) && (#action(#env,#ev) != #global_custody)) && ((#action(#env,#ev) == #acquire) => exists (#drop: event) { ((((((#in_trace(#env,#drop) && (#plugin(#env,#drop) == #p)) && (#resource(#env,#drop) == #resource(#env,#ev))) && (#activation(#env,#drop) == #activation(#env,#ev))) && (#action(#env,#drop) == #return_local)) && (#time(#env,#ev) < #time(#env,#drop))) && (#time(#env,#drop) < #return_boundary(#env,#activation(#env,#ev)))) })))) }) };
    requires resource_lifecycle_v1(introduce_plugin_interceptor_custody, |^+ hypothesis(plugin_interceptor_custody));
    quant proposition #plugin_interceptor_registration(#action: function<environment,event,action>, #conf_live: function<environment,event,integer>, #config_registration: function<environment,event,integer>, #env: environment, #exact_candidate: function<environment,event,integer>, #from_on_new: function<environment,event,integer>, #in_trace: predicate<environment,event>, #initialized: function<environment,event,integer>, #intercept: action, #loaded: predicate<environment,plugin,family>, #plugin: function<environment,event,plugin>, #public_setter: function<environment,event,integer>, #result: function<environment,event,integer>, #share_consumer: function<environment,event,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => forall (#reg: event) { ((#in_trace(#env,#reg) && (#plugin(#env,#reg) == #p)) => ((#action(#env,#reg) == #intercept) => ((((#public_setter(#env,#reg) == 1) && (#result(#env,#reg) == 0)) && (#exact_candidate(#env,#reg) == 1)) && (((#config_registration(#env,#reg) == 1) && (#conf_live(#env,#reg) == 1)) || ((((#config_registration(#env,#reg) == 0) && (#from_on_new(#env,#reg) == 1)) && (#initialized(#env,#reg) == 0)) && (#share_consumer(#env,#reg) == 0)))))) }) };
