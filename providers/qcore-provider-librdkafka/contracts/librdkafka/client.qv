// `rd_kafka_confval_set_type(confval, valuetype, valuep, errstr,
// errstr_size)` (`:3763-3874`) switches on **`confval->valuetype`**, the
// holder's own stored type: its INT arm reads `*valuep` or parses it, its
// STR arm copies it (`rd_strdup`), and its PTR arm stores it
// (`confval->u.PTR = (void *)valuep`) without reading the `valuetype`
// argument at all. The retention is therefore NOT conditioned on the
// argument (USER DECISION 2026-10-05's guard, C04.14.1, would be false of
// this body, which a caller passing the INT constant (0) for a PTR-typed
// `confval` still has retained), and it is declared unconditionally: the
// cautious reading.
extern fn rd_kafka_confval_set_type(confval: ptr<mut, u8>, valuetype: u32, valuep: ptr<const, u8>, errstr: ptr<mut, u8>, errstr_size: usize) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(confval);
    ensures normal resource_borrowed(valuetype);
    ensures normal resource_borrowed(valuep);
    ensures normal resource_borrowed(errstr);
    ensures normal resource_borrowed(errstr_size);
    ensures normal resource_retained_by(valuep, confval);
    ensures normal resource_return_none();
};

