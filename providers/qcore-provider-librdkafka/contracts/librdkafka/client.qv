// audited CMake cache), `rkq->rkq_name = func`, and `return rkq;`. The queue
// keeps `rk` and `func`: both are retained by the returned queue (C04.14.2,
// rule 13e), so a caller must show they outlive it (the queue's last reference
// this caller holds is dropped first). Every audited `func` is the
// `__FUNCTION__` the `rd_kafka_q_new` and `rd_kafka_consume_q_new` macros pass
// (`rdkafka_queue.h:149`), a static array.

extern fn rd_kafka_q_new0(rk: ptr<mut, u8>, for_consume: u8, func: ptr<const, u8>, line: i32) -> ptr<mut, u8>
