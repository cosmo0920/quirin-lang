// ## Card W45-CALLEE-CASCADE-RESIDUAL round 3: `unit_test_telemetry`
//
// ONE TRUSTED ASSUMPTION, pinned after reading the body at both revisions
// (`rdkafka_telemetry_decode.c:525-786`, byte-identical). It is the only
// uncontracted call of `unit_test_telemetry_gauge` and `_sum`.
//
// The body builds its own client and broker (`rd_calloc`), calls
// `set_metric_value(rk, rkb)` once with those two objects it allocated
// (`:651`, the only mention of `set_metric_value` besides its declaration),
// encodes and decodes a telemetry payload, compares the decoded fields with
// `expected_name` and `expected_description` (`strncmp`, `strcmp`) and with
// the scalars (stored in the file-scope `unit_test_data` by
// `clear_unit_test_data`, `:76-94`, scalars only), frees what it allocated on
// the passing path, and returns 0 or 1 (`RD_UT_ASSERT` returns 1 early,
// leaking only its own objects). It keeps no pointer the caller passed and
// releases nothing the caller owns: every parameter borrowed, the callback a
// synchronous invocation over two values the callee supplies
// (`resource_callback_invoked(set_metric_value, _, _)`, C04.19; rule 13y
// checks it against the body). `rd_kafka_type_t`, the producer metric name
// and `rd_kafka_telemetry_metric_type_t` are enumerations with no negative
// enumerator (`rdkafka.h:209-212`, `rdkafka_telemetry_encode.h:53-70`):
// `u32` (C04.1); `rd_bool_t` is `uint8_t` (`rdtypes.h:49`).

extern fn unit_test_telemetry(rk_type: u32, metric_name: u32, expected_name: ptr<const, u8>, expected_description: ptr<const, u8>, expected_type: u32, is_double: u8, is_per_broker: u8, set_metric_value: fnptr, expected_value_int: i64, expected_value_double: f64) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rk_type);
    ensures normal resource_borrowed(metric_name);
    ensures normal resource_borrowed(expected_name);
    ensures normal resource_borrowed(expected_description);
    ensures normal resource_borrowed(expected_type);
    ensures normal resource_borrowed(is_double);
    ensures normal resource_borrowed(is_per_broker);
    ensures normal resource_borrowed(set_metric_value);
    ensures normal resource_callback_invoked(set_metric_value, _, _);
    ensures normal resource_borrowed(expected_value_int);
    ensures normal resource_borrowed(expected_value_double);
    ensures normal resource_return_none();
};

// BEGIN CG22-OP-CALLBACKS-AND-SERVED-QUEUES (scripts/write_contracts.py)

// # Served queues and the op destroyer
//
// Card CG22-OP-CALLBACKS-AND-SERVED-QUEUES (gateway rules 12m-12o, contract
// specification C04.19.1-C04.19.3), on the user's decision of 2026-10-14:
// `supplied_owned` for an object the callee hands its callback, a member
// invocation `TAG.FIELD` whose candidates are the run's closed set of stores
// into the member (premise P-CG22-MEMBER-CLOSED-WORLD), and a type-switched
// release, one `when FIELD == VALUE` / `otherwise` clause per arm. Every body
// was read at `66910c10` and `046accf6` (byte-identical, `scripts/body.py` of
// the card's report); each declaration is pinned (C06.2).
//
// The queue serving family (`rdkafka_queue.c:398-680`): under `rkq->rkq_lock`
// a forward queue is kept (`rd_kafka_q_fwd_get`), served recursively and
// dropped (`rd_kafka_q_destroy`); otherwise each dequeued op goes to
// `rd_kafka_op_handle` (`rdkafka_op.c:1096-1124`), which runs the op's own
// `rko_op_cb` when it is a callback op (`rd_kafka_op_handle_std` ->
// `rd_kafka_op_call`), replaces the caller's `callback` and `opaque` with the
// op's `rko_serve` / `rko_serve_opaque` when set, destroys a handled op, and
// otherwise hands the op to `callback(rk, rkq, rko, cb_type, opaque)`, which
// takes it (`rd_kafka_q_serve0` asserts the result is not `PASS`; the pop
// variants hand a `PASS` op back as their result). `rkq`, `opaque` and the
// other arguments are only read: `resource_borrowed`. `cb_type` is
// `rd_kafka_q_cb_type_t` (`rdkafka_op.h:270-277`, no negative value: `u32`),
// `rd_ts_t` is `int64_t` (`rdtypes.h:44`), `rd_bool_t` is `uint8_t`
// (`rdtypes.h:49`). The op's own `rko_op_cb` borrows the op (`_`: a handled op
// is destroyed by the callee, a kept one is the callback's, which rule 13u
// refuses as effectful); `rko_serve` takes it as `callback` does.
//
// These declarations decide nothing in the corpus today: every callback the
// corpus passes (`rd_kafka_poll_cb`, `rd_kafka_consume_cb`,
// `rd_kafka_background_queue_serve`) calls a callback the application
// registered in `rk` (the pending `rd_kafka_destroy_app` decision) and has no
// contract, and the op members' closed sets hold candidates with no contract
// (`OP-CALLBACK-CANDIDATE-CONTRACTS`). They replace an uncontracted call with
// a named refusal. The served-queue premise on `rd_kafka_q_wait_result` and
// `rd_kafka_q_purge0` (C04.18, above) is unchanged.


// `rd_kafka_q_serve0` (`rdkafka_queue.c:558-649`).
extern fn rd_kafka_q_serve0(rkq: ptr<mut, u8>, timeout_ms: i32, max_cnt: i32, cb_type: u32, callback: fnptr, opaque: ptr<mut, u8>, is_consume_call: u8) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkq);
    ensures normal resource_borrowed(timeout_ms);
    ensures normal resource_borrowed(max_cnt);
    ensures normal resource_borrowed(cb_type);
    ensures normal resource_borrowed(callback);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_borrowed(is_consume_call);
    ensures normal resource_callback_invoked(callback, _, _, supplied_owned, cb_type, opaque);
    ensures normal resource_callback_member_invoked(supplied_owned, rd_kafka_op_s.rko_serve, _, _, supplied_owned, cb_type, _);
    ensures normal resource_callback_member_invoked(supplied_owned, rd_kafka_op_s.rko_op_cb, _, _, _);
    ensures normal resource_return_none();
};

