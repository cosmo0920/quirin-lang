    ensures normal resource_borrowed(for_consume);
    ensures normal resource_borrowed(func);
    ensures normal resource_borrowed(line);
    ensures normal resource_retained_by(rk, result);
    ensures normal resource_retained_by(func, result);
    ensures normal resource_return_owned(nonnull);
    ensures normal resource_return_kind(reference);
};

