// ## Lists with a free callback (card CG22-CALLBACK-REGISTRY-CONTRACT)
//
// Contract spec C04.19, gateway rules 13w (registry) and 13x (element custody,
// flag-conditioned self-release). Each body read at both audited revisions
// (byte-identical at `66910c10` and `046accf6`, `scripts/body.py` of the
// card's report), `lib/librdkafka-2.15.0/src/rdlist.c`; prototypes
// `rdlist.h:72,89,138,216,225`.
//
// `rd_list_init(rl, initial_size, free_cb)` (`:53-62`): `memset(rl, 0, …)`
// (which clears `RD_LIST_F_ALLOCATED`), grows the element array when
// `initial_size > 0`, stores `rl->rl_free_cb = free_cb` and returns `rl`. The
// list keeps the callback: `resource_callback_registered(free_cb, rl)`, an
// in-place registration; rule 13y checks it against this body (the callback
// is mentioned only as the value of `rl->rl_free_cb = free_cb;`). The result
// is its argument (`resource_return_alias(rl, nonnull)`).
//
// `rd_list_new(initial_size, free_cb)` (`:84-89`): `rl = rd_list_alloc()`
// (`rd_malloc`, which aborts rather than return NULL), `rd_list_init(rl, …)`,
// then `rl->rl_flags |= RD_LIST_F_ALLOCATED`, and returns `rl`: a fresh list
// the caller owns, registered by a constructor:
// `resource_callback_registered(free_cb, result)` beside
// `resource_return_owned(nonnull)`.
//
// `rd_list_add(rl, elem)` (`:143-150`): grows the array when full, clears
// `RD_LIST_F_SORTED`, stores a non-NULL `elem` as the next element and returns
// that slot's element (a preallocated element when `elem` is NULL). `elem`
// becomes an element `rl` holds: `resource_element_added(elem, rl)` (custody
// passes to the list when its registered callback releases its argument,
// otherwise the list only retains `elem`). The result points into what the
// list holds: `resource_return_borrowed_from(rl, nullable)`.
//
// `rd_list_destroy(rl)` (`:316-320`): `rd_list_destroy_elems(rl)` (`:290-306`:
// when `rl->rl_free_cb` is set, calls it on every non-NULL element, last
// first, then frees the element array and zeroes the count), then
// `rd_free(rl)` exactly when `rl->rl_flags & RD_LIST_F_ALLOCATED`:
// `resource_callback_registry_invoked(rl, element)`,
// `resource_elements_dropped(rl)`, `resource_callback_unregistered(rl)` (the
// list is gone, or holds nothing a later call may use) and
// `resource_released_if_constructed(rl)`. `rd_list_clear(rl)` (`:311-313`) is
// `rd_list_destroy_elems(rl)` alone: the registry invoked over the elements,
// which are dropped; the registration stays.
//
// Route G decides each of these only where the registration is in force on
// every path in the calling body: a frame list `&L` named nowhere else, or a
// list a constructor returned. A list reached through a formal or a member
// (every list the measured callers destroy) is undecided, never Safe.

extern fn rd_list_init(rl: ptr<mut, u8>, initial_size: i32, free_cb: fnptr) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_borrowed(initial_size);
    ensures normal resource_borrowed(free_cb);
    ensures normal resource_callback_registered(free_cb, rl);
    ensures normal resource_return_alias(rl, nonnull);
};

extern fn rd_list_new(initial_size: i32, free_cb: fnptr) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(initial_size);
    ensures normal resource_borrowed(free_cb);
    ensures normal resource_callback_registered(free_cb, result);
    ensures normal resource_return_owned(nonnull);
};

extern fn rd_list_add(rl: ptr<mut, u8>, elem: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_borrowed(elem);
    ensures normal resource_element_added(elem, rl);
    ensures normal resource_return_borrowed_from(rl, nullable);
};

extern fn rd_list_destroy(rl: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_callback_registry_invoked(rl, element);
    ensures normal resource_elements_dropped(rl);
    ensures normal resource_callback_unregistered(rl);
    ensures normal resource_released_if_constructed(rl);
    ensures normal resource_return_none();
};

extern fn rd_list_clear(rl: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rl);
    ensures normal resource_callback_registry_invoked(rl, element);
    ensures normal resource_elements_dropped(rl);
    ensures normal resource_return_none();
};

// ## nanopb's output stream (card CG22-CALLBACK-REGISTRY-CONTRACT)
//
// `lib/librdkafka-2.15.0/src/nanopb/pb_encode.c`, each body byte-identical at
// both audited revisions. `pb_write(stream, buf, count)` (`:83-104`): when
// `count > 0` and `stream->callback` is set, checks the stream's size limit
// and calls `stream->callback(stream, buf, count)`; then adds `count` to
// `stream->bytes_written`. `pb_encode_varint(stream, value)` (`:606-…`)
// encodes `value` into a local buffer and calls `pb_write(stream, buffer, i)`.
// Both call, during the call, the callback the stream keeps:
// `resource_callback_registry_invoked(stream, …)`. The registration is
// `pb_ostream_from_buffer`, which returns the stream BY VALUE with `callback =
// &buf_write` (`:61-79`): a by-value aggregate result, which the declared-ABI
// reader does not read, so no registration is ever in force in a calling
// body and every call refuses (`callback-registry-undecided`), as every
// measured caller (a formal `stream`) would anyway. `pb_byte_t *` is
// `ptr<const, u8>`; `bool` the result, a status; `pb_uint64_t` is `uint64_t`
// (this build defines no `PB_WITHOUT_64BIT`).

extern fn pb_write(stream: ptr<mut, u8>, buf: ptr<const, u8>, count: usize) -> bool
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(stream);
    ensures normal resource_borrowed(buf);
    ensures normal resource_borrowed(count);
    ensures normal resource_callback_registry_invoked(stream, stream, buf, count);
    ensures normal resource_return_none();
};

extern fn pb_encode_varint(stream: ptr<mut, u8>, value: u64) -> bool
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(stream);
    ensures normal resource_borrowed(value);
    ensures normal resource_callback_registry_invoked(stream, stream, _, _);
    ensures normal resource_return_none();
};

// ## Card W45-CALLEE-CASCADE-RESIDUAL round 3: Admin-API destructors
//
// FIVE TRUSTED ASSUMPTIONS, pinned (C06.2) after reading each body at both
// audited revisions (`rdkafka_admin.c` is byte-identical at `66910c10` and
// `046accf6`). Each is the only uncontracted call of its `_free` wrapper
// (`static void ..._free(void *ptr) { ..._destroy(ptr); }`) and of its
// `_destroy_array` loop.
//
// Each destructor releases its object and everything the object owns, and
// nothing else; none drops a reference or releases a child it does not own:
//
//   * `rd_kafka_AclBinding_destroy` (`:5393-5403`) frees `name`, `principal`
//     and `host` (each `rd_strdup`ed by `rd_kafka_AclBinding_new0`, `:5202-5227`,
//     NULL-tested) and destroys `error` (a fresh `rd_kafka_error_new` there,
//     NULL-tested), then frees the binding.
//   * `rd_kafka_ConfigResource_destroy` (`:2976-2981`) destroys the embedded
//     `config` list (initialised with the free callback
//     `rd_kafka_ConfigEntry_free`, `:2971`: the list owns its entries), frees
//     `errstr` when set, then frees the resource (its name is in the same
//     allocation).
//   * `rd_kafka_NewPartitions_destroy` (`:2516-2519`) destroys the embedded
//     `replicas` list (`rd_list_init(..., rd_list_destroy_free)`, `:2483`: it
//     owns its replica lists) and frees the object.
//   * `rd_kafka_NewTopic_destroy` (`:1950-1955`) destroys the embedded
//     `replicas` (`:1905`, owning) and `config` (`:1911`,
//     `rd_kafka_ConfigEntry_free`) lists, frees `topic` (`rd_strdup`) and the
//     object.
//   * `rd_kafka_UserScramCredentialAlteration_destroy` (`:6070-6082`) returns
//     at once on NULL (`nullable`); otherwise frees `user` and, for an upsert,
//     the `salt` and `password` byte buffers it copied in its constructor
//     (`:6040-6049`), then the object.
//
// The first four dereference their argument unconditionally: `nonnull`. The
// release is the declared assumption; where `rdkafka_admin.c` is analysed,
// each body is examined against it (rule 13g's fold) and the report states
// the standing. NOT CLAIMED: anything about the list elements' own release
// callbacks beyond their being the library's own functions fixed at
// construction.

extern fn rd_kafka_AclBinding_destroy(acl_binding: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(acl_binding, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_ConfigResource_destroy(config: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(config, nonnull);
    ensures normal resource_return_none();
};

