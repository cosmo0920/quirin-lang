// ## Toppar accessors
//
// `rd_kafka_toppar_needs_query(rk, rktp)` (`rdkafka_topic.c:1858-1887`,
// `static`): reads `rktp->rktp_broker`, its `rkb_source`, its state
// (`rd_kafka_broker_get_state`, `rdkafka_broker.h:513-519`: locks the broker,
// reads `rkb_state`) and `rk->rk_conf.sparse_connections`, and returns one of
// the string literals `"not delegated"`, `"internal"`, `"down"`, or NULL. Its
// result is static storage, no custody: `resource_return_none()`, as
// `gai_strerror`'s.

extern fn rd_kafka_toppar_needs_query(rk: ptr<mut, u8>, rktp: ptr<mut, u8>) -> ptr<const, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rk);
    ensures normal resource_borrowed(rktp);
    ensures normal resource_return_none();
};

