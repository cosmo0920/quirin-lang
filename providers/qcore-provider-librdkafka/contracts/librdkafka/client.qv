// END CG22-OP-CALLBACKS-AND-SERVED-QUEUES

// BEGIN OP-CONSTRUCTOR-DECLARATIONS (scripts/write_contracts.py)

// # Op constructors and requests
//
// Card OP-CONSTRUCTOR-DECLARATIONS (gateway rules 12o, 13w, 14e, contract
// specification C04.19.4), on the user's decisions of 2026-10-14: the
// result's discriminant `resource_discriminant_set(result, TAG.FIELD, P,
// FLAGS)` (the actual of `P` OR-ed with `FLAGS`, exact; a release selects the
// arm of that value under its own mask), a callback registered in the result's
// member `resource_callback_member_registered(result, TAG.FIELD, F)`, and the
// `quant` state clause `quant live #result: TAG.FIELD |-> #absent;` (the
// result is live and its member holds no callback). Every body was read at
// `66910c10` and `046accf6` (byte-identical, `scripts/body.py` of the card's
// report); each declaration is pinned (C06.2). `rd_kafka_op_type_t` is an
// enumeration with no negative value (`rdkafka_op.h:84-224`, with the flags
// `RD_KAFKA_OP_CB = 1 << 29`, `RD_KAFKA_OP_REPLY = 1 << 30`): `u32`.
//
// A stated state is read at a later call only while every store the run
// makes into the member is classified (rules 12o, 13w, 14e: a store into a
// constructor's own result or an automatic object, a null callback, a flag-or
// inside the mask, a case-guarded rewrite such as `rd_kafka_broker_op_serve`'s
// `PARTITION_LEAVE` -> `PARTITION_JOIN`, both in the destroyer's `otherwise`
// arm); anything else withdraws it, and the destroyer reads the run closure
// and the cautious join as before.

// `rd_kafka_op_new0(source, type)` (`rdkafka_op.c:224-342`; the macro
// `rd_kafka_op_new(type)` is `rd_kafka_op_new0(NULL, type)`, `rdkafka_op.h:932`,
// `ENABLE_DEVEL` 0 in the audited build): the payload size
// `op2size[type & ~RD_KAFKA_OP_FLAGMASK]`, asserted non-zero; `rko =
// rd_calloc(1, ...)` (zeroed: every member, `rko_op_cb` and `rko_serve`
// included, is NULL); `rko->rko_type = type`, the full actual; `return rko`.
// `source` is stored only under `ENABLE_DEVEL`. Rule 14e checks the state
// against this body where it is defined.
extern fn rd_kafka_op_new0(source: ptr<const, u8>, type: u32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_premise(asserted_allocation, "the result is non-null because it is allocated with rd_calloc (rd.h:139-143), which asserts its result, and the audited compile commands define no NDEBUG, so it never returns NULL in the audited build");
    ensures normal resource_borrowed(source);
    ensures normal resource_borrowed(type);
    ensures normal resource_discriminant_set(result, rd_kafka_op_s.rko_type, type, 0);
    quant live #result: rd_kafka_op_s.rko_op_cb |-> #absent;
    ensures normal resource_return_owned(nonnull);
};

// `rd_kafka_op_new_cb(rk, type, cb)` (`rdkafka_op.c:785-793`):
// `rko = rd_kafka_op_new(type | RD_KAFKA_OP_CB)` (`RD_KAFKA_OP_CB = 1 << 29 =
// 536870912`, `rdkafka_op.h:227`), `rko->rko_op_cb = cb`, `rko->rko_rk = rk`
// (a plain pointer the op keeps, no reference taken: retained by the result,
// C04.14.2), `return rko`. `cb` is `rd_kafka_op_cb_t *`, a pointer to a
// function-type typedef (`rdkafka_op.h:302-304`).
extern fn rd_kafka_op_new_cb(rk: ptr<mut, u8>, type: u32, cb: fnptr) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_premise(asserted_allocation, "the result is non-null because it is allocated with rd_calloc (rd.h:139-143), which asserts its result, and the audited compile commands define no NDEBUG, so it never returns NULL in the audited build");
    ensures normal resource_borrowed(rk);
    ensures normal resource_borrowed(type);
    ensures normal resource_borrowed(cb);
    ensures normal resource_retained_by(rk, result);
    ensures normal resource_discriminant_set(result, rd_kafka_op_s.rko_type, type, 536870912);
    ensures normal resource_callback_member_registered(result, rd_kafka_op_s.rko_op_cb, cb);
    ensures normal resource_return_owned(nonnull);
};

// The request family (`rdkafka_op.c:850-897`). `rd_kafka_op_req0(destq,
// recvq, rko, timeout_ms)`: `rd_kafka_op_set_replyq(rko, recvq, NULL)` (the op
// takes its own reference on `recvq`, `rd_kafka_q_keep`; the caller's is
// unchanged), `rd_kafka_q_enq(destq, rko)` (the op is the queue's; on a
// disabled queue `rd_kafka_op_reply` re-queues it to `recvq` or destroys it:
// the caller never holds it again), `NULL` when the enqueue fails, otherwise
// `rd_kafka_q_pop(recvq, ..., 0)`: an op or `NULL` on timeout. The pop serves
// `recvq` as `rd_kafka_q_pop_serve0` does with a null callback and
// `RD_KAFKA_Q_CB_RETURN`, so each dequeued op's `rko_serve` and `rko_op_cb` may
// run (the two member clauses, as the pop variants above state them). The
// returned op's type is the replier's (the request re-used with
// `RD_KAFKA_OP_REPLY`, `rd_kafka_op_new_reply`'s copy, or any op queued on
// `recvq`): no discriminant is stated. `rd_kafka_op_req(destq, rko,
// timeout_ms)` is `req0` over a temporary `rd_kafka_q_new(destq->rkq_rk)`
// dropped with `rd_kafka_q_destroy_owner`; `rd_kafka_op_req2(destq, type)` is
// `req` over `rd_kafka_op_new(type)` with `RD_POLL_INFINITE`.
// `rd_kafka_op_req0` (`rdkafka_op.c:850-866`).
// LIBRDKAFKA-PLUGIN-PREMISE-UNSTATED: `rd_kafka_op_req0` may run an rk_conf
// callback (rd_kafka_op_req0 -> rd_kafka_q_pop -> rd_kafka_q_pop_serve ->
// rd_kafka_q_pop_serve0 -> rd_kafka_app_polled ->
// rd_kafka_cgrp_consumer_expedite_next_heartbeat -> rd_kafka_log0 ->
// rd_kafka_log_buf -> conf->log_cb; reached: log_cb, on_acknowledgement,
// on_conf_destroy, on_response_received), so it names `rk_plugin_callback_closure`.
extern fn rd_kafka_op_req0(destq: ptr<mut, u8>, recvq: ptr<mut, u8>, rko: ptr<mut, u8>, timeout_ms: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    quant proposition #plugin_artifact_symbol_abi(#actual_abi: function<environment,integer,abi>, #actual_artifact: function<environment,plugin,digest>, #actual_build: function<environment,plugin,digest>, #actual_inventory: function<environment,digest>, #env: environment, #expected_abi: function<environment,integer,abi>, #expected_address: function<environment,plugin,symbol,integer>, #expected_artifact: function<environment,plugin,digest>, #expected_build: function<environment,plugin,digest>, #expected_inventory: function<environment,digest>, #loaded: predicate<environment,plugin,family>, #loader_enabled: function<environment,family,integer>, #required_symbol: predicate<environment,plugin,symbol>, #resolved_address: function<environment,plugin,symbol,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => (((((#actual_build(#env,#p) == #expected_build(#env,#p)) && (#actual_inventory(#env) == #expected_inventory(#env))) && forall (#family: family) { (#loaded(#env,#p,#family) => (#loader_enabled(#env,#family) == 1)) }) && (#actual_artifact(#env,#p) == #expected_artifact(#env,#p))) && forall (#symbol: symbol) { (#required_symbol(#env,#p,#symbol) => (((#resolved_address(#env,#p,#symbol) == #expected_address(#env,#p,#symbol)) && (#resolved_address(#env,#p,#symbol) != 0)) && (#actual_abi(#env,#resolved_address(#env,#p,#symbol)) == #expected_abi(#env,#expected_address(#env,#p,#symbol))))) })) };
    requires resource_lifecycle_v1(introduce_plugin_artifact_symbol_abi, |^+ hypothesis(plugin_artifact_symbol_abi));
    quant proposition #plugin_callback_candidates(#action: function<environment,event,action>, #env: environment, #function: function<environment,event,callback>, #in_trace: predicate<environment,event>, #invoke: action, #member: function<environment,event,member>, #member_candidate: predicate<environment,member,callback>, #public_setter: function<environment,event,integer>, #register: action, #result: function<environment,event,integer>, #static_default: predicate<environment,member,callback>, #time: function<environment,event,integer>) = forall (#ev: event) { ((#in_trace(#env,#ev) && (#action(#env,#ev) == #invoke)) => (#member_candidate(#env,#member(#env,#ev),#function(#env,#ev)) && (#static_default(#env,#member(#env,#ev),#function(#env,#ev)) || exists (#reg: event) { ((((((#in_trace(#env,#reg) && (#action(#env,#reg) == #register)) && (#function(#env,#reg) == #function(#env,#ev))) && (#member(#env,#reg) == #member(#env,#ev))) && (#time(#env,#reg) < #time(#env,#ev))) && (#result(#env,#reg) == 0)) && (#public_setter(#env,#reg) == 1)) }))) };
    requires resource_lifecycle_v1(introduce_plugin_callback_candidates, |^+ hypothesis(plugin_callback_candidates));
    quant proposition #plugin_code_context_lifetime(#action: function<environment,event,action>, #code_live: predicate<environment,callback,integer>, #context_live: predicate<environment,context,integer>, #destroy_callback: action, #env: environment, #function: function<environment,event,callback>, #in_trace: predicate<environment,event>, #invoke: action, #loaded: predicate<environment,plugin,family>, #opaque: function<environment,event,context>, #plugin: function<environment,event,plugin>, #time: function<environment,event,integer>) = forall (#p: plugin) { (exists (#family: family) { #loaded(#env,#p,#family) } => forall (#ev: event) { ((#in_trace(#env,#ev) && (#plugin(#env,#ev) == #p)) => (((#action(#env,#ev) == #invoke) || (#action(#env,#ev) == #destroy_callback)) => (#code_live(#env,#function(#env,#ev),#time(#env,#ev)) && #context_live(#env,#opaque(#env,#ev),#time(#env,#ev))))) }) };
    requires resource_lifecycle_v1(introduce_plugin_code_context_lifetime, |^+ hypothesis(plugin_code_context_lifetime));
