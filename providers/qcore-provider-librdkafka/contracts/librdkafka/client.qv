    ensures normal resource_borrowed(rkt);
    ensures normal resource_reference_kept(rkt);
    ensures normal resource_return_alias(rkt, nonnull);
};

// ## Drops (each subtracts one reference; the last frees the object)
//
// `rd_kafka_toppar_destroy0` (`rdkafka_partition.h:547-551`): when
// `rd_refcnt_sub_fl(func, line, &rktp->rktp_refcnt)` reaches zero,
// `rd_kafka_toppar_destroy_final(rktp)`. The `rd_kafka_toppar_destroy` macro
// (`:540-544`) copies its argument into a block-scope `_RKTP` first.

extern fn rd_kafka_toppar_destroy0(func: ptr<const, u8>, line: i32, rktp: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(func);
    ensures normal resource_borrowed(line);
    ensures normal resource_borrowed(rktp);
    ensures normal resource_reference_dropped(rktp);
    ensures normal resource_return_none();
};

// `rd_kafka_q_destroy0` (`rdkafka_queue.h:219-240`): with `disable`, disables
// and purges the queue; then `do_delete = !--rkq->rkq_refcnt` under the lock,
// and `rd_kafka_q_destroy_final(rkq)` when it reached zero.
// `rd_kafka_q_destroy_owner` (`:253-255`) is `rd_kafka_q_destroy0(rkq, 1)`.

extern fn rd_kafka_q_destroy0(rkq: ptr<mut, u8>, disable: i32) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkq);
    ensures normal resource_borrowed(disable);
    ensures normal resource_reference_dropped(rkq);
    ensures normal resource_return_none();
};

extern fn rd_kafka_q_destroy_owner(rkq: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkq);
    ensures normal resource_reference_dropped(rkq);
    ensures normal resource_return_none();
};

// `rd_kafka_topic_destroy0` (`rdkafka_topic.h:247-253`): a lightweight topic
// through `rd_kafka_lwtopic_destroy`, any other through
