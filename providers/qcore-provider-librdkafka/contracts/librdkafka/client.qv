    ensures normal resource_reference_kept(rkt);
    ensures normal resource_return_alias(rkt, nonnull);
};

// ## Drops (each subtracts one reference; the last frees the object)
//
// `rd_kafka_toppar_destroy0` (`rdkafka_partition.h:547-551`): when
// `rd_refcnt_sub_fl(func, line, &rktp->rktp_refcnt)` reaches zero,
// `rd_kafka_toppar_destroy_final(rktp)`. The `rd_kafka_toppar_destroy` macro
// (`:540-544`) copies its argument into a block-scope `_RKTP` first.

// LIBRDKAFKA-PLUGIN-PREMISE-UNSTATED: `rd_kafka_toppar_destroy0` may run an
// rk_conf callback (rd_kafka_toppar_destroy0 -> rd_kafka_toppar_destroy_final
// -> rd_kafka_log0 -> rd_kafka_log_buf -> conf->log_cb; reached: log_cb,
// on_acknowledgement, on_conf_destroy, on_response_received), so it names
// `rk_plugin_callback_closure`.
extern fn rd_kafka_toppar_destroy0(func: ptr<const, u8>, line: i32, rktp: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
