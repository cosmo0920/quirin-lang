// `rd_slice_reader0` (`rdbuf.c:842-875`) writes `seg->seg_p + rof` through
// `p`, where `seg` is walked from `slice->seg` along the segment list, and
// only when it returns nonzero: a pointer into the buffer `slice` reads,
// owning nothing. `p` is `const void **` (`ptr<mut, ptr<const, u8>>`, rule
// 12v); every caller passes `&LOCAL` or its own slot. Rule 13a checks the
// declaration against this body in `rdbuf.c`, its only unit.

extern fn rd_slice_reader0(slice: ptr<mut, u8>, p: ptr<mut, ptr<const, u8>>, update_pos: i32) -> usize
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(slice);
    ensures normal resource_borrowed(p);
    ensures normal resource_borrowed(update_pos);
    ensures normal resource_out_derived(p, slice, nonnull);
    ensures normal resource_return_none();
};

// # Reference counts
//
// Card REFCOUNT-RESOURCE-KIND (contract specification C04.17, gateway rules
// 13b and 13c). USER DECISION 2026-10-05 (`W48-CALLEE-DECISION-TABLE` class
// 3): a reference count is a resource kind. Taking a reference ("keep") is
// +1 owned reference; dropping one ("destroy", "drop") is -1; each function
// balances the references it takes or hands them off (return, store into a
// tracked owner, a declared transfer). The custody-neutral reading of keep and
// drop was rejected; a keep or drop declaration is withheld from the function
// map, so a consumer that knows nothing of references sees an uncontracted
// callee, never a borrow.
//
// The hazard, resolved at the wrapper level. In the audited build
// (`HAVE_ATOMICS_32`, so no `RD_REFCNT_USE_LOCKS`) `rd.h:298` makes
// `rd_refcnt_t` a typedef of `rd_atomic32_t` and `rd.h:351` defines
// `rd_refcnt_add0(R)` as `rd_atomic32_add(R, 1)`: after preprocessing a
// reference keep and a statistics counter are the same call. No
// `rd_atomic32_*` primitive is declared (see `memory.qv`); a reference
// operation is declared only on a named wrapper whose body this module cites
// and whose pin fixes the body, and rule 13c checks the body structurally in
// every unit that defines it (header bodies are defined in every unit that
// includes them). A statistics counter is therefore never read as a
// reference, and a reference operation spelled through the primitive is not
// read at all (it stays `call to uncontracted function`).
//
// Every body below was read at both audited revisions and is byte-identical
// at `66910c10` and `046accf6` (`scripts/body.py`). Each declaration is
// pinned (C06.2).

// ## Keeps (each returns its argument after one increment)
//
// `rd_kafka_toppar_keep0` (`rdkafka_partition.h:532-536`, `static RD_INLINE`):
// `rd_refcnt_add_fl(func, line, &rktp->rktp_refcnt)` (`rd_atomic32_add` of
// the toppar's `rd_refcnt_t`), `return rktp;`. The `rd_kafka_toppar_keep`
// macro (`:526-527`) passes `__FUNCTION__` and `__LINE__`.

extern fn rd_kafka_toppar_keep0(func: ptr<const, u8>, line: i32, rktp: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(func);
    ensures normal resource_borrowed(line);
    ensures normal resource_borrowed(rktp);
    ensures normal resource_reference_kept(rktp);
    ensures normal resource_return_alias(rktp, nonnull);
};

// `rd_kafka_q_keep` (`rdkafka_queue.h:157-162`): `rkq->rkq_refcnt++` (a plain
// `int` count) under `rkq->rkq_lock`, `return rkq;`.
// `rd_kafka_q_keep_nolock` (`:164-168`): the same increment without the lock.

extern fn rd_kafka_q_keep(rkq: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkq);
    ensures normal resource_reference_kept(rkq);
    ensures normal resource_return_alias(rkq, nonnull);
};

extern fn rd_kafka_q_keep_nolock(rkq: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkq);
    ensures normal resource_reference_kept(rkq);
    ensures normal resource_return_alias(rkq, nonnull);
};

// `rd_kafka_topic_keep` (`rdkafka_topic.h:228-236`): a lightweight topic
// (`rd_kafka_rkt_get_lw(rkt)`, the same object reinterpreted) is kept through
