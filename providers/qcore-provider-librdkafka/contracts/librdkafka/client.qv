// `rd_kafka_op_destroy(rko)` (`rdkafka_op.c:345-628`): when the op is a
// callback op with `rko_op_cb`, sets `rko_err = RD_KAFKA_RESP_ERR__DESTROY` and
// calls `rko_op_cb(rko->rko_rk, NULL, rko)` (asserting neither `YIELD` nor
// `KEEP`: the callback borrows the op); then `switch (rko->rko_type &
// ~RD_KAFKA_OP_FLAGMASK)` (`RD_KAFKA_OP_FLAGMASK = RD_KAFKA_OP_CB |
// RD_KAFKA_OP_REPLY = (1 << 29) | (1 << 30) = 1610612736`,
// `rdkafka_op.h:227-229`) releases the members of the op's union arm the case
// group hands to a call (`rd_free`, the list and partition-list destroyers,
// reference drops, `rd_kafka_msgq_purge`; `RD_IF_FREE` and `RD_LIST_FOREACH`
// expanded); `default: break;` releases none; then the op's `rko_rktp`,
// `rko_error` and reply queue, and `rd_free(rko)`. The arms below are exactly
// the payload paths under `rko_u` each value's case group hands to a call, as
// rule 12o's check reads them (`scripts/op_destroy_arms.py`); that each call
// releases its member stays a declared assumption. `rko` is read first
// (`rko->rko_type`): `resource_released(rko, nonnull)`.
extern fn rd_kafka_op_destroy(rko: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_discriminant(rko, rko_type, 1610612736);
    ensures normal resource_released(rko, nonnull);
    ensures normal resource_callback_member_invoked(rko, rd_kafka_op_s.rko_op_cb, _, _, rko);
    // RD_KAFKA_OP_FETCH = 1 (rdkafka_op.h:86)
    ensures normal resource_arm_released(rko, rko_u.fetch.rkm) when rko_type == 1;
    // RD_KAFKA_OP_ERR = 2 (rdkafka_op.h:87)
    ensures normal resource_arm_released(rko, rko_u.err.errstr) when rko_type == 2;
    ensures normal resource_arm_released(rko, rko_u.err.rkm) when rko_type == 2;
    // RD_KAFKA_OP_CONSUMER_ERR = 3 (rdkafka_op.h:88)
    ensures normal resource_arm_released(rko, rko_u.err.errstr) when rko_type == 3;
    ensures normal resource_arm_released(rko, rko_u.err.rkm) when rko_type == 3;
    // RD_KAFKA_OP_DR = 4 (rdkafka_op.h:89)
    ensures normal resource_arm_released(rko, rko_u.dr.msgq) when rko_type == 4;
    ensures normal resource_arm_released(rko, rko_u.dr.msgq2) when rko_type == 4;
    ensures normal resource_arm_released(rko, rko_u.dr.presult) when rko_type == 4;
    ensures normal resource_arm_released(rko, rko_u.dr.rkt) when rko_type == 4;
    // RD_KAFKA_OP_STATS = 5 (rdkafka_op.h:91)
    ensures normal resource_arm_released(rko, rko_u.stats.json) when rko_type == 5;
    // RD_KAFKA_OP_OFFSET_COMMIT = 6 (rdkafka_op.h:93)
    ensures normal resource_arm_released(rko, rko_u.offset_commit.partitions) when rko_type == 6;
    ensures normal resource_arm_released(rko, rko_u.offset_commit.reason) when rko_type == 6;
    // RD_KAFKA_OP_XMIT_BUF = 8 (rdkafka_op.h:96)
    ensures normal resource_arm_released(rko, rko_u.xbuf.rkbuf) when rko_type == 8;
    // RD_KAFKA_OP_RECV_BUF = 9 (rdkafka_op.h:97)
    ensures normal resource_arm_released(rko, rko_u.xbuf.rkbuf) when rko_type == 9;
    // RD_KAFKA_OP_XMIT_RETRY = 10 (rdkafka_op.h:98)
    ensures normal resource_arm_released(rko, rko_u.xbuf.rkbuf) when rko_type == 10;
    // RD_KAFKA_OP_OFFSET_FETCH = 15 (rdkafka_op.h:103)
    ensures normal resource_arm_released(rko, rko_u.offset_fetch.partitions) when rko_type == 15;
    // RD_KAFKA_OP_REBALANCE = 18 (rdkafka_op.h:110)
    ensures normal resource_arm_released(rko, rko_u.rebalance.partitions) when rko_type == 18;
    // RD_KAFKA_OP_TERMINATE = 19 (rdkafka_op.h:112)
    ensures normal resource_arm_released(rko, rko_u.terminated.ack_batches) when rko_type == 19;
    // RD_KAFKA_OP_SUBSCRIBE = 21 (rdkafka_op.h:114)
    ensures normal resource_arm_released(rko, rko_u.subscribe.topics) when rko_type == 21;
    // RD_KAFKA_OP_ASSIGN = 22 (rdkafka_op.h:115)
