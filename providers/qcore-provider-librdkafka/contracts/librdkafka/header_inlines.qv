// ## Accessors and state updates
//
// `rd_kafka_broker_get_state(rkb)` (`rdkafka_broker.h:513-519`) reads the
// state under the broker lock. `rd_kafka_topic_get_error(rkt)`
// (`rdkafka_topic.h:296-303`) reads the error under the topic's read lock.
// `rd_kafka_op_version_outdated(rko, version)` (`rdkafka_partition.h:
// 1095-1107`) compares versions (an atomic read of the op's toppar version).
// `rd_kafka_rkt_get_lw(rkt)` (`rdkafka_topic.h:70-74`) returns `rkt` itself,
// cast (`rd_kafka_rkt_lw`, `:55`), when its magic marks a lightweight topic,
// else NULL: the argument's own value or NULL.
// `rd_kafka_topic_partition_toppar(rk, rktpar)` (`rdkafka_partition.h:
// 909-917`) returns the toppar the partition's private part holds
// (`rktpar->_private->rktp`), or NULL; it takes no reference: a pointer the
// partition holds, borrowed from it.
// `rd_kafka_app_poll_start(rk, rkq, now, is_blocking)` (`rdkafka_int.h:
// 1366-1392`) and `rd_kafka_app_polled(rk, rkq)` (`:1402-1422`) update poll
// timestamps and averages (and, for a consumer past its poll interval,
// expedite the group heartbeat). `rd_kafka_curr_msgs_add(rk, cnt, size,
// block, rdlock)` (`:975-1009`) adds to the producer's message counters,
// waiting on its condition variable (and releasing and retaking the caller's
// `rdlock` while it waits) when blocking. `rd_kafka_curr_msgs_wait_zero(rk,
// timeout_ms, curr_msgsp)` (`:1079-1096`) waits for the count to reach zero
// and stores the last count through `curr_msgsp` (a scalar).
// `rd_kafka_txn_add_partition(rktp)` (`rdkafka_txnmgr.h:96-137`) links the
// toppar into the client's pending-transaction list with a reference of its
// own (`rd_kafka_toppar_keep`), which the list owns: the caller's reference
// is untouched.

extern fn rd_kafka_broker_get_state(rkb: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkb);
    ensures normal resource_return_none();
};

