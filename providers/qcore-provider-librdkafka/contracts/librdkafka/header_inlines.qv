// ## Op queues (`rdkafka_queue.h`)
//
// `rd_kafka_q_enq(rkq, rko)` (`:484-487`) is `rd_kafka_q_enq1(rkq, rko, rkq,
// 0, 1)`; `rd_kafka_q_reenq(rkq, rko)` (`:501-504`) is `rd_kafka_q_enq1(rkq,
// rko, rkq, 1, 0)` (at head, the caller holding the lock). `rd_kafka_q_enq1`
// (`:425-470`) has three exits, and on each the caller's op leaves its
// custody:
//   * the queue is disabled (`!(rkq_flags & RD_KAFKA_Q_F_READY)`): it returns
//     `rd_kafka_op_reply(rko, RD_KAFKA_RESP_ERR__DESTROY)`
//     (`rdkafka_op.c:804-816`), which DESTROYS the op (`rd_kafka_op_destroy`)
//     and returns 0 when the op has no reply queue, and otherwise enqueues the
//     op on its reply queue (`rd_kafka_replyq_enq`, returning that
//     enqueue's 1 or 0, 0 again meaning destroyed);
//   * the queue is not forwarded: the op is linked into the queue
//     (`rd_kafka_q_enq0`), the queue's condition is signalled and its I/O
//     event raised (`rd_kafka_q_io_event`, which may run the queue's event
//     callback); it returns 1;
//   * the queue is forwarded: the op is enqueued on the forward queue by the
//     same function (whose own result is ignored: the op may have been
//     destroyed there), the forward queue's reference is dropped, and it
//     returns 1.
// So on every exit the op is either linked into a queue or destroyed, and the
// caller holds nothing of it afterwards: `rko` is `resource_consumed`, which
// claims neither that it was destroyed nor that it was linked (a consumption
// is not a proof of destruction, C04.2). A return code does not decide the
// custody (1 can follow a destruction on the forward queue), so no
// `resource_on_return` split is stated. `rkq` is borrowed: every reference
// the body takes on a forward queue it drops itself. The body dereferences
// `rko` on every path, so `nonnull`.

extern fn rd_kafka_q_enq(rkq: ptr<mut, u8>, rko: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    ensures normal resource_borrowed(rkq);
    ensures normal resource_consumed(rko, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_q_reenq(rkq: ptr<mut, u8>, rko: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    ensures normal resource_borrowed(rkq);
    ensures normal resource_consumed(rko, nonnull);
    ensures normal resource_return_none();
};

// `rd_kafka_q_len(rkq)` (`:638-651`) reads the length under the queue lock,
// following a forward queue (whose reference it takes and drops itself).
// `rd_kafka_q_yield(rkq)` (`:366-391`) sets the yield flag and wakes the
// queue (or its forward queue), raising the I/O event when empty.
// `rd_kafka_q_reset(rkq)` (`:263-268`) re-initialises the list head and
// zeroes the counters: it forgets the links, it frees nothing (its callers
// have moved the ops first). `rd_kafka_q_concat0(rkq, srcq, do_lock)`
// (`:550-593`) and `rd_kafka_q_prepend0(rkq, srcq, do_lock)` (`:609-631`)
// move every op of `srcq` into `rkq` (resolving forward queues) and reset
// `srcq`; `concat0` returns 0, or -1 without moving anything when `rkq` is
// disabled. The ops move between two queues the caller does not own through
// these calls; the caller's custody of either queue is unchanged.

extern fn rd_kafka_q_len(rkq: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    ensures normal resource_borrowed(rkq);
    ensures normal resource_return_none();
};

