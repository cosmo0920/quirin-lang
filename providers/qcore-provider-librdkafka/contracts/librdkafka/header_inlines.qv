// ## Utility headers
//
// `rd_atomic64_set(ra, v)` (`rdatomic.h:208-224`) exchanges a 64-bit counter
// and returns the old value, beside the already declared `rd_atomic64_add`
// and `rd_atomic64_get` (`memory.qv`): `rd_refcnt_t` is a 32-bit
// `rd_atomic32_t` (`rd.h:298`), so a 64-bit counter is never a reference
// count. `rd_usleep(usec, terminate)` (`rdposix.h:144-151`) sleeps
// (`nanosleep`, retried on `EINTR` unless `*terminate` is set).
// `rd_crc32_init()` and `rd_crc32_update(crc, data, data_len)`
// (`rdcrc32.h:98-140`) compute a CRC over `data` (zlib's `crc32` or the
// table). `rd_buf_write_pos(rbuf)` (`rdbuf.h:132-145`) reads the write
// offset. `rd_slice_read_varint(slice, nump)` (`rdbuf.h:323-335`) reads a
// varint from the slice and stores the decoded integer through `nump`;
// `rd_varint_dec_i64(src, srcsize, nump)` (`rdvarint.h:135-146`) decodes one
// from `src`. `rd_avl_remove_elm(ravl, elm)` (`rdavl.h:220-225`) unlinks the
// tree node of `elm` under the tree's write lock; the tree indexes elements it
// does not own and frees nothing.
// `rd_tmpabuf_alloc0(func, line, tab, size)` (`rdkafka_buf.h:104-126`,
// `static`) returns `tab->buf + tab->of` and advances `tab->of`, or NULL when
// the arena failed or is full (after printing and asserting when
// `assert_on_fail`): a pointer into the arena block `tab` owns, borrowed from
// `tab`.

extern fn rd_atomic64_set(ra: ptr<mut, u8>, v: i64) -> i64
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ra);
    ensures normal resource_borrowed(v);
    ensures normal resource_return_none();
};

extern fn rd_usleep(usec: i32, terminate: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(usec);
    ensures normal resource_borrowed(terminate);
    ensures normal resource_return_none();
};

