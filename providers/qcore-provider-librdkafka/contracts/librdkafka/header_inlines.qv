module contract;

// # librdkafka header definitions the run has no summary for
//
// Card LIBRDKAFKA-HEADER-INLINES (round 16, 2026-11-05; USER REQUEST,
// verbatim: "Now, we're still needed to fill the gap of the missing
// contracts."). Every function below is a `static` (almost always
// `static RD_INLINE`) definition in a librdkafka header, so every unit that
// includes the header carries its body and gateway constraint 4a offers it to
// the W4 derivation; the user's `current` run at Fluent Bit 046accf6
// published no validated summary for any of them, so each call was
// `call to uncontracted function` (census:
// docs/reports/librdkafka-header-inlines/census/).
//
// Each declaration is stated from the body, read at 046accf6, 66910c10 and
// 34155955 (byte-identical at all three; census `body_sha256`). Each is a
// trusted assumption pinned to its header text (contract spec C06.2): where an
// including unit's W4 derivation validates the body, C06.4 checks the
// declaration against it; where it does not, the declaration is the unchecked
// premise W46-HEADER-INLINE-DECLARED-UNCHECKED tracks.
//
// ABI (constraint 8, C04.1): every object pointer is one `ptr<mut|const, u8>`
// level; `size_t` is `usize`; `int`, `int32_t` and `rd_kafka_resp_err_t`
// (it has negative values) are `i32`; `rd_bool_t` is `uint8_t`
// (`rdtypes.h:49`), `u8`; `rd_crc32_t` is `uint32_t`; `rd_ts_t` is `int64_t`;
// `rd_kafka_broker_state_t` has no negative value, `u32`. `RD_INLINE` and
// `RD_UNUSED` are `inline` and an unused attribute: neither changes a type.
//
// Premise (user decision U2, 2026-10-14: "List it in every dependent
// verdict"). The twelve declarations whose body may run a callback name
// `rk_plugin_callback_closure` with the text every other librdkafka
// declaration uses: eight reach an rk_conf or interceptor callback through
// direct calls (`rd_kafka_op_destroy`, `rd_kafka_q_destroy0`,
// `rd_kafka_log0`, ...), four reach only an unresolved indirect call (the
// queue's `rkq_qio->event_cb`, a segment's `seg_free`, an AVL tree's
// `ravl_cmp`) and take it as LIBRDKAFKA-PLUGIN-PREMISE-UNSTATED's
// conservative label. The census of every declaration below is
// docs/reports/librdkafka-header-inlines/census/premise-reach.json (that
// card's over-approximating call graph, rerun on this module at 66910c10 and
// 046accf6, identical at both). The premise is stated plainly; its symbolic
// decomposition and binding metadata are not written here.

// ## Request buffer writers and updaters (`rdkafka_buf.h`)
//
// `rd_kafka_buf_write(rkbuf, data, len)` (`:1071-1082`):
// `r = rd_buf_write(&rkbuf->rkbuf_buf, data, len)`, then, when the buffer
// computes a CRC, `rkbuf->rkbuf_crc = rd_crc32_update(rkbuf->rkbuf_crc,
// data, len)`; returns `r`, the write offset. `rd_buf_write` (`rdbuf.c:448`)
// copies `len` bytes of `data` (`memcpy`) into the buffer's segments,
// allocating new segments (`rd_buf_write_ensure` -> `rd_buf_alloc_segment`)
// that the buffer owns and frees with itself: the buffer grows inside, it is
// never replaced, and no pointer to `data` is kept. So `rkbuf` and `data`
// are borrowed and the offset is a scalar. A pointer the caller took into the
// buffer earlier is ended at the call by the borrowed-position rule (C04.3.4
// rule 2: every call naming the parent ends its borrows), which is the
// truthful reading of the growth.
//
// Every other writer encodes its value and writes it through
// `rd_kafka_buf_write`, so each is the same statement:
//   `_i8` (`:1105-1107`), `_i16` (`:1122-1126`, `htobe16`), `_i32`
//   (`:1142-1146`, `htobe32`), `_i64` (`:1271-1275`, `htobe64`), `_bool`
//   (`:1447-1450`, through `_i8`), `_uvarint` and `_varint` (`:1172-1193`,
//   encoded into a local array first), `_arraycnt` (`:1203-1214`, `_i32` or
//   `_uvarint` by the buffer's FLEXVER flag), `_str` (`:1338-1371`: a length,
//   then the bytes of `str` when it is not NULL; `strlen` when `len` is
//   `(size_t)-1`), `_kstr` (`:1294-1329`) and `_kbytes` (`:1390-1426`: the
//   serialised form or the length and bytes of a `rd_kafkap_str_t` /
//   `rd_kafkap_bytes_t`, NULL written as the null length), `_bytes`
//   (`:1431-1441`) and `_uuid` (`:1519-1523`, `static`, two `_i64` writes of
//   the UUID's halves, `void`).
// The updaters overwrite bytes already written, in place:
//   `rd_kafka_buf_update_i8`/`_i16`/`_i32`/`_u32`/`_i64` (`:1114-1166`,
//   `:1282-1285`) call `rd_kafka_buf_update` (`:1094-1100`:
//   `rd_kafka_assert(NULL, ...)` then `rd_buf_write_update`), and
//   `rd_kafka_buf_finalize_arraycnt` (`:1237-1264`) updates the count in place
//   and, for a FLEXVER buffer, erases the unused bytes (`rd_buf_erase`, which
//   moves data inside the buffer and frees nothing the caller holds).
// `rd_kafka_buf_crc_init` (`:1474-1478`) sets the CRC flag and seed.
// None keeps, frees or hands back anything the caller passed.

extern fn rd_kafka_buf_write(rkbuf: ptr<mut, u8>, data: ptr<const, u8>, len: usize) -> usize
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkbuf);
    ensures normal resource_borrowed(data);
    ensures normal resource_borrowed(len);
    ensures normal resource_return_none();
};

