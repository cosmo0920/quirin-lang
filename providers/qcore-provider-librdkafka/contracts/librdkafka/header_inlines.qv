// ## Message queues (`rdkafka_msg.h`)
//
// `rd_kafka_msgq_enq(rkmq, rkm)` (`:530-535`) links the message at the tail
// of the queue, adds its sizes and returns the new count: the message's
// custody passes to the queue (it is freed with the queue's purge or by its
// delivery), so `rkm` is consumed; the body dereferences it. `_init`
// (`:283-287`) initialises an empty queue in place. `_first` and `_last`
// (`:404-416`) return the head or tail message of the queue, or NULL: a
// message the queue holds, borrowed from it. `_concat(dst, src)` and
// `_move(dst, src)` (`:312-332`) move every message of `src` to `dst` and
// re-initialise `src`. `_purge(rk, rkmq)` (`:352-365`) destroys every message
// the queue holds (`rd_kafka_msg_destroy`) and re-initialises it: the queue's
// own messages, not the caller's.

extern fn rd_kafka_msgq_enq(rkmq: ptr<mut, u8>, rkm: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkmq);
    ensures normal resource_consumed(rkm, nonnull);
    ensures normal resource_return_none();
};

extern fn rd_kafka_msgq_init(rkmq: ptr<mut, u8>) -> unit
