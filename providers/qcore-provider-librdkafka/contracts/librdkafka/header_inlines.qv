// ## Partition leaders (`rdkafka_partition.h:1126-1141`, `static`)
//
// `rd_kafka_partition_leader_new(rkb)` allocates a leader (`rd_malloc`, read
// as nullable like the constructors above), stores `rkb` in it with a broker
// reference of the leader's own (`rd_kafka_broker_keep`) and a fresh empty
// partition list, and returns it: a fresh heap object the caller owns; the
// caller's broker reference is untouched. `rd_kafka_partition_leader_destroy
// (leader)` drops the leader's broker reference, destroys its partition list
// and frees the leader (`rd_free`): it releases the object
// `rd_kafka_partition_leader_new` returned, children included.

extern fn rd_kafka_partition_leader_new(rkb: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(rkb);
    ensures normal resource_return_owned(nullable);
};

extern fn rd_kafka_partition_leader_destroy(leader: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    ensures normal resource_released(leader, nonnull);
    ensures normal resource_return_none();
};
