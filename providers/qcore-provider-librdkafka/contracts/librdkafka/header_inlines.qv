// ## Protocol string and bytes constructors (`rdkafka_proto.h`)
//
// `rd_kafkap_str_new(str, len)` (`:308-336`) measures `str` (`strlen` when
// `len` is -1; the null length when `str` is NULL), allocates the header,
// the serialised 2-byte length and a copy of the string in ONE `rd_malloc`
// block, copies (`memcpy`) and returns the block. `rd_kafkap_bytes_new(bytes,
// len)` (`:440-463`) is the same with a 4-byte length (no copy when `bytes`
// is NULL). Nothing the caller passed is kept. The block is a fresh heap
// object the caller owns and releases with `rd_kafkap_str_destroy` /
// `rd_kafkap_bytes_destroy` (`rd_free`). `rd_malloc` (`rd.h:145-149`) asserts
// its result; this crate reads it through libc `malloc`'s nullable owned
// result (`memory.qv`), the reading for an assert-disabled build, and the
// constructors are stated the same way: owned, nullable.

extern fn rd_kafkap_str_new(str: ptr<const, u8>, len: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(str);
    ensures normal resource_borrowed(len);
    ensures normal resource_return_owned(nullable);
};

extern fn rd_kafkap_bytes_new(bytes: ptr<const, u8>, len: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(bytes);
    ensures normal resource_borrowed(len);
    ensures normal resource_return_owned(nullable);
};

