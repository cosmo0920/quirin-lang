module contract;
#include "quirin-provider-libc:libc/memory.qv";
#include "quirin-provider-libc:libc/string.qv";

// Trusted resource-projection assumptions, vocabulary version 1.
// These preserve the Cycle 19 audit table; they do not verify the C bodies.
// Borrowed scalar/opaque arguments carry no resource custody requirement.
// Detailed observation/lifecycle contracts remain separate semantic profiles.
//
// Card CONTRACT-INHERIT-QCORE-PROVIDER-NAMING: librdkafka's allocator and
// string-duplication wrappers take their contracts from the libc declarations
// they wrap instead of restating them. `src/rd.h` defines `rd_malloc`,
// `rd_calloc`, `rd_strdup` and `rd_strndup` as `malloc`, `calloc`, `strdup`
// (`_strdup` on Windows) and `strndup` (or `rd_malloc` + `memcpy` without
// `HAVE_STRNDUP`) followed by `rd_assert` on the result, and `rd_free` as
// `free(ptr)`. The `nullable` owned result is the parent's statement and
// covers the assert-disabled build. Each elaborates to the clauses these
// declarations carried when they were written out by hand (clause for clause,
// parameter names included); an inherited contract is a trusted assumption of
// the same strength as that hand-written one, never a proof. `rd_realloc`
// stays written out: libc declares no `realloc`.

extern fn rd_malloc(size: usize) -> ptr<mut, u8> contract inherit libc::malloc;

extern fn rd_calloc(count: usize, size: usize) -> ptr<mut, u8> contract inherit libc::calloc;

extern fn rd_strdup(str: ptr<const, u8>) -> ptr<mut, u8> contract inherit libc::strdup;

extern fn rd_strndup(str: ptr<const, u8>, len: usize) -> ptr<mut, u8> contract inherit libc::strndup;

extern fn rd_free(ptr: ptr<mut, u8>) -> unit contract inherit libc::free;

extern fn rd_realloc(ptr: ptr<mut, u8>, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(ptr, nullable);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_reallocated(ptr, nullable);
};

// ## Card W46-EXTERNAL-CALLEE-CONTRACTS: `rd_atomic32_get`
//
// ONE TRUSTED ASSUMPTION, pinned (contract spec C06.2) after reading the body
// at both audited revisions (identical at `66910c10` and `046accf6`). It is
// the last uncontracted call of `rd_kafka_thread_cnt` (`src/rdkafka.c:114-116`,
// `return rd_atomic32_get(&rd_kafka_thread_cnt_curr);`). It sits in this
// module because the crate has no atomic-counter module and one declaration
// does not justify a new resource-view module.
//
// ## The body, read from `lib/librdkafka-2.15.0/src/rdatomic.h:100-112`
//
//     static RD_INLINE int32_t RD_UNUSED rd_atomic32_get(rd_atomic32_t *ra) {
//     #if defined(_WIN32) || defined(__SUNPRO_C)
//             return ra->val;
//     #elif !HAVE_ATOMICS_32
//             int32_t r;
//             mtx_lock(&ra->lock);
//             r = ra->val;
//             mtx_unlock(&ra->lock);
//             return r;
//     #else
//             return ATOMIC_OP32(fetch, add, &ra->val, 0);
//     #endif
//     }
//
// On every configuration arm the function READS the counter (an atomic
// fetch-and-add of zero, a plain read, or a read under the counter's own
// mutex) and returns its `int32_t` value. It allocates, frees, stores and
// transfers nothing, so `ra` is `resource_borrowed` and the scalar result is
// `resource_return_none()`.
//
// ## Where the body lives
//
// `static RD_INLINE` in a header: every unit that includes `rdatomic.h` holds
// a copy, but no analysed function of the corpus is this function, so no body
// is checked against this declaration (constraint 8, rule 10g). `RD_INLINE` and
// `RD_UNUSED` are `inline` and an `__attribute__((unused))` decoration; neither
// changes a parameter type or the arity.
//
// ## ABI (constraint 8)
//
// `rd_atomic32_t *` is one object-pointer level, `ptr<mut, u8>`; `int32_t` is
// `i32`.
//
// NOT CLAIMED: memory ordering, the counter's value, or anything about the
// counter's lifetime.

// --- read a 32-bit atomic counter ---
extern fn rd_atomic32_get(ra: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ra);
    ensures normal resource_return_none();
};

// ## Card W47-CALLEE-CLOSURE-R2: `rd_file_read`
//
// ONE TRUSTED ASSUMPTION, pinned (contract spec C06.2) after reading the body
// at both audited revisions (identical at `66910c10` and `046accf6`; one copy
// in the tree). After P3 it is the last uncontracted call of
// `rd_kafka_oidc_assertion_read_from_file`
// (`src/rdkafka_sasl_oauthbearer_oidc.c:651-656`: a null test of its formal,
// then `return rd_file_read(file_path, NULL, max_size);`); its other call site
// (`:275`) sits in a function with other blockers. It sits in this module,
// beside `rd_malloc` and `rd_free`, whose custody its result carries.
//
// ## The body, read from `lib/librdkafka-2.15.0/src/rd.h:472-521`
//
//     static RD_INLINE RD_UNUSED char *
//     rd_file_read(const char *file_path, size_t *size, size_t max_size) {
//             FILE *file;
//             char *buf = NULL;
//             size_t file_size;
//             size_t read_size;
//             if (!size)
//                     size = &read_size;
//             file = fopen(file_path, "rb");          /* the non-_WIN32 arm */
//             if (!file)
//                     return NULL;
//             if (fseek(file, 0, SEEK_END) != 0)
//                     goto err;
//             file_size = (size_t)ftell(file);
//             ...                                      /* seek back, size cap */
//             buf       = (char *)rd_malloc(file_size + 1);
//             read_size = fread(buf, 1, file_size, file);
//             if (read_size != file_size)
//                     goto err;
//             buf[file_size] = '\0';
//             *size          = file_size;
//             fclose(file);
//             return buf;
//     err:
//             fclose(file);
//             if (buf)
//                     rd_free(buf);
//             return NULL;
//     }
//
// Its comment says so (`:468`): "@remark The returned pointer ownership is
// transferred to the caller."
//
// ## Custody
//
//   * The result is `resource_return_owned(nullable)`: on success it is the
//     buffer `rd_malloc` returned (the heap kind `rd_free` releases, as
//     `libc::free`), handed to the caller; on every failure arm the body has
//     released it itself (`rd_free(buf)`) or never allocated it, and returns
//     NULL. The `FILE` the body opens is closed on every arm before the
//     return, so nothing else outlives the call.
//   * `file_path` is `resource_borrowed` (read by `fopen`); `size` is
//     `resource_borrowed` (optional: the body substitutes a local when it is
//     NULL, and writes a scalar through it on success); `max_size` is a scalar.
//
// ## Where the body lives
//
// `static RD_INLINE` in a header: every unit that includes `rd.h` holds a
// copy, but no analysed function of the corpus is this function, so no body
// is checked against this declaration (constraint 8, rule 10g); it is an
// unchecked premise pinned to the header text, as `rd_atomic32_get` above.
//
// ## ABI (constraint 8)
//
// `const char *` is `ptr<const, u8>`, `size_t *` one object-pointer level
// (`ptr<mut, u8>`), `size_t` is `usize` under LP64 and `char *` is
// `ptr<mut, u8>`.
//
// NOT CLAIMED: the buffer's contents or NUL termination, the size written
// through `size`, `errno`, or the Windows arm (`fopen_s`), which is not in
// the audited build.

// --- read a whole file into a new heap buffer ---
extern fn rd_file_read(file_path: ptr<const, u8>, size: ptr<mut, u8>, max_size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(file_path);
    ensures normal resource_borrowed(size);
    ensures normal resource_borrowed(max_size);
    ensures normal resource_return_owned(nullable);
};
