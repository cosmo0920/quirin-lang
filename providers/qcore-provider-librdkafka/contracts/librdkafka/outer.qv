module contract;

// RK-PLUGIN-LIBRARY-OUTER-ENVELOPE. The loader body was read at 66910c10
// and 046accf6: it opens path, resolves conf_init, passes conf, and returns
// RD_KAFKA_RESP_ERR_NO_ERROR only after conf_init succeeds (or for a duplicate).
// A plugin may register callbacks and interceptors through the public API.
// This is an assumption about that loaded code, not a claim that no library is
// loaded. Interceptor list candidates are the separately pinned runtime-only
// outer-candidates.json inventory; static list invocation stays unsupported.
// Public cJSON allocator hooks are covered only by the explicit condition
// that loaded code does not call cJSON_InitHooks or replace the global hooks.
//
// Card SP8-OUTER-CONTRACT-SYMBOLIC-STATEMENTS (contract specification C04.20,
// C04.18.9's SP8 block; USER DECISION 2026-11-20, conditions as symbols, not
// sentences; USER DECISIONS 2026-11-23, D1 A, D2 B, D3 B): the statement is a
// formula over registered terms, conjunct by conjunct the sentence it
// replaced (docs/reports/sp8-outer-contract-symbolic-statements/): public
// setters and member candidates for rk_conf callbacks; interceptors appended
// only by a candidate's setter returning 0 under the inventory constant
// CANDIDATES_<SHA-256 of outer-candidates.json>; the neutral custody
// restriction on every interceptor run; validity through the last possible
// invocation of every registration and copy; the configuration and on_new
// lifecycle; no cJSON_InitHooks call, global hook store or cJSON link store;
// no store into librdkafka internals, no non-public symbol, public functions
// only under their published conditions; malformed lists are the negation of
// the list shape of the representation premise; earlier hooks satisfy
// cjson_allocator_hooks (#allocator_hooks_premise cites it).

extern fn rd_kafka_plugin_new(conf: ptr<mut, u8>, path: ptr<const, u8>, errstr: ptr<mut, u8>, errstr_size: u64) -> i32
contract {
    requires outer_contract_v1;
    quant #outer [[contract]] rk_plugin_library, (quant all #f in #conf_registrations: #f in #public_setter_values && #f in #meets_candidate) && (quant all #f in #interceptors: #f in #zero_appends(CANDIDATES_5C3F8C4723832C0E9E6EBB784BE6A57EBC0264D519421D5B95A18A8F68C18147)) && (quant all #f in #interceptors: #f |-> (#inert && #borrows_args && #borrows_handles && #no_global_custody && #balanced)) && (quant all #f in #copies(#conf_registrations | #interceptors): #f in #valid_through_last) && (quant all #f in #interceptors: (#f in #conf_lifecycle(CANDIDATES_5C3F8C4723832C0E9E6EBB784BE6A57EBC0264D519421D5B95A18A8F68C18147) -> #f in #on_live_conf) && (#f in #client_lifecycle(CANDIDATES_5C3F8C4723832C0E9E6EBB784BE6A57EBC0264D519421D5B95A18A8F68C18147) -> #f in #from_on_new && #f in #before_init && #f in #client_lifecycle(CANDIDATES_5C3F8C4723832C0E9E6EBB784BE6A57EBC0264D519421D5B95A18A8F68C18147) \ #on_share_consumer)) && #outer_code |-> (#calls_none(#cjson_init_hooks) && #stores_none(#cjson_global_hooks) && #stores_none(#cjson_link_cells) && #stores_none(#rk_internal) && #calls_none(#rk_nonpublic) && #meets_published(#rk_public)) && (quant all #a in #cjson_handed: (quant all #c in #child(#a): #c in #first(#a)) && (quant all #c in #first(#a): #c in #child(#a)) && (quant all #b in #children(#a): quant all #p in #pred(#a, #b): #b in #next(#p)) && (quant all #c in #children(#a): #c in #next_reach(#c) -> #false) && ((quant all #c in #child(#a): #false) -> quant all #c in #children(#a): #false) && ((quant all #c in #children(#a): #false) -> quant all #c in #child(#a): #false) && (quant all #b in #children(#a): quant all #p in #pred(#a, #b): #p in #prev(#b)) && (quant all #f in #first(#a): quant all #l in #last(#a): #l in #prev(#f)) && #nodup(#a) && (quant all #c in #children(#a): quant all #y in #next(#c) | #prev(#c): #y in #children(#a)) && (quant all #l in #last(#a): quant all #y in #next(#l): #false) && (#a in #children(#a) -> #false)) && #allocator_hooks_premise;
    quant #outer where #conf in #loaded [[runtime]] when #result == 0;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_conf_set |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_conf_set |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_conf_dup |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_conf_dup |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_conf_destroy |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_conf_destroy |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_new |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_new |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_destroy |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_destroy |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_send |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_send |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_acknowledgement |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_acknowledgement |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_consume |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_consume |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_commit |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_commit |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_request_sent |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_request_sent |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_response_received |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_response_received |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_thread_start |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_thread_start |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_thread_exit |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_thread_exit |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.interceptors.on_broker_state_change |-> #registered;
    quant #outer #loaded: rd_kafka_s.rk_conf.interceptors.on_broker_state_change |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.background_event_cb |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.closesocket_cb |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.connect_cb |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.offset_commit_cb |-> #registered;
    quant #outer #loaded: rd_kafka_conf_s.open_cb |-> #registered;
