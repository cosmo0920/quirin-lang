module contract;

// LZ4 stream state reset — resource-projection vocabulary version 1.
//
// Card W37-CORPUS-CONTRACTS-4. ONE TRUSTED ASSUMPTION about one upstream
// function. This module verifies nothing: the C body is not analyzed by this
// loader, and a declaration is a premise.
//
// Read from the pinned checkout at Fluent Bit
// 66910c10a4d7eafa810b84229cf2dcf7b0f26f97 on this card's own run.
//
// ## Why this callee
//
// `LZ4_resetStream` is the SOLE blocker of one projected function,
// `LZ4_resetStreamState` (`lib/librdkafka-2.15.0/src/lz4.c:2706-2711`), whose
// single leaf is the call at `:2709`.
//
// This module is the sibling of `librdkafka/kafka_mem.qcore`, whose
// `rd_kafka_mem_free` declaration card W36-CORPUS-CONTRACTS-3 landed to free
// `LZ4_freeStream`, `LZ4_freeStreamDecode`, `LZ4_freeHC` and
// `LZ4_freeStreamHC` in this same unit. Those are the RELEASE half of the LZ4
// stream lifecycle; this is the RESET half, and it releases nothing.
//
// ## The body, read from `lib/librdkafka-2.15.0/src/lz4.c:1524-1528`
//
//     /* resetStream is now deprecated,
//      * prefer initStream() which is more general */
//     void LZ4_resetStream (LZ4_stream_t* LZ4_stream)
//     {
//         DEBUGLOG(5, "LZ4_resetStream (ctx:%p)", LZ4_stream);
//         MEM_INIT(LZ4_stream, 0, sizeof(LZ4_stream_t_internal));
//     }
//
//   * `LZ4_stream` is WRITTEN THROUGH and nothing else: `MEM_INIT` is
//     `memset`, zeroing `sizeof(LZ4_stream_t_internal)` bytes at the pointer.
//     The object is NOT freed — `LZ4_freeStream` (`:1536`) is the function that
//     does that, and it is a different name — not stored anywhere that outlives
//     the call, and not transferred. The caller's obligation to free the stream
//     it allocated is exactly what it was before the call, which is what
//     `resource_borrowed` says.
//   * `DEBUGLOG` expands to nothing unless `LZ4_DEBUG` is set, which it is not
//     in the pinned build; even when it expands it only formats the POINTER
//     VALUE and writes to `stderr`, taking no custody.
//   * The result is `void`, so `resource_return_none()` is the faithful — and
//     the only faithful — result mode.
//   * The body dereferences (memsets through) its parameter immediately with no
//     guard, so `LZ4_resetStream(NULL)` is upstream undefined behaviour. That is
//     NOT expressible here and is NOT claimed: v1 carries a nullability marker
//     only on a RELEASED parameter, and this one is borrowed. Contrast
//     `LZ4_freeStream` at `:1536`, whose first statement IS
//     `if (!LZ4_stream) return 0;  /* support free on NULL */` — the two
//     neighbours genuinely differ, which is why only one of them could carry a
//     marker even if the vocabulary allowed it on a borrow.
//
// ## Zeroing is not releasing, and that distinction is the whole declaration
//
// A `memset` to zero over a stream context DISCARDS the context's internal
// dictionary pointers. It does not free them, and this projection does not
// model them: `LZ4_stream_t_internal`'s `dictionary` field points into a
// caller-supplied buffer that LZ4 never owns. So the reset creates no leak this
// projection can see and discharges no obligation either. Recorded rather than
// implied.
//
// ## The duty gate (constraint 8)
//
// The body is defined in `lib/librdkafka-2.15.0/src/lz4.c`, which IS one of the
// 185 analysed units (87 projected functions in the baseline), so the duty gate
// applies. This declaration is the NEUTRAL ELEMENT — the one formal `Borrowed`,
// result `None` — the weakest statement the vocabulary can make (constraint 4's
// `N(m)`), so a derived summary can contradict it only by claiming the formal
// is released, transferred, delivered or restored. The body does none of those.
// Any conflict would be a `SummaryConflict` with the declaration governing,
// never a silent override — the shape card W36-CORPUS-CONTRACTS-3 measured for
// `rd_kafka_mem_free` in this same library.
//
// ## ABI (constraint 8)
//
//     lib/librdkafka-2.15.0/src/lz4.h:834
//         LZ4LIB_API void LZ4_resetStream (LZ4_stream_t* streamPtr);
//
// One definition in the whole tree, external linkage. `LZ4LIB_API` is a
// visibility/linkage decoration that changes no type, arity or calling
// convention. `LZ4_stream_t *` is one object-pointer level, `ptr<mut, u8>`; the
// `void` result is `unit`. The header spells the parameter `streamPtr` where
// the definition spells it `LZ4_stream`; a declaration's parameter NAMES are
// its own — the ABI comparison is over types, pointer levels and arity — and
// this module follows the DEFINITION's spelling, the disagreement being
// recorded here rather than silently resolved.
//
// ## NOT CLAIMED
//
//   * Nothing about LZ4 compression correctness, the stream's usability after
//     the reset, or the deprecation the comment announces.
//   * Nothing about `sizeof(LZ4_stream_t_internal)` matching the allocated
//     object's size. A `memset` of the wrong length is an upstream
//     out-of-bounds write this declaration neither creates nor detects.
//   * Nothing about thread safety.
//
// ## Read at the same time and DELIBERATELY LEFT UNDECLARED
//
// `LZ4_resetStream_fast` (`:1532`), `LZ4_initStream`, `LZ4_prepareTable` and
// `LZ4_freeStream` (`:1536`) were all read beside this body and none is
// declared: `LZ4_freeStream` is already decided through
// `librdkafka/kafka_mem.qcore`'s `rd_kafka_mem_free`, and none of the others is
// the sole blocker of any projected function in the baseline.

// --- the deprecated in-place reset of an LZ4 compression stream context ---
extern fn LZ4_resetStream(LZ4_stream: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(LZ4_stream);
    ensures normal resource_return_none();
};

// ## Card W45-CALLEE-CASCADE-RESIDUAL: three one-shot LZ4 buffer functions
//
// THREE TRUSTED ASSUMPTIONS, pinned (contract spec C06.2) after reading each
// body at both audited revisions (`lib/librdkafka-2.15.0/src/lz4.c` and
// `lz4hc.c` are byte-identical at `66910c10` and `046accf6`). Each is the only
// uncontracted call of the deprecated wrappers in its own unit, every one a
// `return CALLEE(...)` over its formals: `LZ4_compress_HC` of
// `LZ4_compressHC`, `LZ4_compressHC2`, `LZ4_compressHC_limitedOutput` and
// `LZ4_compressHC2_limitedOutput` (`lz4hc.c`); `LZ4_decompress_unsafe_generic`
// of `LZ4_decompress_fast`, `_fast_withPrefix64k` and `_fast_extDict`;
// `LZ4_compress_default` of `LZ4_compress` and `LZ4_compress_limitedOutput`
// (`lz4.c`).
//
// ## `LZ4_compress_HC`, read from `lz4hc.c:958-973`
//
//     int LZ4_compress_HC(const char* src, char* dst, int srcSize, int dstCapacity, int compressionLevel)
//     {
//         int cSize;
//     #if defined(LZ4HC_HEAPMODE) && LZ4HC_HEAPMODE==1
//         LZ4_streamHC_t* const statePtr = (LZ4_streamHC_t*)ALLOC(sizeof(LZ4_streamHC_t));
//         if (statePtr==NULL) return 0;
//     #else
//         LZ4_streamHC_t state;
//         LZ4_streamHC_t* const statePtr = &state;
//     #endif
//         cSize = LZ4_compress_HC_extStateHC(statePtr, src, dst, srcSize, dstCapacity, compressionLevel);
//     #if defined(LZ4HC_HEAPMODE) && LZ4HC_HEAPMODE==1
//         FREEMEM(statePtr);
//     #endif
//         return cSize;
//     }
//
// `LZ4HC_HEAPMODE` defaults to 1 (`:46-48`): the state is allocated and freed
// on every path that allocated it, or is a local. Either way the state, which
// `LZ4_compress_HC_extStateHC` fills with pointers into `src`, dies with the
// call, so nothing given outlives it. `src` is read, `dst` written up to
// `dstCapacity`, and the result is a byte count (0 on failure).
//
// ## `LZ4_decompress_unsafe_generic`, read from `lz4.c:1799-1896`
//
// A `LZ4_FORCE_INLINE` (`static inline`) loop that reads `istart`, copies
// literals and matches into `ostart` (from `ostart`'s own prefix or from
// `dictStart`), and returns the bytes read or -1. It allocates nothing and
// stores no pointer outside its locals.
//
// ## `LZ4_compress_default`, read from `lz4.c:1440-1443`
//
// `return LZ4_compress_fast(src, dst, srcSize, maxOutputSize, 1);`, whose state
// (`:1421-1437`) is a local (`LZ4_HEAPMODE` defaults to 0, `:43-45`) or
// `ALLOC`ed and `FREEMEM`ed around the one `LZ4_compress_fast_extState` call.
//
// ## Custody
//
// Every pointer formal is read or written through and not stored, freed or
// transferred: `resource_borrowed`; every result is an `int`:
// `resource_return_none()`. The stream-state forms are NOT declared here: the
// `_extState`, `_extStateHC` and `_continue` functions leave pointers into
// `src` in a state the caller owns (W48-CALLEE-DECISION-TABLE class 1).
//
// ## ABI (constraint 8)
//
// `const char *` and `const BYTE *` (`typedef uint8_t BYTE;`, `:307`) are
// `ptr<const, u8>`; `char *` and `BYTE *` `ptr<mut, u8>`; `int` `i32`;
// `size_t` `usize`. `LZ4_decompress_unsafe_generic` is `static`, one
// definition in the tree.
//
// NOT CLAIMED: bounds (that `dst` holds `dstCapacity` bytes, or that the
// unsafe decoder stays inside `ostart`, which is the caller's premise by its
// name), the compressed format, or the result's value.

// --- one-shot high-compression into a caller buffer ------------------------
extern fn LZ4_compress_HC(src: ptr<const, u8>, dst: ptr<mut, u8>, srcSize: i32, dstCapacity: i32, compressionLevel: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(dst);
    ensures normal resource_borrowed(srcSize);
    ensures normal resource_borrowed(dstCapacity);
    ensures normal resource_borrowed(compressionLevel);
    ensures normal resource_return_none();
};

// --- the unchecked decoder over caller buffers ------------------------------
extern fn LZ4_decompress_unsafe_generic(istart: ptr<const, u8>, ostart: ptr<mut, u8>, decompressedSize: i32, prefixSize: usize, dictStart: ptr<const, u8>, dictSize: usize) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(istart);
    ensures normal resource_borrowed(ostart);
    ensures normal resource_borrowed(decompressedSize);
    ensures normal resource_borrowed(prefixSize);
    ensures normal resource_borrowed(dictStart);
    ensures normal resource_borrowed(dictSize);
    ensures normal resource_return_none();
};

// --- the generic checked decoder over caller buffers -----------------------
// Card W43-ABI-ENUM-AND-CONST-PP (gateway rule 12u). `LZ4_decompress_generic`
// (`lz4.c:1942-2344`, `LZ4_FORCE_INLINE`, byte-identical at `66910c10` and
// `046accf6`) decodes `src` into `dst`, reading back-references from
// `lowPrefix` and `dictStart`; every call in its body is a copy, a load or a
// store over those buffers (`LZ4_memcpy`, `LZ4_memmove`, `LZ4_wildCopy8`,
// `LZ4_wildCopy32`, `LZ4_memcpy_using_offset`, `LZ4_readLE16`,
// `LZ4_write32`, `read_variable_length`). It allocates, frees and keeps
// nothing. `partialDecoding` (`earlyEnd_directive`, `:1772`,
// `decode_full_block = 0, partial_decode = 1`) and `dict` (`dict_directive`,
// `:726`, `noDict = 0 … usingDictCtx`) are untagged enumerations with no
// negative value: Clang's integer type for both is `unsigned int`, `u32`.
extern fn LZ4_decompress_generic(src: ptr<const, u8>, dst: ptr<mut, u8>, srcSize: i32, outputSize: i32, partialDecoding: u32, dict: u32, lowPrefix: ptr<const, u8>, dictStart: ptr<const, u8>, dictSize: usize) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(dst);
    ensures normal resource_borrowed(srcSize);
    ensures normal resource_borrowed(outputSize);
    ensures normal resource_borrowed(partialDecoding);
    ensures normal resource_borrowed(dict);
    ensures normal resource_borrowed(lowPrefix);
    ensures normal resource_borrowed(dictStart);
    ensures normal resource_borrowed(dictSize);
    ensures normal resource_return_none();
};

// --- one-shot default compression into a caller buffer ---------------------
extern fn LZ4_compress_default(src: ptr<const, u8>, dst: ptr<mut, u8>, srcSize: i32, maxOutputSize: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(dst);
    ensures normal resource_borrowed(srcSize);
    ensures normal resource_borrowed(maxOutputSize);
    ensures normal resource_return_none();
};

// ## Card CALLEE-RETENTION-CLASS1, stage (b): the retaining stream states
//
// USER DECISION 2026-10-05 (W48-CALLEE-DECISION-TABLE class 1, "split by
// shape"): a pointer retained in a holder is stated by
// `resource_retained_by(P, holder)` (contract spec C04.14, gateway rule 12t).
// The caller keeps custody of `P`'s object, but must establish that it
// outlives the holder, or that the holder is reset or destroyed first;
// otherwise the call is never `Safe`. A declaration carrying the clause is
// withheld from the function map, so no consumer that does not implement it
// reads `src` as borrowed and forgotten. Pinned (C06.2) after reading the
// bodies at both audited revisions (`lib/librdkafka-2.15.0/src/lz4.c` and
// `lz4hc.c` are byte-identical at `66910c10` and `046accf6`).
//
//   * `LZ4_compress_HC_extStateHC(state, src, …)` (`lz4hc.c:951-956`) calls
//     `LZ4_initStreamHC(state)` and then `_fastReset` (`:939-949`), whose
//     `LZ4HC_init_internal(ctx, src)` (`:100-116`) stores `prefixStart`, `end`
//     and `dictStart = src` in the state: after the call `state` holds
//     pointers into `src`, which a later `LZ4_compress_HC_continue` on the
//     same state reads as its dictionary. `state` is retained-by holder.
//   * `LZ4_compress_HC_continue(LZ4_streamHCPtr, src, …)` (`:1151-1157`, over
//     `LZ4_compressHC_continue_generic`, `:1112-1149`) auto-initialises the
//     same pointers from `src` and moves `end` to the end of `src`.
//   * `LZ4_compress_fast_continue(LZ4_stream, source, …)` (`lz4.c:1637-1713`)
//     sets `streamPtr->dictionary = (const BYTE*)source` and
//     `dictSize = inputSize` before returning (`:1709`): the next block reads `source`
//     as its dictionary.
//   * `LZ4_compress_fast_extState(state, source, …)` (`lz4.c:1351-1372`)
//     re-initialises the whole state (`LZ4_initStream` zeroes it), then
//     compresses with `noDict`. On a 64-bit target the hash table holds
//     offsets, not pointers; with `byPtr` (32-bit, `source` above
//     `LZ4_DISTANCE_MAX`, `:1361`, `:1368`) it holds pointers into `source`. The
//     declaration states the retention on every target, which is the
//     refusing direction, and the reset that precedes it
//     (`resource_holder_reset(state)`).
//
// `dst`/`dest` are written and not kept, the sizes and levels are data: all
// `resource_borrowed`. NOT CLAIMED: anything about a `dictCtx` another
// stream attached (`LZ4_attach_dictionary`), which these calls keep.

// --- HC one-shot over a caller's state: the state keeps pointers into `src`
extern fn LZ4_compress_HC_extStateHC(state: ptr<mut, u8>, src: ptr<const, u8>, dst: ptr<mut, u8>, srcSize: i32, dstCapacity: i32, compressionLevel: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(state);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(dst);
    ensures normal resource_borrowed(srcSize);
    ensures normal resource_borrowed(dstCapacity);
    ensures normal resource_borrowed(compressionLevel);
    ensures normal resource_retained_by(src, state);
    ensures normal resource_return_none();
};

// --- HC streaming: the stream keeps `src` as its dictionary ----------------
extern fn LZ4_compress_HC_continue(LZ4_streamHCPtr: ptr<mut, u8>, src: ptr<const, u8>, dst: ptr<mut, u8>, srcSize: i32, dstCapacity: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(LZ4_streamHCPtr);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(dst);
    ensures normal resource_borrowed(srcSize);
    ensures normal resource_borrowed(dstCapacity);
    ensures normal resource_retained_by(src, LZ4_streamHCPtr);
    ensures normal resource_return_none();
};

// --- fast streaming: the stream keeps `source` as its dictionary ------------
extern fn LZ4_compress_fast_continue(LZ4_stream: ptr<mut, u8>, source: ptr<const, u8>, dest: ptr<mut, u8>, inputSize: i32, maxOutputSize: i32, acceleration: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(LZ4_stream);
    ensures normal resource_borrowed(source);
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(inputSize);
    ensures normal resource_borrowed(maxOutputSize);
    ensures normal resource_borrowed(acceleration);
    ensures normal resource_retained_by(source, LZ4_stream);
    ensures normal resource_return_none();
};

// --- fast one-shot over a caller's state: reset, then `source` kept ---------
extern fn LZ4_compress_fast_extState(state: ptr<mut, u8>, source: ptr<const, u8>, dest: ptr<mut, u8>, inputSize: i32, maxOutputSize: i32, acceleration: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(state);
    ensures normal resource_borrowed(source);
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(inputSize);
    ensures normal resource_borrowed(maxOutputSize);
    ensures normal resource_borrowed(acceleration);
    ensures normal resource_holder_reset(state);
    ensures normal resource_retained_by(source, state);
    ensures normal resource_return_none();
};
