module contract;

// Card LIBCURL-PROVIDER-PLUGIN. URL encoding (see global.qv for what every
// declaration of this crate shares).

// curl_easy_escape: https://curl.se/libcurl/c/curl_easy_escape.html
// AVAILABILITY: "Added in curl 7.15.4". DESCRIPTION: it "returns that as a
// new allocated string"; "You must curl_free the returned string". RETURN
// VALUE: "A pointer to a null-terminated string or NULL if it failed".
// Pinned prototype: `char *curl_easy_escape(CURL *handle, const char
// *string, int length)`. The handle is unused and the string only read
// (W48-LIBCURL-CONTRACT-PLUGIN, lib/escape.c).
extern fn curl_easy_escape(handle: ptr<mut, u8>, text: ptr<const, u8>, length: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    requires resource_revision(flexible);
    requires resource_library_version(curl, since "7.15.4");
    ensures normal resource_borrowed(handle);
    ensures normal resource_borrowed(text);
    ensures normal resource_borrowed(length);
    ensures normal resource_return_owned(nullable);
};
