extern fn cmt_metric_hist_set(metric: ptr<mut, u8>, timestamp: u64, bucket_id: i32, val: f64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #bucket_extent(
        #bucket_extent: integer,
        #bucket_id: integer,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #hist_buckets: object,
        #hist_buckets_field: field,
        #live: predicate<environment, object>,
        #metric: object,
        #u64: scalar_type
    ) =
        (((((0 <= #bucket_id) && (#bucket_id < #bucket_extent)) && #field(#env,#metric,#hist_buckets_field,#hist_buckets)) && #live(#env,#hist_buckets)) && #extent(#env,#hist_buckets,#bucket_extent,#u64));
    quant condition entry #unsigned_conversion(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615)));
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    ensures normal successful_CAS_stores_converted_integer_bucket_count_then_timestamp;
    ensures normal no_joint_atomicity_or_wait_free_progress_is_promised;
    ensures normal metric_and_nested_storage_ownership_are_preserved;
};

extern fn cmt_summary_quantile_set(metric: ptr<mut, u8>, timestamp: u64, quantile_id: i32, val: f64) -> unit
contract {
    quant condition entry #quantile_representation(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #integer_field: predicate<environment, object, field, integer>,
        #live: predicate<environment, object>,
        #metric: object,
        #null: object,
        #quantiles: object,
        #quantiles_count: integer,
        #quantiles_count_field: field,
        #quantiles_field: field,
        #u64: scalar_type
    ) =
        (!((#metric == #null)) => (((#live(#env,#metric) && #field(#env,#metric,#quantiles_field,#quantiles)) && #integer_field(#env,#metric,#quantiles_count_field,#quantiles_count)) && (!((#quantiles == #null)) => (#live(#env,#quantiles) && #extent(#env,#quantiles,#quantiles_count,#u64)))));
    quant condition entry #quantile_storage(
        #atomic_array: predicate<environment, object, integer>,
        #env: environment,
        #metric: object,
        #null: object,
        #quantile_id: integer,
        #quantiles: object,
        #quantiles_count: integer,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && !((#quantiles == #null))) && ((0 <= #quantile_id) && (#quantile_id < #quantiles_count))) => (#writable(#env,#quantiles,#u64) && #atomic_array(#env,#quantiles,#quantile_id)));
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    ensures normal null_metric_null_array_negative_or_out_of_range_id_is_a_noop;
    ensures normal admitted_slot_CAS_stores_double_bits_then_timestamp;
    ensures normal no_joint_atomicity_or_wait_free_progress_is_promised;
    ensures normal metric_and_nested_storage_ownership_are_preserved;
};

