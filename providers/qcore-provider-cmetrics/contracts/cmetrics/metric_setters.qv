module contract;

// QUANT-CONTRACT-HYPOTHESES: each explicit entry condition is an obligation
// under the explicitly bound model environment and relation/function meanings.
// Mathematical integers have no C wraparound; C ranges are stated separately.
// The migration map records primitive meanings and open C/model correspondence.
// These declared models install no interpreted resource/bounds/outer permission.

// Complete-call exclusion covers the typed owner (if any), selected metric
// and storage used by the call: conflicting writers/raw readers, replacement,
// expiration and destruction. Internal locks do not supply this caller guard.

// Declared effect models, outside resource/bounds/outer interpreted views.
// Source: Fluent Bit 66910c10a4d7eafa810b84229cf2dcf7b0f26f97,
// cmt_metric.c, cmt_metric_histogram.c, cmt_summary.c and their public headers.
// Atomic backend/layout correctness is a premise. Normal postconditions do
// not assert termination of CAS loops or a coherent multi-field snapshot.
// Existing set_double/int64/uint64/timestamp/start_timestamp and unset_start_
// timestamp declarations remain custody-only in metric_values.qv. Their
// richer value/domain/synchronization obligations are documented in the report;
// this file neither duplicates nor strengthens their interpreted permissions.

extern fn cmt_metric_set(metric: ptr<mut, u8>, timestamp: u64, val: f64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #scalar_conversions(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && (((-9223372036854775808 <= #trunc(#val)) && (#trunc(#val) <= 9223372036854775807)) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615))));

    quant condition normal #delegate(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #set_double: declaration,
        #trace: trace
    ) =
        exists (#e: event) { (#event_of(#trace,#call,#e) && #invoke(#trace,#e,#set_double)) };
    quant condition normal #scalar_stores(
        #call: activation,
        #double_bits: function<floating,integer>,
        #double_tag: integer,
        #event_of: predicate<trace,activation,event>,
        #int64_field: field,
        #metric: object,
        #position: function<trace,event,integer>,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace,
        #trunc: function<floating,integer>,
        #type_field: field,
        #uint64_field: field,
        #val: floating,
        #val_field: field
    ) =
        exists (#e0: event) { exists (#e1: event) { exists (#e2: event) { exists (#e3: event) { exists (#e4:
        event) { (((((((((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#val_field,0,#double_bits(#val))) && (#event_of(#trace,#call,#e1) &&
        #store(#trace,#e1,#metric,#int64_field,0,#trunc(#val)))) && (#event_of(#trace,#call,#e2) &&
        #store(#trace,#e2,#metric,#uint64_field,0,#trunc(#val)))) && (#event_of(#trace,#call,#e3) &&
        #store(#trace,#e3,#metric,#timestamp_field,0,#timestamp))) && (#event_of(#trace,#call,#e4) &&
        #store(#trace,#e4,#metric,#type_field,0,#double_tag))) && #position(#trace,#e0) < #position(#trace,#e1))
        && #position(#trace,#e1) < #position(#trace,#e2)) && #position(#trace,#e2) < #position(#trace,#e3)) &&
        #position(#trace,#e3) < #position(#trace,#e4)) } } } } };
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};

extern fn cmt_metric_set_exp_hist_count(metric: ptr<mut, u8>, count: u64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };

    quant condition normal #count_store(
        #call: activation,
        #count: integer,
        #event_of: predicate<trace,activation,event>,
        #exp_count_field: field,
        #metric: object,
        #store: predicate<trace,event,object,field,integer,integer>,
        #trace: trace
    ) =
        exists (#e0: event) { (#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#exp_count_field,0,#count)) };
    quant condition normal #timestamp_frame(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp_field: field,
        #trace: trace
    ) =
        forall (#e: event) { forall (#index: integer) { forall (#value: integer) { (#event_of(#trace,#call,#e)
        => !#store(#trace,#e,#metric,#timestamp_field,#index,#value)) } } };
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};

extern fn cmt_metric_set_exp_hist_sum(metric: ptr<mut, u8>, sum_set: i32, sum: f64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };

    quant condition normal #normalized_sum(
        #call: activation,
        #double_bits: function<floating,integer>,
        #event_of: predicate<trace,activation,event>,
        #exp_flag_field: field,
        #exp_sum_field: field,
        #metric: object,
        #position: function<trace,event,integer>,
        #store: predicate<trace,event,object,field,integer,integer>,
        #sum: floating,
        #sum_set: integer,
        #trace: trace
    ) =
        (((#sum_set == 0) => exists (#e0: event) { exists (#e1: event) { (((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#exp_flag_field,0,0)) && (#event_of(#trace,#call,#e1) &&
        #store(#trace,#e1,#metric,#exp_sum_field,0,0))) && #position(#trace,#e0) < #position(#trace,#e1)) } })
        && ((!(#sum_set == 0)) => exists (#e0: event) { exists (#e1: event) { (((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#exp_flag_field,0,1)) && (#event_of(#trace,#call,#e1) &&
        #store(#trace,#e1,#metric,#exp_sum_field,0,#double_bits(#sum)))) && #position(#trace,#e0) <
        #position(#trace,#e1)) } }));
    quant condition normal #timestamp_frame(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp_field: field,
        #trace: trace
    ) =
        forall (#e: event) { forall (#index: integer) { forall (#value: integer) { (#event_of(#trace,#call,#e)
        => !#store(#trace,#e,#metric,#timestamp_field,#index,#value)) } } };
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};

