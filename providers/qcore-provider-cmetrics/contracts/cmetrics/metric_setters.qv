module contract;

// QUANT-CONTRACT-HYPOTHESES: each explicit entry condition is an obligation
// under the explicitly bound model environment and relation/function meanings.
// Mathematical integers have no C wraparound; C ranges are stated separately.
// The migration map records primitive meanings and open C/model correspondence.
// These declared models install no interpreted resource/bounds/outer permission.

// Complete-call exclusion covers the typed owner (if any), selected metric
// and storage used by the call: conflicting writers/raw readers, replacement,
// expiration and destruction. Internal locks do not supply this caller guard.

// Declared effect models, outside resource/bounds/outer interpreted views.
// Source: Fluent Bit 66910c10a4d7eafa810b84229cf2dcf7b0f26f97,
// cmt_metric.c, cmt_metric_histogram.c, cmt_summary.c and their public headers.
// Atomic backend/layout correctness is a premise. Normal postconditions do
// not assert termination of CAS loops or a coherent multi-field snapshot.
// Existing set_double/int64/uint64/timestamp/start_timestamp and unset_start_
// timestamp declarations remain custody-only in metric_values.qv. Their
// richer value/domain/synchronization obligations are documented in the report;
// this file neither duplicates nor strengthens their interpreted permissions.

extern fn cmt_metric_set(metric: ptr<mut, u8>, timestamp: u64, val: f64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #scalar_conversions(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && (((-9223372036854775808 <= #trunc(#val)) && (#trunc(#val) <= 9223372036854775807)) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615))));
    ensures normal delegates_to_cmt_metric_set_double;
    ensures normal scalar_value_mirrors_timestamp_and_double_type_tag_are_stored;
    ensures normal no_whole_record_atomic_snapshot_is_promised;
    ensures normal metric_and_nested_storage_ownership_are_preserved;
    ensures normal no_pointer_or_ownership_escapes;
};

