extern fn cmt_metric_hist_set(metric: ptr<mut, u8>, timestamp: u64, bucket_id: i32, val: f64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #bucket_extent(
        #bucket_extent: integer,
        #bucket_id: integer,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #hist_buckets: object,
        #hist_buckets_field: field,
        #live: predicate<environment, object>,
        #metric: object,
        #u64: scalar_type
    ) =
        (((((0 <= #bucket_id) && (#bucket_id < #bucket_extent)) && #field(#env,#metric,#hist_buckets_field,#hist_buckets)) && #live(#env,#hist_buckets)) && #extent(#env,#hist_buckets,#bucket_extent,#u64));
    quant condition entry #unsigned_conversion(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615)));
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };

    quant condition normal #cas_then_timestamp(
        #bucket_field: field,
        #bucket_id: integer,
        #call: activation,
        #cas: predicate<trace,event>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #position: function<trace,event,integer>,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace,
        #trunc: function<floating,integer>,
        #val: floating
    ) =
        exists (#e0: event) { exists (#e1: event) { ((((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#bucket_field,#bucket_id,#trunc(#val))) && #cas(#trace,#e0)) &&
        (#event_of(#trace,#call,#e1) && #store(#trace,#e1,#metric,#timestamp_field,0,#timestamp))) &&
        #position(#trace,#e0) < #position(#trace,#e1)) } };
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};

extern fn cmt_summary_quantile_set(metric: ptr<mut, u8>, timestamp: u64, quantile_id: i32, val: f64) -> unit
contract {
    quant condition entry #quantile_representation(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #integer_field: predicate<environment, object, field, integer>,
        #live: predicate<environment, object>,
        #metric: object,
        #null: object,
        #quantiles: object,
        #quantiles_count: integer,
        #quantiles_count_field: field,
        #quantiles_field: field,
        #u64: scalar_type
    ) =
        (!((#metric == #null)) => (((#live(#env,#metric) && #field(#env,#metric,#quantiles_field,#quantiles)) && #integer_field(#env,#metric,#quantiles_count_field,#quantiles_count)) && (!((#quantiles == #null)) => (#live(#env,#quantiles) && #extent(#env,#quantiles,#quantiles_count,#u64)))));
    quant condition entry #quantile_storage(
        #atomic_array: predicate<environment, object, integer>,
        #env: environment,
        #metric: object,
        #null: object,
        #quantile_id: integer,
        #quantiles: object,
        #quantiles_count: integer,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && !((#quantiles == #null))) && ((0 <= #quantile_id) && (#quantile_id < #quantiles_count))) => (#writable(#env,#quantiles,#u64) && #atomic_array(#env,#quantiles,#quantile_id)));
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };

    quant condition normal #guarded_stores(
        #call: activation,
        #cas: predicate<trace,event>,
        #double_bits: function<floating,integer>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #null: object,
        #position: function<trace,event,integer>,
        #quantile_field: field,
        #quantile_id: integer,
        #quantiles: object,
        #quantiles_count: integer,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace,
        #val: floating
    ) =
        (((!(#metric == #null) && !(#quantiles == #null)) && ((0 <= #quantile_id) && (#quantile_id <
        #quantiles_count))) => exists (#e0: event) { exists (#e1: event) { ((((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#quantile_field,#quantile_id,#double_bits(#val))) && #cas(#trace,#e0)) &&
        (#event_of(#trace,#call,#e1) && #store(#trace,#e1,#metric,#timestamp_field,0,#timestamp))) &&
        #position(#trace,#e0) < #position(#trace,#e1)) } });
    quant condition normal #inactive_no_store(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #null: object,
        #quantile_id: integer,
        #quantiles: object,
        #quantiles_count: integer,
        #store: predicate<trace,event,object,field,integer,integer>,
        #trace: trace
    ) =
        ((!((!(#metric == #null) && !(#quantiles == #null)) && ((0 <= #quantile_id) && (#quantile_id <
        #quantiles_count)))) => forall (#e: event) { forall (#target: object) { forall (#field: field) { forall
        (#index: integer) { forall (#value: integer) { (#event_of(#trace,#call,#e) =>
        !#store(#trace,#e,#target,#field,#index,#value)) } } } } });
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};

extern fn cmt_summary_sum_set(metric: ptr<mut, u8>, timestamp: u64, val: f64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };

    quant condition normal #cas_then_timestamp(
        #call: activation,
        #cas: predicate<trace,event>,
        #double_bits: function<floating,integer>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #position: function<trace,event,integer>,
        #store: predicate<trace,event,object,field,integer,integer>,
        #summary_sum_field: field,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace,
        #val: floating
    ) =
        exists (#e0: event) { exists (#e1: event) { ((((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#summary_sum_field,0,#double_bits(#val))) && #cas(#trace,#e0)) &&
        (#event_of(#trace,#call,#e1) && #store(#trace,#e1,#metric,#timestamp_field,0,#timestamp))) &&
        #position(#trace,#e0) < #position(#trace,#e1)) } };
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};

extern fn cmt_summary_count_set(metric: ptr<mut, u8>, timestamp: u64, count: u64) -> unit
contract {
    quant condition entry #metric_storage(
        #atomic_backend: predicate<environment, object>,
        #atomic_cell: predicate<environment, object, object>,
        #env: environment,
        #live: predicate<environment, object>,
        #metric: object,
        #metric_type: scalar_type,
        #null: object,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#metric == #null)) && #live(#env,#metric)) && #writable(#env,#metric,#metric_type)) && forall (#cell: object) { (#atomic_cell(#env,#metric,#cell) => (#writable(#env,#cell,#u64) && #atomic_backend(#env,#cell))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };

    quant condition normal #cas_then_timestamp(
        #call: activation,
        #cas: predicate<trace,event>,
        #count: integer,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #position: function<trace,event,integer>,
        #store: predicate<trace,event,object,field,integer,integer>,
        #summary_count_field: field,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace
    ) =
        exists (#e0: event) { exists (#e1: event) { ((((#event_of(#trace,#call,#e0) &&
        #store(#trace,#e0,#metric,#summary_count_field,0,#count)) && #cas(#trace,#e0)) &&
        (#event_of(#trace,#call,#e1) && #store(#trace,#e1,#metric,#timestamp_field,0,#timestamp))) &&
        #position(#trace,#e0) < #position(#trace,#e1)) } };
    quant condition normal #custody_frame(
        #before: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #metric: object,
        #nested: predicate<state,object,object>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #metric) || #nested(#before,#metric,#o)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    // Separate atomic steps establish no joint snapshot or CAS-loop termination guarantee.

};
