module contract;

// QUANT-CONTRACT-HYPOTHESES: each explicit entry condition is an obligation
// under the explicitly bound model environment and relation/function meanings.
// Mathematical integers have no C wraparound; C ranges are stated separately.
// The migration map records primitive meanings and open C/model correspondence.
// These declared models install no interpreted resource/bounds/outer permission.

// Source-audited declared model, not an interpreted resource-v1 declaration.
// Read cmt_opts.{h,c} and CFL SDS helpers at Fluent Bit
// 66910c10a4d7eafa810b84229cf2dcf7b0f26f97. The enclosing opts record belongs
// to its caller. Its five pointer fields own SDS handles after committed writes.
// Init is not transactional; exit leaves pointer bytes unchanged after release.
resource type CmtOptsContents {
    repr: ptr<mut, u8>;
    footprint: { opts_contents = 1 };
    destructor: cmt_opts_exit noexcept;
    copy: forbidden;
    move: allowed;
}

extern fn cmt_opts_init(opts: ptr<mut, u8>, ns: ptr<mut, u8>,
                         subsystem: ptr<mut, u8>, name: ptr<mut, u8>,
                         description: ptr<mut, u8>) -> i32
contract {
    quant condition entry #opts_storage(
        #caller: object,
        #env: environment,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #opts_type: scalar_type,
        #owns: predicate<environment, object, object>,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((!((#opts == #null)) && #live(#env,#opts)) && #owns(#env,#caller,#opts)) && #writable(#env,#opts,#opts_type));
    quant condition entry #null_sds_fields(
        #description_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #subsystem_field: field
    ) =
        ((((#field(#env,#opts,#ns_field,#null) && #field(#env,#opts,#subsystem_field,#null)) && #field(#env,#opts,#name_field,#null)) && #field(#env,#opts,#description_field,#null)) && #field(#env,#opts,#fqname_field,#null));
    quant condition entry #input_strings(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #null: object,
        #string_input: predicate<activation, object>,
        #terminated: predicate<environment, object>
    ) =
        forall (#input: object) { ((#string_input(#call,#input) && !((#input == #null))) => (#live(#env,#input) && #terminated(#env,#input))) };
    quant condition entry #input_frame(
        #call: activation,
        #description_field: field,
        #env: environment,
        #field_disjoint: predicate<environment, object, object, field>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #string_input: predicate<activation, object>,
        #subsystem_field: field,
        #trace: trace
    ) =
        forall (#input: object) { ((#string_input(#call,#input) && !((#input == #null))) => (#stable(#trace,#call,#input) && forall (#f: field) { (((#f == #ns_field) || ((#f == #subsystem_field) || ((#f == #name_field) || ((#f == #description_field) || (#f == #fqname_field))))) => #field_disjoint(#env,#input,#opts,#f)) })) };
    quant condition entry #string_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition normal #result_domain(#result: integer) = ((#result == 0) || (#result == -1));
    quant condition entry #call_exclusion(
        #access: predicate<trace,event,object>,
        #actor: function<event,actor>,
        #before: state,
        #call: activation,
        #caller: actor,
        #description_field: field,
        #during: predicate<trace,activation,event>,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #subsystem_field: field,
        #trace: trace
    ) =
        forall (#e: event) { forall (#o: object) { ((((#o == #opts) || exists (#f: field) { (((((#f == #ns_field
        || #f == #subsystem_field) || #f == #name_field) || #f == #description_field) || #f == #fqname_field) &&
        ((#o == #field(#before,#opts,#f)) && !(#o == #null))) }) && (#during(#trace,#call,#e) &&
        #access(#trace,#e,#o))) => #actor(#e) == #caller) } };
    quant condition entry #helper_frame(
        #before: state,
        #call: activation,
        #helper_event: predicate<trace,activation,event>,
        #input: predicate<activation,object>,
        #null: object,
        #opts: object,
        #release: predicate<trace,event,object>,
        #retain: predicate<trace,event,object>,
        #start: function<state,object,integer>,
        #stop: function<state,object,integer>,
        #trace: trace,
        #write_start: function<trace,event,integer>,
        #write_stop: function<trace,event,integer>,
        #writes: predicate<trace,event>
    ) =
        forall (#e: event) { (#helper_event(#trace,#call,#e) => forall (#o: object) { (((#o == #opts) ||
        (#input(#call,#o) && !(#o == #null))) => (((!#release(#trace,#e,#o)) && (!#retain(#trace,#e,#o))) &&
        (#writes(#trace,#e) => ((#write_stop(#trace,#e) <= #start(#before,#o)) || (#stop(#before,#o) <=
        #write_start(#trace,#e)))))) }) };
    quant condition normal #null_name(
        #after: state,
        #before: state,
        #call: activation,
        #description_field: field,
        #event_of: predicate<trace,activation,event>,
        #field: function<state,object,field,object>,
        #field_write: predicate<trace,event,object,field>,
        #fqname_field: field,
        #name: object,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #repr: function<state,object,field,bytes>,
        #result: integer,
        #subsystem_field: field,
        #trace: trace
    ) =
        ((#name == #null) => ((#result == -1) && (forall (#f: field) { (((((#f == #ns_field || #f ==
        #subsystem_field) || #f == #name_field) || #f == #description_field) || #f == #fqname_field) =>
        (#field(#after,#opts,#f) == #field(#before,#opts,#f))) } && (forall (#f: field) { (((((#f == #ns_field
        || #f == #subsystem_field) || #f == #name_field) || #f == #description_field) || #f == #fqname_field) =>
        (#repr(#after,#opts,#f) == #repr(#before,#opts,#f))) } && forall (#e: event) {
        (#event_of(#trace,#call,#e) => forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) ||
        #f == #name_field) || #f == #description_field) || #f == #fqname_field) =>
        !#field_write(#trace,#e,#opts,#f)) }) }))));
    quant condition normal #success_contents(
        #after: state,
        #description_field: field,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #live: predicate<state,object>,
        #name_field: field,
        #null: object,
        #opts: object,
        #owns: predicate<state,object,object>,
        #result: integer,
        #sds: predicate<state,object>
    ) =
        ((#result == 0) => ((((!(#field(#after,#opts,#name_field) == #null) &&
        (#live(#after,#field(#after,#opts,#name_field)) && (#sds(#after,#field(#after,#opts,#name_field)) &&
        #owns(#after,#opts,#field(#after,#opts,#name_field))))) && (!(#field(#after,#opts,#description_field) ==
        #null) && (#live(#after,#field(#after,#opts,#description_field)) &&
        (#sds(#after,#field(#after,#opts,#description_field)) &&
        #owns(#after,#opts,#field(#after,#opts,#description_field)))))) && (!(#field(#after,#opts,#fqname_field)
        == #null) && (#live(#after,#field(#after,#opts,#fqname_field)) &&
        (#sds(#after,#field(#after,#opts,#fqname_field)) &&
        #owns(#after,#opts,#field(#after,#opts,#fqname_field))))))));
    quant condition normal #optional_copies(
        #after: state,
        #field: function<state,object,field,object>,
        #live: predicate<state,object>,
        #ns: object,
        #ns_field: field,
        #null: object,
        #opts: object,
        #owns: predicate<state,object,object>,
        #result: integer,
        #sds: predicate<state,object>,
        #subsystem: object,
        #subsystem_field: field
    ) =
        ((#result == 0) => (((!(#ns == #null)) => (!(#field(#after,#opts,#ns_field) == #null) &&
        (#live(#after,#field(#after,#opts,#ns_field)) && (#sds(#after,#field(#after,#opts,#ns_field)) &&
        #owns(#after,#opts,#field(#after,#opts,#ns_field)))))) && ((!(#subsystem == #null)) =>
        (!(#field(#after,#opts,#subsystem_field) == #null) &&
        (#live(#after,#field(#after,#opts,#subsystem_field)) &&
        (#sds(#after,#field(#after,#opts,#subsystem_field)) &&
        #owns(#after,#opts,#field(#after,#opts,#subsystem_field))))))));
    quant condition normal #stored_contents(
        #after: state,
        #description_field: field,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #live: predicate<state,object>,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #owns: predicate<state,object,object>,
        #sds: predicate<state,object>,
        #subsystem_field: field
    ) =
        forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (!(#field(#after,#opts,#f) == #null) =>
        (#live(#after,#field(#after,#opts,#f)) && (#sds(#after,#field(#after,#opts,#f)) &&
        #owns(#after,#opts,#field(#after,#opts,#f)))))) };
    quant condition normal #failed_append(
        #append: predicate<trace,event>,
        #call: activation,
        #event_after: function<trace,event,state>,
        #event_before: function<trace,event,state>,
        #event_of: predicate<trace,activation,event>,
        #event_result: function<trace,event,object>,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #null: object,
        #opts: object,
        #trace: trace
    ) =
        forall (#e: event) { ((#event_of(#trace,#call,#e) && (#append(#trace,#e) && (#event_result(#trace,#e) ==
        #null))) => #field(#event_after(#trace,#e),#opts,#fqname_field) ==
        #field(#event_before(#trace,#e),#opts,#fqname_field)) };
    quant condition normal #input_custody(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #input: predicate<activation,object>,
        #null: object,
        #release: predicate<trace,event,object>,
        #retain: predicate<trace,event,object>,
        #trace: trace
    ) =
        forall (#o: object) { ((#input(#call,#o) && !(#o == #null)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => (!#release(#trace,#e,#o) && !#retain(#trace,#e,#o))) }) };
    quant condition normal #record_frame(
        #after: state,
        #before: state,
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #index_field: field,
        #live: predicate<state,object>,
        #opts: object,
        #release: predicate<trace,event,object>,
        #repr: function<state,object,field,bytes>,
        #trace: trace
    ) =
        (#live(#after,#opts) && ((#repr(#after,#opts,#index_field) == #repr(#before,#opts,#index_field)) &&
        forall (#e: event) { (#event_of(#trace,#call,#e) => !#release(#trace,#e,#opts)) }));
    // A failed initializer may retain zero or more committed contents; no rollback guarantee follows.
};

extern fn cmt_opts_exit(opts: ptr<mut, u8>) -> unit
contract {
    quant condition entry #opts_lifetime(
        #caller: object,
        #env: environment,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #owns: predicate<environment, object, object>
    ) =
        ((!((#opts == #null)) && #live(#env,#opts)) && #owns(#env,#caller,#opts));
    quant condition entry #sds_ownership(
        #description_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #live: predicate<environment, object>,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #owns: predicate<environment, object, object>,
        #sds_handle: predicate<environment, object>,
        #subsystem_field: field
    ) =
        (forall (#f: field) { forall (#handle: object) { (((((#f == #ns_field) || ((#f == #subsystem_field) || ((#f == #name_field) || ((#f == #description_field) || (#f == #fqname_field))))) && #field(#env,#opts,#f,#handle)) && !((#handle == #null))) => ((#live(#env,#handle) && #owns(#env,#opts,#handle)) && #sds_handle(#env,#handle))) } } && forall (#f: field) { forall (#g: field) { forall (#left: object) { forall (#right: object) { ((((((((#f == #ns_field) || ((#f == #subsystem_field) || ((#f == #name_field) || ((#f == #description_field) || (#f == #fqname_field))))) && #field(#env,#opts,#f,#left)) && (((#g == #ns_field) || ((#g == #subsystem_field) || ((#g == #name_field) || ((#g == #description_field) || (#g == #fqname_field))))) && #field(#env,#opts,#g,#right))) && !((#left == #null))) && !((#right == #null))) && !((#f == #g))) => !((#left == #right))) } } } });
    quant condition entry #initialization_state(
        #committed: predicate<environment, object, object>,
        #description_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #owns: predicate<environment, object, object>,
        #subsystem_field: field
    ) =
        (forall (#handle: object) { (#committed(#env,#opts,#handle) => #owns(#env,#opts,#handle)) } && forall (#f: field) { forall (#handle: object) { (((((#f == #ns_field) || ((#f == #subsystem_field) || ((#f == #name_field) || ((#f == #description_field) || (#f == #fqname_field))))) && #field(#env,#opts,#f,#handle)) && !((#handle == #null))) => #committed(#env,#opts,#handle)) } });
    quant condition entry #sds_retirement(
        #call: activation,
        #description_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #later_use: predicate<trace, activation, event, object>,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #subsystem_field: field,
        #trace: trace
    ) =
        forall (#f: field) { forall (#handle: object) { (((((#f == #ns_field) || ((#f == #subsystem_field) || ((#f == #name_field) || ((#f == #description_field) || (#f == #fqname_field))))) && #field(#env,#opts,#f,#handle)) && !((#handle == #null))) => forall (#event: event) { !(#later_use(#trace,#call,#event,#handle)) }) } };
    quant condition entry #call_exclusion(
        #access: predicate<trace,event,object>,
        #actor: function<event,actor>,
        #before: state,
        #call: activation,
        #caller: actor,
        #description_field: field,
        #during: predicate<trace,activation,event>,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #subsystem_field: field,
        #trace: trace
    ) =
        forall (#e: event) { forall (#o: object) { ((((#o == #opts) || exists (#f: field) { (((((#f == #ns_field
        || #f == #subsystem_field) || #f == #name_field) || #f == #description_field) || #f == #fqname_field) &&
        ((#o == #field(#before,#opts,#f)) && !(#o == #null))) }) && (#during(#trace,#call,#e) &&
        #access(#trace,#e,#o))) => #actor(#e) == #caller) } };
    quant condition entry #helper_frame(
        #before: state,
        #call: activation,
        #helper_event: predicate<trace,activation,event>,
        #input: predicate<activation,object>,
        #null: object,
        #opts: object,
        #release: predicate<trace,event,object>,
        #retain: predicate<trace,event,object>,
        #start: function<state,object,integer>,
        #stop: function<state,object,integer>,
        #trace: trace,
        #write_start: function<trace,event,integer>,
        #write_stop: function<trace,event,integer>,
        #writes: predicate<trace,event>
    ) =
        forall (#e: event) { (#helper_event(#trace,#call,#e) => forall (#o: object) { (((#o == #opts) ||
        (#input(#call,#o) && !(#o == #null))) => (((!#release(#trace,#e,#o)) && (!#retain(#trace,#e,#o))) &&
        (#writes(#trace,#e) => ((#write_stop(#trace,#e) <= #start(#before,#o)) || (#stop(#before,#o) <=
        #write_start(#trace,#e)))))) }) };
    quant condition entry #sds_physical_frame(
        #before: state,
        #description_field: field,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #start: function<state,object,integer>,
        #stop: function<state,object,integer>,
        #subsystem_field: field
    ) =
        (forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (!(#field(#before,#opts,#f) == #null) =>
        ((#start(#before,#field(#before,#opts,#f)) < #stop(#before,#field(#before,#opts,#f))) &&
        ((#stop(#before,#field(#before,#opts,#f)) <= #start(#before,#opts)) || (#stop(#before,#opts) <=
        #start(#before,#field(#before,#opts,#f))))))) } && forall (#f: field) { forall (#g: field) { ((((((#f ==
        #ns_field || #f == #subsystem_field) || #f == #name_field) || #f == #description_field) || #f ==
        #fqname_field) && (((((#g == #ns_field || #g == #subsystem_field) || #g == #name_field) || #g ==
        #description_field) || #g == #fqname_field) && (!(#f == #g) && (!(#field(#before,#opts,#f) == #null) &&
        !(#field(#before,#opts,#g) == #null))))) => ((#stop(#before,#field(#before,#opts,#f)) <=
        #start(#before,#field(#before,#opts,#g))) || (#stop(#before,#field(#before,#opts,#g)) <=
        #start(#before,#field(#before,#opts,#f))))) } });
    quant condition normal #release_once(
        #before: state,
        #call: activation,
        #description_field: field,
        #event_of: predicate<trace,activation,event>,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #release: predicate<trace,event,object>,
        #subsystem_field: field,
        #trace: trace
    ) =
        forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (!(#field(#before,#opts,#f) == #null) => exists (#e:
        event) { ((#event_of(#trace,#call,#e) && #release(#trace,#e,#field(#before,#opts,#f))) && forall
        (#other: event) { ((#event_of(#trace,#call,#other) && #release(#trace,#other,#field(#before,#opts,#f)))
        => #other == #e) }) })) };
    quant condition normal #retire_contents(
        #after: state,
        #before: state,
        #description_field: field,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #live: predicate<state,object>,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #owns: predicate<state,object,object>,
        #subsystem_field: field
    ) =
        forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (!(#field(#before,#opts,#f) == #null) =>
        (!#live(#after,#field(#before,#opts,#f)) && !#owns(#after,#opts,#field(#before,#opts,#f))))) };
    quant condition normal #record_live(
        #after: state,
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #live: predicate<state,object>,
        #opts: object,
        #release: predicate<trace,event,object>,
        #trace: trace
    ) =
        (#live(#after,#opts) && forall (#e: event) { (#event_of(#trace,#call,#e) => !#release(#trace,#e,#opts))
        });
    quant condition normal #field_bytes(
        #after: state,
        #before: state,
        #description_field: field,
        #fqname_field: field,
        #index_field: field,
        #name_field: field,
        #ns_field: field,
        #opts: object,
        #repr: function<state,object,field,bytes>,
        #subsystem_field: field
    ) =
        (forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (#repr(#after,#opts,#f) == #repr(#before,#opts,#f))) } &&
        (#repr(#after,#opts,#index_field) == #repr(#before,#opts,#index_field)));
    quant condition normal #pointer_values(
        #after: state,
        #before: state,
        #description_field: field,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #opts: object,
        #subsystem_field: field
    ) =
        forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (#field(#after,#opts,#f) == #field(#before,#opts,#f))) };
    quant condition normal #old_aliases(
        #after: state,
        #alias: predicate<state,object,object>,
        #before: state,
        #description_field: field,
        #field: function<state,object,field,object>,
        #fqname_field: field,
        #name_field: field,
        #ns_field: field,
        #null: object,
        #opts: object,
        #subsystem_field: field,
        #usable: predicate<state,object>
    ) =
        forall (#f: field) { (((((#f == #ns_field || #f == #subsystem_field) || #f == #name_field) || #f ==
        #description_field) || #f == #fqname_field) => (!(#field(#before,#opts,#f) == #null) => forall (#a:
        object) { (#alias(#before,#a,#field(#before,#opts,#f)) => !#usable(#after,#a)) })) };
    // Pointer bytes remain; retired allocation epochs are not revived by repeating exit.
    // A separate map teardown must discharge its own prerequisites and must not read retired strings.
};
