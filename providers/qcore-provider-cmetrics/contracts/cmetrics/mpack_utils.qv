module contract;

// CMetrics msgpack tag readers — resource-projection vocabulary version 1.
//
// Card W37-CORPUS-CONTRACTS-4. ONE TRUSTED ASSUMPTION about one upstream
// function. This module verifies nothing: the C body is not analyzed by this
// loader, and a declaration is a premise.
//
// Read from the pinned checkout at Fluent Bit
// 66910c10a4d7eafa810b84229cf2dcf7b0f26f97 on this card's own run.
//
// ## Why this callee
//
// `cmt_mpack_consume_uint_tag` is the SOLE blocker of one projected function,
// `unpack_meta_ver` (`lib/cmetrics/src/cmt_decode_msgpack.c:1407-1426`), whose
// single leaf is the call at `:1417`.
//
// ## The body, read from `lib/cmetrics/src/cmt_mpack_utils.c:88-113`
//
//     int cmt_mpack_consume_uint_tag(mpack_reader_t *reader, uint64_t *output_buffer)
//     {
//         mpack_tag_t tag;
//
//         if (NULL == output_buffer) {
//             return CMT_MPACK_INVALID_ARGUMENT_ERROR;
//         }
//
//         if (NULL == reader) {
//             return CMT_MPACK_INVALID_ARGUMENT_ERROR;
//         }
//
//         tag = mpack_read_tag(reader);
//
//         if (mpack_ok != mpack_reader_error(reader)) {
//             return CMT_MPACK_ENGINE_ERROR;
//         }
//
//         if (mpack_type_uint != mpack_tag_type(&tag)) {
//             return CMT_MPACK_UNEXPECTED_DATA_TYPE_ERROR;
//         }
//
//         *output_buffer = mpack_tag_uint_value(&tag);
//
//         return CMT_MPACK_SUCCESS;
//     }
//
//   * `reader` is READ THROUGH (`mpack_read_tag`, `mpack_reader_error`) and
//     nothing else. It is not freed, not stored, not transferred; the caller's
//     obligation to destroy the reader it initialised is unchanged. Borrowed.
//   * `output_buffer` is a `uint64_t *` OUT parameter. The only thing written
//     through it is a SCALAR (`*output_buffer = mpack_tag_uint_value(&tag)`),
//     which is a value and not a resource identity. It is therefore NOT an
//     `Out` slot in the custody sense — nothing is delivered into it that the
//     caller must later release — and `resource_borrowed` is the faithful mode.
//     Declaring a custody `Out` here would assert the caller acquires an
//     obligation it does not acquire.
//   * The result is `int`, a SCALAR status code. A scalar result carries no
//     custody, so `resource_return_none()` is the faithful and only writable
//     result mode.
//   * BOTH pointer parameters are explicitly NULL-guarded before any
//     dereference (`:92` and `:96`), so this body has real failure paths and
//     asserts non-nullness of neither. A borrowed declaration installs no entry
//     resource and asserts no non-nullness, so it cannot delete either path —
//     the hazard constraint 4 names.
//
// ## The duty gate (constraint 8)
//
// The body is defined in `lib/cmetrics/src/cmt_mpack_utils.c`, which IS one of
// the 185 analysed units (7 projected functions in the baseline), so the duty
// gate applies. This declaration is the NEUTRAL ELEMENT — every formal
// `Borrowed`, result `None` — the weakest statement the vocabulary can make
// (constraint 4's `N(m)`), so a derived summary can contradict it only by
// claiming a formal is released, transferred, delivered or restored. The body
// performs no such operation on either parameter. Any conflict that did arise
// would be a `SummaryConflict` diagnostic with the declaration governing, never
// a silent override.
//
// ## ABI (constraint 8)
//
//     lib/cmetrics/include/cmetrics/cmt_mpack_utils.h:37
//         int cmt_mpack_consume_uint_tag(mpack_reader_t *reader, uint64_t *output_buffer);
//
// One definition in the whole tree, external linkage, prototype agreeing with
// the definition in types, arity and parameter spelling. `mpack_reader_t *` and
// `uint64_t *` are each one object-pointer level, `ptr<mut, u8>`; `int`
// projects to `i32` under the LP64 model (`LOADER-ABI-LP64`).
//
// ## NOT CLAIMED
//
//   * Nothing about the decoded value's meaning, range or msgpack
//     well-formedness, and nothing about the reader's error flag.
//   * Nothing about `*output_buffer` being written on the failure paths — on
//     three of the four returns it is not. A custody projection is silent about
//     scalar initialisation, and an uninitialised read in the caller is an
//     upstream defect this declaration neither creates nor detects.
//   * Nothing about the four `CMT_MPACK_*` status constants' values.
//
// ## Read at the same time and DELIBERATELY LEFT UNDECLARED
//
// `cmt_mpack_consume_string_tag`, `cmt_mpack_consume_double_tag`,
// `cmt_mpack_consume_binary_tag` and the rest of the `cmt_mpack_*` family share
// this body's shape but block no projected function in the baseline, so
// declaring them would cost premises and buy nothing. `mpack_read_tag`,
// `mpack_reader_error`, `mpack_tag_type` and `mpack_tag_uint_value` are named
// by this body and undeclared for the same reason.

// --- one unsigned msgpack tag consumed into a caller-supplied scalar slot ---
extern fn cmt_mpack_consume_uint_tag(reader: ptr<mut, u8>, output_buffer: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(reader);
    ensures normal resource_borrowed(output_buffer);
    ensures normal resource_return_none();
};

// ## The array and map unpackers (card CG22-CALLBACK-REGISTRY-CONTRACT)
//
// Contract spec C04.19, gateway rules 13u (synchronous invocation) and 13v
// (table dispatch). Each body read at both audited revisions
// (`scripts/body.py` of the card's report): `cmt_mpack_unpack_array` is
// byte-identical at `66910c10` and `046accf6`; `046accf6` adds to
// `cmt_mpack_unpack_map` a duplicate-key check (a local `seen` array of table
// entries; each handler is then called at most once per map), which changes
// nothing below.
//
// `cmt_mpack_unpack_array(reader, entry_processor_callback, context)`
// (`lib/cmetrics/src/cmt_mpack_utils.c:246-303`) reads an array tag through
// `reader` (`mpack_read_tag`, `mpack_reader_error`, `mpack_tag_array_count`),
// refuses more than `CMT_MPACK_MAX_ARRAY_ENTRY_COUNT` entries, then calls
// `entry_processor_callback(reader, entry_index, context)` once per entry
// while the previous call returned `CMT_MPACK_SUCCESS`, and finishes the
// array (`mpack_done_array`). The callback is called during the call only,
// zero or more times, with the caller's `reader`, an index the body counts and
// the caller's `context`; it is never stored, never handed on, never
// rebound: `resource_callback_invoked(entry_processor_callback, reader, _,
// context)`. Rule 13y checks exactly this against the body in
// `cmt_mpack_utils.c`. `reader` and `context` are read and handed to the
// callback only: borrowed. The result is a status.
//
// `cmt_mpack_unpack_map(reader, callback_list, context)` (`:177-244`) reads a
// map tag, refuses more than `CMT_MPACK_MAX_MAP_ENTRY_COUNT` entries, and for
// each entry reads its key (`cmt_mpack_consume_string_tag`, an sds the body
// destroys) and walks `callback_list` from its first entry while the entry's
// `identifier` is not NULL, calling `callback_entry->handler(reader,
// entry_index, context)` for the entry whose identifier equals the key. The
// handlers are read from the caller's table, during the call only, zero or
// more times, with the same three actuals: `resource_callback_table(
// callback_list, reader, _, context)` (not body-checked: a declared
// assumption). Route G closes the table only when it is an automatic array
// whose braced initializer names the handlers and which the caller names
// nowhere else; the sentinel `{NULL, NULL}` is never called.
//
// `cmt_mpack_unpacker_entry_callback_fn_t` is `int (*)(mpack_reader_t *,
// size_t, void *)` (`cmt_mpack_utils.h:27`), projected `fnptr`; `struct
// cmt_mpack_map_entry_callback_t *`, `mpack_reader_t *` and `void *` are
// `ptr<mut, u8>`.

extern fn cmt_mpack_unpack_array(reader: ptr<mut, u8>, entry_processor_callback: fnptr, context: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(reader);
    ensures normal resource_borrowed(entry_processor_callback);
    ensures normal resource_borrowed(context);
    ensures normal resource_callback_invoked(entry_processor_callback, reader, _, context);
    ensures normal resource_return_none();
};

extern fn cmt_mpack_unpack_map(reader: ptr<mut, u8>, callback_list: ptr<mut, u8>, context: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(reader);
    ensures normal resource_borrowed(callback_list);
    ensures normal resource_borrowed(context);
    ensures normal resource_callback_table(callback_list, reader, _, context);
    ensures normal resource_return_none();
};
