module contract;

// Complete-call exclusion covers the typed owner (if any), selected metric
// and storage used by the call: conflicting writers/raw readers, replacement,
// expiration and destruction. Internal locks do not supply this caller guard.

// Source-audited declared models, no interpreted call permission.
// Fluent Bit 66910c10a4d7eafa810b84229cf2dcf7b0f26f97:
// cmt_{counter,gauge,untyped,histogram,summary,exp_histogram}.c and headers.
// The named getter obligations are the complete cmt_map_metric_get contract
// in map_lifetime.qv, including static hash-zero storage accounting.
// A writable result of lookup is a borrow, never fresh caller ownership.
// Logging/backend validity and C extraction/model correspondence are premises.

extern fn cmt_counter_set(counter: ptr<mut, u8>, timestamp: u64, val: f64,
                          labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    requires counter_is_live_with_matching_opts_map_parent_and_counter_tag;
    requires map_and_lookup_inputs_meet_the_getter_representation_obligations;
    requires caller_excludes_retirement_and_conflicting_metric_users_for_the_complete_call;
    requires val_has_defined_C_double_to_int64_and_uint64_conversions;
    requires failure_logging_context_strings_and_backend_are_valid;
    ensures normal result_is_zero_or_minus_one;
    ensures normal lookup_is_called_with_write_op_true;
    ensures normal minus_one_may_retain_committed_lookup_changes;
    ensures normal lookup_failure_performs_no_following_scalar_set;
    ensures normal decrease_with_allow_reset_zero_returns_minus_one_without_scalar_set;
    ensures normal zero_result_sets_double_value_mirrors_type_and_timestamp;
    ensures normal no_counter_map_or_metric_ownership_is_transferred;
    ensures normal no_coherent_multi_field_snapshot_or_counter_compare_set_is_promised;
};

extern fn cmt_gauge_set(gauge: ptr<mut, u8>, timestamp: u64, val: f64,
                        labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    requires gauge_is_live_with_matching_opts_map_parent_and_gauge_tag;
    requires map_and_lookup_inputs_meet_the_getter_representation_obligations;
    requires caller_excludes_retirement_and_conflicting_metric_users_for_the_complete_call;
    requires val_has_defined_C_double_to_int64_and_uint64_conversions;
    requires failure_logging_context_strings_and_backend_are_valid;
    ensures normal result_is_zero_or_minus_one;
    ensures normal lookup_is_called_with_write_op_true;
    ensures normal minus_one_may_retain_committed_lookup_changes_without_scalar_set;
    ensures normal zero_result_sets_double_value_mirrors_type_and_timestamp;
    ensures normal no_gauge_map_or_metric_ownership_is_transferred;
    ensures normal no_coherent_multi_field_snapshot_is_promised;
};

