    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #histogram_sizes(
        #allocation_bytes: integer,
        #bucket_count: integer,
        #bucket_entries: integer,
        #int_max: integer,
        #size_max: integer,
        #sizeof: function<scalar_type, integer>,
        #u64: scalar_type,
        #u64_size: integer
    ) =
        ((((((#bucket_entries == (#bucket_count + 1)) && (0 <= #bucket_count)) && (#bucket_entries <= #int_max)) && (#u64_size == #sizeof(#u64))) && (#allocation_bytes == (#bucket_entries * #u64_size))) && (#allocation_bytes <= #size_max));
    quant condition entry #bucket_defaults(
        #bucket_count: integer,
        #bucket_defaults: object,
        #bucket_entries: integer,
        #call: activation,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #readable: predicate<environment, object, scalar_type>,
        #stable: predicate<trace, activation, object>,
        #trace: trace,
        #u64: scalar_type
    ) =
        ((#bucket_entries == (#bucket_count + 1)) && ((#extent(#env,#bucket_defaults,#bucket_entries,#u64) && #readable(#env,#bucket_defaults,#u64)) && #stable(#trace,#call,#bucket_defaults)));
    quant condition entry #bucket_ownership(
        #bucket_count: integer,
        #bucket_entries: integer,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #hist_buckets: object,
        #hist_buckets_field: field,
        #live: predicate<environment, object>,
        #metric: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((#bucket_entries == (#bucket_count + 1)) && #field(#env,#metric,#hist_buckets_field,#hist_buckets)) && ((#hist_buckets == #null) || (((#live(#env,#hist_buckets) && #owns(#env,#metric,#hist_buckets)) && #extent(#env,#hist_buckets,#bucket_entries,#u64)) && #writable(#env,#hist_buckets,#u64))));
    quant condition entry #bucket_conversions(
        #bucket_defaults: object,
        #bucket_entries: integer,
        #env: environment,
        #finite: predicate<floating>,
        #read_u64: function<environment, object, integer, integer>,
        #to_double: function<integer, floating>,
        #trunc: function<floating, integer>
    ) =
        forall (#i: integer) { (((0 <= #i) && (#i < #bucket_entries)) => (#finite(#to_double(#read_u64(#env,#bucket_defaults,#i))) && ((0 <= #trunc(#to_double(#read_u64(#env,#bucket_defaults,#i)))) && (#trunc(#to_double(#read_u64(#env,#bucket_defaults,#i))) <= 18446744073709551615)))) };
    quant condition entry #input_array_frame(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #input_array: predicate<activation, object>,
        #trace: trace
    ) =
        forall (#input: object) { (#input_array(#call,#input) => forall (#target: object) { (#affected(#trace,#call,#target) => #disjoint(#env,#input,#target)) }) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #typed_logging(
        #call: activation,
        #env: environment,
        #format_types: predicate<environment, activation>,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        ((forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call)) && #format_types(#env,#call));

    quant condition normal #result_domain(
        #result: integer
    ) =
        ((#result == 0) || (#result == -1));
    quant condition normal #lookup(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_decl: declaration,
        #lookup_event: event,
        #metric: object,
        #object_result: function<trace,event,object>,
        #trace: trace
    ) =
        ((#direct_event(#trace,#call,#lookup_event) && #invoke(#trace,#lookup_event,#lookup_decl)) &&
        #object_result(#trace,#lookup_event) == #metric);
    quant condition normal #map_lookup_write(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #map_lookup_decl: declaration,
        #trace: trace
    ) =
        exists (#e: event) { ((#event_of(#trace,#call,#e) && #invoke(#trace,#e,#map_lookup_decl)) &&
        #integer_arg(#trace,#e,4) == 1) };
    quant condition normal #lookup_failure(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((#metric == #null) => (#result == -1));
    quant condition normal #root_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #map: object,
        #release: predicate<trace,event,object>,
        #root: object,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #root) || (#o == #map)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #metric_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #lookup_event: event,
        #metric: object,
        #null: object,
        #position: function<trace,event,integer>,
        #release: predicate<trace,event,object>,
        #return_position: function<trace,event,integer>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        ((!(#metric == #null)) => forall (#e: event) { ((#event_of(#trace,#call,#e) &&
        (#return_position(#trace,#lookup_event) < #position(#trace,#e))) => ((!#release(#trace,#e,#metric)) &&
        ((!#transfer(#trace,#e,#metric)) && (!#escape(#trace,#e,#metric))))) });
    quant condition normal #active_input_custody(
        #active_input: predicate<trace,activation,object>,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (#active_input(#trace,#call,#o) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #present_success(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((!(#metric == #null)) => (#result == 0));
    quant condition normal #bucket_values(
        #after: state,
        #before: state,
        #bucket_array_field: field,
        #bucket_count: integer,
        #bucket_defaults: object,
        #live: predicate<state,object>,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #owns: predicate<state,object,object>,
        #read_u64: function<state,object,integer,integer>,
        #result: integer,
        #to_double: function<integer,floating>,
        #trunc: function<floating,integer>
    ) =
        ((#result == 0) => (((!(#object_field(#after,#metric,#bucket_array_field) == #null) &&
        #live(#after,#object_field(#after,#metric,#bucket_array_field))) &&
        #owns(#after,#metric,#object_field(#after,#metric,#bucket_array_field))) && forall (#i: integer) { (((0
        <= #i) && (#i < (#bucket_count + 1))) =>
        #read_u64(#after,#object_field(#after,#metric,#bucket_array_field),#i) ==
        #trunc(#to_double(#read_u64(#before,#bucket_defaults,#i)))) }));
    quant condition normal #sum_count_timestamp(
        #after: state,
        #count: integer,
        #count_field: field,
        #double_bits: function<floating,integer>,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #result: integer,
        #sum: floating,
        #sum_field: field,
        #timestamp: integer,
        #timestamp_field: field
    ) =
        ((#result == 0) => ((#int_field(#after,#metric,#sum_field) == #double_bits(#sum) &&
        #int_field(#after,#metric,#count_field) == #count) && #int_field(#after,#metric,#timestamp_field) ==
        #timestamp));
    // Failure retains permitted lookup effects; separate stores grant no joint atomic snapshot.

};

extern fn cmt_summary_set_default(summary: ptr<mut, u8>, timestamp: u64,
                                  quantile_values: ptr<mut, f64>, sum: f64, count: u64,
                                  labels_count: i32, label_vars: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #summary_parent(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #quantile_sizes(
        #allocation_bytes: integer,
        #int_max: integer,
        #quantiles_count: integer,
        #size_max: integer,
        #sizeof: function<scalar_type, integer>,
        #u64: scalar_type,
        #u64_size: integer
    ) =
        (((((0 <= #quantiles_count) && (#quantiles_count <= #int_max)) && (#u64_size == #sizeof(#u64))) && (#allocation_bytes == (#quantiles_count * #u64_size))) && (#allocation_bytes <= #size_max));
    quant condition entry #quantile_values(
        #call: activation,
        #double_type: scalar_type,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #null: object,
        #quantile_values: object,
        #quantiles_count: integer,
        #readable: predicate<environment, object, scalar_type>,
        #stable: predicate<trace, activation, object>,
        #trace: trace
    ) =
        (!((#quantile_values == #null)) => ((#extent(#env,#quantile_values,#quantiles_count,#double_type) && #readable(#env,#quantile_values,#double_type)) && #stable(#trace,#call,#quantile_values)));
    quant condition entry #quantile_ownership(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #integer_field: predicate<environment, object, field, integer>,
        #live: predicate<environment, object>,
        #metric: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #quantiles: object,
        #quantiles_count: integer,
        #quantiles_count_field: field,
        #quantiles_field: field,
        #stored_count: integer,
        #u64: scalar_type
    ) =
        ((#field(#env,#metric,#quantiles_field,#quantiles) && #integer_field(#env,#metric,#quantiles_count_field,#stored_count)) && ((#quantiles == #null) || (((#live(#env,#quantiles) && #owns(#env,#metric,#quantiles)) && #extent(#env,#quantiles,#stored_count,#u64)) && (#quantiles_count <= #stored_count))));
    quant condition entry #input_array_frame(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #input_array: predicate<activation, object>,
        #trace: trace
    ) =
        forall (#input: object) { (#input_array(#call,#input) => forall (#target: object) { (#affected(#trace,#call,#target) => #disjoint(#env,#input,#target)) }) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #failure_logging(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call));

    quant condition normal #result_domain(
        #result: integer
    ) =
        ((#result == 0) || (#result == -1));
    quant condition normal #lookup(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_decl: declaration,
        #lookup_event: event,
        #metric: object,
        #object_result: function<trace,event,object>,
        #trace: trace
    ) =
        ((#direct_event(#trace,#call,#lookup_event) && #invoke(#trace,#lookup_event,#lookup_decl)) &&
        #object_result(#trace,#lookup_event) == #metric);
    quant condition normal #map_lookup_write(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #map_lookup_decl: declaration,
        #trace: trace
    ) =
        exists (#e: event) { ((#event_of(#trace,#call,#e) && #invoke(#trace,#e,#map_lookup_decl)) &&
        #integer_arg(#trace,#e,4) == 1) };
    quant condition normal #lookup_failure(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((#metric == #null) => (#result == -1));
    quant condition normal #root_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #map: object,
        #release: predicate<trace,event,object>,
        #root: object,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #root) || (#o == #map)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #metric_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #lookup_event: event,
        #metric: object,
        #null: object,
        #position: function<trace,event,integer>,
        #release: predicate<trace,event,object>,
        #return_position: function<trace,event,integer>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        ((!(#metric == #null)) => forall (#e: event) { ((#event_of(#trace,#call,#e) &&
        (#return_position(#trace,#lookup_event) < #position(#trace,#e))) => ((!#release(#trace,#e,#metric)) &&
        ((!#transfer(#trace,#e,#metric)) && (!#escape(#trace,#e,#metric))))) });
    quant condition normal #active_input_custody(
        #active_input: predicate<trace,activation,object>,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (#active_input(#trace,#call,#o) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #success_metric(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((#result == 0) => !(#metric == #null));
    quant condition normal #sum_count_timestamp(
        #after: state,
        #count: integer,
        #count_field: field,
        #double_bits: function<floating,integer>,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #result: integer,
        #sum: floating,
        #sum_field: field,
        #timestamp: integer,
        #timestamp_field: field
    ) =
        ((#result == 0) => ((#int_field(#after,#metric,#sum_field) == #double_bits(#sum) &&
        #int_field(#after,#metric,#count_field) == #count) && #int_field(#after,#metric,#timestamp_field) ==
        #timestamp));
    quant condition normal #present_quantile_flag(
        #after: state,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #null: object,
        #quantile_flag_field: field,
        #quantile_values: object,
        #result: integer
    ) =
        ((#result == 0) => ((!(#quantile_values == #null)) => #int_field(#after,#metric,#quantile_flag_field) ==
        1));
    quant condition normal #admitted_quantile_values(
        #after: state,
        #before: state,
        #double_bits: function<floating,integer>,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #metric_count_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #parent_count: integer,
        #quantile_array_field: field,
        #quantile_values: object,
        #read_float: function<state,object,integer,floating>,
        #read_u64: function<state,object,integer,integer>,
        #result: integer
    ) =
        ((#result == 0) => ((!(#quantile_values == #null)) => forall (#i: integer) { (((0 <= #i) && ((#i <
        #parent_count) && (#i < #int_field(#after,#metric,#metric_count_field)))) =>
        #read_u64(#after,#object_field(#after,#metric,#quantile_array_field),#i) ==
        #double_bits(#read_float(#before,#quantile_values,#i))) }));
    quant condition normal #null_quantile_flag(
        #after: state,
        #after_lookup: state,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #null: object,
        #quantile_flag_field: field,
        #quantile_values: object,
        #result: integer
    ) =
        ((#result == 0) => ((#quantile_values == #null) => #int_field(#after,#metric,#quantile_flag_field) ==
        #int_field(#after_lookup,#metric,#quantile_flag_field)));
    quant condition normal #null_quantile_no_call(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #null: object,
        #quantile_decl: declaration,
        #quantile_values: object,
        #trace: trace
    ) =
        ((#quantile_values == #null) => forall (#e: event) { (#direct_event(#trace,#call,#e) =>
        !#invoke(#trace,#e,#quantile_decl)) });
    quant condition normal #existing_quantile_storage(
        #after: state,
        #after_lookup: state,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #metric_count_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #quantile_array_field: field,
        #result: integer
    ) =
        ((#result == 0) => (!(#object_field(#after_lookup,#metric,#quantile_array_field) == #null) =>
        (#object_field(#after,#metric,#quantile_array_field) ==
        #object_field(#after_lookup,#metric,#quantile_array_field) &&
        #int_field(#after,#metric,#metric_count_field) ==
        #int_field(#after_lookup,#metric,#metric_count_field))));
    quant condition normal #null_input_existing_values(
        #after: state,
        #after_lookup: state,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #metric_count_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #quantile_array_field: field,
        #quantile_values: object,
        #read_u64: function<state,object,integer,integer>,
        #result: integer
    ) =
        ((#result == 0) => (((#quantile_values == #null) &&
        !(#object_field(#after_lookup,#metric,#quantile_array_field) == #null)) => forall (#i: integer) { (((0
        <= #i) && (#i < #int_field(#after_lookup,#metric,#metric_count_field))) =>
        #read_u64(#after,#object_field(#after,#metric,#quantile_array_field),#i) ==
        #read_u64(#after_lookup,#object_field(#after_lookup,#metric,#quantile_array_field),#i)) }));
    quant condition normal #prepared_quantile_storage(
        #after: state,
        #after_lookup: state,
        #int_field: function<state,object,field,integer>,
        #live: predicate<state,object>,
        #metric: object,
        #metric_count_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #owns: predicate<state,object,object>,
        #parent_count: integer,
        #quantile_array_field: field,
        #result: integer
    ) =
        ((#result == 0) => (((#object_field(#after_lookup,#metric,#quantile_array_field) == #null) &&
        (#parent_count > 0)) => (((!(#object_field(#after,#metric,#quantile_array_field) == #null) &&
        #live(#after,#object_field(#after,#metric,#quantile_array_field))) &&
        #owns(#after,#metric,#object_field(#after,#metric,#quantile_array_field))) &&
        #int_field(#after,#metric,#metric_count_field) == #parent_count)));
    quant condition normal #null_input_new_values(
        #after: state,
        #after_lookup: state,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #parent_count: integer,
        #quantile_array_field: field,
        #quantile_values: object,
        #read_u64: function<state,object,integer,integer>,
        #result: integer
    ) =
        ((#result == 0) => (((#quantile_values == #null) &&
        ((#object_field(#after_lookup,#metric,#quantile_array_field) == #null) && (#parent_count > 0))) =>
        forall (#i: integer) { (((0 <= #i) && (#i < #parent_count)) =>
        #read_u64(#after,#object_field(#after,#metric,#quantile_array_field),#i) == 0) }));
    quant condition normal #failure_reason(
        #call: activation,
        #calloc_decl: declaration,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #null: object,
        #object_result: function<trace,event,object>,
        #result: integer,
        #trace: trace
    ) =
        ((#result == -1) => ((#metric == #null) || exists (#e: event) { ((#direct_event(#trace,#call,#e) &&
        #invoke(#trace,#e,#calloc_decl)) && #object_result(#trace,#e) == #null) }));
    quant condition normal #present_complete(
        #after: state,
        #after_lookup: state,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #parent_count: integer,
        #quantile_array_field: field,
        #result: integer
    ) =
        ((!(#metric == #null) && ((!(#object_field(#after_lookup,#metric,#quantile_array_field) == #null) ||
        (#parent_count == 0)) || !(#object_field(#after,#metric,#quantile_array_field) == #null))) => (#result
        == 0));
    quant condition normal #zero_parent_storage(
        #after: state,
        #after_lookup: state,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #parent_count: integer,
        #quantile_array_field: field,
        #result: integer
    ) =
        ((#result == 0) => (((#object_field(#after_lookup,#metric,#quantile_array_field) == #null) &&
        (#parent_count == 0)) => (#object_field(#after,#metric,#quantile_array_field) == #null)));
    // Failure retains permitted lookup effects; separate stores grant no joint atomic snapshot.

};

// LP64 projection: size_t is u64. This module grants no ABI or call permission.
extern fn cmt_exp_histogram_set_default(exp_histogram: ptr<mut, u8>, timestamp: u64,
    scale: i32, zero_count: u64, zero_threshold: f64,
    positive_offset: i32, positive_bucket_count: u64, positive_bucket_counts: ptr<mut, u64>,
    negative_offset: i32, negative_bucket_count: u64, negative_bucket_counts: ptr<mut, u64>,
    sum_set: i32, sum: f64, count: u64,
    labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #size_abi(
        #call_abi: function<scalar_type, abi_class>,
        #maximum: function<scalar_type, integer>,
        #minimum: function<scalar_type, integer>,
        #signedness: function<scalar_type, integer>,
        #size_t_type: scalar_type,
        #u64: scalar_type,
        #width: function<scalar_type, integer>
    ) =
        ((((#width(#size_t_type) == #width(#u64)) && (#signedness(#size_t_type) == #signedness(#u64))) && (#minimum(#size_t_type) == #minimum(#u64))) && ((#maximum(#size_t_type) == #maximum(#u64)) && (#call_abi(#size_t_type) == #call_abi(#u64))));
    quant condition entry #exp_histogram_parent(
        #env: environment,
        #exp_histogram: object,
        #exp_histogram_tag: tag,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#exp_histogram == #null)) && #live(#env,#exp_histogram)) && #field(#env,#exp_histogram,#opts_field,#opts)) && #field(#env,#exp_histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#exp_histogram)) && #tag(#env,#map,#exp_histogram_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #input_extents(
        #call: activation,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #negative_array: object,
        #negative_count: integer,
        #null: object,
        #positive_array: object,
        #positive_count: integer,
        #readable: predicate<environment, object, scalar_type>,
        #stable: predicate<trace, activation, object>,
        #trace: trace,
        #u64: scalar_type
    ) =
        ((!((#positive_array == #null)) => ((#extent(#env,#positive_array,#positive_count,#u64) && #readable(#env,#positive_array,#u64)) && #stable(#trace,#call,#positive_array))) && (!((#negative_array == #null)) => ((#extent(#env,#negative_array,#negative_count,#u64) && #readable(#env,#negative_array,#u64)) && #stable(#trace,#call,#negative_array))));
    quant condition entry #copy_sizes(
        #negative_bytes: integer,
        #negative_count: integer,
        #positive_bytes: integer,
        #positive_count: integer,
        #size_max: integer,
        #sizeof: function<scalar_type, integer>,
        #u64: scalar_type,
        #u64_size: integer
    ) =
        (((((#u64_size == #sizeof(#u64)) && (#positive_bytes == (#positive_count * #u64_size))) && (#negative_bytes == (#negative_count * #u64_size))) && (#positive_bytes <= #size_max)) && (#negative_bytes <= #size_max));
    quant condition entry #old_arrays(
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #metric: object,
        #negative_field: field,
        #null: object,
        #old_negative: object,
        #old_positive: object,
        #owns: predicate<environment, object, object>,
        #positive_field: field
    ) =
        ((((#field(#env,#metric,#positive_field,#old_positive) && #field(#env,#metric,#negative_field,#old_negative)) && (!((#old_positive == #null)) => (#live(#env,#old_positive) && #owns(#env,#metric,#old_positive)))) && (!((#old_negative == #null)) => (#live(#env,#old_negative) && #owns(#env,#metric,#old_negative)))) && ((!((#old_positive == #null)) && !((#old_negative == #null))) => #disjoint(#env,#old_positive,#old_negative)));
    quant condition entry #input_array_frame(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #input_array: predicate<activation, object>,
        #trace: trace
    ) =
        forall (#input: object) { (#input_array(#call,#input) => forall (#target: object) { (#affected(#trace,#call,#target) => #disjoint(#env,#input,#target)) }) };
    quant condition entry #borrower_exclusion(
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #later_use: predicate<trace, activation, event, object>,
        #old_negative: object,
        #old_positive: object,
        #trace: trace
    ) =
        ((forall (#event: event) { !(#later_use(#trace,#call,#event,#old_positive)) } && forall (#event: event) { !(#later_use(#trace,#call,#event,#old_negative)) }) && forall (#event: event) { (!(#conflicts(#trace,#call,#event,#old_positive)) && !(#conflicts(#trace,#call,#event,#old_negative))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #exp_histogram_backend(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #lock_abi: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #metric: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        ((forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call)) && #lock_abi(#env,#metric));

    quant condition normal #result_domain(
        #result: integer
    ) =
        ((#result == 0) || (#result == -1));
    quant condition normal #lookup(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_decl: declaration,
        #lookup_event: event,
        #metric: object,
        #object_result: function<trace,event,object>,
        #trace: trace
    ) =
        ((#direct_event(#trace,#call,#lookup_event) && #invoke(#trace,#lookup_event,#lookup_decl)) &&
        #object_result(#trace,#lookup_event) == #metric);
    quant condition normal #map_lookup_write(
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #map_lookup_decl: declaration,
        #trace: trace
    ) =
        exists (#e: event) { ((#event_of(#trace,#call,#e) && #invoke(#trace,#e,#map_lookup_decl)) &&
        #integer_arg(#trace,#e,4) == 1) };
    quant condition normal #lookup_failure(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((#metric == #null) => (#result == -1));
    quant condition normal #root_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #map: object,
        #release: predicate<trace,event,object>,
        #root: object,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #root) || (#o == #map)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #metric_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #lookup_event: event,
        #metric: object,
        #null: object,
        #position: function<trace,event,integer>,
        #release: predicate<trace,event,object>,
        #return_position: function<trace,event,integer>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        ((!(#metric == #null)) => forall (#e: event) { ((#event_of(#trace,#call,#e) &&
        (#return_position(#trace,#lookup_event) < #position(#trace,#e))) => ((!#release(#trace,#e,#metric)) &&
        ((!#transfer(#trace,#e,#metric)) && (!#escape(#trace,#e,#metric))))) });
    quant condition normal #active_input_custody(
        #active_input: predicate<trace,activation,object>,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #release: predicate<trace,event,object>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (#active_input(#trace,#call,#o) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #null_input_failure(
        #negative_count: integer,
        #negative_input: object,
        #null: object,
        #positive_count: integer,
        #positive_input: object,
        #result: integer
    ) =
        ((((#positive_count > 0) && (#positive_input == #null)) || ((#negative_count > 0) && (#negative_input ==
        #null))) => (#result == -1));
    quant condition normal #success_metric(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((#result == 0) => !(#metric == #null));
    quant condition normal #failed_preparation_fields(
        #after: state,
        #after_lookup: state,
        #metric: object,
        #negative_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #positive_field: field,
        #result: integer
    ) =
        (((#result == -1) && !(#metric == #null)) => (#object_field(#after,#metric,#positive_field) ==
        #object_field(#after_lookup,#metric,#positive_field) && #object_field(#after,#metric,#negative_field) ==
        #object_field(#after_lookup,#metric,#negative_field)));
    quant condition normal #failed_copy_release(
        #call: activation,
        #copy_alloc: predicate<trace,activation,object>,
        #event_of: predicate<trace,activation,event>,
        #release: predicate<trace,event,object>,
        #result: integer,
        #trace: trace
    ) =
        ((#result == -1) => forall (#o: object) { (#copy_alloc(#trace,#call,#o) => exists (#e: event) {
        ((#event_of(#trace,#call,#e) && #release(#trace,#e,#o)) && forall (#other: event) {
        ((#event_of(#trace,#call,#other) && #release(#trace,#other,#o)) => #other == #e) }) }) });
    quant condition normal #positive_copy(
        #after: state,
        #before: state,
        #live: predicate<state,object>,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #owns: predicate<state,object,object>,
        #positive_count: integer,
        #positive_field: field,
        #positive_input: object,
        #read_u64: function<state,object,integer,integer>,
        #result: integer
    ) =
        ((#result == 0) => (((#positive_count == 0) => #object_field(#after,#metric,#positive_field) == #null)
        && ((#positive_count > 0) => (((!(#object_field(#after,#metric,#positive_field) == #null) &&
        #live(#after,#object_field(#after,#metric,#positive_field))) &&
        #owns(#after,#metric,#object_field(#after,#metric,#positive_field))) && forall (#i: integer) { (((0 <=
        #i) && (#i < #positive_count)) => #read_u64(#after,#object_field(#after,#metric,#positive_field),#i) ==
        #read_u64(#before,#positive_input,#i)) }))));
    quant condition normal #positive_fresh(
        #after: state,
        #after_lookup: state,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #positive_count: integer,
        #positive_field: field,
        #result: integer
    ) =
        ((#result == 0) => (((#positive_count > 0) && !(#object_field(#after_lookup,#metric,#positive_field) ==
        #null)) => !(#object_field(#after,#metric,#positive_field) ==
        #object_field(#after_lookup,#metric,#positive_field))));
    quant condition normal #positive_release(
        #after: state,
        #after_lookup: state,
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #live: predicate<state,object>,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #owns: predicate<state,object,object>,
        #position: function<trace,event,integer>,
        #positive_field: field,
        #release: predicate<trace,event,object>,
        #result: integer,
        #trace: trace,
        #unlock_event: event
    ) =
        ((#result == 0) => (!(#object_field(#after_lookup,#metric,#positive_field) == #null) => exists (#e:
        event) { (((((#event_of(#trace,#call,#e) &&
        #release(#trace,#e,#object_field(#after_lookup,#metric,#positive_field))) &&
        #position(#trace,#unlock_event) < #position(#trace,#e)) && forall (#other: event) {
        ((#event_of(#trace,#call,#other) &&
        #release(#trace,#other,#object_field(#after_lookup,#metric,#positive_field))) => #other == #e) }) &&
        !#live(#after,#object_field(#after_lookup,#metric,#positive_field))) &&
        !#owns(#after,#metric,#object_field(#after_lookup,#metric,#positive_field))) }));
    quant condition normal #positive_swap_order(
        #after: state,
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #metric: object,
        #object_field: function<state,object,field,object>,
        #position: function<trace,event,integer>,
        #positive_field: field,
        #result: integer,
        #trace: trace,
        #unlock_event: event,
        #write_object: predicate<trace,event,object,field,object>
    ) =
        ((#result == 0) => exists (#e: event) { ((#direct_event(#trace,#call,#e) &&
        #write_object(#trace,#e,#metric,#positive_field,#object_field(#after,#metric,#positive_field))) &&
        #position(#trace,#e) < #position(#trace,#unlock_event)) });
    quant condition normal #negative_copy(
        #after: state,
        #before: state,
        #live: predicate<state,object>,
        #metric: object,
        #negative_count: integer,
        #negative_field: field,
        #negative_input: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #owns: predicate<state,object,object>,
        #read_u64: function<state,object,integer,integer>,
        #result: integer
    ) =
        ((#result == 0) => (((#negative_count == 0) => #object_field(#after,#metric,#negative_field) == #null)
        && ((#negative_count > 0) => (((!(#object_field(#after,#metric,#negative_field) == #null) &&
        #live(#after,#object_field(#after,#metric,#negative_field))) &&
        #owns(#after,#metric,#object_field(#after,#metric,#negative_field))) && forall (#i: integer) { (((0 <=
        #i) && (#i < #negative_count)) => #read_u64(#after,#object_field(#after,#metric,#negative_field),#i) ==
        #read_u64(#before,#negative_input,#i)) }))));
    quant condition normal #negative_fresh(
        #after: state,
        #after_lookup: state,
        #metric: object,
        #negative_count: integer,
        #negative_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #result: integer
    ) =
        ((#result == 0) => (((#negative_count > 0) && !(#object_field(#after_lookup,#metric,#negative_field) ==
        #null)) => !(#object_field(#after,#metric,#negative_field) ==
        #object_field(#after_lookup,#metric,#negative_field))));
    quant condition normal #negative_release(
        #after: state,
        #after_lookup: state,
        #call: activation,
        #event_of: predicate<trace,activation,event>,
        #live: predicate<state,object>,
        #metric: object,
        #negative_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #owns: predicate<state,object,object>,
        #position: function<trace,event,integer>,
        #release: predicate<trace,event,object>,
        #result: integer,
        #trace: trace,
        #unlock_event: event
    ) =
        ((#result == 0) => (!(#object_field(#after_lookup,#metric,#negative_field) == #null) => exists (#e:
        event) { (((((#event_of(#trace,#call,#e) &&
        #release(#trace,#e,#object_field(#after_lookup,#metric,#negative_field))) &&
        #position(#trace,#unlock_event) < #position(#trace,#e)) && forall (#other: event) {
        ((#event_of(#trace,#call,#other) &&
        #release(#trace,#other,#object_field(#after_lookup,#metric,#negative_field))) => #other == #e) }) &&
        !#live(#after,#object_field(#after_lookup,#metric,#negative_field))) &&
        !#owns(#after,#metric,#object_field(#after_lookup,#metric,#negative_field))) }));
    quant condition normal #negative_swap_order(
        #after: state,
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #metric: object,
        #negative_field: field,
        #object_field: function<state,object,field,object>,
        #position: function<trace,event,integer>,
        #result: integer,
        #trace: trace,
        #unlock_event: event,
        #write_object: predicate<trace,event,object,field,object>
    ) =
        ((#result == 0) => exists (#e: event) { ((#direct_event(#trace,#call,#e) &&
        #write_object(#trace,#e,#metric,#negative_field,#object_field(#after,#metric,#negative_field))) &&
        #position(#trace,#e) < #position(#trace,#unlock_event)) });
    quant condition normal #unlock(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #object_arg: function<trace,event,integer,object>,
        #result: integer,
        #trace: trace,
        #unlock_decl: declaration,
        #unlock_event: event
    ) =
        ((#result == 0) => ((#direct_event(#trace,#call,#unlock_event) &&
        #invoke(#trace,#unlock_event,#unlock_decl)) && #object_arg(#trace,#unlock_event,0) == #metric));
    quant condition normal #numeric_fields(
        #after: state,
        #count: integer,
        #exp_count_field: field,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #negative_count: integer,
        #negative_count_field: field,
        #negative_offset: integer,
        #negative_offset_field: field,
        #positive_count: integer,
        #positive_count_field: field,
        #positive_offset: integer,
        #positive_offset_field: field,
        #result: integer,
        #scale: integer,
        #scale_field: field,
        #timestamp: integer,
        #timestamp_field: field,
        #zero_count: integer,
        #zero_count_field: field
    ) =
        ((#result == 0) => (((((((#int_field(#after,#metric,#positive_count_field) == #positive_count &&
        #int_field(#after,#metric,#negative_count_field) == #negative_count) &&
        #int_field(#after,#metric,#scale_field) == #scale) && #int_field(#after,#metric,#zero_count_field) ==
        #zero_count) && #int_field(#after,#metric,#positive_offset_field) == #positive_offset) &&
        #int_field(#after,#metric,#negative_offset_field) == #negative_offset) &&
        #int_field(#after,#metric,#exp_count_field) == #count) && #int_field(#after,#metric,#timestamp_field) ==
        #timestamp));
    quant condition normal #threshold_write(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #metric: object,
        #position: function<trace,event,integer>,
        #result: integer,
        #threshold_field: field,
        #trace: trace,
        #unlock_event: event,
        #write_float: predicate<trace,event,object,field,floating>,
        #zero_threshold: floating
    ) =
        ((#result == 0) => exists (#e: event) { ((#direct_event(#trace,#call,#e) &&
        #write_float(#trace,#e,#metric,#threshold_field,#zero_threshold)) && #position(#trace,#e) <
        #position(#trace,#unlock_event)) });
    quant condition normal #sum_flag_bits(
        #after: state,
        #double_bits: function<floating,integer>,
        #exp_flag_field: field,
        #exp_sum_field: field,
        #int_field: function<state,object,field,integer>,
        #metric: object,
        #result: integer,
        #sum: floating,
        #sum_set: integer
    ) =
        ((#result == 0) => (((#sum_set == 0) => (#int_field(#after,#metric,#exp_flag_field) == 0 &&
        #int_field(#after,#metric,#exp_sum_field) == 0)) && ((!(#sum_set == 0)) =>
        (#int_field(#after,#metric,#exp_flag_field) == 1 && #int_field(#after,#metric,#exp_sum_field) ==
        #double_bits(#sum)))));
    quant condition normal #failure_reason(
        #call: activation,
        #calloc_decl: declaration,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #negative_count: integer,
        #negative_input: object,
        #null: object,
        #object_result: function<trace,event,object>,
        #positive_count: integer,
        #positive_input: object,
        #result: integer,
        #trace: trace
    ) =
        ((#result == -1) => ((#metric == #null) || ((((#positive_count > 0) && (#positive_input == #null)) ||
        ((#negative_count > 0) && (#negative_input == #null))) || exists (#e: event) {
        ((#direct_event(#trace,#call,#e) && #invoke(#trace,#e,#calloc_decl)) && #object_result(#trace,#e) ==
        #null) })));
    quant condition normal #positive_aliases(
        #after: state,
        #after_lookup: state,
        #alias: predicate<state,object,object>,
        #metric: object,
        #null: object,
        #object_field: function<state,object,field,object>,
        #positive_field: field,
        #result: integer,
        #usable: predicate<state,object>
    ) =
        ((#result == 0) => (!(#object_field(#after_lookup,#metric,#positive_field) == #null) => forall (#a:
        object) { (#alias(#after_lookup,#a,#object_field(#after_lookup,#metric,#positive_field)) =>
        !#usable(#after,#a)) }));
    quant condition normal #negative_aliases(
        #after: state,
        #after_lookup: state,
        #alias: predicate<state,object,object>,
        #metric: object,
        #negative_field: field,
        #null: object,
        #object_field: function<state,object,field,object>,
        #result: integer,
        #usable: predicate<state,object>
    ) =
        ((#result == 0) => (!(#object_field(#after_lookup,#metric,#negative_field) == #null) => forall (#a:
        object) { (#alias(#after_lookup,#a,#object_field(#after_lookup,#metric,#negative_field)) =>
        !#usable(#after,#a)) }));
    // Failure retains permitted lookup effects; separate stores grant no joint atomic snapshot.

};
