module contract;

// QUANT-CONTRACT-HYPOTHESES: each explicit entry condition is an obligation
// under the explicitly bound model environment and relation/function meanings.
// Mathematical integers have no C wraparound; C ranges are stated separately.
// The migration map records primitive meanings and open C/model correspondence.
// These declared models install no interpreted resource/bounds/outer permission.

// Complete-call exclusion covers the typed owner (if any), selected metric
// and storage used by the call: conflicting writers/raw readers, replacement,
// expiration and destruction. Internal locks do not supply this caller guard.

// Source-audited declared models, no interpreted call permission.
// Fluent Bit 66910c10a4d7eafa810b84229cf2dcf7b0f26f97:
// cmt_{counter,gauge,untyped,histogram,summary,exp_histogram}.c and headers.
// The named getter obligations are the complete cmt_map_metric_get contract
// in map_lifetime.qv, including static hash-zero storage accounting.
// A writable result of lookup is a borrow, never fresh caller ownership.
// Logging/backend validity and C extraction/model correspondence are premises.

extern fn cmt_counter_set(counter: ptr<mut, u8>, timestamp: u64, val: f64,
                          labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #counter_parent(
        #counter: object,
        #counter_tag: tag,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#counter == #null)) && #live(#env,#counter)) && #field(#env,#counter,#opts_field,#opts)) && #field(#env,#counter,#map_field,#map)) && #field(#env,#map,#parent_field,#counter)) && #tag(#env,#map,#counter_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #scalar_conversions(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && (((-9223372036854775808 <= #trunc(#val)) && (#trunc(#val) <= 9223372036854775807)) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615))));
    quant condition entry #failure_logging(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call));

    quant condition normal #result_domain(
        #result: integer
    ) =
        ((#result == 0) || (#result == -1));
    quant condition normal #lookup_write(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_decl: declaration,
        #lookup_event: event,
        #metric: object,
        #object_result: function<trace,event,object>,
        #trace: trace
    ) =
        (((#direct_event(#trace,#call,#lookup_event) && #invoke(#trace,#lookup_event,#lookup_decl)) &&
        #integer_arg(#trace,#lookup_event,4) == 1) && #object_result(#trace,#lookup_event) == #metric);
    quant condition normal #lookup_failure(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #null: object,
        #result: integer,
        #scalar_decl: declaration,
        #trace: trace
    ) =
        ((#metric == #null) => ((#result == -1) && forall (#e: event) { (#direct_event(#trace,#call,#e) =>
        !#invoke(#trace,#e,#scalar_decl)) }));
    quant condition normal #success_call(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #floating_arg: function<trace,event,integer,floating>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_event: event,
        #metric: object,
        #object_arg: function<trace,event,integer,object>,
        #position: function<trace,event,integer>,
        #result: integer,
        #scalar_decl: declaration,
        #timestamp: integer,
        #trace: trace,
        #val: floating
    ) =
        ((#result == 0) => exists (#e: event) { (((((#direct_event(#trace,#call,#e) &&
        #invoke(#trace,#e,#scalar_decl)) && #object_arg(#trace,#e,0) == #metric) && #integer_arg(#trace,#e,1) ==
        #timestamp) && #floating_arg(#trace,#e,2) == #val) && #position(#trace,#lookup_event) <
        #position(#trace,#e)) });
    quant condition normal #success_stores(
        #call: activation,
        #descendant: predicate<trace,event,event>,
        #direct_event: predicate<trace,activation,event>,
        #double_bits: function<floating,integer>,
        #double_tag: integer,
        #int64_field: field,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #position: function<trace,event,integer>,
        #result: integer,
        #scalar_decl: declaration,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace,
        #trunc: function<floating,integer>,
        #type_field: field,
        #uint64_field: field,
        #val: floating,
        #val_field: field
    ) =
        ((#result == 0) => forall (#s: event) { ((#direct_event(#trace,#call,#s) &&
        #invoke(#trace,#s,#scalar_decl)) => exists (#e0: event) { exists (#e1: event) { exists (#e2: event) {
        exists (#e3: event) { exists (#e4: event) { (((((((((#descendant(#trace,#s,#e0) &&
        #store(#trace,#e0,#metric,#val_field,0,#double_bits(#val))) && (#descendant(#trace,#s,#e1) &&
        #store(#trace,#e1,#metric,#int64_field,0,#trunc(#val)))) && (#descendant(#trace,#s,#e2) &&
        #store(#trace,#e2,#metric,#uint64_field,0,#trunc(#val)))) && (#descendant(#trace,#s,#e3) &&
        #store(#trace,#e3,#metric,#timestamp_field,0,#timestamp))) && (#descendant(#trace,#s,#e4) &&
        #store(#trace,#e4,#metric,#type_field,0,#double_tag))) && #position(#trace,#e0) < #position(#trace,#e1))
        && #position(#trace,#e1) < #position(#trace,#e2)) && #position(#trace,#e2) < #position(#trace,#e3)) &&
        #position(#trace,#e3) < #position(#trace,#e4)) } } } } }) });
    quant condition normal #root_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #map: object,
        #release: predicate<trace,event,object>,
        #root: object,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #root) || (#o == #map)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #scalar_custody(
        #after_lookup: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #lookup_event: event,
        #metric: object,
        #nested: predicate<state,object,object>,
        #null: object,
        #position: function<trace,event,integer>,
        #release: predicate<trace,event,object>,
        #return_position: function<trace,event,integer>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        ((!(#metric == #null)) => forall (#o: object) { (((#o == #metric) || #nested(#after_lookup,#metric,#o))
        => forall (#e: event) { ((#event_of(#trace,#call,#e) && (#return_position(#trace,#lookup_event) <
        #position(#trace,#e))) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) });
    quant condition normal #observed_value(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #floating_result: function<trace,event,floating>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_event: event,
        #metric: object,
        #null: object,
        #object_arg: function<trace,event,integer,object>,
        #old_value: floating,
        #position: function<trace,event,integer>,
        #read_decl: declaration,
        #trace: trace
    ) =
        ((!(#metric == #null)) => exists (#e: event) { ((((#direct_event(#trace,#call,#e) &&
        #invoke(#trace,#e,#read_decl)) && #object_arg(#trace,#e,0) == #metric) && #floating_result(#trace,#e) ==
        #old_value) && #position(#trace,#lookup_event) < #position(#trace,#e)) });
    quant condition normal #refused_decrease(
        #allow_reset: integer,
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #less: predicate<floating,floating>,
        #metric: object,
        #null: object,
        #old_value: floating,
        #result: integer,
        #scalar_decl: declaration,
        #trace: trace,
        #val: floating
    ) =
        ((!(#metric == #null) && ((#allow_reset == 0) && #less(#val,#old_value))) => ((#result == -1) && forall
        (#e: event) { (#direct_event(#trace,#call,#e) => !#invoke(#trace,#e,#scalar_decl)) }));
    quant condition normal #accepted_value(
        #allow_reset: integer,
        #less: predicate<floating,floating>,
        #metric: object,
        #null: object,
        #old_value: floating,
        #result: integer,
        #val: floating
    ) =
        ((!(#metric == #null) && ((!(#allow_reset == 0)) || !#less(#val,#old_value))) => (#result == 0));
    // Failure does not promise lookup rollback; scalar stores are separate atomic events.

};

extern fn cmt_gauge_set(gauge: ptr<mut, u8>, timestamp: u64, val: f64,
                        labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #gauge_parent(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #gauge: object,
        #gauge_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#gauge == #null)) && #live(#env,#gauge)) && #field(#env,#gauge,#opts_field,#opts)) && #field(#env,#gauge,#map_field,#map)) && #field(#env,#map,#parent_field,#gauge)) && #tag(#env,#map,#gauge_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #scalar_conversions(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && (((-9223372036854775808 <= #trunc(#val)) && (#trunc(#val) <= 9223372036854775807)) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615))));
    quant condition entry #failure_logging(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call));

    quant condition normal #result_domain(
        #result: integer
    ) =
        ((#result == 0) || (#result == -1));
    quant condition normal #lookup_write(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_decl: declaration,
        #lookup_event: event,
        #metric: object,
        #object_result: function<trace,event,object>,
        #trace: trace
    ) =
        (((#direct_event(#trace,#call,#lookup_event) && #invoke(#trace,#lookup_event,#lookup_decl)) &&
        #integer_arg(#trace,#lookup_event,4) == 1) && #object_result(#trace,#lookup_event) == #metric);
    quant condition normal #lookup_failure(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #null: object,
        #result: integer,
        #scalar_decl: declaration,
        #trace: trace
    ) =
        ((#metric == #null) => ((#result == -1) && forall (#e: event) { (#direct_event(#trace,#call,#e) =>
        !#invoke(#trace,#e,#scalar_decl)) }));
    quant condition normal #success_call(
        #call: activation,
        #direct_event: predicate<trace,activation,event>,
        #floating_arg: function<trace,event,integer,floating>,
        #integer_arg: function<trace,event,integer,integer>,
        #invoke: predicate<trace,event,declaration>,
        #lookup_event: event,
        #metric: object,
        #object_arg: function<trace,event,integer,object>,
        #position: function<trace,event,integer>,
        #result: integer,
        #scalar_decl: declaration,
        #timestamp: integer,
        #trace: trace,
        #val: floating
    ) =
        ((#result == 0) => exists (#e: event) { (((((#direct_event(#trace,#call,#e) &&
        #invoke(#trace,#e,#scalar_decl)) && #object_arg(#trace,#e,0) == #metric) && #integer_arg(#trace,#e,1) ==
        #timestamp) && #floating_arg(#trace,#e,2) == #val) && #position(#trace,#lookup_event) <
        #position(#trace,#e)) });
    quant condition normal #success_stores(
        #call: activation,
        #descendant: predicate<trace,event,event>,
        #direct_event: predicate<trace,activation,event>,
        #double_bits: function<floating,integer>,
        #double_tag: integer,
        #int64_field: field,
        #invoke: predicate<trace,event,declaration>,
        #metric: object,
        #position: function<trace,event,integer>,
        #result: integer,
        #scalar_decl: declaration,
        #store: predicate<trace,event,object,field,integer,integer>,
        #timestamp: integer,
        #timestamp_field: field,
        #trace: trace,
        #trunc: function<floating,integer>,
        #type_field: field,
        #uint64_field: field,
        #val: floating,
        #val_field: field
    ) =
        ((#result == 0) => forall (#s: event) { ((#direct_event(#trace,#call,#s) &&
        #invoke(#trace,#s,#scalar_decl)) => exists (#e0: event) { exists (#e1: event) { exists (#e2: event) {
        exists (#e3: event) { exists (#e4: event) { (((((((((#descendant(#trace,#s,#e0) &&
        #store(#trace,#e0,#metric,#val_field,0,#double_bits(#val))) && (#descendant(#trace,#s,#e1) &&
        #store(#trace,#e1,#metric,#int64_field,0,#trunc(#val)))) && (#descendant(#trace,#s,#e2) &&
        #store(#trace,#e2,#metric,#uint64_field,0,#trunc(#val)))) && (#descendant(#trace,#s,#e3) &&
        #store(#trace,#e3,#metric,#timestamp_field,0,#timestamp))) && (#descendant(#trace,#s,#e4) &&
        #store(#trace,#e4,#metric,#type_field,0,#double_tag))) && #position(#trace,#e0) < #position(#trace,#e1))
        && #position(#trace,#e1) < #position(#trace,#e2)) && #position(#trace,#e2) < #position(#trace,#e3)) &&
        #position(#trace,#e3) < #position(#trace,#e4)) } } } } }) });
    quant condition normal #root_custody(
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #map: object,
        #release: predicate<trace,event,object>,
        #root: object,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        forall (#o: object) { (((#o == #root) || (#o == #map)) => forall (#e: event) {
        (#event_of(#trace,#call,#e) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) };
    quant condition normal #scalar_custody(
        #after_lookup: state,
        #call: activation,
        #escape: predicate<trace,event,object>,
        #event_of: predicate<trace,activation,event>,
        #lookup_event: event,
        #metric: object,
        #nested: predicate<state,object,object>,
        #null: object,
        #position: function<trace,event,integer>,
        #release: predicate<trace,event,object>,
        #return_position: function<trace,event,integer>,
        #trace: trace,
        #transfer: predicate<trace,event,object>
    ) =
        ((!(#metric == #null)) => forall (#o: object) { (((#o == #metric) || #nested(#after_lookup,#metric,#o))
        => forall (#e: event) { ((#event_of(#trace,#call,#e) && (#return_position(#trace,#lookup_event) <
        #position(#trace,#e))) => ((!#release(#trace,#e,#o)) && ((!#transfer(#trace,#e,#o)) &&
        (!#escape(#trace,#e,#o))))) }) });
    quant condition normal #present_success(
        #metric: object,
        #null: object,
        #result: integer
    ) =
        ((!(#metric == #null)) => (#result == 0));
    // Failure does not promise lookup rollback; scalar stores are separate atomic events.

};

extern fn cmt_untyped_set(untyped: ptr<mut, u8>, timestamp: u64, val: f64,
                          labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #untyped_parent(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>,
        #untyped: object,
        #untyped_tag: tag
    ) =
        (((((((!((#untyped == #null)) && #live(#env,#untyped)) && #field(#env,#untyped,#opts_field,#opts)) && #field(#env,#untyped,#map_field,#map)) && #field(#env,#map,#parent_field,#untyped)) && #tag(#env,#map,#untyped_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #scalar_conversions(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && (((-9223372036854775808 <= #trunc(#val)) && (#trunc(#val) <= 9223372036854775807)) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615))));
    quant condition entry #failure_logging(
        #call: activation,
