extern fn cmt_untyped_set(untyped: ptr<mut, u8>, timestamp: u64, val: f64,
                          labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #untyped_parent(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>,
        #untyped: object,
        #untyped_tag: tag
    ) =
        (((((((!((#untyped == #null)) && #live(#env,#untyped)) && #field(#env,#untyped,#opts_field,#opts)) && #field(#env,#untyped,#map_field,#map)) && #field(#env,#map,#parent_field,#untyped)) && #tag(#env,#map,#untyped_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #scalar_conversions(
        #finite: predicate<floating>,
        #trunc: function<floating, integer>,
        #val: floating
    ) =
        (#finite(#val) && (((-9223372036854775808 <= #trunc(#val)) && (#trunc(#val) <= 9223372036854775807)) && ((0 <= #trunc(#val)) && (#trunc(#val) <= 18446744073709551615))));
    quant condition entry #failure_logging(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call));
    ensures normal result_is_zero_or_minus_one;
    ensures normal lookup_is_called_with_write_op_true;
    ensures normal minus_one_may_retain_committed_lookup_changes_without_scalar_set;
    ensures normal zero_result_sets_double_value_mirrors_type_and_timestamp;
    ensures normal no_untyped_map_or_metric_ownership_is_transferred;
    ensures normal no_coherent_multi_field_snapshot_is_promised;
};

extern fn cmt_histogram_set_default(histogram: ptr<mut, u8>, timestamp: u64,
                                    bucket_defaults: ptr<mut, u64>, sum: f64, count: u64,
                                    labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #histogram_parent(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #histogram_sizes(
        #allocation_bytes: integer,
        #bucket_count: integer,
        #bucket_entries: integer,
        #int_max: integer,
        #size_max: integer,
        #sizeof: function<scalar_type, integer>,
        #u64: scalar_type,
        #u64_size: integer
    ) =
        ((((((#bucket_entries == (#bucket_count + 1)) && (0 <= #bucket_count)) && (#bucket_entries <= #int_max)) && (#u64_size == #sizeof(#u64))) && (#allocation_bytes == (#bucket_entries * #u64_size))) && (#allocation_bytes <= #size_max));
    quant condition entry #bucket_defaults(
        #bucket_count: integer,
        #bucket_defaults: object,
        #bucket_entries: integer,
        #call: activation,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #readable: predicate<environment, object, scalar_type>,
        #stable: predicate<trace, activation, object>,
        #trace: trace,
        #u64: scalar_type
    ) =
        ((#bucket_entries == (#bucket_count + 1)) && ((#extent(#env,#bucket_defaults,#bucket_entries,#u64) && #readable(#env,#bucket_defaults,#u64)) && #stable(#trace,#call,#bucket_defaults)));
    quant condition entry #bucket_ownership(
        #bucket_count: integer,
        #bucket_entries: integer,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #hist_buckets: object,
        #hist_buckets_field: field,
        #live: predicate<environment, object>,
        #metric: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #u64: scalar_type,
        #writable: predicate<environment, object, scalar_type>
    ) =
        (((#bucket_entries == (#bucket_count + 1)) && #field(#env,#metric,#hist_buckets_field,#hist_buckets)) && ((#hist_buckets == #null) || (((#live(#env,#hist_buckets) && #owns(#env,#metric,#hist_buckets)) && #extent(#env,#hist_buckets,#bucket_entries,#u64)) && #writable(#env,#hist_buckets,#u64))));
    quant condition entry #bucket_conversions(
        #bucket_defaults: object,
        #bucket_entries: integer,
        #env: environment,
        #finite: predicate<floating>,
        #read_u64: function<environment, object, integer, integer>,
        #to_double: function<integer, floating>,
        #trunc: function<floating, integer>
    ) =
        forall (#i: integer) { (((0 <= #i) && (#i < #bucket_entries)) => (#finite(#to_double(#read_u64(#env,#bucket_defaults,#i))) && ((0 <= #trunc(#to_double(#read_u64(#env,#bucket_defaults,#i)))) && (#trunc(#to_double(#read_u64(#env,#bucket_defaults,#i))) <= 18446744073709551615)))) };
    quant condition entry #input_array_frame(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #input_array: predicate<activation, object>,
        #trace: trace
    ) =
        forall (#input: object) { (#input_array(#call,#input) => forall (#target: object) { (#affected(#trace,#call,#target) => #disjoint(#env,#input,#target)) }) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #typed_logging(
        #call: activation,
        #env: environment,
        #format_types: predicate<environment, activation>,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        ((forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call)) && #format_types(#env,#call));
    ensures normal result_is_zero_or_minus_one;
    ensures normal minus_one_may_retain_lookup_or_storage_preparation_changes;
    ensures normal zero_result_sets_all_count_plus_one_buckets_sum_count_and_timestamp;
    ensures normal bucket_counts_follow_u64_to_double_to_u64_conversion_not_exact_copy;
    ensures normal new_hist_bucket_storage_is_metric_owned_and_inputs_are_not_retained;
    ensures normal no_whole_histogram_atomic_snapshot_is_promised;
};

extern fn cmt_summary_set_default(summary: ptr<mut, u8>, timestamp: u64,
                                  quantile_values: ptr<mut, f64>, sum: f64, count: u64,
                                  labels_count: i32, label_vars: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #summary_parent(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #quantile_sizes(
        #allocation_bytes: integer,
        #int_max: integer,
        #quantiles_count: integer,
        #size_max: integer,
        #sizeof: function<scalar_type, integer>,
        #u64: scalar_type,
        #u64_size: integer
    ) =
        (((((0 <= #quantiles_count) && (#quantiles_count <= #int_max)) && (#u64_size == #sizeof(#u64))) && (#allocation_bytes == (#quantiles_count * #u64_size))) && (#allocation_bytes <= #size_max));
    quant condition entry #quantile_values(
        #call: activation,
        #double_type: scalar_type,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #null: object,
        #quantile_values: object,
        #quantiles_count: integer,
        #readable: predicate<environment, object, scalar_type>,
        #stable: predicate<trace, activation, object>,
        #trace: trace
    ) =
        (!((#quantile_values == #null)) => ((#extent(#env,#quantile_values,#quantiles_count,#double_type) && #readable(#env,#quantile_values,#double_type)) && #stable(#trace,#call,#quantile_values)));
    quant condition entry #quantile_ownership(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #field: predicate<environment, object, field, object>,
        #integer_field: predicate<environment, object, field, integer>,
        #live: predicate<environment, object>,
        #metric: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #quantiles: object,
        #quantiles_count: integer,
        #quantiles_count_field: field,
        #quantiles_field: field,
        #stored_count: integer,
        #u64: scalar_type
    ) =
        ((#field(#env,#metric,#quantiles_field,#quantiles) && #integer_field(#env,#metric,#quantiles_count_field,#stored_count)) && ((#quantiles == #null) || (((#live(#env,#quantiles) && #owns(#env,#metric,#quantiles)) && #extent(#env,#quantiles,#stored_count,#u64)) && (#quantiles_count <= #stored_count))));
    quant condition entry #input_array_frame(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #input_array: predicate<activation, object>,
        #trace: trace
    ) =
        forall (#input: object) { (#input_array(#call,#input) => forall (#target: object) { (#affected(#trace,#call,#target) => #disjoint(#env,#input,#target)) }) };
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #failure_logging(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call));
    ensures normal result_is_zero_or_minus_one;
    ensures normal minus_one_may_retain_lookup_or_storage_preparation_changes;
    ensures normal zero_result_sets_sum_count_and_timestamp;
    ensures normal present_input_sets_quantiles_flag_and_each_admitted_quantile_slot;
    ensures normal null_input_preserves_quantile_values_and_set_flag_but_may_prepare_storage;
    ensures normal new_quantile_storage_is_metric_owned_and_input_is_not_retained;
    ensures normal no_whole_summary_atomic_snapshot_is_promised;
};

// LP64 projection: size_t is u64. This module grants no ABI or call permission.
extern fn cmt_exp_histogram_set_default(exp_histogram: ptr<mut, u8>, timestamp: u64,
    scale: i32, zero_count: u64, zero_threshold: f64,
    positive_offset: i32, positive_bucket_count: u64, positive_bucket_counts: ptr<mut, u64>,
    negative_offset: i32, negative_bucket_count: u64, negative_bucket_counts: ptr<mut, u64>,
    sum_set: i32, sum: f64, count: u64,
    labels_count: i32, label_vals: ptr<mut, ptr<mut, u8>>) -> i32
contract {
    quant condition entry #size_abi(
        #call_abi: function<scalar_type, abi_class>,
        #maximum: function<scalar_type, integer>,
        #minimum: function<scalar_type, integer>,
        #signedness: function<scalar_type, integer>,
        #size_t_type: scalar_type,
        #u64: scalar_type,
        #width: function<scalar_type, integer>
    ) =
        ((((#width(#size_t_type) == #width(#u64)) && (#signedness(#size_t_type) == #signedness(#u64))) && (#minimum(#size_t_type) == #minimum(#u64))) && ((#maximum(#size_t_type) == #maximum(#u64)) && (#call_abi(#size_t_type) == #call_abi(#u64))));
    quant condition entry #exp_histogram_parent(
        #env: environment,
        #exp_histogram: object,
        #exp_histogram_tag: tag,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #tag: predicate<environment, object, tag>
    ) =
        (((((((!((#exp_histogram == #null)) && #live(#env,#exp_histogram)) && #field(#env,#exp_histogram,#opts_field,#opts)) && #field(#env,#exp_histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#exp_histogram)) && #tag(#env,#map,#exp_histogram_tag)) && #live(#env,#opts)) && #live(#env,#map));
    quant condition entry #lookup_map_ownership(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #map: object,
        #null: object,
        #owns: predicate<environment, object, object>,
        #primary: predicate<environment, object, object>,
        #static_field: field,
        #static_metric: object
    ) =
        ((!((#map == #null)) && #live(#env,#map)) && (#field(#env,#map,#static_field,#static_metric) && forall (#child: object) { (#primary(#env,#map,#child) => ((!((#child == #static_metric)) && #live(#env,#child)) && #owns(#env,#map,#child))) }));
    quant condition entry #lookup_index_links(
        #cache_field: field,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #primary: predicate<environment, object, object>,
        #secondary: predicate<environment, object, object>
    ) =
        ((forall (#child: object) { (#secondary(#env,#map,#child) => #primary(#env,#map,#child)) } && forall (#child: object) { (#primary(#env,#map,#child) => #field(#env,#child,#map_field,#map)) }) && forall (#cached: object) { (#field(#env,#map,#cache_field,#cached) => ((#cached == #null) || #primary(#env,#map,#cached))) });
    quant condition entry #lookup_label_extent(
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #labels_count: integer,
        #labels_val: object,
        #ptr_type: scalar_type,
        #readable: predicate<environment, object, scalar_type>
    ) =
        ((0 <= #labels_count) && ((0 < #labels_count) => (#extent(#env,#labels_val,#labels_count,#ptr_type) && #readable(#env,#labels_val,#ptr_type))));
    quant condition entry #lookup_lookup_strings(
        #call: activation,
        #element: predicate<environment, object, integer, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #fqname_field: field,
        #fqname_read: predicate<environment, activation>,
        #labels_count: integer,
        #labels_val: object,
        #live: predicate<environment, object>,
        #null: object,
        #opts: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        (forall (#i: integer) { (((0 <= #i) && (#i < #labels_count)) => forall (#label: object) { ((#element(#env,#labels_val,#i,#label) && !((#label == #null))) => ((#live(#env,#label) && #terminated(#env,#label)) && #stable(#trace,#call,#label))) }) } && forall (#fqname: object) { ((#field(#env,#opts,#fqname_field,#fqname) && #fqname_read(#env,#call)) => (!((#fqname == #null)) && ((#live(#env,#fqname) && #terminated(#env,#fqname)) && #stable(#trace,#call,#fqname)))) });
    quant condition entry #lookup_parent_layout(
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #histogram: object,
        #histogram_tag: tag,
        #live: predicate<environment, object>,
        #map: object,
        #map_field: field,
        #null: object,
        #opts: object,
        #opts_field: field,
        #parent_field: field,
        #summary: object,
        #summary_tag: tag,
        #tag: predicate<environment, object, tag>
    ) =
        ((#tag(#env,#map,#histogram_tag) => (((((((!((#histogram == #null)) && #live(#env,#histogram)) && #field(#env,#histogram,#opts_field,#opts)) && #field(#env,#histogram,#map_field,#map)) && #field(#env,#map,#parent_field,#histogram)) && #tag(#env,#map,#histogram_tag)) && #live(#env,#opts)) && #live(#env,#map))) && (#tag(#env,#map,#summary_tag) => (((((((!((#summary == #null)) && #live(#env,#summary)) && #field(#env,#summary,#opts_field,#opts)) && #field(#env,#summary,#map_field,#map)) && #field(#env,#map,#parent_field,#summary)) && #tag(#env,#map,#summary_tag)) && #live(#env,#opts)) && #live(#env,#map))));
    quant condition entry #lookup_storage_bounds(
        #allocation_size: predicate<environment, activation, integer>,
        #call: activation,
        #env: environment,
        #int_argument: predicate<environment, activation, integer>,
        #int_max: integer,
        #size_max: integer
    ) =
        (forall (#amount: integer) { (#allocation_size(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #size_max))) } && forall (#amount: integer) { (#int_argument(#env,#call,#amount) => ((0 <= #amount) && (#amount <= #int_max))) });
    quant condition entry #lookup_hash_nonzero(
        #digest: integer,
        #labels_count: integer
    ) =
        ((0 < #labels_count) => !((#digest == 0)));
    quant condition entry #lookup_static_labels(
        #env: environment,
        #map: object,
        #static_label_node: predicate<environment, object, object>
    ) =
        forall (#child: object) { !(#static_label_node(#env,#map,#child)) };
    quant condition entry #lookup_borrow_lifetime(
        #borrow_use: predicate<trace, object, event>,
        #live_at: predicate<trace, event, object>,
        #map: object,
        #retired_before: predicate<trace, object, event>,
        #trace: trace
    ) =
        forall (#event: event) { (#borrow_use(#trace,#map,#event) => (#live_at(#trace,#event,#map) && !(#retired_before(#trace,#map,#event)))) };
    quant condition entry #input_extents(
        #call: activation,
        #env: environment,
        #extent: predicate<environment, object, integer, scalar_type>,
        #negative_array: object,
        #negative_count: integer,
        #null: object,
        #positive_array: object,
        #positive_count: integer,
        #readable: predicate<environment, object, scalar_type>,
        #stable: predicate<trace, activation, object>,
        #trace: trace,
        #u64: scalar_type
    ) =
        ((!((#positive_array == #null)) => ((#extent(#env,#positive_array,#positive_count,#u64) && #readable(#env,#positive_array,#u64)) && #stable(#trace,#call,#positive_array))) && (!((#negative_array == #null)) => ((#extent(#env,#negative_array,#negative_count,#u64) && #readable(#env,#negative_array,#u64)) && #stable(#trace,#call,#negative_array))));
    quant condition entry #copy_sizes(
        #negative_bytes: integer,
        #negative_count: integer,
        #positive_bytes: integer,
        #positive_count: integer,
        #size_max: integer,
        #sizeof: function<scalar_type, integer>,
        #u64: scalar_type,
        #u64_size: integer
    ) =
        (((((#u64_size == #sizeof(#u64)) && (#positive_bytes == (#positive_count * #u64_size))) && (#negative_bytes == (#negative_count * #u64_size))) && (#positive_bytes <= #size_max)) && (#negative_bytes <= #size_max));
    quant condition entry #old_arrays(
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #field: predicate<environment, object, field, object>,
        #live: predicate<environment, object>,
        #metric: object,
        #negative_field: field,
        #null: object,
        #old_negative: object,
        #old_positive: object,
        #owns: predicate<environment, object, object>,
        #positive_field: field
    ) =
        ((((#field(#env,#metric,#positive_field,#old_positive) && #field(#env,#metric,#negative_field,#old_negative)) && (!((#old_positive == #null)) => (#live(#env,#old_positive) && #owns(#env,#metric,#old_positive)))) && (!((#old_negative == #null)) => (#live(#env,#old_negative) && #owns(#env,#metric,#old_negative)))) && ((!((#old_positive == #null)) && !((#old_negative == #null))) => #disjoint(#env,#old_positive,#old_negative)));
    quant condition entry #input_array_frame(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #disjoint: predicate<environment, object, object>,
        #env: environment,
        #input_array: predicate<activation, object>,
        #trace: trace
    ) =
        forall (#input: object) { (#input_array(#call,#input) => forall (#target: object) { (#affected(#trace,#call,#target) => #disjoint(#env,#input,#target)) }) };
    quant condition entry #borrower_exclusion(
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #later_use: predicate<trace, activation, event, object>,
        #old_negative: object,
        #old_positive: object,
        #trace: trace
    ) =
        ((forall (#event: event) { !(#later_use(#trace,#call,#event,#old_positive)) } && forall (#event: event) { !(#later_use(#trace,#call,#event,#old_negative)) }) && forall (#event: event) { (!(#conflicts(#trace,#call,#event,#old_positive)) && !(#conflicts(#trace,#call,#event,#old_negative))) });
    quant condition entry #caller_exclusion(
        #affected: predicate<trace, activation, object>,
        #call: activation,
        #conflicts: predicate<trace, activation, event, object>,
        #trace: trace
    ) =
        forall (#target: object) { (#affected(#trace,#call,#target) => forall (#event: event) { !(#conflicts(#trace,#call,#event,#target)) }) };
    quant condition entry #exp_histogram_backend(
        #call: activation,
        #env: environment,
        #live: predicate<environment, object>,
        #lock_abi: predicate<environment, object>,
        #logging_backend: predicate<environment, activation>,
        #logging_string: predicate<environment, activation, object>,
        #metric: object,
        #stable: predicate<trace, activation, object>,
        #terminated: predicate<environment, object>,
        #trace: trace
    ) =
        ((forall (#input: object) { (#logging_string(#env,#call,#input) => ((#live(#env,#input) && #terminated(#env,#input)) && #stable(#trace,#call,#input))) } && #logging_backend(#env,#call)) && #lock_abi(#env,#metric));
    ensures normal result_is_zero_or_minus_one;
    ensures normal positive_count_with_null_input_returns_minus_one_after_possible_lookup_changes;
    ensures normal preparation_failure_preserves_old_arrays_and_frees_temporary_copies;
    ensures normal minus_one_does_not_imply_lookup_rollback;
    ensures normal zero_result_installs_fresh_owned_copies_or_null_for_zero_counts;
    ensures normal zero_result_sets_scale_zero_fields_offsets_counts_sum_flag_sum_and_timestamp;
    ensures normal old_arrays_are_freed_after_swap_and_unlock_and_old_aliases_are_invalidated;
    ensures normal input_array_ownership_is_preserved_and_input_pointers_are_not_retained;
    ensures normal map_metric_and_enclosing_histogram_ownership_are_preserved;
    ensures normal internal_array_lock_does_not_supply_retirement_or_raw_alias_lifetime;
};
