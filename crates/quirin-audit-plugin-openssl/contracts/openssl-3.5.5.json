    },
    "static-object-return": {
      "checked": true,
      "meaning": "No parameter; the body is exactly `return &V;` for the named file-scope static const object V of the defining file: the result is library-owned static storage the caller must not release."
    },
    "pure-reader": {
      "checked": true,
      "meaning": "The body is loop-free and call-free and contains no assignment, increment or static local: it reads its arguments' reachable memory and constants and writes, allocates and releases nothing; a returned pointer is borrowed."
    },
    "member-store": {
      "checked": true,
      "meaning": "The body is exactly the listed stores `param->member op= expression`, each expression call-free and assignment-free over the parameters; the listed pointer parameters escape into the base object; nothing is allocated or released."
    },
    "refcounted-release": {
      "checked": false,
      "meaning": "Drops one reference to the object and frees it, with everything it owns, when the count reaches zero; NULL is accepted."
    },
    "release": {
      "checked": false,
      "meaning": "Releases the object and everything it owns; NULL is accepted."
    },
    "constructor": {
      "checked": false,
      "meaning": "Returns a new object the caller owns (one reference), or NULL on failure."
    },
    "container": {
      "checked": false,
      "meaning": "Stores or reads an element pointer of the stack without taking ownership of it."
    },
    "ownership-transfer": {
      "checked": false,
      "meaning": "Takes a reference to, or a copy of, the caller's object into the context; the caller keeps its own reference."
    },
    "configuration": {
