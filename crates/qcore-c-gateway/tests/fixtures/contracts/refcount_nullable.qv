module contract;

// Card REFERENCE-DROP-NULL-ACCEPTING: a NULL-accepting drop beside the
// `rc_*` surface of refcount.qv (OpenSSL's `X509_free` shape: a NULL
// argument does nothing).

extern fn rc_drop_null(p: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(p);
    ensures normal resource_reference_dropped(p, nullable);
    ensures normal resource_return_none();
};
