module contract;

// Card CG21-CALL-EXITS-AND-BOUNDARIES: no-return declarations for the route-G
// controls of gateway rule 11o. Synthetic trusted test assumptions, not facts
// about any library: each states a terminating exit. The C prelude of
// `tests/cg21_call_exits.rs` declares `cg_die` and `cg_die_with` `noreturn`
// and `cg_die_plain` without the attribute.

extern fn cg_die() -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};

extern fn cg_die_with(p: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(p);
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};

extern fn cg_die_plain() -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};
