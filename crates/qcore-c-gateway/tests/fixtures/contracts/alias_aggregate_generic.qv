module contract;

// ALIAS-AGGREGATE — held-out generic opaque-member custody API.
//
// Deliberately unrelated to ChunkIO, to Fluent Bit and to the `g_*` (O04),
// `h_*` (O04-ARMS), `k_*` (O04-B08), `r_*` (O04-READ-BOUND) and `m_*`
// (O04-B09B10) families: every rule under test is stated over declared C types
// and contract modes, so no name here can matter. These are synthetic trusted
// test assumptions, not facts about any library.

// The aggregate's own constructor and destructor. `v_drop` releases exactly the
// aggregate it is given: it declares no `Removed` parameter, so under premise
// P-B08-SHALLOW it does not discharge anything the aggregate's members link.
extern fn v_make(n: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(n);
    ensures normal resource_return_owned(nullable);
};

extern fn v_drop(b: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(b, nonnull);
    ensures normal resource_return_none();
};

// The child resource stored into an opaque member.
extern fn v_take(n: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(n);
    ensures normal resource_return_owned(nullable);
};

extern fn v_release(i: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(i, nonnull);
    ensures normal resource_return_none();
};

extern fn v_probe(i: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(i);
    ensures normal resource_return_none();
};
