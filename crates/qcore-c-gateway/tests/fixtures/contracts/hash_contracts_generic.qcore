module contract;

// HASH-CONTRACTS — held-out generic API for declared literal-argument premises.
//
// Deliberately unrelated to Fluent Bit, to ChunkIO and to the `g_*` (O04),
// `h_*` (O04-ARMS), `k_*` (O04-B08), `r_*` (O04-READ-BOUND) and `m_*`
// (O04-B09B10) families: the rule under test is stated over declared contract
// modes and a declared premise, so no name here can matter. These are synthetic
// trusted test assumptions, not facts about any library.
//
// `p_publish` is the shape the card exists for: a real callee whose behaviour
// switches on a scalar argument. Its declaration below was read off the
// size-zero arm alone — the value is stored by pointer, nothing is copied and
// nothing is freed — so its §C04.5 literal-argument premise restricts the
// declaration to call sites that pass exactly the literal `0`.

// The table the value is published into.
extern fn p_open(n: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(n);
    ensures normal resource_return_owned(nullable);
};

// Closing the table says nothing about published values: this projection has no
// claim that a table releases what was published into it, and this declaration
// deliberately makes none.
extern fn p_close(t: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(t, nonnull);
    ensures normal resource_return_none();
};

// The value.
extern fn p_new(n: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(n);
    ensures normal resource_return_owned(nullable);
};

extern fn p_release(v: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(v, nonnull);
    ensures normal resource_return_none();
};

// The value-dependent publication. Borrowed at every position: the size-zero
// arm imposes no custody precondition and moves no obligation, so the caller
// keeps the value and must still release it.
extern fn p_publish(t: ptr<mut, u8>, v: ptr<mut, u8>, size: isize) -> i32
contract {
    requires resource_contract_v1;
    requires resource_literal_argument(size, 0);
    ensures normal resource_borrowed(t);
    ensures normal resource_borrowed(v);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_none();
};
