module contract;

// NEIGHBOURS — the held-out generic `n_*` family, deliberately unrelated to
// Fluent Bit, to ChunkIO and to the `g_*` (O04), `h_*` (O04-ARMS), `k_*`
// (O04-B08), `r_*` (O04-READ-BOUND), `m_*` (O04-B09B10), `v_*` (O04-TRACE),
// `p_*` (HASH-CONTRACTS) and `w_*` (PROD-CONTRACTS) families.
//
// Its shapes mirror the six production ones this card lands: a residency
// predicate and two residency transitions that return a status and take no
// custody, a name generator that writes through a caller buffer, a header
// writer that allocates and frees its own scratch, and a parameterless clock
// reading whose result is floating-point.
//
// Nothing here is a production declaration and nothing here is derived from any
// C body: these are synthetic premises about a synthetic API, written so the
// admission and its refusals can be exercised without the real corpus.

// --- the caller's own obligation -------------------------------------------
extern fn n_open(size: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn n_close(handle: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(handle, nonnull);
    ensures normal resource_return_none();
};

// --- the residency family: status out, no custody moved --------------------
extern fn n_is_up(handle: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(handle);
    ensures normal resource_return_none();
};

extern fn n_up(handle: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(handle);
    ensures normal resource_return_none();
};

extern fn n_down(handle: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(handle);
    ensures normal resource_return_none();
};

// --- the buffer writer: written through, never owned -----------------------
extern fn n_name(instance: ptr<mut, u8>, out_buf: ptr<mut, u8>, buf_size: i32) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(instance);
    ensures normal resource_borrowed(out_buf);
    ensures normal resource_borrowed(buf_size);
    ensures normal resource_return_none();
};

// --- the header writer: private scratch, borrowed tag ----------------------
extern fn n_header(handle: ptr<mut, u8>, kind: i32, tag: ptr<mut, u8>, tag_len: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(handle);
    ensures normal resource_borrowed(kind);
    ensures normal resource_borrowed(tag);
    ensures normal resource_borrowed(tag_len);
    ensures normal resource_return_none();
};

// --- the clock: no parameter at all, floating-point result -----------------
extern fn n_clock() -> f64
contract {
    requires resource_contract_v1;
    ensures normal resource_return_none();
};
