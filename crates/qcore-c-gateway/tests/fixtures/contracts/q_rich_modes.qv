module contract;

// Borrowed/owned/consumed/out parameter modes for the analyzer unit tests.

extern fn q_observe(p: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(p);
    ensures normal resource_return_none();
};

extern fn q_mutate(p: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(p, nonnull);
    ensures normal resource_return_none();
};

extern fn q_consume(p: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_consumed(p, nonnull);
    ensures normal resource_return_none();
};

extern fn q_make(destination: ptr<mut, ptr<mut, u8>>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_out(destination, nonnull);
    ensures normal resource_return_none();
};
