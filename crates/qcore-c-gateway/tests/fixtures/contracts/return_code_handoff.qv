module contract;

// Card SUPPLIED-OWNED-RETURN-CODE-HANDOFF: synthetic serve loops and
// callbacks for the caller branch check (rule 12m). Trusted test
// assumptions: a `Safe` here is `Safe` over them and promotes nothing.

alias #PASS = @H_PASS;

// Serve loops: each dequeues an op it owns and hands it to `cb`.
extern fn h_serve(q: ptr<mut, u8>, cb: fnptr, opaque: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_callback_invoked(cb, _, supplied_owned, opaque);
    ensures normal resource_return_none();
};

extern fn h_keep_serve(q: ptr<mut, u8>, cb: fnptr, opaque: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_callback_invoked(cb, _, supplied_owned, opaque);
    ensures normal resource_return_none();
};

extern fn h_pop_serve(q: ptr<mut, u8>, cb: fnptr, opaque: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_callback_invoked(cb, _, supplied_owned, opaque);
    ensures normal resource_return_none();
};

// A serve loop that stores the callback's result through a narrowing
// conversion before comparing with PASS.
extern fn h_converted_serve(q: ptr<mut, u8>, cb: fnptr, opaque: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_callback_invoked(cb, _, supplied_owned, opaque);
    ensures normal resource_return_none();
};

// A serve loop whose op stays its own at `_` (an op callback's position).
extern fn h_op_serve(q: ptr<mut, u8>, cb: fnptr, opaque: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_borrowed(cb);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_callback_invoked(cb, _, _, opaque);
    ensures normal resource_return_none();
};

// Candidates: the op is the callback's exactly where the guard holds.
extern fn not_pass_cb(q: ptr<mut, u8>, op: ptr<mut, u8>, opaque: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_owned(op, nonnull);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_return_none();
    quant live #op: #owner |-> #callback when #result != #PASS;
};

extern fn not_pass_named_cb(q: ptr<mut, u8>, op: ptr<mut, u8>, opaque: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_owned(op, nonnull);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_return_none();
    quant live #op: #owner |-> #callback when #result != @H_PASS;
};

extern fn keep_cb(q: ptr<mut, u8>, op: ptr<mut, u8>, opaque: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_owned(op, nonnull);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_return_none();
    quant live #op: #owner |-> #callback when #result == @H_KEEP;
};

// A typo: no enumerator `H_PAS`.
extern fn typo_cb(q: ptr<mut, u8>, op: ptr<mut, u8>, opaque: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_owned(op, nonnull);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_return_none();
    quant live #op: #owner |-> #callback when #result != @H_PAS;
};

// A constant of another enumeration than the result's.
extern fn other_type_cb(q: ptr<mut, u8>, op: ptr<mut, u8>, opaque: ptr<mut, u8>) -> u32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(q);
    ensures normal resource_owned(op, nonnull);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_return_none();
    quant live #op: #owner |-> #callback when #result != @OTHER_A;
};
