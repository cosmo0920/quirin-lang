module contract;

// Card CG10-INDIRECT-ACCESS-SOLE-RESIDUALS round 2 (rules 14a-14c): test
// assumptions, not a model of any real library. `rr_load` reads the scalar its
// formal points at and returns a scalar; `rr_release_count` releases its
// formal and returns a scalar.

extern fn rr_load(p: ptr<mut, u8>) -> i64
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(p);
    ensures normal resource_return_none();
};

extern fn rr_release_count(p: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_released(p, nonnull);
    ensures normal resource_return_none();
};
