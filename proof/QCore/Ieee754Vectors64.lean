    sameValue binary64 (arithBits binary64 .add a b) ra &&
    sameValue binary64 (arithBits binary64 .sub a b) rs &&
    sameValue binary64 (arithBits binary64 .mul a b) rm &&
    sameValue binary64 (arithBits binary64 .div a b) rd) = true := by
  decide +kernel

