// Upstream: lib/chunkio/src/cio_chunk.c, cio_chunk_is_locked.
// Bounded chunk-source profile: old_* names are entry ghost values and the
// unprefixed fields are exit ghost values. Reading lock preserves both fields.

extern fn cio_chunk_is_locked(
    chunk: borrow<'call, const, Chunk> use one
) -> i32
contract {
    requires chunk_is_live;
    requires exclusive_chunk_access;
    requires busy_is_boolean;
    requires lock_is_boolean;
    ensures normal result == old_lock;
    ensures normal lock == old_lock;
    ensures normal busy == old_busy;
};

fn main() -> i32 {
    return 0;
}
