module contract;

// Seven existing-file profiles only. Native error output, rejected headers and
// descriptor residuals are preserved by the trusted strict trace adapter.
extern fn native_file_existing_observation() -> unit
contract {
    requires compiled_source_and_build_recorded;
    requires exclusive_instrumented_fixture;
    ensures normal exact_constructor_and_rollback;
    ensures normal exact_parent_teardown;
    ensures normal os_identities_bound;
    ensures normal allocations == releases;
    ensures normal releases == transient_releases + rollback_releases + teardown_releases;
    ensures normal transient_releases == 1;
    ensures normal descriptor_residual_after_return == descriptor_residual_after_parents;
    ensures normal not descriptor_residual_after_parents or chunk_null;
    ensures normal not descriptor_residual_after_parents or acl_failed;
    ensures normal harness_descriptor_reclaimed == descriptor_residual_after_parents;
    ensures normal not corruption_result or chunk_null;
    ensures normal original_inode_and_bytes_retained;
    ensures normal fixture_cleanup_complete;
    ensures normal static_certificate == 0;
    ensures normal durability_proved == 0;
};
