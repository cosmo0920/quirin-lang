  "candidates": [
    {
      "id": "C1",
      "status": "source-supported failure-path defect candidate; no runtime fault-injection validation",
      "source": [
        "src/flb_scheduler.c:275-285",
        "src/flb_scheduler.c:868-891",
        "src/flb_scheduler.c:904-912",
        "src/flb_scheduler.c:965-970"
      ],
      "claim": "If request allocation fails after timer allocation in flb_sched_request_create, return -1 leaves timer linked to sched->timers until scheduler teardown; retry_now performs the missing timer destroy on the analogous branch.",
      "contrary_guard": "sched_destroy eventually releases linked timers; this is transient retention across a recoverable allocation failure, not an unbounded leak demonstrated in this card.",
      "reproduce": "Inject failure into request flb_malloc after successful flb_sched_timer_create, assert sched->timers returns to baseline before teardown, then compare retry_now branch."
    },
    {
      "id": "C2",
      "status": "source-supported ownership defect candidate; no runtime fault-injection validation",
      "source": [
        "src/flb_output.c:288-295",
        "src/flb_output.c:360-374",
        "include/fluent-bit/flb_task.h:171-193"
      ],
      "claim": "singleplex_enqueue increments task->users before queue allocation; allocation failure destroys retry if present but returns without decrementing the temporary user, leaving task artificially live.",
      "contrary_guard": "normal queue flush decrements the temporary user at flb_output.c:325-329; that path is not reached when enqueue allocation fails. Shutdown destroys input tasks regardless of users.",
      "reproduce": "In a synchronous output test, fail queued_task allocation, inspect users before/after and task map occupancy after the caller handles -1; run both first-dispatch and retry cases."
    },
    {
      "id": "C3",
      "status": "source-supported orphan candidate; requires fault injection and queue-state validation",
      "source": [
        "src/flb_output.c:325-341",
        "src/flb_output.c:415-463",
        "include/fluent-bit/flb_task.h:171-193",
        "src/flb_engine_dispatch.c:157-167"
      ],
      "claim": "When queued retry is popped, temporary user is decremented without release; if output task flush fails and retry is destroyed, a zero-user, zero-retry task can remain until shutdown.",
      "contrary_guard": "another active output user or retry retains task; the first-dispatch path may be reaped by other engine cleanup only when routes are empty, so isolate one route and inspect.",
      "reproduce": "Queue a retry behind an in-progress synchronous flush, then fail flush creation or self-pipe write at flush_one; assert task map and input tasks empty after in-progress completion."
    },
    {
      "id": "C4",
      "status": "unvalidated identity hazard hypothesis",
      "source": [
        "include/fluent-bit/flb_task.h:47-52",
        "src/flb_engine.c:579-608",
        "src/flb_task.c:42-77",
        "src/flb_task.c:899-909"
      ],
      "claim": "Encoded completion carries task id/out id without a task generation and the handler dereferences the current map entry; a delayed or duplicate completion after id reuse could target a new task.",
      "contrary_guard": "normal completion holds an active user until processed and shutdown/event-loop ordering may exclude delayed events; no reachable stale event demonstrated.",
      "reproduce": "Instrument completion enqueue/dequeue and task map recycling; prove an accepted stale event through a real output route before alleging a defect."
    }
  ],
