// Upstream defines this fourth setter with no prototype in ctr_span.h, and it
// writes the SAME field as ctr_span_set_dropped_links_count. The declared field
// is what the checker must reproduce from source; the name is not evidence.
extern fn ctr_span_set_dropped_link_count(
    span: borrow<'call, mut, CtraceSpan> use one
) -> unit
contract {
    requires object_is_live;
    requires exclusive_object_access;
