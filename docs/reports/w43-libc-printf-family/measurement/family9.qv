module contract;

// MEASUREMENT ONLY, never shipped. Card W43-LIBC-PRINTF-FAMILY's declared-ABI
// census input: every printf-family member the brief names, spelled with the
// v1 ABI projection of the glibc prototype the pinned units declare, so the
// census can say, per unit, whether the reader agrees. The four fixed-arity
// variadic members are spelled exactly as shipped in
// `providers/quirin-provider-libc/contracts/libc/stdio.qcore`. The four
// `va_list` members spell the `__gnuc_va_list` parameter as the x86-64 decayed
// `__va_list_tag *` object pointer, `ptr<mut, u8>`: that is a placeholder whose
// only job is to learn whether the reader can read `__gnuc_va_list` at all.
// The modes are placeholders too: the census compares types only.

extern fn printf(format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(format);
  ensures normal resource_variadic_data_tail(); ensures normal resource_return_none(); };

extern fn fprintf(stream: ptr<mut, u8>, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(stream);
  ensures normal resource_borrowed(format); ensures normal resource_variadic_data_tail();
  ensures normal resource_return_none(); };

extern fn snprintf(s: ptr<mut, u8>, maxlen: usize, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(maxlen); ensures normal resource_borrowed(format);
  ensures normal resource_variadic_data_tail(); ensures normal resource_return_none(); };

extern fn sprintf(s: ptr<mut, u8>, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(format); ensures normal resource_variadic_data_tail();
  ensures normal resource_return_none(); };

extern fn dprintf(fd: i32, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(fd);
  ensures normal resource_borrowed(format); ensures normal resource_variadic_data_tail();
  ensures normal resource_return_none(); };

extern fn vprintf(format: ptr<const, u8>, arg: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(format);
  ensures normal resource_borrowed(arg); ensures normal resource_return_none(); };

extern fn vfprintf(stream: ptr<mut, u8>, format: ptr<const, u8>, arg: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(stream);
  ensures normal resource_borrowed(format); ensures normal resource_borrowed(arg);
  ensures normal resource_return_none(); };

extern fn vsprintf(s: ptr<mut, u8>, format: ptr<const, u8>, arg: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(format); ensures normal resource_borrowed(arg);
  ensures normal resource_return_none(); };

extern fn vsnprintf(s: ptr<mut, u8>, maxlen: usize, format: ptr<const, u8>, arg: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(maxlen); ensures normal resource_borrowed(format);
  ensures normal resource_borrowed(arg); ensures normal resource_return_none(); };
