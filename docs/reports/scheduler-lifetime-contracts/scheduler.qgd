guarded_decomposition_v1;
(environment ∧ worker_tls ∧ valid_membership ∧ suspended_coroutines ∧ exact_parent_embedding ∧ borrowed_chain_live ∧ tls_params_owned ∧ callback_footprint ∧ no_concurrent_writer ∧ no_later_alias_use ∧ tls_api_success) |-> cleanup;
invalid_membership !-> cleanup;
retiring_current_tls !-> cleanup;
cleanup ||-> empty_list / nonempty_list;
empty_list ->| original_state_unchanged;
nonempty_list ->| selected_list_empty_and_borrows_live;
(environment ∧ valid_membership ∧ parent_live ∧ callee_live ∧ borrowed_chain_live ∧ callback_footprint ∧ tls_api_success) |-> destroy;
invalid_membership !-> destroy;
destroy ||-> tls_absent_callback_absent / tls_present_callback_absent / tls_absent_callback_present / tls_present_callback_present;
tls_absent_callback_absent ->| parent_callee_retired_borrows_live;
tls_present_callback_absent ->| parent_callee_params_retired_borrows_live;
tls_absent_callback_present ->| callback_checked_parent_callee_retired;
tls_present_callback_present ->| callback_checked_parent_callee_params_retired;
(environment ∧ request_live ∧ allocation_extent ∧ callback_dispatch_closure ∧ tls_api_success) |-> create;
create ||-> missing_scheduler / allocation_failed / data_null / coroutine_creation_failed / created;
missing_scheduler ->| creation_unchanged;
allocation_failed ->| creation_no_new_owner;
data_null ->| allocated_parent_unresolved;
coroutine_creation_failed ->| linked_owner_with_unresolved_switch;
created ->| linked_parent_and_borrowed_request;
(environment ∧ valid_membership ∧ borrowed_chain_live ∧ tls_api_success) |-> purge;
invalid_membership !-> purge;
purge ||-> missing_purge_scheduler / moved_to_purge;
missing_purge_scheduler ->| original_lists_unchanged;
moved_to_purge ->| active_unlinked_purge_member;
