    "source_rules": "module contract;\n\n// Executable acceptance policies over facts extracted from typed C source.\n// Rust owns AST decoding, expression evaluation, storage and control semantics.\n// These rules do not assert C memory safety, termination or custody discharge.\n\nextern fn source_enum_value() -> unit\ncontract {\n    ensures normal evaluated_constant;\n    ensures normal type_matches;\n};\n\nextern fn source_scan_effects() -> unit\ncontract {\n    ensures normal not header_calls;\n    ensures normal not match_calls;\n    ensures normal not return_calls;\n};\n\nextern fn source_scan_initial() -> unit\ncontract {\n    ensures normal remaining_paths == 0;\n    ensures normal not index_escaped;\n};\n\nextern fn source_type_match() -> unit\ncontract {\n    ensures normal type_matches;\n};\n\nextern fn source_symbol() -> unit\ncontract {\n    ensures normal producer_type_matches;\n};\n\nextern fn source_loop_index() -> unit\ncontract {\n    ensures normal scope_matches;\n};\n\nextern fn source_scan_region() -> unit\ncontract {\n    ensures normal read_only;\n};\n\nextern fn frame_write() -> unit\ncontract {\n    ensures normal not lifecycle_field;\n    ensures normal ordinary_int_field;\n};\n\nextern fn frame_declaration() -> unit\ncontract {\n    ensures normal declaration_count > 0;\n    ensures normal all_external_prototypes;\n};\n\nextern fn frame_dependency() -> unit\ncontract {\n    ensures normal layout_matches;\n    ensures normal not duplicate;\n};\n",
