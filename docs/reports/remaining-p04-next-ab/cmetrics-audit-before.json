          "contract": "module contract;\n\n// Pinned cmt_counter_allow_reset sets allow_reset and returns no scalar value.\n// The v3 importer binds field/old_field to the declared allow_reset model;\n// no general counter, caller, allocation or synchronization guarantee follows.\nextern fn cmt_counter_allow_reset(\n    counter: borrow<'call, mut, cmt_counter> use one\n) -> unit\ncontract {\n    requires object_is_live;\n    requires exclusive_object_access;\n    requires field_is_boolean;\n    ensures normal field == 1;\n};\n",
