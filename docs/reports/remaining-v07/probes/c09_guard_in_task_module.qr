concurrency checked;
fn worker(x: i32) -> i32 { return x; }
fn main() -> i32 effects { throws<SpawnError>, spawn, join, may_block } {
    let v = 42;
    with lock v as g {
        thread scope s {
            let a = spawn s worker(copy v)?;
            let r = join move a?;
            return r;
        }
    }
}
