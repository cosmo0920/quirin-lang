concurrency checked;
fn worker(x: i32) -> i32 contract { quant normal wall_clock <= 5; } { return x; }
fn main() -> i32 effects { throws<SpawnError>, spawn, join, may_block } {
    let v = 42;
    thread scope s {
        let a = spawn s worker(copy v)?;
        let r = join move a?;
        return r;
    }
}
