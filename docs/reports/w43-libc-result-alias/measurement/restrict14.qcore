module contract;

// MEASUREMENT ONLY, never shipped. The fourteen prototypes card
// W43-LIBC-CONTRACTS withdrew for a qualifier after the `*`, spelled with the
// ABI projections its report records, so the declared-ABI census can measure
// what the pointer-qualifier reader alone does to their availability. The
// modes are placeholders (every parameter borrowed, no custody result): the
// census compares types only.

extern fn printf(format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(format);
  ensures normal resource_variadic_data_tail(); ensures normal resource_return_none(); };

extern fn fprintf(stream: ptr<mut, u8>, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(stream);
  ensures normal resource_borrowed(format); ensures normal resource_variadic_data_tail();
  ensures normal resource_return_none(); };

extern fn snprintf(s: ptr<mut, u8>, maxlen: usize, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(maxlen); ensures normal resource_borrowed(format);
  ensures normal resource_variadic_data_tail(); ensures normal resource_return_none(); };

extern fn sprintf(s: ptr<mut, u8>, format: ptr<const, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(format); ensures normal resource_variadic_data_tail();
  ensures normal resource_return_none(); };

extern fn stat(file: ptr<const, u8>, buf: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(file);
  ensures normal resource_borrowed(buf); ensures normal resource_return_none(); };

extern fn strftime(s: ptr<mut, u8>, maxsize: usize, format: ptr<const, u8>, tp: ptr<const, u8>) -> usize
contract { requires resource_contract_v1; ensures normal resource_borrowed(s);
  ensures normal resource_borrowed(maxsize); ensures normal resource_borrowed(format);
  ensures normal resource_borrowed(tp); ensures normal resource_return_none(); };

extern fn gettimeofday(tv: ptr<mut, u8>, tz: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(tv);
  ensures normal resource_borrowed(tz); ensures normal resource_return_none(); };

extern fn getsockopt(fd: i32, level: i32, optname: i32, optval: ptr<mut, u8>, optlen: ptr<mut, u8>) -> i32
contract { requires resource_contract_v1; ensures normal resource_borrowed(fd);
