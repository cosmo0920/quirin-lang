module contract;

// ## Card W43-LIBC-RESULT-ALIAS: results derived from an argument
//
// TRUSTED ASSUMPTIONS, read from the same headers. Each result below is
// DERIVED from one argument and owns nothing (contract spec C04.3.1): it
// acquires, discharges and transfers no custody, releasing it is not a release
// of the base, and releasing the base invalidates it.
//
// ### The exact aliases: the result IS the first argument
//
//   extern void *memcpy (void *__restrict __dest, const void *__restrict __src,
//                        size_t __n) __THROW __nonnull ((1, 2));
//   extern void *memmove (void *__dest, const void *__src, size_t __n)
//        __THROW __nonnull ((1, 2));
//   extern void *memset (void *__s, int __c, size_t __n) __THROW __nonnull ((1));
//   extern char *strcpy (char *__restrict __dest, const char *__restrict __src)
//        __THROW __nonnull ((1, 2));
//   extern char *strncpy (char *__restrict __dest,
//                         const char *__restrict __src, size_t __n)
//        __THROW __nonnull ((1, 2));
//
//   Each writes through its first argument, reads the others, and "returns the
//   value of" its first argument (C11 7.24.2.1p3, 7.24.2.2p3, 7.24.6.1p3,
//   7.24.2.3p3, 7.24.2.4p5). So: every pointer is `resource_borrowed` (the
//   callee retains nothing), and the result is `resource_return_alias(dest,
//   nonnull)` -- the call never substitutes NULL for its argument. The
//   `__restrict` spellings are read by the declared-ABI reader as qualifiers
//   of the parameter object (C11 6.7.6.3p15) since this card.

extern fn strcpy(dest: ptr<mut, u8>, src: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn strncpy(dest: ptr<mut, u8>, src: ptr<const, u8>, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn memcpy(dest: ptr<mut, u8>, src: ptr<const, u8>, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn memmove(dest: ptr<mut, u8>, src: ptr<const, u8>, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(dest);
    ensures normal resource_borrowed(src);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(dest, nonnull);
};

extern fn memset(s: ptr<mut, u8>, c: i32, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_alias(s, nonnull);
};

// ## Card W43-LIBC-RESULT-ALIAS: the reentrant broken-down time calls
//
//   extern struct tm *gmtime_r (const time_t *__restrict __timer,
//                               struct tm *__restrict __tp) __THROW;
//   extern struct tm *localtime_r (const time_t *__restrict __timer,
//                                  struct tm *__restrict __tp) __THROW;
//
// Each reads `*__timer`, writes the caller's `*__tp`, and returns `__tp` on
// success or NULL on error (POSIX). Nothing is allocated, freed or retained:
// both pointers are `resource_borrowed`, and the result is
// `resource_return_alias(tp, nullable)` -- exactly the second argument, or
// NULL. TRUSTED ASSUMPTIONS; the `__restrict` spellings are read by the
// declared-ABI reader since this card. Nothing here says anything about time
// zones or the validity of the broken-down time.

extern fn gmtime_r(timer: ptr<const, u8>, tp: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(timer);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_alias(tp, nullable);
};

extern fn localtime_r(timer: ptr<const, u8>, tp: ptr<mut, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(timer);
    ensures normal resource_borrowed(tp);
    ensures normal resource_return_alias(tp, nullable);
};

// ### The interior pointers: the result points INTO the first argument
//
//   extern char *strchr (const char *__s, int __c)
//        __THROW __attribute_pure__ __nonnull ((1));
//   extern char *strrchr (const char *__s, int __c)
//        __THROW __attribute_pure__ __nonnull ((1));
//   extern char *strstr (const char *__haystack, const char *__needle)
//        __THROW __attribute_pure__ __nonnull ((1, 2));
//   extern char *strcasestr (const char *__haystack, const char *__needle)
//        __THROW __attribute_pure__ __nonnull ((1, 2));
//   extern void *memchr (const void *__s, int __c, size_t __n)
//        __THROW __attribute_pure__ __nonnull ((1));
//   extern void *memrchr (const void *__s, int __c, size_t __n)
//        __THROW __attribute_pure__ __nonnull ((1));
//
//   Each only READS its arguments and returns either a pointer to a located
//   character or substring inside the object its first argument points to,
//   or NULL (C11 7.24.5.2p3, 7.24.5.5p3, 7.24.5.7p3, 7.24.5.1p2; glibc for
//   `strcasestr` and `memrchr`). So: every pointer is `resource_borrowed`, and
//   the result is `resource_return_interior(s, nullable)`. The base is
//   `const char *`/`const void *` while the result is not, so the loader
//   records `const_dropped`: a write through the result writes through a
//   pointer the caller declared `const`.
//
// ## What no declaration in this section says
//
// Nothing about bounds, overlap, termination, the offset of an interior
// result, or whether the located byte exists. Releasing an interior result is
// an invalid free unless the offset happens to be zero, which the analyzer
// cannot know: it reports a violation CANDIDATE, never a defect.

extern fn strchr(s: ptr<const, u8>, c: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_return_interior(s, nullable);
};

extern fn strrchr(s: ptr<const, u8>, c: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_return_interior(s, nullable);
};

extern fn strstr(haystack: ptr<const, u8>, needle: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(haystack);
    ensures normal resource_borrowed(needle);
    ensures normal resource_return_interior(haystack, nullable);
};

extern fn strcasestr(haystack: ptr<const, u8>, needle: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(haystack);
    ensures normal resource_borrowed(needle);
    ensures normal resource_return_interior(haystack, nullable);
};

extern fn memchr(s: ptr<const, u8>, c: i32, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_interior(s, nullable);
};

extern fn memrchr(s: ptr<const, u8>, c: i32, n: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(s);
    ensures normal resource_borrowed(c);
    ensures normal resource_borrowed(n);
    ensures normal resource_return_interior(s, nullable);
};
