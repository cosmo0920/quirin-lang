 "creators": {
  "mk_event_channel_create": {
   "status": "MISSING",
   "why": "The cells receive the values the creator stores through its slots `*r_fd` / `*w_fd` on `#result == 0` (event_loop.qv D3). On every Fluent Bit build (epoll) those are `pipe`'s descriptors. libc/result_sets.qv declares `pipe`'s RESULT (`-1 | 0`) only; no contract states the values `pipe` writes to `pipedes[0..1]`, and no form of G05j states an out slot's value set. monkey/result_range.qv's pin-derived `nonnull_result_range(-1, 0)` is the creator's status result, not the descriptors.",
   "proposed": "[0, MAX] (POSIX.1-2017 pipe(): fildes[0] and fildes[1] are file descriptors, non-negative)"
  },
  "flb_pipe_create": {
   "status": "MISSING",
   "why": "flb_pipe.c forwards `pipe(pipefd)` (Linux). Its slot values are `pipe`'s descriptors; no contract states them (as for mk_event_channel_create).",
   "proposed": "[0, MAX] (POSIX.1-2017 pipe())"
  },
  "mk_event_timeout_create": {
   "status": "MISSING",
   "why": "The cell holds the creator's result on `#result != -1` (event_loop.qv D1). Its result set rests on `timerfd_create` (epoll with MK_HAVE_TIMERFD_CREATE), which no libc contract declares (libc-names.txt does not list it, RULE-38-VALIDITY-READING-RESULT-SET), and no derived mk_event_timeout_create range is pinned.",
   "proposed": "[0, MAX] (the `!= -1` class of `-1 | [0, MAX]`, Linux timerfd_create(2))"
  }
 },
