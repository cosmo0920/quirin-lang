+
+// CONTRACT-COUNT-PINS-FROM-LOCKS acceptance scratch, throwaway branch only:
+// one plain borrow (the function map) and one global retention (the
+// retaining table), added to an already selected module.
+extern fn qcore_scratch_count_probe_borrow(p: ptr<mut, u8>) -> unit
+contract {
+    requires resource_contract_v1;
+    ensures normal resource_borrowed(p);
+    ensures normal resource_return_none();
+};
+
+extern fn qcore_scratch_count_probe_retain(key: u32, pointer: ptr<const, u8>) -> i32
+contract {
+    requires resource_contract_v1;
+    ensures normal resource_borrowed(key);
+    ensures normal resource_borrowed(pointer);
+    ensures normal resource_retained_by(pointer, global);
+    ensures normal resource_return_none();
+};
