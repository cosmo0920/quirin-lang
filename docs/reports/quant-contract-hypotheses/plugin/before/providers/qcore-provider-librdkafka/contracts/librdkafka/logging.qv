// BEGIN OP-APP-RK-CALLBACKS-VIA-POLL-CB (scripts/write_contracts.py)

// # Fluent Bit's registered rk_conf callbacks
//
// Card OP-APP-RK-CALLBACKS-VIA-POLL-CB (gateway rule 12n), on the user's
// decisions of 2026-10-14 ("Closed over FB's registrations"; "Each candidate
// needs its own contract"; F1: declared-assumption standing for the three
// Fluent Bit candidates, each body read). The callbacks Fluent Bit registers
// through `rd_kafka_conf_set_*_cb`: `plugins/out_kafka/kafka_config.c:108`
// (`dr_msg_cb`), `:111` (`log_cb`) and `src/aws/flb_aws_msk_iam.c:775`
// (`sasl.oauthbearer.token_refresh_cb`). Each body was read at `66910c10` and
// `046accf6` (identical); no analysed route defines them, so each is a
// declared assumption (rule 13i). Each is pinned (C06.2).

// `cb_kafka_msg(rk, rkmessage, opaque)` (`plugins/out_kafka/kafka.c:63-78`):
// reads the opaque's plugin context and the message's error, length and
// partition, and logs through `flb_plg_warn` / `flb_plg_debug`; keeps nothing.
extern fn cb_kafka_msg(rk: ptr<mut, u8>, rkmessage: ptr<const, u8>, opaque: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    requires resource_hypothesis(plugin_artifact_symbol_abi, "For every reached loaded artifact, exact selected build/inventory, artifact identity and required symbol/address/ABI prerequisites hold.");
    requires resource_lifecycle_v1(introduce_plugin_artifact_symbol_abi, |^+ hypothesis(plugin_artifact_symbol_abi));
    requires resource_hypothesis(plugin_callback_candidates, "Every actual rk_conf invocation has its exact declared member candidate and a prior successful public registration or stated static default.");
    requires resource_lifecycle_v1(introduce_plugin_callback_candidates, |^+ hypothesis(plugin_callback_candidates));
    requires resource_hypothesis(plugin_code_context_lifetime, "Every loaded callback invocation, including destruction and copied on_new paths, has live code and opaque context.");
    requires resource_lifecycle_v1(introduce_plugin_code_context_lifetime, |^+ hypothesis(plugin_code_context_lifetime));
    requires resource_hypothesis(plugin_interceptor_custody, "Every interceptor-descendant pointer and scalar resource is borrowed, with no retain/transfer/global custody and each local acquisition dropped before its activation returns.");
    requires resource_lifecycle_v1(introduce_plugin_interceptor_custody, |^+ hypothesis(plugin_interceptor_custody));
    requires resource_hypothesis(plugin_interceptor_registration, "Every loaded interceptor uses a successful public setter with the exact pinned list/union-arm candidate and permitted configuration/client lifecycle.");
    requires resource_lifecycle_v1(introduce_plugin_interceptor_registration, |^+ hypothesis(plugin_interceptor_registration));
    requires resource_hypothesis(plugin_lifecycle_unload, "Every callback invocation precedes matching final unload and copied registrations retain actual loader references.");
    requires resource_lifecycle_v1(introduce_plugin_lifecycle_unload, |^+ hypothesis(plugin_lifecycle_unload));
    requires resource_hypothesis(plugin_outer_bridge, "Actually loaded RK and Fluent Bit C/Go code independently meet their respectively bound proposed outer envelopes; one envelope covers no missing obligation of another.");
    requires resource_lifecycle_v1(introduce_plugin_outer_bridge, |^+ hypothesis(plugin_outer_bridge));
    requires resource_premise_decomposition(rk_plugin_callback_closure, plugin_artifact_symbol_abi, plugin_callback_candidates, plugin_code_context_lifetime, plugin_interceptor_custody, plugin_interceptor_registration, plugin_lifecycle_unload, plugin_outer_bridge);
    requires resource_premise_flow_v1(decompose_rk_plugin_callback_closure, ((((((plugin_artifact_symbol_abi |-> plugin_callback_candidates) |-> plugin_code_context_lifetime) |-> plugin_interceptor_custody) |-> plugin_interceptor_registration) |-> plugin_lifecycle_unload) |-> plugin_outer_bridge));
    ensures normal resource_borrowed(rk);
    ensures normal resource_borrowed(rkmessage);
    ensures normal resource_borrowed(opaque);
    ensures normal resource_return_none();
};

