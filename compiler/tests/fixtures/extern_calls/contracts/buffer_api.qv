module contract;

// A trusted, declared model of a tiny C buffer API. Loading this file asserts
// nothing about the C implementation: it is a `ContractTrust::Declared`
// assumption (contract spec §C06), and no clause here promises how many bytes
// any callee touches — C04 pointers are extentless `u8` projections.

extern fn qcore_extern_alloc(size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn qcore_extern_alloc_failing(size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn qcore_extern_fill(buffer: ptr<mut, u8>, value: u32) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(buffer);
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
};

extern fn qcore_extern_sum(buffer: ptr<const, u8>, count: u32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(buffer);
    ensures normal resource_borrowed(count);
    ensures normal resource_return_none();
};

extern fn qcore_extern_release(buffer: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_consumed(buffer, nonnull);
    ensures normal resource_return_none();
};

// --- Card `PIPE-SCALAR-RESULT`: a second scalar-result callee. ---

// `resource_return_none()` with an `i32` result, exactly as `qcore_extern_sum`
// declares — but with scalar *parameters* only, so it is the stage a scalar
// result can feed. Nothing here carries custody in any position: contract spec
// §C04.1's "a scalar may carry a descriptor number as data, but cannot carry
// descriptor custody" is the whole reason binding this result is admissible.
extern fn qcore_extern_scale(value: i32, factor: i32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(value);
    ensures normal resource_borrowed(factor);
    ensures normal resource_return_none();
};

// Card `STD-IO-COMPOSE`: a scalar-returning callee of a **different width**.
// It is here so the composed route's "this width is not renderable" refusal is
// reachable and non-vacuous: `source.std-io.v1`'s two renderings are total on
// `int32_t` and on nothing else, and a value declared `i64` is refused at the
// rendering rather than emitted through a conversion that does not describe it.
// Nothing here carries custody in any position.
extern fn qcore_extern_widen(value: i32) -> i64
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
};

// --- Card EXTERN-F1: the `resource_out` and `resource_stored` call modes. ---

// Fresh custody written through a declared out slot. The declared nullability
// is what makes the failure arm checkable; a `nonnull` slot would assert the
// written pointer without a branch and is refused (`Q024`).
extern fn qcore_extern_open(slot: ptr<mut, ptr<mut, u8>>, size: usize) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_out(slot, nullable);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_none();
};

// The same declared shape, always refusing: the fixture that declares
// `succeeds false` links against this one so the null arm is real.
extern fn qcore_extern_open_failing(slot: ptr<mut, ptr<mut, u8>>, size: usize) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_out(slot, nullable);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_none();
};

// Custody of `child` becomes indexed beneath `owner`. Contract spec §C04.2
// requires that owner to be a distinct `resource_owned` parameter, so this
// declaration is what makes `resource_owned` admissible at all — and only in
// this position.
extern fn qcore_extern_attach(owner: ptr<mut, u8>, child: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(owner, nonnull);
    ensures normal resource_stored(child, owner, nonnull);
    ensures normal resource_return_none();
};

// --- Card `EXTERN-ERR-REL`: releasing a declared store owner. ---

// A second consuming callee. Its declaration says exactly what every other
// `resource_consumed` clause says — the caller's obligation moves to the
// callee — and nothing more. That this particular C implementation also
// releases whatever was stored beneath the owner is the fixture satisfying
// `StoredCustodyUnderDeclaredOwner` for its own runs; no clause here, and no
// run, establishes that premise in general.
extern fn qcore_extern_release_owner(owner: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_consumed(owner, nonnull);
    ensures normal resource_return_none();
};

// --- Card `EXTERN-MODES`: the released and reallocated call modes. ---

// `resource_released` says something `resource_consumed` deliberately does not:
// contract spec §C04.2 reads "the trusted call contract discharges the resource
// obligation. A false declaration here can invalidate a safety conclusion."
// Declaring it here is exactly that trusted claim; the certificate records it
// as its own premise so a reader can see which callees a leak-freedom reading
// rests on. The nullable form is refused by the bridging table (`Q024`), so
// this declaration is `nonnull` and the caller must supply a live identity.
extern fn qcore_extern_free(buffer: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(buffer, nonnull);
    ensures normal resource_return_none();
};

// `resource_return_reallocated(buffer, nullable)`. Contract spec §C04.3 fixes
// both arms: a null failure preserves the incoming custody, and a successful
// replacement consumes the old resource exactly once and establishes the result
// identity. That is why the subject must be `resource_owned` — the caller
// supplies live custody — and why a reallocation is the one departing argument
// an acquiring call may carry: its status on the failure arm is declared rather
// than left silent.
extern fn qcore_extern_grow(buffer: ptr<mut, u8>, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(buffer, nonnull);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_reallocated(buffer, nullable);
};

// The same declared shape, always refusing. Its C implementation returns null
// and leaves the subject untouched, so the preserved-custody arm of §C04.3 is a
// real observation and the error arm's disposition is a real release.
extern fn qcore_extern_grow_failing(buffer: ptr<mut, u8>, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(buffer, nonnull);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_reallocated(buffer, nullable);
};
