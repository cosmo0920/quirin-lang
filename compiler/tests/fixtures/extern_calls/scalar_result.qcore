import std.extern;

// Card `PIPE-SCALAR-RESULT`: a non-acquiring call's scalar result bound to a
// local, and that local passed on at a declared scalar parameter. Neither form
// touches custody: the buffer is acquired, lent, lent again and released
// exactly as `round_trip.qcore` does, and the two scalar bindings sit beside
// that accounting without entering it.
error Failure { Failed; }

extern fn qcore_extern_alloc(size: usize) -> ptr<mut, u8>;
extern fn qcore_extern_fill(buffer: ptr<mut, u8>, value: u32) -> unit;
extern fn qcore_extern_sum(buffer: ptr<const, u8>, count: u32) -> i32;
extern fn qcore_extern_scale(value: i32, factor: i32) -> i32;
extern fn qcore_extern_release(buffer: ptr<mut, u8>) -> unit;

fn main() -> unit effects { io, alloc, mut } {
    let b = qcore_extern_alloc(8) succeeds true else raise Failure;
    qcore_extern_fill(b, 7);
    let total = qcore_extern_sum(b, 8);
    let scaled = qcore_extern_scale(total, 2);
    qcore_extern_release(move b);
    return;
}
