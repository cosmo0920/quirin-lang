// Two disjoint sub-ranges of one owned buffer, held at the same time, while the
// owner writes a third range that neither of them covers
// (card `CT07-SLICE-PERMISSIONS`).
//
// `borrow_utf8(store, 0, 2)` and `borrow_utf8(store, 4, 6)` are two immutable
// views of two ranges of the same buffer. Both windows are open across
// `store[2] = 88;` and `store[3] = 89;`, and those writes are **admitted**
// because byte 2 and byte 3 lie outside both `[0, 2)` and `[4, 6)`. The
// disjointness is decided at check time — `max low < min high`, exact because
// every bound here is a check-time constant — and a write into either lent
// range refuses at `Q078` instead.
//
// The third view reads the bytes the owner wrote, after the first two windows
// have closed, which is what makes the admission visible in the observation
// rather than only in the certificate.
#import std.string;
#import std.buffer;
#import std.io;

fn main() -> unit effects { io, alloc, mut } {
    let store = bytes(6);
    store[0] = 97;
    store[1] = 98;
    store[2] = 99;
    store[3] = 100;
    store[4] = 101;
    store[5] = 102;

    let head = borrow_utf8(store, 0, 2);
    let tail = borrow_utf8(store, 4, 6);

    store[2] = 88;
    store[3] = 89;

    print head;
    print tail;

    let middle = borrow_utf8(store, 2, 4);
    print middle;

    drop store;
    return;
}
