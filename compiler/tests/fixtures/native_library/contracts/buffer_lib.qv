module contract;

// Card `NATIVE-LIBRARY-CONTRACT-SLICE`: the declared contract slice of one
// native library, for the manifest beside it
// (`fixtures/native_library/buffer_lib.qcorelib`).
//
// Loading this file asserts nothing about the C implementation: every clause is
// a `ContractTrust::Declared` assumption (contract spec §C06), and no clause
// promises how many bytes any callee touches — C04 pointers are extentless `u8`
// projections.
//
// It is a **separate module** from `fixtures/extern_calls/contracts/buffer_api.qcore`
// on purpose. Design §4.1's binding totality runs in both directions: every
// declaration of a module a manifest's slice names must be bound by an entry of
// that manifest. Binding the shared fixture module would therefore have made
// every future declaration added to it, by any card, a refusal of this card's
// manifest. The slice is the library's exported surface, so the fixture that
// models a library gets its own.
//
// The four declarations are exactly those `fixtures/unsafe_linkage/round_trip.qcore`
// and `fixtures/extern_calls/round_trip.qcore` call, with the same text as in
// the shared module, so the positive row of this card is the *already accepted*
// program rebound through a manifest rather than a new one.

extern fn qcore_extern_alloc(size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn qcore_extern_fill(buffer: ptr<mut, u8>, value: u32) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(buffer);
    ensures normal resource_borrowed(value);
    ensures normal resource_return_none();
};

extern fn qcore_extern_sum(buffer: ptr<const, u8>, count: u32) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(buffer);
    ensures normal resource_borrowed(count);
    ensures normal resource_return_none();
};

extern fn qcore_extern_release(buffer: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_consumed(buffer, nonnull);
    ensures normal resource_return_none();
};
