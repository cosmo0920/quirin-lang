# Card `NATIVE-LIBRARY-HEADER`: `fixtures/native_library/buffer_lib.qrlib`
# with its **exported header** bound.
#
# Two fields are added and nothing else moves. `header` names the `.h` this
# library ships and `header_hash` names that file's digest; both are present or
# neither is, and a manifest with neither — every manifest written before this
# card — is unaffected by this level entirely.
#
# What the two fields buy: each entry's transcribed declaration below is now
# **compared against the header's own text** rather than believed, at load, for
# every symbol this manifest binds. A disagreement refuses the manifest; it does
# not withdraw to the weaker reading, because the weaker reading here is this
# same manifest without a header, and that is accepted.
#
# The digest is *verified*, unlike the artifact `hash` above it: the header is
# read at check time and its text decides admission, so measuring it is both
# possible and honest. Whether the linker used `libqcore_buffer_demo.a` remains
# the builder's act and is still a pin.

native_library manifest v1;
library qcore_buffer_demo;
version 0.2.0;
artifact libqcore_buffer_demo.a;
hash sha256:4d1f8a03be27c5901e6ab4772d05f3c81a9e6b40d7cc2318f5be0947aa6132ed;
data_model lp64;
unwinding abort;
allocator_custody closed;
thread_posture single_caller;
header include/qcore_buffer_demo.h;
header_hash sha256:aa92b5d783202524bad45bcc39750944ab19af0547f555429623fc8a2a49a657;

contract fn qcore_extern_alloc(uintptr_t) -> uint8_t * from fixtures/native_library/contracts/buffer_lib.qv;
contract fn qcore_extern_fill(uint8_t *, uint32_t) -> void from fixtures/native_library/contracts/buffer_lib.qv;
contract fn qcore_extern_sum(const uint8_t *, uint32_t) -> int32_t from fixtures/native_library/contracts/buffer_lib.qv;
contract fn qcore_extern_release(uint8_t *) -> void from fixtures/native_library/contracts/buffer_lib.qv;
