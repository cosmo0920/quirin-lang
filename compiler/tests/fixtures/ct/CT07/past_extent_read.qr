// CT07's BOUNDS control, layer two: the PAYLOAD's own extent. The identical
// program with the owner's first byte read moved from 0 to 4 — one past the
// payload's four bytes (BUFFER_PAYLOAD_BYTES, the real bytes of the emitted
// struct's int32_t). Refused at check time as outside the payload's extent.
//
// The two bounds controls are deliberately separate because the two bounds live
// in different layers and neither implies the other: past_range_byte.qcore's
// index is a real payload byte refused by the LEASE it goes through, and this
// one is a real owner access refused by the PAYLOAD. Card
// WRITE-LEND-TASKS-EXERCISE measured what happens when the emitted guard for
// this rule is removed: one byte past the payload lands inside the buffer
// struct's own tail padding, where AddressSanitizer is silent — which is why
// this bound is a checker refusal and not a sanitizer observation.
import std.concurrency;
concurrency checked;
fn writer(half: lend<Buffer>) -> i32 {
  let done = qcore_buffer_write(half, 0, 9);
  return 1;
}
fn main() -> i32 effects { alloc, throws<AllocError>, spawn, join, may_block } {
  let buffer = qcore_buffer_new(0)?;
  thread scope s {
    match spawn s writer(lend buffer 0..2) {
      Result::Ok { value: first } => {
        match spawn s writer(lend buffer 2..4) {
          Result::Ok { value: second } => {
            let a = join move first?;
            let b = join move second?;
            let byte0 = qcore_buffer_read(buffer, 4);
            let byte2 = qcore_buffer_read(buffer, 2);
            drop buffer;
            return byte2;
          }
          Result::Err { error: refused } => {
            let a = join move first?;
            drop buffer;
            return a;
          }
        }
      }
      Result::Err { error: failure } => {
        drop buffer;
        return 0;
      }
    }
  }
}
