// CT07's bounds control: the identical program with one byte of the owner's
// write moved **past the buffer's declared extent** (card `CT-WIRE-LANE-2`).
//
// `store[6] = 88;` names a byte `bytes(6)` does not have. It is provably
// outside every live loan's range, so the range-wise exclusion does not fire,
// and the statement reaches `source.buffer.v1`'s own bounds rule, which
// refuses it at check time (`Q077` on this composed route, carrying that
// model's own message). This is the "bounds proof" half of CT07's expected
// text, measured as a refusal rather than a run-time trap.
import std.string;
import std.buffer;
import std.io;

fn main() -> unit effects { io, alloc, mut } {
    let store = bytes(6);
    store[0] = 97;
    store[1] = 98;
    store[2] = 99;
    store[3] = 100;
    store[4] = 101;
    store[5] = 102;

    let head = borrow_utf8(store, 0, 2);
    let tail = borrow_utf8(store, 4, 6);

    store[6] = 88;
    store[3] = 89;

    print head;
    print tail;

    let middle = borrow_utf8(store, 2, 4);
    print middle;

    drop store;
    return;
}
