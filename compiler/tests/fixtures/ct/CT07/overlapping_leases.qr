// CT07's DISJOINTNESS control. The identical program with one bound of the
// first lease moved from 2 to 3, so the two ranges share exactly byte 2.
// Refused by the scoped-task ledger's exclusivity rule between two range write
// leases (`OverlappingLeases`, naming both ranges) — so the case's admission is
// a DECIDED disjointness between two write authorities held by two threads, not
// a route that hands out second leases anywhere. Nothing overlapping ever
// reaches a sanitizer, because the refusal precedes emission.
import std.concurrency;
concurrency checked;
fn writer(half: lend<Buffer>) -> i32 {
  let done = qcore_buffer_write(half, 0, 9);
  return 1;
}
fn main() -> i32 effects { alloc, throws<AllocError>, spawn, join, may_block } {
  let buffer = qcore_buffer_new(0)?;
  thread scope s {
    match spawn s writer(lend buffer 0..3) {
      Result::Ok { value: first } => {
        match spawn s writer(lend buffer 2..4) {
          Result::Ok { value: second } => {
            let a = join move first?;
            let b = join move second?;
            let byte0 = qcore_buffer_read(buffer, 0);
            let byte2 = qcore_buffer_read(buffer, 2);
            drop buffer;
            return byte2;
          }
          Result::Err { error: refused } => {
            let a = join move first?;
            drop buffer;
            return a;
          }
        }
      }
      Result::Err { error: failure } => {
        drop buffer;
        return 0;
      }
    }
  }
}
