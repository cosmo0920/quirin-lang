import std.buffer;
import std.fmt;
import std.io;

// CT07's case since card CT07-WRITE-REMAP (wave 30): the program card
// SLICE-PERMISSIONS-WRITE-LEND published as the half of CT07 the read card
// could not reach — two parties each holding WRITE authority over their own
// range of one buffer, mutating independently while both loans are live.
// `left` and `right` cover [0, 4) and [4, 8): provably disjoint, decided at
// check time, and the interleaved stores below are each admitted because each
// goes through the loan that owns its byte. The owner reads the bytes back
// only after both windows close, which is when its authority returns. Moved
// here from compiler/tests/fixtures/write_lend/disjoint_write_halves.qcore
// byte-identically (only this comment changed); compiler/tests/write_lend.rs
// still runs it as that card's own fixture.
fn main() -> unit effects { io, alloc, mut } {
    let store = bytes(8);
    let left = lend(store, 0, 4);
    let right = lend(store, 4, 8);
    left[0] = 11;
    right[0] = 55;
    left[1] = 22;
    right[1] = 66;
    let b = right[1];
    let a = left[1];
    let x = store[0];
    let y = store[4];
    print dec a;
    print dec b;
    print dec x;
    print dec y;
    drop store;
    return;
}
