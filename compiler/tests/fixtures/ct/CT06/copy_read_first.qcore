// CT06 boundary control. The copy stays, and so does the read through it; only
// the release moves past that read. Admitted — so the obligation the copy
// carries is the original's own obligation, bounded by the copy's last read and
// not by the existence of a second name.
import std.string;
import std.buffer;
import std.io;

fn main() -> unit effects { io, alloc, mut } {
    let store = bytes(2);
    store[0] = 104;
    store[1] = 105;
    let view = borrow_utf8(store);
    print view;
    let same = view[0:2];
    print same;
    drop store;
    return;
}
