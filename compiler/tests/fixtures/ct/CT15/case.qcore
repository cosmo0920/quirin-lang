import std.concurrency;
concurrency checked;
fn worker(x: i32) -> i32 { return x; }
fn main() -> i32 effects { throws<SpawnError>, spawn, join, may_block } {
    let value = 42;
    thread scope tasks {
        let handle = spawn tasks worker(copy value)?;
        let result = join move handle;
        let joined = result?;
        return joined;
    }
}
