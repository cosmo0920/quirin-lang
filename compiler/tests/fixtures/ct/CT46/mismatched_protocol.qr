#import std.concurrency;
fn main() -> unit {
    thread scope s {
        let buf = protected 4;
        let other = protected 4;
        let m = mutex guards buf;
        let n = mutex guards other;
        thread scope c share buf under n {
            with lock n as gc { open gc; write other with gc; close gc; }
        }
        with lock m as g { read buf with g; }
    }
}
