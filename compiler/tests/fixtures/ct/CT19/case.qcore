concurrency checked;
fn worker(x: i32) -> i32 { return x; }
fn main() -> i32 effects { throws<SpawnError>, spawn, join, may_block } {
    let value = 42;
    thread scope tasks {
        let first = spawn tasks worker(copy value)?;
        let second = spawn tasks worker(copy value)?;
        let second_result = join move second?;
        let first_result = join move first?;
        return first_result;
    }
}
