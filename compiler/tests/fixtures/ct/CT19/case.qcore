// CT19 (spec §55; rule in §43.7): a parent error exit that would bypass a live
// sibling obligation must be rejected "even if the usual sequential cleanup
// pack would otherwise be valid".
// Sequential obligation core: the sibling's obligation is modeled as an
// ownership transfer out of the parent frame, so it is no longer a member of
// the frame's cleanup pack while still being outstanding. The subsequent
// failing checked operation is the parent's error exit. The pack itself is
// empty and would be valid; the exit is refused because the outstanding
// transferred obligation cannot be accounted for on the error edge.
module executable;
error ScopeError { Failed; }
fn parent() -> i32 {
    let sibling = qcore_acquire(4, true, ScopeError);
    move sibling;
    qcore_check(false, ScopeError);
    return 0;
}
