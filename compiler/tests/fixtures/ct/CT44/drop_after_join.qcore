import std.concurrency;
concurrency checked;

// CT44 control -- the environment outliving the join, admitted. Byte-identical
// to case.qcore but for ONE statement's position: the destruction is moved to
// after `join move handle?` instead of before it. It checks and takes
// ScopedReadLoansV1.
//
// This is the case's attribution control in the wave-9 sense: the construct
// CT44 names is the expiry BEFORE THE JOIN, and removing exactly that -- the
// relative position, nothing else about the program -- moves the verdict.
fn reader(payload: borrow<Buffer>) -> i32 {
  let seen = qcore_buffer_read(payload);
  return seen;
}
fn main() -> i32 effects { alloc, throws<AllocError>, spawn, join, may_block } {
  let buffer = qcore_buffer_new(7)?;
  thread scope s {
    match spawn s reader(read buffer share FULL) {
      Result::Ok { value: handle } => {
        let seen = join move handle?;
        drop buffer;
        return seen;
      }
      Result::Err { error: failure } => {
        drop buffer;
        return 1;
      }
    }
  }
}
