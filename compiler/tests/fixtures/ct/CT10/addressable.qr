#import std.concurrency;
concurrency checked;

type Pair {
    left: field<0, 4>,
    right: field<4, 4>
}

fn writer(value: i32) -> unit effects { mut } {
    write value;
    return;
}

fn main() -> unit effects { spawn, join, mut } {
    let pair = Pair;
    thread scope workers {
        let left = spawn workers writer(write pair.left)?;
        let right = spawn workers writer(write pair.right)?;
        let left_done = join move left?;
        let right_done = join move right?;
    }
    return;
}
