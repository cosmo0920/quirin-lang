module contract;

// The declared custody API this C twin is analyzed against. These are trusted
// test assumptions about a synthetic `q_*` allocator, not verified facts. The
// deliberate omission is `q_destroy`: the case's destructor has no access
// contract here, which is what the case is about.

extern fn q_alloc() -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_return_owned(nonnull);
};

extern fn q_free(p: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(p, nonnull);
    ensures normal resource_return_none();
};
