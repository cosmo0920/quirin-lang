#import std.concurrency;
concurrency checked;

// CT47 control -- the SHARE contract supplied, admitted. Byte-identical to
// case.qcore but for the capture's mode: `read buffer share 512` is the
// second of the two contracts the case's refusal message names for this kind
// ("`read PLACE share N` (a counted read share)"). It checks and takes
// ScopedReadSharesV1, so the case's Q600 is keyed to the missing contract and
// not to crossing a spawn boundary with this value at all.
fn reader(payload: borrow<Buffer>) -> i32 {
  let seen = qcore_buffer_read(payload);
  return seen;
}
fn main() -> i32 effects { alloc, throws<AllocError>, spawn, join, may_block } {
  let buffer = qcore_buffer_new(7)?;
  thread scope s {
    match spawn s reader(read buffer share 512) {
      Result::Ok { value: handle } => {
        let seen = join move handle?;
        drop buffer;
        return seen;
      }
      Result::Err { error: failure } => {
        drop buffer;
        return 1;
      }
    }
  }
}
