// Card `STRING-SLICE`: a `source.string.v1` module that writes nothing.
//
// It exists to show two things at once. Its declared effect row is **empty** —
// literal construction, `len` and a successful slice have no `Alloc` and no
// `Mut` effect (amendment §7), unlike the sibling buffer route where an
// acquisition always derives `Alloc`. And its emitted program allocates nothing
// and frees nothing, so a sanitized run has nothing to find and nothing to leak.
import std.string;

fn main() -> unit {
    let text = "quirin";
    let part = text[0:2];
    let n = len(part);
    return;
}
