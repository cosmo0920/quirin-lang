module contract;

// Trusted resource-projection assumptions, vocabulary version 1.
// These preserve the Cycle 19 audit table; they do not verify the C bodies.
// Borrowed scalar/opaque arguments carry no resource custody requirement.
// Detailed observation/lifecycle contracts remain separate semantic profiles.

extern fn rd_malloc(size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn rd_calloc(count: usize, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(count);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn rd_strdup(str: ptr<const, u8>) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(str);
    ensures normal resource_return_owned(nullable);
};

extern fn rd_strndup(str: ptr<const, u8>, len: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(str);
    ensures normal resource_borrowed(len);
    ensures normal resource_return_owned(nullable);
};

extern fn rd_free(ptr: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(ptr, nullable);
    ensures normal resource_return_none();
};

extern fn rd_realloc(ptr: ptr<mut, u8>, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(ptr, nullable);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_reallocated(ptr, nullable);
};

// Card W46-EXTERNAL-CALLEE-CONTRACTS appended `rd_atomic32_get` to the
// converted module; it inherits nothing, so its hand-written form is the
// module's own text and the conversion's parity is unchanged.
extern fn rd_atomic32_get(ra: ptr<mut, u8>) -> i32
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(ra);
    ensures normal resource_return_none();
};

// Card W47-CALLEE-CLOSURE-R2 appended `rd_file_read` to the converted module;
// it inherits nothing either, so its hand-written form is the module's own
// text and the conversion's parity is unchanged.
extern fn rd_file_read(file_path: ptr<const, u8>, size: ptr<mut, u8>, max_size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(file_path);
    ensures normal resource_borrowed(size);
    ensures normal resource_borrowed(max_size);
    ensures normal resource_return_owned(nullable);
};

// Card CONTRACT-NORETURN-AND-BORROWED-TAILS appended `rd_kafka_crash` to the
// converted module; it inherits nothing either. RK-PLUGIN-LIBRARY-OUTER-ENVELOPE
// updates this parity fixture to the run callback-closure premise.
// PLUGIN-PREMISE-DECOMPOSITION adds its exact seven proposed atoms and neutral
// same-name attachment; token parity still checks every inherited declaration.
extern fn rd_kafka_crash(file: ptr<const, u8>, line: i32, function: ptr<const, u8>, rk: ptr<mut, u8>, reason: ptr<const, u8>) -> unit
contract {
    requires resource_contract_v1;
    requires resource_premise(rk_plugin_callback_closure, "P-RK-PLUGIN-CALLBACK-CLOSURE: in the static scope every rk_conf callback a call may run, including rd_kafka_log_buf's log callback, is a run registration or a stated default with a declared candidate; with loaded external code, extra registrations depend on the applicable pinned rk_plugin_library and flb_external_plugin outer envelopes (OP-APP-RK-CALLBACKS-VIA-POLL-CB, C04.20)");
    requires resource_hypothesis(plugin_artifact_symbol_abi, "For every reached loaded artifact, exact selected build/inventory, artifact identity and required symbol/address/ABI prerequisites hold.");
    requires resource_hypothesis(plugin_callback_candidates, "Every actual rk_conf invocation has its exact declared member candidate and a prior successful public registration or stated static default.");
    requires resource_hypothesis(plugin_code_context_lifetime, "Every loaded callback invocation, including destruction and copied on_new paths, has live code and opaque context.");
    requires resource_hypothesis(plugin_interceptor_custody, "Every interceptor-descendant pointer and scalar resource is borrowed, with no retain/transfer/global custody and each local acquisition dropped before its activation returns.");
    requires resource_hypothesis(plugin_interceptor_registration, "Every loaded interceptor uses a successful public setter with the exact pinned list/union-arm candidate and permitted configuration/client lifecycle.");
    requires resource_hypothesis(plugin_lifecycle_unload, "Every callback invocation precedes matching final unload and copied registrations retain actual loader references.");
    requires resource_hypothesis(plugin_outer_bridge, "Actually loaded RK and Fluent Bit C/Go code independently meet their respectively bound proposed outer envelopes; one envelope covers no missing obligation of another.");
    requires resource_premise_decomposition(rk_plugin_callback_closure, plugin_artifact_symbol_abi, plugin_callback_candidates, plugin_code_context_lifetime, plugin_interceptor_custody, plugin_interceptor_registration, plugin_lifecycle_unload, plugin_outer_bridge);
    ensures normal resource_borrowed(file);
    ensures normal resource_borrowed(line);
    ensures normal resource_borrowed(function);
    ensures normal resource_borrowed(rk);
    ensures normal resource_borrowed(reason);
    ensures normal resource_return_none();
    ensures normal resource_no_return();
};

