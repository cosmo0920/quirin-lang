#import std.buffer;
#import std.fmt;
#import std.io;
type P { x: i32, y: i32 }
fn twice(v: i32) -> i32 {
    return v * 2;
}
fn main() -> unit effects { io, alloc, mut } {
    let p = P { x: 1, y: 2 };
    let b = bytes(4);
    let l = lend(b, 0, 2);
    l[0] = 1;
    drop b;
    let t = twice(3);
    print dec t;
    return;
}
