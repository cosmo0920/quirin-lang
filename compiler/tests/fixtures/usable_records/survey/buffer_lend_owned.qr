type F { tag: i32, buf: bytes }
fn main() -> unit effects { io, alloc, mut } {
    let b = bytes(4);
    let f = F { tag: 1, buf: b };
    let c = bytes(4);
    let l = lend(c, 0, 2);
    l[0] = 1;
    drop c;
    drop f;
    return;
