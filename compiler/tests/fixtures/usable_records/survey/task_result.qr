// Survey cell (task, result) of card W48-QR-USABLE-RECORDS; written by
// docs/reports/w48-qr-usable-records/make_survey.py.
#import std.concurrency;
#import std.fmt;
#import std.io;
concurrency checked;
type P { x: i32, y: i32 }
fn work(a: i32) -> P {
    let p = P { x: a, y: a };
    return p;
}
fn main() -> i32 effects { throws<SpawnError>, spawn, join, may_block, io } {
    let a = 1;
    thread scope s {
        let h = spawn s work(copy a)?;
        let r = join move h?;
        print dec r;
        return 0;
    }
}
