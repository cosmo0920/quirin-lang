// Survey cell (buffer, loop_owned) of card W48-QR-USABLE-RECORDS; written by
// docs/reports/w48-qr-usable-records/make_survey.py.
#import std.buffer;
#import std.fmt;
#import std.io;
type F { tag: i32, buf: bytes }
fn main() -> unit effects { io, alloc, mut } {
    let b = bytes(4);
    let f = F { tag: 1, buf: b };
    for i in 0..2 {
        f.buf[i] = 7;
    }
    drop f;
    return;
}
