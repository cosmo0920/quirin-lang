// Survey cell (buffer, loop) of card W48-QR-USABLE-RECORDS; written by
// docs/reports/w48-qr-usable-records/make_survey.py.
#import std.buffer;
#import std.fmt;
#import std.io;
type P { x: i32, y: i32 }
fn main() -> unit effects { io, alloc, mut } {
    let b = bytes(4);
    for i in 0..2 {
        let p = P { x: 1, y: 2 };
        let a = p.x;
        b[i] = a;
    }
    let v = b[0];
    print dec v;
    drop b;
    return;
}
