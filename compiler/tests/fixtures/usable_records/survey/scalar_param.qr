// Survey cell (scalar, param) of card W48-QR-USABLE-RECORDS; written by
// docs/reports/w48-qr-usable-records/make_survey.py.
#import std.fmt;
#import std.io;
type P { x: i32, y: i32 }
fn twice(v: i32) -> i32 {
    return v * 2;
}
fn get(p: P) -> i32 {
    let v = p.x;
    return v;
}
fn main() -> unit effects { io } {
    let p = P { x: 1, y: 2 };
    let v = get(p);
    let t = twice(v);
    print dec t;
    return;
}
