module contract;

// Trusted resource-projection assumptions, vocabulary version 1.
// These preserve the Cycle 19 audit table; they do not verify the C bodies.
// Borrowed scalar/opaque arguments carry no resource custody requirement.
// Detailed observation/lifecycle contracts remain separate semantic profiles.

extern fn flb_malloc(size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn flb_calloc(count: usize, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(count);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_owned(nullable);
};

extern fn flb_free(ptr: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(ptr, nullable);
    ensures normal resource_return_none();
};

// Card LOADER-ABI: `len` is `int`, not a size. Upstream declares
// `flb_sds_t flb_sds_create_len(const char *str, int len);`
// (`include/fluent-bit/flb_sds.h:99` at the pinned revision) and defines it with
// the same signature; the earlier `usize` here was an unfaithful projection,
// found by the declared/C ABI comparison and corrected against the read body.
// The mode is unchanged: a scalar carries no custody either way.
extern fn flb_sds_create_len(str: ptr<const, u8>, len: i32) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_borrowed(str);
    ensures normal resource_borrowed(len);
    ensures normal resource_return_owned(nullable);
};

extern fn flb_sds_destroy(ptr: ptr<mut, u8>) -> unit
contract {
    requires resource_contract_v1;
    ensures normal resource_released(ptr, nullable);
    ensures normal resource_return_none();
};
