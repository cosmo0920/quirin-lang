module contract;

// Reallocation: null failure preserves the old custody, success replaces it.

extern fn q_realloc(p: ptr<mut, u8>, size: usize) -> ptr<mut, u8>
contract {
    requires resource_contract_v1;
    ensures normal resource_owned(p, nonnull);
    ensures normal resource_borrowed(size);
    ensures normal resource_return_reallocated(p, nullable);
};
