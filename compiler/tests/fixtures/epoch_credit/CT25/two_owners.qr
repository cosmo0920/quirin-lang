import std.concurrency;
concurrency checked;
error Failure { Failed; }

// A measured boundary, not a rule of this card's reader: two simultaneously
// live region owners refuse at the task route's OWN custody gate, because the
// second acquisition's `?` failure edge discards the first -- the erased
// straight-line program's real leak path. The composed reader admits the
// shape and the unedited scoped-task checker refuses the program it erases
// to, which is the fail-closed direction (REGION-JOINS-MULTI-OWNER; see
// sequenced_owners.qcore for the admitted two-owner spelling).
fn worker(value: i32) -> own<Buffer> effects { alloc, throws<AllocError> } {
    let buffer = qcore_buffer_new(value)?;
    return move buffer;
}
fn main() -> i32 effects { alloc, throws<AllocError>, throws<SpawnError>, spawn, join, may_block } {
    thread scope plan epoch {
        bound 65536 effort 1000;
        overhead scope 512 thread 128;
        thread scope worker {
            copy;
            peak 1024;
            effort 10;
            credit 4096 effort 100;
            retained 64;
            join(drop);
        }
    }
    let value = 42;
    thread scope s {
        let handle = spawn s worker(copy value)?;
        let returned = join move handle?;
        let answer = qcore_buffer_read(returned);
        drop returned;
        error region R {
            let first = qcore_buffer_new(1)?;
            let second = qcore_buffer_new(2)?;
            credit 5;
            effort 2;
            qcore_check(false, Failure);
        } catch (Failure) quant open R as pack {
            discharge pack;
        }
        return answer;
    }
}
