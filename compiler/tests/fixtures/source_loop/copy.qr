// `source.loop.v1` on `source.buffer.v1` (card LOOP-V1): the bounded counted
// loop, and the recorded blocker it makes real.
//
// STD-BUFFER-COPY was recorded by card STD-BUFFER as "a bulk copy between two
// buffers. Needs no new custody shape, but needs the loop or the bulk operation
// the flat route has no statement for". This is that loop, and the copy below
// is written with no new buffer statement at all: the read and the write are
// `source.buffer.v1`'s own, and what the loop adds is that they run four times
// with a different index each time.
//
// Every index here is decided at check time. The bound is `extent(src)`, which
// the checker reads out of the ownership ledger's own footprint, so the four
// accesses are proved in range before a byte of C is emitted.

#import std.buffer;
#import std.fmt;
#import std.io;
#import std.logger;

fn main() -> unit effects { io, alloc, mut } {
    let src = bytes(4);
    src[0] = 81;
    src[1] = 67;
    src[2] = 111;
    src[3] = 114;

    let dst = bytes(4);
    let n = extent(src);

    // The payoff. `v` and `i` are both body-local: naming either after the
    // loop refuses, exactly as an `if` arm's bindings do.
    for i in 0..n {
        let v = src[i];
        dst[i] = v;
    }

    // A second loop, over a literal bound, writing lines rather than bytes.
    // The index is an ordinary integer scalar, so rendering it needs no new
    // operand form: `source.std-io.v1`'s existing one already denotes it.
    for k in 0..3 {
        print dec k;
    }

    let a = dst[0];
    let b = dst[1];
    let c = dst[2];
    let d = dst[3];
    print dec a;
    print dec b;
    print dec c;
    print dec d;
    log info dec n;
    flush;

    drop src;
    drop dst;
    return;
}
